<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" /> 
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SureBudgetRequest.Web.styles.css"]" />
    <ImportMap />
       @*  <link rel="icon" type="image/png" href="favicon.png" /> *@
    <link rel="icon" href="/favicon.ico" />
   

    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Prevent wheel scrolling from accidentally changing numeric inputs
        document.addEventListener('wheel', function (e) {
            if (document.activeElement && document.activeElement.type === 'number') {
                document.activeElement.blur();
            }
        }, { passive: true });
        // Native drag-cursor support for in-app list reordering (e.g. the export
        // column picker). Blazor's C# drag handlers can't touch the drag's
        // dataTransfer, so without setting an allowed "move" effect (and a tiny
        // payload some browsers require) the browser shows the "no-drop" cursor for
        // the whole drag. Wiring these natively keeps the move/grab cursor and marks
        // the list a valid drop zone. Reordering itself stays in C# (on dragenter).
        window.columnPickerDnd = {
            enable: function (container) {
                if (!container || container.__dndWired) return;
                container.__dndWired = true;
                container.addEventListener('dragstart', function (e) {
                    if (e.dataTransfer) {
                        e.dataTransfer.effectAllowed = 'move';
                        try { e.dataTransfer.setData('text/plain', 'col'); } catch (_) { }
                    }
                });
                container.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
                });
            }
        };

        window.attachmentPreview = {
            createObjectUrls: function (inputId) {
                var input = document.getElementById(inputId);
                if (!input || !input.files) return [];
                var urls = [];
                for (var i = 0; i < input.files.length; i++) {
                    urls.push(URL.createObjectURL(input.files[i]));
                }
                return urls;
            },
            revokeObjectURL: function (url) {
                if (url) {
                    URL.revokeObjectURL(url);
                }
            }
        };

        window.positionContextMenu = function (el, clientX, clientY, isButton) {
            if (!el) return;

            if (clientX !== undefined && clientY !== undefined) {
                el._anchor = { clientX: clientX, clientY: clientY, isButton: !!isButton };
            }

            function updatePos() {
                if (!el || !el.isConnected) return;
                var anchor = el._anchor || { clientX: clientX || 0, clientY: clientY || 0, isButton: !!isButton };
                var w = el.offsetWidth || 220;
                var h = el.offsetHeight || 210;
                var winW = window.innerWidth;
                var winH = window.innerHeight;

                var x = anchor.isButton ? (anchor.clientX - w) : anchor.clientX;
                var y = anchor.clientY + 6;

                if (y + h > winH - 12) {
                    var upY = anchor.isButton ? (anchor.clientY - h - 6) : (anchor.clientY - h);
                    if (upY >= 12) {
                        y = upY;
                    } else {
                        y = Math.max(12, winH - h - 12);
                    }
                }
                if (x + w > winW - 12) {
                    x = winW - w - 12;
                }
                if (x < 12) x = 12;
                if (y < 12) y = 12;

                el.style.left = x + 'px';
                el.style.top = y + 'px';
            }

            updatePos();

            if (window.ResizeObserver && !el._ro) {
                var ro = new ResizeObserver(function () {
                    if (!el || !el.isConnected) {
                        ro.disconnect();
                        if (el) el._ro = null;
                        return;
                    }
                    updatePos();
                });
                ro.observe(el);
                el._ro = ro;
            }

            if (!el._winResizeBound) {
                el._winResizeBound = true;
                window.addEventListener('resize', function () {
                    if (!el || !el.isConnected) return;
                    updatePos();
                }, { passive: true });
            }
        };

        window.positionTooltip = function (el, anchorX, anchorY, placement, anchorW, anchorH) {
            if (!el) return;
            placement = placement || 'top';
            anchorW = anchorW || 0;
            anchorH = anchorH || 0;

            var tw = el.offsetWidth || 120;
            var th = el.offsetHeight || 32;
            var winW = window.innerWidth;
            var winH = window.innerHeight;

            var targetX = anchorW > 0 ? (anchorX + anchorW / 2) : anchorX;
            var targetY = anchorY;

            var actualPlacement = placement;
            var x = 0;
            var y = 0;

            if (placement === 'top') {
                var proposedY = targetY - th - 8;
                if (proposedY < 8) {
                    actualPlacement = 'bottom';
                    y = (anchorH > 0 ? anchorY + anchorH : targetY) + 8;
                } else {
                    y = proposedY;
                }
            } else if (placement === 'bottom') {
                var proposedY = (anchorH > 0 ? anchorY + anchorH : targetY) + 8;
                if (proposedY + th > winH - 8) {
                    actualPlacement = 'top';
                    y = targetY - th - 8;
                } else {
                    y = proposedY;
                }
            } else if (placement === 'left') {
                var proposedX = targetX - tw - 8;
                if (proposedX < 8) {
                    actualPlacement = 'right';
                    x = (anchorW > 0 ? anchorX + anchorW : targetX) + 8;
                } else {
                    x = proposedX;
                }
                y = targetY - (th / 2);
            } else if (placement === 'right') {
                var proposedX = (anchorW > 0 ? anchorX + anchorW : targetX) + 8;
                if (proposedX + tw > winW - 8) {
                    actualPlacement = 'left';
                    x = targetX - tw - 8;
                } else {
                    x = proposedX;
                }
                y = targetY - (th / 2);
            }

            if (actualPlacement === 'top' || actualPlacement === 'bottom') {
                x = targetX - (tw / 2);
            }

            var padding = 8;
            if (x < padding) x = padding;
            if (x + tw > winW - padding) x = winW - tw - padding;
            if (y < padding) y = padding;
            if (y + th > winH - padding) y = winH - th - padding;

            el.style.left = Math.round(x) + 'px';
            el.style.top = Math.round(y) + 'px';
            el.setAttribute('data-placement', actualPlacement);

            var arrow = el.querySelector('.tooltip-arrow');
            if (arrow) {
                if (actualPlacement === 'top' || actualPlacement === 'bottom') {
                    var arrowLeft = targetX - x;
                    arrowLeft = Math.max(10, Math.min(tw - 10, arrowLeft));
                    arrow.style.left = Math.round(arrowLeft) + 'px';
                    arrow.style.top = '';
                } else {
                    var arrowTop = targetY - y;
                    arrowTop = Math.max(8, Math.min(th - 8, arrowTop));
                    arrow.style.top = Math.round(arrowTop) + 'px';
                    arrow.style.left = '';
                }
            }
        };

        window.addEventListener('pointerdown', function () {
            var portals = document.querySelectorAll('.custom-tooltip-portal.visible');
            for (var i = 0; i < portals.length; i++) {
                portals[i].classList.remove('visible');
            }
        }, { passive: true, capture: true });
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting()
            ? InteractiveServer
            : null;
}
