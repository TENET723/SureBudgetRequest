@using SureBudgetRequest.Domain.Enums
@*
    Renders a small "⚠ {period} limit" badge when the supplied snapshot values
    indicate the request crossed its department's cumulative cap at submission.
    Renders nothing otherwise.

    Snapshot-based: drafts (where the snapshots are null / PeriodType = None) never
    show the badge, which is the desired behavior — the cap only matters at submission.

    Use anywhere a budget request is shown:

        <PeriodOverrunBadge
            PeriodType="@r.PeriodTypeAtSubmission"
            PeriodLimitAtSubmission="@r.PeriodLimitAtSubmission"
            PeriodSpendBeforeAtSubmission="@r.PeriodSpendBeforeAtSubmission"
            RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />

    Optional: pass Compact="true" to render just the icon (no text), for
    tight cells. The native browser tooltip still carries the math.
*@

@if (IsOver)
{
    <span class="badge badge-role"
          title="@TooltipText">
        ⚠@(Compact ? "" : $" {PeriodLabel} limit")
    </span>
}

@code {
    [Parameter] public decimal? PeriodLimitAtSubmission { get; set; }
    [Parameter] public decimal? PeriodSpendBeforeAtSubmission { get; set; }
    [Parameter] public decimal RequestedAmountInMmkAtSubmission { get; set; }
    [Parameter] public bool Compact { get; set; }

    private bool IsOver =>
         PeriodLimitAtSubmission.HasValue
        && PeriodSpendBeforeAtSubmission.HasValue
        && (PeriodSpendBeforeAtSubmission.Value + RequestedAmountInMmkAtSubmission) > PeriodLimitAtSubmission.Value;

    private string PeriodLabel => "Monthly";

    private string TooltipText
    {
        get
        {
            if (!IsOver) return "";
            var spend = PeriodSpendBeforeAtSubmission!.Value;
            var limit = PeriodLimitAtSubmission!.Value;
            var amount = RequestedAmountInMmkAtSubmission;
            var total = spend + amount;
            return
                $"Exceeded the {PeriodLabel.ToLowerInvariant()} limit at submission. " +
                $"Already spent {spend:N2} MMK of {limit:N2} MMK; " +
                $"this request adds {amount:N2} MMK (total {total:N2} MMK).";
        }
    }
}
