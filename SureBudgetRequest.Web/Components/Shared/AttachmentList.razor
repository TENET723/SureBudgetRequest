@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using SureBudgetRequest.Application.Abstractions
@using SureBudgetRequest.Application.BudgetRequests.Commands.RemoveAttachment
@using SureBudgetRequest.Application.BudgetRequests.Commands.UploadAttachment
@using SureBudgetRequest.Application.BudgetRequests.Common
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Domain.Enums

@inject IMediator Mediator
@inject ICurrentUser CurrentUser

@*
    Reusable list of attachments + uploader.
    -- Image attachments render as a wrapping gallery of large previews
       (no filename), each clickable to open full size in a new tab.
    -- Non-image attachments render as the familiar row with icon + filename + size.
    -- Editable=true shows the InputFile and per-item Remove (✕).
    The component calls OnChanged after a successful upload or remove so the
    parent can refetch the latest attachment list.
*@

<div class="attachment-list">

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2 small mb-2">@_error</div>
    }

    @{
        // Visible = the slice this section is responsible for rendering.
        // When Category is null we keep the legacy behavior (show everything passed in).
        var visible = Category.HasValue
            ? Attachments.Where(a => a.Category == Category.Value).ToList()
            : Attachments.ToList();

        var images = visible.Where(a => IsImage(a.ContentType)).ToList();
        var files = visible.Where(a => !IsImage(a.ContentType)).ToList();
    }

    @if (visible.Count == 0)
    {
        <div class="text-muted small mb-2"><em>No attachments yet.</em></div>
    }

    @* ── Image previews ─────────────────────────────────────────────────── *@
    @if (images.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-2">
            @foreach (var img in images)
            {
                <div style="position:relative;">
                    <a href="@($"/api/attachments/{img.Id}")"
                       target="_blank"
                       rel="noopener"
                       title="@img.FileName">
                        <img src="@($"/api/attachments/{img.Id}")"
                             alt=""
                             loading="lazy"
                             style="max-width:240px;max-height:240px;object-fit:contain;
                        display:block;border:1px solid #dee2e6;border-radius:6px;
                        background:#f8f9fa;" />
                    </a>
                    @if (Editable)
                    {
                        <button type="button"
                                class="btn btn-sm"
                                disabled="@_busy"
                                @onclick="() => OnRemoveClick(img.Id)"
                                title="Remove"
                                style="position:absolute;top:4px;right:4px;
                            width:24px;height:24px;padding:0;line-height:1;
                            background:rgba(255,255,255,0.92);
                            border:1px solid #dee2e6;border-radius:50%;
                            color:#dc3545;font-size:0.85rem;">
                            ✕
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* ── Non-image files ────────────────────────────────────────────────── *@
    @if (files.Count > 0)
    {
        <ul class="list-group list-group-flush mb-2">
            @foreach (var att in files)
            {
                <li class="list-group-item d-flex align-items-center px-0 py-2">
                    <a href="@($"/api/attachments/{att.Id}")"
                       target="_blank"
                       rel="noopener"
                       class="text-decoration-none flex-grow-1 d-flex align-items-center gap-2"
                       style="min-width:0;">
                        <span style="width:32px;height:32px;display:inline-flex;
                            align-items:center;justify-content:center;
                            font-size:1.3rem;flex-shrink:0;">
                            @FileIcon(att.ContentType)
                        </span>
                        <span class="text-truncate">@att.FileName</span>
                    </a>
                    <span class="text-muted small me-3">@FormatSize(att.SizeBytes)</span>
                    @if (Editable)
                    {
                        <button type="button"
                                class="btn btn-sm btn-link text-danger p-0"
                                disabled="@_busy"
                                @onclick="() => OnRemoveClick(att.Id)"
                                title="Remove">
                            ✕
                        </button>
                    }
                </li>
            }
        </ul>
    }

    @* ── Uploader ──────────────────────────────────────────────────────── *@
    @if (Editable)
    {
        @if (Attachments.Count >= AttachmentConstraints.MaxFilesPerRequest)
        {
            <div class="text-muted small">
                Maximum @AttachmentConstraints.MaxFilesPerRequest files reached.
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-2">
                <InputFile OnChange="OnFileSelected"
                           disabled="@_busy"
                           multiple
                           class="form-control form-control-sm" />
                @if (_busy)
                {
                    <span class="text-muted small">Uploading…</span>
                }
            </div>
            <div class="form-text small mt-1">
                Max @(AttachmentConstraints.MaxBytes / (1024 * 1024)) MB per file.
                PDF, images, Word, Excel, plain text and CSV.
            </div>
        }
    }
</div>

@code {
    /// <summary>The request these attachments belong to.</summary>
    [Parameter, EditorRequired] public Guid BudgetRequestId { get; set; }

    /// <summary>Current list of attachments to render. Parent owns the list.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AttachmentDto> Attachments { get; set; } = Array.Empty<AttachmentDto>();

    /// <summary>True iff the request is in Draft or SentBack AND the viewer is the requester.</summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>
    /// When set, the component renders only attachments of this category and
    /// tags new uploads with it. When null (default), the component renders the
    /// full <see cref="Attachments"/> list unfiltered and uploads tag as
    /// <see cref="AttachmentCategory.General"/> — preserving the pre-category
    /// single-section behavior for callers that pass a flat list.
    ///
    /// The file-count cap is always checked against the TOTAL attachment count
    /// (across categories) so the limit is honored whichever section the upload
    /// happens in.
    /// </summary>
    [Parameter] public AttachmentCategory? Category { get; set; }

    /// <summary>Fired after a successful upload or remove so the parent can refetch.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;

        var files = e.GetMultipleFiles(maximumFileCount: AttachmentConstraints.MaxFilesPerRequest).ToList();

        foreach (var file in files)
        {
            if (Attachments.Count >= AttachmentConstraints.MaxFilesPerRequest)
            {
                _error = $"Maximum {AttachmentConstraints.MaxFilesPerRequest} files reached.";
                break;
            }

            if (file.Size > AttachmentConstraints.MaxBytes)
            {
                _error = $"\"{file.Name}\" is larger than {AttachmentConstraints.MaxBytes / (1024 * 1024)} MB.";
                continue;
            }

            if (!AttachmentConstraints.IsAllowedContentType(file.ContentType))
            {
                _error = $"\"{file.Name}\" has an unsupported file type ({file.ContentType}).";
                continue;
            }

            _busy = true;
            StateHasChanged();

            try
            {
                await using var stream = file.OpenReadStream(AttachmentConstraints.MaxBytes);

                var cmd = new UploadAttachmentCommand(
                    BudgetRequestId,
                    CurrentUser.UserId,
                    file.Name,
                    file.ContentType,
                    file.Size,
                    stream,
                    Category ?? AttachmentCategory.General);

                var result = await Mediator.Send(cmd);
                if (result.IsFailure)
                {
                    _error = result.Error.Message;
                }
                else
                {
                    await OnChanged.InvokeAsync();
                }
            }
            catch (Exception ex)
            {
                _error = $"Upload failed: {ex.Message}";
            }
            finally
            {
                _busy = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnRemoveClick(Guid attachmentId)
    {
        _error = null;
        _busy = true;
        try
        {
            var cmd = new RemoveAttachmentCommand(BudgetRequestId, attachmentId, CurrentUser.UserId);
            var result = await Mediator.Send(cmd);
            if (result.IsFailure)
            {
                _error = result.Error.Message;
            }
            else
            {
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Remove failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsImage(string contentType) =>
        !string.IsNullOrEmpty(contentType) &&
        contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static string FileIcon(string contentType) => contentType switch
    {
        "application/pdf" => "📄",
        "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "📝",
        "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "📊",
        "text/plain" or "text/csv" => "📃",
        _ => "📎",
    };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}