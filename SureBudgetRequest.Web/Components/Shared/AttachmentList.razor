@using Microsoft.AspNetCore.Components.Forms
@using SureBudgetRequest.Application.Abstractions
@using SureBudgetRequest.Application.Abstractions.Services
@using SureBudgetRequest.Application.BudgetRequests.Common
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Domain.Enums

@inject IJSRuntime JS
@inject ICurrentUser CurrentUser
@inject IFileStorage FileStorage

<div class="attachment-list">

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2 small mb-2">@_error</div>
    }

    @{
        // Filter existing and pending attachments based on the category (General / WithdrawMethod)
        var visibleExisting = Category.HasValue
            ? Attachments.Where(a => a.Category == Category.Value && !PendingDeletions.Contains(a.Id)).ToList()
            : Attachments.Where(a => !PendingDeletions.Contains(a.Id)).ToList();

        var visiblePending = Category.HasValue
            ? PendingAttachments.Where(a => a.Category == Category.Value).ToList()
            : PendingAttachments.ToList();

        // Construct Dto list for the gallery
        var pendingDtos = visiblePending.Select(p => new AttachmentDto(
            Id: p.Id,
            FileName: p.FileName,
            ContentType: p.ContentType,
            SizeBytes: p.SizeBytes,
            UploadedByUserId: CurrentUser.UserId,
            UploadedAt: DateTime.UtcNow,
            Category: p.Category
        )).ToList();

        var allVisible = visibleExisting.Concat(pendingDtos).ToList();

        // Create dictionary of preview URLs for the gallery (Guid -> blob Url)
        var previewUrls = visiblePending
            .Where(p => !string.IsNullOrEmpty(p.PreviewUrl))
            .ToDictionary(p => p.Id, p => p.PreviewUrl!);
    }

    @if (allVisible.Count == 0)
    {
        <div class="text-muted small mb-2"><em>No attachments yet.</em></div>
    }
    else
    {
        <div class="my-2">
            <AttachmentStackGallery Attachments="allVisible"
                                    PreviewUrls="previewUrls"
                                    AllowDelete="Editable"
                                    OnDelete="OnRemoveClick"
                                    CardWidth="90px"
                                    CardHeight="70px"
                                    Disabled="_busy" />
        </div>
    }

    @* ── Uploader ──────────────────────────────────────────────────────── *@
    @if (Editable)
    {
        var currentCount = Attachments.Count - PendingDeletions.Count + PendingAttachments.Count;
        @if (currentCount >= AttachmentConstraints.MaxFilesPerRequest)
        {
            <div class="text-muted small">
                Maximum @AttachmentConstraints.MaxFilesPerRequest files reached.
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-2">
                <InputFile id="@_inputId"
                           OnChange="OnFileSelected"
                           disabled="@_busy"
                           multiple
                           class="input" />
            </div>
            <div class="form-text small mt-1">
                Max @(AttachmentConstraints.MaxBytes / (1024 * 1024)) MB per file.
                PDF, images, Word, Excel, plain text and CSV.
            </div>
        }
    }

    @if (PendingAttachments.Any(p => p.Uploading))
    {
        <div class="text-sm text-muted mt-2 d-flex align-items-center gap-2">
            <span class="spinner spinner-sm"></span>
            <span>Uploading attachments to storage...</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AttachmentDto> Attachments { get; set; } = Array.Empty<AttachmentDto>();
    [Parameter] public List<PendingAttachment> PendingAttachments { get; set; } = new();
    [Parameter] public HashSet<Guid> PendingDeletions { get; set; } = new();
    [Parameter] public bool Editable { get; set; }
    [Parameter] public AttachmentCategory? Category { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly string _inputId = $"file-input-{Guid.NewGuid():N}";
    private readonly Guid _sessionId = Guid.NewGuid();
    private bool _busy;
    private string? _error;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        var files = e.GetMultipleFiles(maximumFileCount: AttachmentConstraints.MaxFilesPerRequest).ToList();

        var currentCount = Attachments.Count - PendingDeletions.Count + PendingAttachments.Count;
        if (currentCount >= AttachmentConstraints.MaxFilesPerRequest)
        {
            _error = $"Maximum {AttachmentConstraints.MaxFilesPerRequest} files reached.";
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            // Call JavaScript to generate object URLs for the selected files
            var urls = await JS.InvokeAsync<List<string>>("attachmentPreview.createObjectUrls", _inputId);

            for (int i = 0; i < files.Count; i++)
            {
                var file = files[i];

                if (Attachments.Count - PendingDeletions.Count + PendingAttachments.Count >= AttachmentConstraints.MaxFilesPerRequest)
                {
                    _error = $"Maximum {AttachmentConstraints.MaxFilesPerRequest} files reached.";
                    break;
                }

                if (file.Size > AttachmentConstraints.MaxBytes)
                {
                    _error = $"\"{file.Name}\" is larger than {AttachmentConstraints.MaxBytes / (1024 * 1024)} MB.";
                    continue;
                }

                if (!AttachmentConstraints.IsAllowedContentType(file.ContentType))
                {
                    _error = $"\"{file.Name}\" has an unsupported file type ({file.ContentType}).";
                    continue;
                }

                var url = (urls != null && i < urls.Count) ? urls[i] : null;

                var pending = new PendingAttachment
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    SizeBytes = file.Size,
                    PreviewUrl = url,
                    Category = Category ?? AttachmentCategory.General,
                    Uploading = true
                };

                PendingAttachments.Add(pending);
                await OnChanged.InvokeAsync();

                // Fire-and-forget background upload
                _ = UploadFileAsync(file, pending);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to stage files: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task UploadFileAsync(IBrowserFile file, PendingAttachment pending)
    {
        try
        {
            await using var stream = file.OpenReadStream(AttachmentConstraints.MaxBytes);
            var path = await FileStorage.SaveAsync($"temp/{_sessionId}", file.Name, stream);
            pending.StoredPath = path;
            pending.Uploading = false;
        }
        catch (Exception ex)
        {
            pending.Uploading = false;
            pending.Error = ex.Message;
            _error = $"Failed to upload \"{pending.FileName}\": {ex.Message}";
        }
        finally
        {
            await OnChanged.InvokeAsync();
            StateHasChanged();
        }
    }

    private async Task OnRemoveClick(Guid id)
    {
        _error = null;

        // Check if it is a pending staged file
        var pending = PendingAttachments.FirstOrDefault(p => p.Id == id);
        if (pending != null)
        {
            if (!string.IsNullOrEmpty(pending.PreviewUrl))
            {
                try
                {
                    await JS.InvokeVoidAsync("attachmentPreview.revokeObjectURL", pending.PreviewUrl);
                }
                catch {}
            }

            if (!string.IsNullOrEmpty(pending.StoredPath))
            {
                try
                {
                    await FileStorage.DeleteAsync(pending.StoredPath);
                }
                catch {}
            }

            PendingAttachments.Remove(pending);
            await OnChanged.InvokeAsync();
            return;
        }

        // Check if it is an existing attachment
        var existing = Attachments.FirstOrDefault(a => a.Id == id);
        if (existing != null)
        {
            PendingDeletions.Add(id);
            await OnChanged.InvokeAsync();
        }
    }

    public sealed class PendingAttachment
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string FileName { get; set; } = null!;
        public string ContentType { get; set; } = null!;
        public long SizeBytes { get; set; }
        public string? PreviewUrl { get; set; }
        public string? StoredPath { get; set; }
        public AttachmentCategory Category { get; set; }
        public bool Uploading { get; set; }
        public string? Error { get; set; }
    }
}