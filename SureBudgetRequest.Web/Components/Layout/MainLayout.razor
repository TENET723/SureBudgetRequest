<div class="app-shell @(_sidebarCollapsed ? "sidebar-collapsed" : "")" id="app-shell">
    <aside class="sidebar" id="app-sidebar">
        <div class="nav-brand">
            <a href="" class="brand-logo">aSure Budget</a>
            <button class="btn btn-icon sidebar-toggle" @onclick="ToggleSidebar" title="Toggle sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M7.22 14.47L9.69 12L7.22 9.53a.749.749 0 0 1 .326-1.275a.75.75 0 0 1 .734.215l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 0 1-1.042-.018a.75.75 0 0 1-.018-1.042"/><path fill="currentColor" d="M3.75 2h16.5c.966 0 1.75.784 1.75 1.75v16.5A1.75 1.75 0 0 1 20.25 22H3.75A1.75 1.75 0 0 1 2 20.25V3.75C2 2.784 2.784 2 3.75 2M3.5 3.75v16.5c0 .138.112.25.25.25H15v-17H3.75a.25.25 0 0 0-.25.25m13 16.75h3.75a.25.25 0 0 0 .25-.25V3.75a.25.25 0 0 0-.25-.25H16.5Z"/></svg>
            </button>
        </div>
        <nav class="sidebar-nav">
            <NavMenu Collapsed="_sidebarCollapsed" OnExpandRequested="ExpandSidebar" />
        </nav>

        @if (CurrentUser.IsLoaded)
        {
            <div class="sidebar-profile-wrap">
                <button type="button" class="sidebar-profile-trigger @(CurrentUser.IsFallbackPersonAct ? "delegated" : "") @(ContextMenu.IsOpen ? "active" : "")"
                        @onclick="OpenProfileContextMenu"
                        title="@(CurrentUser.IsFallbackPersonAct ? $"Acting as {CurrentUser.FullName} (You: {CurrentUser.RealActorFullName})" : $"{CurrentUser.FullName} ({CurrentUser.Role})")">
                    <div class="profile-avatar-wrap">
                        <div class="user-avatar" style="@(CurrentUser.IsFallbackPersonAct ? "background: #d97706;" : "")">
                            @(CurrentUser.FullName.Length > 0 ? CurrentUser.FullName[0].ToString().ToUpper() : "?")
                        </div>
                        <span class="avatar-status-dot @(CurrentUser.IsFallbackPersonAct ? "status-delegated" : (_isOnLeave ? "status-leave" : "status-active"))"></span>
                    </div>
                    <div class="profile-user-info">
                        <span class="profile-user-name">@CurrentUser.FullName</span>
                        <span class="profile-user-role">
                            @if (CurrentUser.IsFallbackPersonAct)
                            {
                                <span class="text-amber-600 font-semibold" style="font-size: 10.5px;">Acting on behalf</span>
                            }
                            else if (_isOnLeave)
                            {
                                <span class="text-amber-600 font-semibold">On Leave</span>
                            }
                            else
                            {
                                @CurrentUser.Role
                            }
                        </span>
                    </div>
                    <svg class="profile-chevron" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="12" r="1.5"/>
                        <circle cx="12" cy="5" r="1.5"/>
                        <circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>
            </div>
        }
    </aside>

    <div class="main-area">
        @* @if (CurrentUser.IsFallbackPersonAct)
        {
            <div class="delegation-banner">
                <div class="flex items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <span>
                        Acting as <strong>@CurrentUser.FullName</strong> (while on leave). Actions are recorded under your name (<strong>@CurrentUser.RealActorFullName</strong>).
                    </span>
                </div>
                <form method="post" action="/account/switch-back" style="margin:0;"
                      onsubmit="var o=document.getElementById('switching-overlay');var t=document.getElementById('switching-overlay-text');if(t)t.textContent='Switching back to your account…';if(o)o.style.display='flex';">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-switch-back">
                        Switch Back to My Account
                    </button>
                </form>
            </div>
        } *@

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<ToastContainer />
<LoadingOverlay />
<ContextMenuContainer />
<TooltipContainer />
<DebitVoucherPrint />

@* ── Instant Feedback Overlay for Account Switching ──────────────────────── *@
<div id="switching-overlay" class="loading-overlay" style="display:none;">
    <div class="spinner"></div>
    <span class="loading-overlay-text" id="switching-overlay-text">Switching account…</span>
</div>

@* ── Switch Account Popover Box (Tag Management Style) ──────────────────────── *@
@if (_showSwitchPopover)
{
    <div style="position: fixed; inset: 0; z-index: 1055; background: transparent;"
         @onclick="CloseAllPopovers"
         @onclick:stopPropagation="true">
    </div>

    <div class="tag-popover-box" style="left: @(_sidebarCollapsed ? 64 : 12)px; bottom: 12px; width: 300px;"
         @onclick:stopPropagation="true">
        <div class="popover-header">
            <div class="popover-header-lead">
                <div class="popover-header-icon text-blue-600">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="8.5" cy="7" r="4"/>
                        <polyline points="17 11 19 13 23 9"/>
                    </svg>
                </div>
                <div>
                    <div class="popover-title-text">Switch Account</div>
                    <div class="popover-subtitle-text">Act on behalf of colleague on leave</div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="popover-quota">@_availableDelegations.Count</span>
                <button type="button" class="btn btn-icon btn-xs" style="padding: 1px 4px; border: none; background: transparent; color: var(--color-text-muted); cursor: pointer;"
                        @onclick="CloseAllPopovers" title="Close">✕</button>
            </div>
        </div>

        <div class="popover-search-wrap">
            <input type="text" class="input input-sm w-full"
                   placeholder="Search colleague..."
                   @bind="_switchSearchFilter"
                   @bind:event="oninput" />
        </div>

        <div class="popover-tag-list" style="max-height: 240px; padding: 4px;">
            @{
                var filteredDelegations = _availableDelegations
                    .Where(d => string.IsNullOrWhiteSpace(_switchSearchFilter) ||
                                d.FullName.Contains(_switchSearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                d.Role.ToString().Contains(_switchSearchFilter, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            @if (filteredDelegations.Count > 0)
            {
                @foreach (var del in filteredDelegations)
                {
                    <form method="post" action="/account/switch-user" style="display:block;margin:0;"
                          onsubmit="var o=document.getElementById('switching-overlay');var t=document.getElementById('switching-overlay-text');if(t)t.textContent='Switching to @del.FullName…';if(o)o.style.display='flex';">
                        <AntiforgeryToken />
                        <input type="hidden" name="targetUserId" value="@del.Id" />
                        <button type="submit" class="popover-user-row" title="Act on behalf of @del.FullName">
                            <div class="cm-switch-avatar">@(del.FullName.Length > 0 ? del.FullName[0].ToString().ToUpper() : "?")</div>
                            <div class="popover-user-info">
                                <span class="popover-user-name">@del.FullName</span>
                                <span class="popover-user-role">@del.Role</span>
                            </div>
                            <div class="popover-user-action">
                                <span class="btn btn-outline btn-xs" style="padding: 2px 8px; font-size: 11px;">Switch</span>
                            </div>
                        </button>
                    </form>
                }
            }
            else
            {
                <div class="text-muted text-xs p-4 text-center">
                    @(string.IsNullOrWhiteSpace(_switchSearchFilter) ? "No available delegations." : "No matching colleagues.")
                </div>
            }
        </div>
    </div>
}

@* ── Assign Fallback Colleague Popover Box (Tag Management Style) ─────────────── *@
@if (_showFallbackPopover)
{
    <div style="position: fixed; inset: 0; z-index: 1055; background: transparent;"
         @onclick="CloseAllPopovers"
         @onclick:stopPropagation="true">
    </div>

    <div class="tag-popover-box" style="left: @(_sidebarCollapsed ? 64 : 12)px; bottom: 12px; width: 310px;"
         @onclick:stopPropagation="true">
        <div class="popover-header">
            <div class="popover-header-lead">
                <div class="popover-header-icon text-indigo-600">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <div class="popover-title-text">Fallback Colleague</div>
                    <div class="popover-subtitle-text">Colleague who covers for you while on leave</div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                @if (_savingDelegation)
                {
                    <span class="spinner spinner-xs" style="width: 10px; height: 10px; border-width: 1.5px; border-color: var(--color-primary); border-top-color: transparent;"></span>
                }
                <button type="button" class="btn btn-icon btn-xs" style="padding: 1px 4px; border: none; background: transparent; color: var(--color-text-muted); cursor: pointer;"
                        @onclick="CloseAllPopovers" title="Close">✕</button>
            </div>
        </div>

        <div class="popover-search-wrap">
            <input type="text" class="input input-sm w-full"
                   placeholder="Search colleague to assign..."
                   @bind="_fallbackSearchFilter"
                   @bind:event="oninput" />
        </div>

        <div class="popover-tag-list" style="max-height: 240px; padding: 4px;">
            @{
                var filteredFallbackUsers = _eligibleFallbackUsers
                    .Where(u => string.IsNullOrWhiteSpace(_fallbackSearchFilter) ||
                                u.FullName.Contains(_fallbackSearchFilter, StringComparison.OrdinalIgnoreCase) ||
                                u.Role.ToString().Contains(_fallbackSearchFilter, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            @if (filteredFallbackUsers.Count > 0)
            {
                @foreach (var user in filteredFallbackUsers)
                {
                    var isCurrent = _currentFallbackUserId == user.Id;
                    <div class="popover-user-row @(isCurrent ? "selected" : "")"
                         style="cursor: pointer;"
                         @onclick="() => SelectFallbackColleagueAsync(user)">
                        <div class="cm-switch-avatar">@(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")</div>
                        <div class="popover-user-info">
                            <span class="popover-user-name">@user.FullName</span>
                            <span class="popover-user-role">@user.Role</span>
                        </div>
                        <div class="popover-user-action">
                            @if (isCurrent)
                            {
                                <span class="text-indigo-600 font-bold" style="font-size: 15px;">✓</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted text-xs p-4 text-center">
                    @(string.IsNullOrWhiteSpace(_fallbackSearchFilter) ? "No eligible colleagues found." : "No matching colleagues.")
                </div>
            }
        </div>

        <div class="popover-footer-action flex items-center justify-between" style="padding: 8px 12px; border-top: 1px solid var(--color-border); background: #fafafa;">
            @if (_currentFallbackUserId.HasValue)
            {
                <button type="button" class="btn btn-outline btn-xs text-danger" style="padding: 3px 8px; font-size: 11px;"
                        disabled="@_savingDelegation"
                        @onclick="RemoveFallbackColleagueAsync">
                    Remove Fallback
                </button>
            }
            else
            {
                <span class="text-xs text-muted" style="font-size: 11px;">None assigned</span>
            }
            <button type="button" class="btn btn-primary btn-xs" style="padding: 3px 12px; font-size: 11px;"
                    @onclick="CloseAllPopovers">
                Done
            </button>
        </div>
    </div>
}

@* ── Change Password Popover Box (Tag Management Style) ──────────────────────── *@
@if (_showChangePasswordPopover)
{
    <div style="position: fixed; inset: 0; z-index: 1055; background: transparent;"
         @onclick="CloseAllPopovers"
         @onclick:stopPropagation="true">
    </div>

    <div class="tag-popover-box" style="left: @(_sidebarCollapsed ? 64 : 12)px; bottom: 12px; width: 320px;"
         @onclick:stopPropagation="true">
        <div class="popover-header">
            <div class="popover-header-lead">
                <div class="popover-header-icon text-amber-600">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <div>
                    <div class="popover-title-text">Change Password</div>
                    <div class="popover-subtitle-text">Update your account login password</div>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-xs" style="padding: 1px 4px; border: none; background: transparent; color: var(--color-text-muted); cursor: pointer;"
                    @onclick="CloseAllPopovers" title="Close">✕</button>
        </div>

        <div style="padding: 12px 14px; display: flex; flex-direction: column; gap: 10px;">
            @if (!string.IsNullOrEmpty(_passwordError))
            {
                <div class="alert alert-error text-xs" style="padding: 6px 10px; font-size: 11.5px; border-radius: var(--radius-sm); margin: 0;">
                    @_passwordError
                </div>
            }

            <div class="form-field">
                <label class="form-label" style="font-size: 11.5px; margin-bottom: 3px; font-weight: 600;">Current password</label>
                <input type="password" class="input input-sm w-full"
                       placeholder="Enter current password"
                       @bind="_currentPassword"
                       autocomplete="current-password"
                       autofocus />
            </div>

            <div class="form-field">
                <label class="form-label" style="font-size: 11.5px; margin-bottom: 3px; font-weight: 600;">New password</label>
                <input type="password" class="input input-sm w-full"
                       placeholder="Min. 6 characters"
                       @bind="_newPassword"
                       autocomplete="new-password" />
            </div>

            <div class="form-field">
                <label class="form-label" style="font-size: 11.5px; margin-bottom: 3px; font-weight: 600;">Confirm new password</label>
                <input type="password" class="input input-sm w-full"
                       placeholder="Repeat new password"
                       @bind="_confirmPassword"
                       autocomplete="new-password" />
            </div>
        </div>

        <div class="popover-footer-action flex items-center justify-between" style="padding: 8px 12px; border-top: 1px solid var(--color-border); background: #fafafa;">
            <button type="button" class="btn btn-outline btn-xs" style="padding: 3px 10px; font-size: 11px;"
                    @onclick="CloseAllPopovers">
                Cancel
            </button>
            <button type="button" class="btn btn-primary btn-xs" style="padding: 3px 14px; font-size: 11px;"
                    disabled="@_savingPassword"
                    @onclick="HandleChangePasswordAsync">
                @if (_savingPassword)
                {
                    <span class="spinner spinner-xs" style="width: 10px; height: 10px; border-width: 1.5px; margin-right: 4px;"></span>
                    <span>Updating…</span>
                }
                else
                {
                    <span>Update Password</span>
                }
            </button>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _sidebarCollapsed = false;
    private List<UserDto> _availableDelegations = new();
    private List<UserDto> _eligibleFallbackUsers = new();
    private double _lastMenuX;
    private double _lastMenuY;

    // Popover states
    private bool _showSwitchPopover;
    private string _switchSearchFilter = "";
    private bool _showFallbackPopover;
    private string _fallbackSearchFilter = "";
    private bool _showChangePasswordPopover;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _passwordError;
    private bool _savingPassword;

    // Leave & fallback state
    private bool _isOnLeave;
    private Guid? _currentFallbackUserId;
    private string? _currentFallbackUserName;
    private bool _savingDelegation;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
    private void ExpandSidebar() => _sidebarCollapsed = false;

    private void OpenProfileContextMenu(MouseEventArgs e)
    {
        CloseAllPopovers();

        if (ContextMenu.IsOpen)
        {
            ContextMenu.Close();
            return;
        }

        _lastMenuX = _sidebarCollapsed ? 64 : 12;
        _lastMenuY = e.ClientY;

        var menuTitle = CurrentUser.IsFallbackPersonAct ? $"{CurrentUser.FullName} (Delegated)" : CurrentUser.FullName;
        ContextMenu.Show(_lastMenuX, _lastMenuY, RenderProfileContextMenu(), title: menuTitle, isButton: false, customClass: "profile-context-menu");
    }

    private void CloseAllPopovers()
    {
        _showSwitchPopover = false;
        _showFallbackPopover = false;
        _showChangePasswordPopover = false;
        _passwordError = null;
    }

    private void OpenChangePasswordPopover()
    {
        ContextMenu.Close();
        _currentPassword = "";
        _newPassword = "";
        _confirmPassword = "";
        _passwordError = null;
        _showChangePasswordPopover = true;
        _showSwitchPopover = false;
        _showFallbackPopover = false;
    }

    private async Task HandleChangePasswordAsync()
    {
        if (_savingPassword) return;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordError = "Current password is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < ChangePasswordCommandHandler.MinimumPasswordLength)
        {
            _passwordError = $"New password must be at least {ChangePasswordCommandHandler.MinimumPasswordLength} characters.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordError = "New password and confirmation do not match.";
            return;
        }

        if (_currentPassword == _newPassword)
        {
            _passwordError = "New password must be different from current password.";
            return;
        }

        _savingPassword = true;
        _passwordError = null;

        try
        {
            var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;
            var result = await Mediator.Send(new ChangePasswordCommand(
                realId,
                _currentPassword,
                _newPassword));

            if (result.IsFailure)
            {
                _passwordError = result.Error.Message;
                return;
            }

            _showChangePasswordPopover = false;
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
            Toast.Show(ToastLevel.Success, "Password Updated", "Your password has been changed successfully.");
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private void OpenSwitchPopover()
    {
        ContextMenu.Close();
        _switchSearchFilter = "";
        _showSwitchPopover = true;
        _showFallbackPopover = false;
    }

    private async Task OpenFallbackPopoverAsync()
    {
        ContextMenu.Close();
        _fallbackSearchFilter = "";
        if (_eligibleFallbackUsers.Count == 0)
        {
            await LoadEligibleFallbackUsers();
        }
        _showFallbackPopover = true;
        _showSwitchPopover = false;
    }

    private async Task LoadEligibleFallbackUsers()
    {
        var usersResult = await Mediator.Send(new ListUsersQuery(IncludeInactive: false));
        if (usersResult.IsSuccess)
        {
            var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;
            _eligibleFallbackUsers = usersResult.Value.Where(u => u.Id != realId).OrderBy(u => u.FullName).ToList();
        }
    }

    private async Task SelectFallbackColleagueAsync(UserDto colleague)
    {
        if (_savingDelegation) return;

        _savingDelegation = true;
        try
        {
            var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;
            var result = await Mediator.Send(new UpdateUserFallbackCommand(realId, colleague.Id, _isOnLeave));
            if (result.IsFailure)
            {
                Toast.Show(ToastLevel.Error, "Update Failed", result.Error.Message);
                return;
            }

            _currentFallbackUserId = colleague.Id;
            _currentFallbackUserName = colleague.FullName;
            Toast.Show(ToastLevel.Success, "Fallback Assigned", $"{colleague.FullName} is designated as your fallback colleague.");
        }
        finally
        {
            _savingDelegation = false;
        }
    }

    private async Task RemoveFallbackColleagueAsync()
    {
        if (_savingDelegation) return;

        if (_isOnLeave)
        {
            Toast.Show(ToastLevel.Warning, "Action Blocked", "Please turn off 'On Leave' status before removing your fallback colleague.");
            return;
        }

        _savingDelegation = true;
        try
        {
            var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;
            var result = await Mediator.Send(new UpdateUserFallbackCommand(realId, null, false));
            if (result.IsFailure)
            {
                Toast.Show(ToastLevel.Error, "Update Failed", result.Error.Message);
                return;
            }

            _currentFallbackUserId = null;
            _currentFallbackUserName = null;
            Toast.Show(ToastLevel.Success, "Fallback Removed", "Fallback colleague designation has been cleared.");
        }
        finally
        {
            _savingDelegation = false;
        }
    }

    private async Task ToggleLeaveStatusAsync()
    {
        if (_savingDelegation) return;

        var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;

        // If trying to turn on leave, ensure a fallback user is designated
        if (!_isOnLeave && !_currentFallbackUserId.HasValue)
        {
            ContextMenu.Close();
            Toast.Show(ToastLevel.Warning, "Fallback Required", "Please assign a fallback colleague before marking yourself on leave.");
            await OpenFallbackPopoverAsync();
            return;
        }

        _savingDelegation = true;
        try
        {
            var targetLeave = !_isOnLeave;
            var result = await Mediator.Send(new UpdateUserFallbackCommand(realId, _currentFallbackUserId, targetLeave));
            if (result.IsFailure)
            {
                Toast.Show(ToastLevel.Error, "Update Failed", result.Error.Message);
                return;
            }

            _isOnLeave = targetLeave;
            Toast.Show(ToastLevel.Success, "Status Updated", _isOnLeave ? "You are now marked as On Leave." : "You are now marked as Active.");

            if (ContextMenu.IsOpen)
            {
                ContextMenu.Show(_lastMenuX, _lastMenuY, RenderProfileContextMenu(), title: CurrentUser.FullName, isButton: false, customClass: "profile-context-menu");
            }
            StateHasChanged();
        }
        finally
        {
            _savingDelegation = false;
        }
    }

    private RenderFragment RenderProfileContextMenu() => @<text>
        @if (CurrentUser.IsFallbackPersonAct)
        {
            @* Delegated session indicator badge *@
            <div style="padding: 8px 12px; background: #fffbeb; border-radius: var(--radius-sm); margin: 4px 6px 6px; border: 1px solid #fef3c7;">
                <div class="flex items-center gap-1.5" style="color: #b45309; font-weight: 700; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.04em;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>Acting on behalf</span>
                </div>
                
                <div class="text-muted" style="font-size: 11px; margin-top: 1px;">
                    Real account: <strong class="text-slate-700">@CurrentUser.RealActorFullName</strong>
                </div>
            </div>

            @* Prominent switch back action *@
            <form method="post" action="/account/switch-back" style="margin: 2px 0 6px;"
                  onsubmit="var o=document.getElementById('switching-overlay');var t=document.getElementById('switching-overlay-text');if(t)t.textContent='Switching back to @CurrentUser.RealActorFullName…';if(o)o.style.display='flex';">
                <AntiforgeryToken />
                <button type="submit" class="context-menu-item flex items-center justify-between" style="font-weight: 600; color: #1d4ed8; background: #eff6ff; padding: 7px 12px; border-radius: var(--radius-sm); width: calc(100% - 12px); margin: 0 6px;">
                    <div class="flex items-center gap-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 14 4 9 9 4"/>
                            <path d="M20 20v-7a4 4 0 0 0-4-4H4"/>
                        </svg>
                        <span>Switch Back to My Account</span>
                    </div>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-500">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </button>
            </form>
        }
        else
        {
            @* 1. Switch Account (opens popover box) *@
            @if (_availableDelegations.Count > 0)
            {
                <button type="button" class="context-menu-item flex items-center justify-between" @onclick="OpenSwitchPopover">
                    <div class="flex items-center gap-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-600">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <polyline points="17 11 19 13 23 9"/>
                        </svg>
                        <span>Switch Account</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="cm-count-pill">@_availableDelegations.Count</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </div>
                </button>
            }
            else
            {
                <div class="context-menu-item text-muted flex items-center justify-between" style="cursor:default;opacity:0.6;">
                    <div class="flex items-center gap-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <polyline points="17 11 19 13 23 9"/>
                        </svg>
                        <span>Switch Account</span>
                    </div>
                    <span class="text-xs text-muted" style="font-size:10px;">0</span>
                </div>
            }

            @* 2. On Leave (toggle) *@
            <div class="context-menu-item flex items-center justify-between cursor-pointer" @onclick="ToggleLeaveStatusAsync" @onclick:stopPropagation="true">
                <div class="flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isOnLeave ? "text-amber-500" : "text-muted")">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                    <div class="flex flex-col text-left">
                        <span class="leading-tight font-medium">On Leave</span>
                        <span class="text-muted" style="font-size:10px;">@(_isOnLeave ? "Out of office" : "Active")</span>
                    </div>
                </div>
                <div class="cm-toggle-track @(_isOnLeave ? "active" : "")">
                    <div class="cm-toggle-knob"></div>
                </div>
            </div>

            @* 3. Assign Fallback User (opens popover box) *@
            <button type="button" class="context-menu-item flex items-center justify-between" @onclick="OpenFallbackPopoverAsync">
                <div class="flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-500">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <div class="flex flex-col text-left">
                        <span class="leading-tight font-medium">Assign Fallback User</span>
                        <span class="text-muted" style="font-size:10px;">@(!string.IsNullOrEmpty(_currentFallbackUserName) ? $"Current: {_currentFallbackUserName}" : "None assigned")</span>
                    </div>
                </div>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>

            <div class="context-menu-divider"></div>

            @* 4. Change Password *@
            <button type="button" class="context-menu-item" @onclick="OpenChangePasswordPopover">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Change Password</span>
            </button>
        }

        @* 5. Logout *@
        <form method="post" action="/logout" style="margin:0;">
            <AntiforgeryToken />
            <button type="submit" class="context-menu-item text-danger">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3M11 11l3-3-3-3M14 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Logout</span>
            </button>
        </form>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        DelegationNotifier.OnRevocation += HandleDelegationRevoked;

        var authState = await AuthStateTask;
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var mustChange = authState.User
            .FindFirst(SureBudgetRequest.Web.Services.CurrentUserService.ClaimMustChangePassword)?.Value == "true";

        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (mustChange && !relative.StartsWith("/account/change-password", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/account/change-password", forceLoad: false);
            return;
        }

        await LoadDelegationData();
    }

    private async Task LoadDelegationData()
    {
        if (!CurrentUser.IsLoaded) return;

        if (CurrentUser.IsFallbackPersonAct)
        {
            var targetUserResult = await Mediator.Send(new GetUserQuery(CurrentUser.UserId));
            if (targetUserResult.IsFailure ||
                !targetUserResult.Value.IsOnLeave ||
                targetUserResult.Value.FallbackUserId != CurrentUser.RealActorUserId)
            {
                Nav.NavigateTo("/logout", forceLoad: true);
                return;
            }
        }

        // Load available delegations (who delegated to me)
        var delResult = await Mediator.Send(new GetAvailableDelegationsQuery());
        if (delResult.IsSuccess)
        {
            _availableDelegations = delResult.Value.ToList();
        }

        // Load current user's own fallback and leave status
        var realId = CurrentUser.RealActorUserId != Guid.Empty ? CurrentUser.RealActorUserId : CurrentUser.UserId;
        var userResult = await Mediator.Send(new GetUserQuery(realId));
        if (userResult.IsSuccess)
        {
            _isOnLeave = userResult.Value.IsOnLeave;
            _currentFallbackUserId = userResult.Value.FallbackUserId;
            if (_currentFallbackUserId.HasValue)
            {
                var fb = await Mediator.Send(new GetUserQuery(_currentFallbackUserId.Value));
                _currentFallbackUserName = fb.IsSuccess ? fb.Value.FullName : null;
            }
            else
            {
                _currentFallbackUserName = null;
            }
        }
    }

    private static string FormatUserOption(UserDto u) => $"{u.FullName} ({u.Role})";

    private void HandleDelegationRevoked(Guid targetUserId)
    {
        if (CurrentUser.IsFallbackPersonAct && CurrentUser.UserId == targetUserId)
        {
            _ = InvokeAsync(() => Nav.NavigateTo("/logout", forceLoad: true));
        }
    }

    public void Dispose()
    {
        DelegationNotifier.OnRevocation -= HandleDelegationRevoked;
    }
}
