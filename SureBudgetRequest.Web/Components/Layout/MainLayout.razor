@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-between">
            <div></div>
            <div class="d-flex align-items-center gap-2">
                @if (CurrentUser.IsLoaded)
                {
                    <span class="small">@CurrentUser.FullName</span>
                    <span class="badge bg-secondary">@CurrentUser.Role</span>
                    <a class="btn btn-sm btn-outline-secondary" href="/account/change-password">Change password</a>
                    <form method="post" action="/logout" class="m-0">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // If the user is logged in with MustChangePassword=true, force them to the
        // change-password page before they can use any other page.
        var authState = await AuthStateTask;
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var mustChange = authState.User
            .FindFirst(SureBudgetRequest.Web.Services.CurrentUserService.ClaimMustChangePassword)?.Value == "true";

        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (mustChange && !relative.StartsWith("/account/change-password", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/account/change-password", forceLoad: false);
        }
    }
}
