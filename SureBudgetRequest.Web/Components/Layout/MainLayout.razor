@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

<div class="app-shell @(_sidebarCollapsed ? "sidebar-collapsed" : "")" id="app-shell">
    <aside class="sidebar" id="app-sidebar">
        <div class="nav-brand">
            @if (!_sidebarCollapsed)
            {
                <a href="" class="brand-logo">aSure Budget</a>
            }
            <button class="btn btn-icon sidebar-toggle" @onclick="ToggleSidebar" title="Toggle sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M7.22 14.47L9.69 12L7.22 9.53a.749.749 0 0 1 .326-1.275a.75.75 0 0 1 .734.215l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 0 1-1.042-.018a.75.75 0 0 1-.018-1.042"/><path fill="currentColor" d="M3.75 2h16.5c.966 0 1.75.784 1.75 1.75v16.5A1.75 1.75 0 0 1 20.25 22H3.75A1.75 1.75 0 0 1 2 20.25V3.75C2 2.784 2.784 2 3.75 2M3.5 3.75v16.5c0 .138.112.25.25.25H15v-17H3.75a.25.25 0 0 0-.25.25m13 16.75h3.75a.25.25 0 0 0 .25-.25V3.75a.25.25 0 0 0-.25-.25H16.5Z"/></svg>
            </button>
        </div>
        <nav class="sidebar-nav">
            <NavMenu Collapsed="_sidebarCollapsed" />
        </nav>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-left">
                @* Page title injected by each page via CascadingValue or left blank *@
            </div>
            <div class="topbar-right">
                @if (CurrentUser.IsLoaded)
                {
                   @*  <button class="notif-bell" title="Notifications">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 2a6 6 0 0 0-6 6v3l-1.5 2.5A1 1 0 0 0 3.5 15h13a1 1 0 0 0 .866-1.5L16 11V8a6 6 0 0 0-6-6Z" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M8 15a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        <span class="notif-badge">!</span>
                    </button> *@
                    <div class="topbar-user">
                        <div class="user-avatar">@(CurrentUser.FullName.Length > 0 ? CurrentUser.FullName[0].ToString().ToUpper() : "?")</div>
                        <div class="user-info">
                            <span class="user-name">@CurrentUser.FullName</span>
                            <span class="user-role"><span class="role-dot"></span>@CurrentUser.Role</span>
                        </div>
                       @*  <svg class="user-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg> *@
                    </div>
                }
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<ToastContainer />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _sidebarCollapsed = false;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var mustChange = authState.User
            .FindFirst(SureBudgetRequest.Web.Services.CurrentUserService.ClaimMustChangePassword)?.Value == "true";

        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (mustChange && !relative.StartsWith("/account/change-password", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/account/change-password", forceLoad: false);
        }
    }
}
