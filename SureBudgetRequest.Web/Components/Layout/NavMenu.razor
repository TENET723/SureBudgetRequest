@inject ICurrentUser CurrentUser

<div class="nav-home nav-item">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 6.5L8 2l6 4.5V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M6 15v-4h4v4" stroke="currentColor" stroke-width="1.5"/></svg>
        Home
    </NavLink>
</div>

<div class="nav-group">
    <button class="nav-group-header" onclick="this.classList.toggle('collapsed');this.nextElementSibling.classList.toggle('collapsed')">
        <span>Budget Requests</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="nav-group-items">
        <div class="nav-item">
            <NavLink class="nav-link" href="requests/mine">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M5 6h6M5 9h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                My Requests
            </NavLink>
        </div>

        @if (CurrentUser.Role is not UserRole.Employee and not UserRole.Accounting)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="requests/inbox">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="8" width="14" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M1 8l3-5h8l3 5" stroke="currentColor" stroke-width="1.5"/><path d="M5 11h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Inbox
                </NavLink>
            </div>
        }

        @if (CurrentUser.Role is UserRole.Finance or UserRole.Admin or UserRole.Accounting)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="requests/outstanding">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M1 7h14" stroke="currentColor" stroke-width="1.5"/><path d="M4 10h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Outstanding Payments
                </NavLink>
            </div>
        }

        @if (CurrentUser.Role is UserRole.Finance or UserRole.Admin)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="coas">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Chart Of Accounts
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="withdraw-methods">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 12V4M5 7l3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Withdraw Methods
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="bank-accounts">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 7h12M2 13h12M8 2L2 7h12L8 2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 7v6M8 7v6M12 7v6" stroke="currentColor" stroke-width="1.5"/></svg>
                    Bank Accounts
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="app-settings">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.5"/><path d="M13.5 8c0-.4 0-.8-.1-1.1l1.4-1.1-1.5-2.6-1.7.7A5.5 5.5 0 0 0 9 3.1V1.5H7v1.6a5.5 5.5 0 0 0-1.6.8L3.7 3.2 2.2 5.8l1.4 1.1C3.5 7.2 3.5 7.6 3.5 8s0 .8.1 1.1L2.2 10.2l1.5 2.6 1.7-.7a5.5 5.5 0 0 0 1.6.8v1.6H9v-1.6a5.5 5.5 0 0 0 1.6-.8l1.7.7 1.5-2.6-1.4-1.1c.1-.3.1-.7.1-1.1Z" stroke="currentColor" stroke-width="1.5"/></svg>
                    App Settings
                </NavLink>
            </div>
        }
    </div>
</div>

@if (CurrentUser.Role is not UserRole.Employee)
{
    <div class="nav-group">
        <button class="nav-group-header" onclick="this.classList.toggle('collapsed');this.nextElementSibling.classList.toggle('collapsed')">
            <span>Reports</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-group-items">
            <div class="nav-item">
                <NavLink class="nav-link" href="reports/budget-requests">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="10" width="3" height="4" rx="0.5" fill="currentColor"/><rect x="6" y="6" width="3" height="8" rx="0.5" fill="currentColor"/><rect x="11" y="2" width="3" height="12" rx="0.5" fill="currentColor"/></svg>
                    Budget Requests
                </NavLink>
            </div>
        </div>
    </div>
}

@if (CurrentUser.Role == UserRole.Finance)
{
    <div class="nav-group">
        <button class="nav-group-header" onclick="this.classList.toggle('collapsed');this.nextElementSibling.classList.toggle('collapsed')">
            <span>Admin</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-group-items">
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/users">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Users
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="finance/budget-plan">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="11" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M1 7h14M5 3V1M11 3V1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Budget Plan
                </NavLink>
            </div>
        </div>
    </div>
}

@if (CurrentUser.Role == UserRole.Admin)
{
    <div class="nav-group">
        <button class="nav-group-header" onclick="this.classList.toggle('collapsed');this.nextElementSibling.classList.toggle('collapsed')">
            <span>Admin</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-group-items">
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/departments">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="6" width="12" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M5 6V4a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5"/></svg>
                    Departments
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/department-heads">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M1 14c0-2.8 2.2-5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M11 9l1.5 1.5L15 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Dept. Heads
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/users">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Users
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/currencies">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v6M6 6.5h3a1 1 0 0 1 0 2H7a1 1 0 0 0 0 2h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Currencies
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/budget-categories">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4h3l2 2h7a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5"/></svg>
                    Budget Categories
                </NavLink>
            </div>
        </div>
    </div>
}

<div class="sidebar-bottom">
    <div class="nav-item">
        <NavLink class="nav-link" href="account/change-password">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.5"/><path d="M13.5 8c0-.4 0-.8-.1-1.1l1.4-1.1-1.5-2.6-1.7.7A5.5 5.5 0 0 0 9 3.1V1.5H7v1.6a5.5 5.5 0 0 0-1.6.8L3.7 3.2 2.2 5.8l1.4 1.1C3.5 7.2 3.5 7.6 3.5 8s0 .8.1 1.1L2.2 10.2l1.5 2.6 1.7-.7a5.5 5.5 0 0 0 1.6.8v1.6H9v-1.6a5.5 5.5 0 0 0 1.6-.8l1.7.7 1.5-2.6-1.4-1.1c.1-.3.1-.7.1-1.1Z" stroke="currentColor" stroke-width="1.5"/></svg>
            Settings
        </NavLink>
    </div>
    <div class="nav-item">
        <form method="post" action="/logout" class="signout-form">
            <AntiforgeryToken />
            <button type="submit" class="signout-btn">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3M11 11l3-3-3-3M14 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Sign out
            </button>
        </form>
    </div>
</div>
