                    @if (!Collapsed) { <span>Currencies</span> }
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/budget-categories" title="Budget Categories">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4h3l2 2h7a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5"/></svg>
                    @if (!Collapsed) { <span>Budget Categories</span> }
                </NavLink>
            </div>
        </div>
