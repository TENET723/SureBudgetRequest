@inject ICurrentUser CurrentUser

<div class="brand-row">
    <a class="navbar-brand" href="">aSure Budget</a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </div>

        <div class="nav-section">Budget Requests</div>

        @* <div class="nav-item">
            <NavLink class="nav-link" href="requests/new">New request</NavLink>
        </div> *@

        <div class="nav-item">
            <NavLink class="nav-link" href="requests/mine">My requests</NavLink>
        </div>

        @if (CurrentUser.Role != UserRole.Employee)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="requests/inbox">Inbox</NavLink>
            </div>
        }

        @if (CurrentUser.Role is UserRole.Finance or UserRole.Admin)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="requests/outstanding">To pay</NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="coas">Chart of accounts</NavLink>
            </div>
        }

        @if (CurrentUser.Role == UserRole.Admin)
        {
            <div class="nav-section">Admin</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="admin/departments">Departments</NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="admin/department-heads">Dept. heads</NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="admin/users">Users</NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="admin/currencies">Currencies</NavLink>
            </div>
        }

    </nav>
</div>
