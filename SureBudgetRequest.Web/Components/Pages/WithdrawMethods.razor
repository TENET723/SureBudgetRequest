@page "/withdraw-methods"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Commands.CreateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.UpdateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.DeactivateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.ReactivateWithdrawMethod
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Withdraw Methods</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Withdraw Methods</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenCreate">+ New Method</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">@_errorMessage <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible">@_successMessage <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="showInactiveMethods" @bind="_showInactive" @bind:after="LoadData" />
        <label class="form-check-label small" for="showInactiveMethods">Show inactive</label>
    </div>

    <div class="mb-3">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:1%">#</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Requires attachment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var m = _filtered[i];
                        <tr class="@(!m.IsActive ? "text-muted" : "")">
                            <td class="text-muted small">@(i + 1)</td>
                            <td><strong>@m.Name</strong></td>
                            <td>
                                @if (m.IsActive) { <span class="badge bg-success">Active</span> }
                                else             { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td>
                                @if (m.RequiresAttachment)
                                {
                                    <span class="badge bg-info text-dark">Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(m)">Edit</button>
                                @if (m.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => ConfirmDeactivate(m)">Deactivate</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => DoReactivate(m)" disabled="@_saving">Reactivate</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No withdraw methods match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No withdraw methods found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Withdraw Method" : "New Withdraw Method")</h6>
                    <button class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger small py-2">@_formError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Name</label>
                        <input class="form-control form-control-sm" @bind="_formName"
                               placeholder="e.g. Cash, Bank Transfer" maxlength="200" />
                        <div class="form-text small">Shown to requesters in the draft form.</div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="methodFormRequiresAttachment"
                               @bind="_formRequiresAttachment" />
                        <label class="form-check-label small" for="methodFormRequiresAttachment">
                            Requires banking-info attachment
                        </label>
                        <div class="form-text small">
                            When enabled, the requester must upload at least one banking file
                            (e.g. bank book photo) before submitting.
                        </div>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="methodFormActive" @bind="_formIsActive" />
                            <label class="form-check-label small" for="methodFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingMethod is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate Withdraw Method</h6>
                    <button class="btn-close" @onclick="() => _deactivatingMethod = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 small">
                        Deactivate <strong>@_deactivatingMethod.Name</strong>?
                        It won't appear in the draft picker. Existing requests keep their link.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _deactivatingMethod = null">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<WithdrawMethodDto> _methods = new();
    private List<WithdrawMethodDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private string? _errorMessage;
    private string? _successMessage;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private bool _formIsActive = true;
    private bool _formRequiresAttachment;

    // Deactivate confirm
    private WithdrawMethodDto? _deactivatingMethod;

    protected override async Task OnInitializedAsync()
    {
        // Finance owns withdraw methods (parallel to COA); Admin retains access as a safety net.
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var result = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _methods = result.Value.OrderBy(m => m.Name).ToList();
        else
            _errorMessage = result.Error.Message;
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _methods.ToList()
            : _methods
                .Where(m => m.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formIsActive = true;
        _formRequiresAttachment = false;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(WithdrawMethodDto m)
    {
        _editingId = m.Id;
        _formName = m.Name;
        _formIsActive = m.IsActive;
        _formRequiresAttachment = m.RequiresAttachment;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateWithdrawMethodCommand(
                    _editingId.Value, _formName, _formIsActive, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method updated.";
            }
            else
            {
                var result = await Mediator.Send(new CreateWithdrawMethodCommand(
                    _formName, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method created.";
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(WithdrawMethodDto m) => _deactivatingMethod = m;

    private async Task DoDeactivate()
    {
        if (_deactivatingMethod is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateWithdrawMethodCommand(_deactivatingMethod.Id));
        _saving = false;
        var name = _deactivatingMethod.Name;
        _deactivatingMethod = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{name}' deactivated."; await LoadData(); }
    }

    private async Task DoReactivate(WithdrawMethodDto m)
    {
        _saving = true;
        var result = await Mediator.Send(new ReactivateWithdrawMethodCommand(m.Id));
        _saving = false;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{m.Name}' reactivated."; await LoadData(); }
    }
}
