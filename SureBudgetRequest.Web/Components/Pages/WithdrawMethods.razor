@page "/withdraw-methods"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Commands.CreateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.UpdateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.DeactivateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.ReactivateWithdrawMethod
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Withdraw Methods</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Withdraw Methods</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Method</button>
    </div>

    

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name" Width="260px" />
    </div>

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_filtered.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="WithdrawMethodDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="5">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Name</th>
            <th>Status</th>
            <th>Requires attachment</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var m = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(!m.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == m.Id ? "menu-open" : "")"
                @onclick="() => OpenEdit(m)"
                @oncontextmenu="e => OpenContextMenu(e, m)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong>@m.Name</strong></td>
                <td @onclick:stopPropagation="true">
                    @if (m.IsActive)
                    {
                        <button class="badge badge-active" @onclick="() => ConfirmDeactivate(m)" title="Click to deactivate">Active</button>
                    }
                    else
                    {
                        <button class="badge badge-inactive" @onclick="() => DoReactivate(m)" title="Click to activate" disabled="@_saving">Inactive</button>
                    }
                </td>
                <td @onclick:stopPropagation="true">
                    <button class="badge @(m.RequiresAttachment ? "badge-role" : "badge-inactive")"
                            @onclick="() => ToggleRequiresAttachment(m)"
                            title="Click to toggle banking attachment requirement"
                            disabled="@_saving">
                        @(m.RequiresAttachment ? "Yes (Required)" : "No (Optional)")
                    </button>
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, m)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <span>No withdraw methods match your search.</span>
            }
            else
            {
                <span>No withdraw methods found.</span>
            }
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_filtered.Count method(s)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Withdraw Method" : "New Withdraw Method")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName"
                               placeholder="e.g. Cash, Bank Transfer" maxlength="200" />
                        <div class="form-hint">Shown to requesters in the draft form.</div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="methodFormRequiresAttachment"
                               @bind="_formRequiresAttachment" />
                        <label class="form-label" for="methodFormRequiresAttachment">
                            Requires banking-info attachment
                        </label>
                        <div class="form-hint">
                            When enabled, the requester must upload at least one banking file
                            (e.g. bank book photo) before submitting.
                        </div>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="methodFormActive" @bind="_formIsActive" />
                            <label class="form-label" for="methodFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingMethod is not null)
{
    <ConfirmDialog Title="Deactivate Withdraw Method"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingMethod = null">
        Deactivate withdraw method <strong>@_deactivatingMethod.Name</strong>? It will no longer appear in the draft picker.
    </ConfirmDialog>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.Name</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Method</span>
        </button>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = ToggleRequiresAttachment(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l8.49-8.49a4 4 0 0 1 5.66 5.66l-8.49 8.49a2 2 0 0 1-2.83-2.83l7.78-7.78"/></svg>
            <span>@(_contextMenuTarget.RequiresAttachment ? "Make Attachment Optional" : "Require Banking Attachment")</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = DoReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<WithdrawMethodDto> _methods = new();
    private List<WithdrawMethodDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private bool _formIsActive = true;
    private bool _formRequiresAttachment;

    // Deactivate confirm
    private WithdrawMethodDto? _deactivatingMethod;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private WithdrawMethodDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, WithdrawMethodDto method)
    {
        _contextMenuTarget = method;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, WithdrawMethodDto method)
    {
        _contextMenuTarget = method;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("withdraw_methods") ?? "";
        if (FilterState.GetFlag("withdraw_methods_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("withdraw_methods_inactive", _showInactive);
        _loading = true;
        var result = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _methods = result.Value.OrderBy(m => m.Name).ToList();
        else
            Toast.Error("Load Failed", result.Error.Message);
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        _page = 1;
        FilterState.SetSearch("withdraw_methods", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _methods.ToList()
            : _methods
                .Where(m => m.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formIsActive = true;
        _formRequiresAttachment = false;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(WithdrawMethodDto m)
    {
        _editingId = m.Id;
        _formName = m.Name;
        _formIsActive = m.IsActive;
        _formRequiresAttachment = m.RequiresAttachment;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateWithdrawMethodCommand(
                    _editingId.Value, _formName, _formIsActive, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method updated.";
            }
            else
            {
                var result = await Mediator.Send(new CreateWithdrawMethodCommand(
                    _formName, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method created.";
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(WithdrawMethodDto m) => _deactivatingMethod = m;

    private async Task ToggleRequiresAttachment(WithdrawMethodDto m)
    {
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new UpdateWithdrawMethodCommand(
            m.Id, m.Name, m.IsActive, !m.RequiresAttachment));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else
        {
            var status = !m.RequiresAttachment ? "required" : "optional";
            Toast.Success("Requirement Updated", $"Banking attachment is now {status} for '{m.Name}'.");
            await LoadData();
        }
    }


    private async Task DoDeactivate()
    {
        if (_deactivatingMethod is null) return;
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateWithdrawMethodCommand(_deactivatingMethod.Id));
        _saving = false;
        var name = _deactivatingMethod.Name;
        _deactivatingMethod = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{name}' deactivated."; await LoadData(); }
        StateHasChanged();
    }

    private async Task DoReactivate(WithdrawMethodDto m)
    {
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new ReactivateWithdrawMethodCommand(m.Id));
        _saving = false;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{m.Name}' reactivated."; await LoadData(); }
        StateHasChanged();
    }
}
