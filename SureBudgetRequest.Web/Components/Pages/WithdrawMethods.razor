@page "/withdraw-methods"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Commands.CreateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.UpdateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.DeactivateWithdrawMethod
@using SureBudgetRequest.Application.WithdrawMethods.Commands.ReactivateWithdrawMethod
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Withdraw Methods</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Withdraw Methods</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Method</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="showInactiveMethods" @bind="_showInactive" @bind:after="LoadData" />
        <label class="form-label" for="showInactiveMethods">Show inactive</label>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Requires attachment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var m = _filtered[i];
                        <tr class="@(!m.IsActive ? "text-muted" : "")">
                            <td class="text-muted text-sm">@(i + 1)</td>
                            <td><strong>@m.Name</strong></td>
                            <td>
                                <label class="toggle" title="@(m.IsActive ? "Active" : "Inactive")" style="cursor:default">
                                    <input type="checkbox" checked="@m.IsActive" disabled style="opacity:0;width:0;height:0;position:absolute" />
                                    <span class="toggle-track"></span>
                                    <span class="toggle-thumb"></span>
                                </label>
                            </td>
                            <td>
                                @if (m.RequiresAttachment)
                                {
                                    <span class="badge badge-role">Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted text-sm">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-icon " @onclick="() => OpenEdit(m)" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="m14.06 9.02l.92.92L5.92 19H5v-.92zM17.66 3c-.25 0-.51.1-.7.29l-1.83 1.83l3.75 3.75l1.83-1.83a.996.996 0 0 0 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29m-3.6 3.19L3 17.25V21h3.75L17.81 9.94z"/></svg></button>
                                @if (m.IsActive)
                                {
                                    <button class="btn btn-icon text-danger" @onclick="() => ConfirmDeactivate(m)" title="Deactivate"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m5 11H7v-2h10z"/></svg></button>
                                }
                                else
                                {
                                    <button class="btn btn-icon text-success" @onclick="() => DoReactivate(m)" title="Reactivate" disabled="@_saving"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m5 11h-4v4h-2v-4H7v-2h4V7h2v4h4z"/></svg></button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="5" class="text-center text-muted ">No withdraw methods match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted ">No withdraw methods found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Withdraw Method" : "New Withdraw Method")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName"
                               placeholder="e.g. Cash, Bank Transfer" maxlength="200" />
                        <div class="form-hint">Shown to requesters in the draft form.</div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="methodFormRequiresAttachment"
                               @bind="_formRequiresAttachment" />
                        <label class="form-label" for="methodFormRequiresAttachment">
                            Requires banking-info attachment
                        </label>
                        <div class="form-hint">
                            When enabled, the requester must upload at least one banking file
                            (e.g. bank book photo) before submitting.
                        </div>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="methodFormActive" @bind="_formIsActive" />
                            <label class="form-label" for="methodFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingMethod is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate Withdraw Method</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _deactivatingMethod = null"></button>
                </div>
                <div class="modal-body">
                    <p class=" text-sm">
                        Deactivate <strong>@_deactivatingMethod.Name</strong>?
                        It won't appear in the draft picker. Existing requests keep their link.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _deactivatingMethod = null">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<WithdrawMethodDto> _methods = new();
    private List<WithdrawMethodDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private string? _errorMessage;
    private string? _successMessage;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private bool _formIsActive = true;
    private bool _formRequiresAttachment;

    // Deactivate confirm
    private WithdrawMethodDto? _deactivatingMethod;

    protected override async Task OnInitializedAsync()
    {
        // Finance owns withdraw methods (parallel to COA); Admin retains access as a safety net.
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var result = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _methods = result.Value.OrderBy(m => m.Name).ToList();
        else
            _errorMessage = result.Error.Message;
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _methods.ToList()
            : _methods
                .Where(m => m.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formIsActive = true;
        _formRequiresAttachment = false;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(WithdrawMethodDto m)
    {
        _editingId = m.Id;
        _formName = m.Name;
        _formIsActive = m.IsActive;
        _formRequiresAttachment = m.RequiresAttachment;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateWithdrawMethodCommand(
                    _editingId.Value, _formName, _formIsActive, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method updated.";
            }
            else
            {
                var result = await Mediator.Send(new CreateWithdrawMethodCommand(
                    _formName, _formRequiresAttachment));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Withdraw method created.";
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(WithdrawMethodDto m) => _deactivatingMethod = m;

    private async Task DoDeactivate()
    {
        if (_deactivatingMethod is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateWithdrawMethodCommand(_deactivatingMethod.Id));
        _saving = false;
        var name = _deactivatingMethod.Name;
        _deactivatingMethod = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{name}' deactivated."; await LoadData(); }
    }

    private async Task DoReactivate(WithdrawMethodDto m)
    {
        _saving = true;
        var result = await Mediator.Send(new ReactivateWithdrawMethodCommand(m.Id));
        _saving = false;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{m.Name}' reactivated."; await LoadData(); }
    }
}
