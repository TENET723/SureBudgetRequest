@page "/finance/budget-plan"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Departments.Commands.UpsertDepartmentMonthlyBudget
@using SureBudgetRequest.Domain.Enums

<PageTitle>Budget Plan</PageTitle>

@if (CurrentUser.Role != UserRole.Finance)
{
    <div class="alert alert-error">Access denied.</div>
    return;
}

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Department Budget Plan</h5>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">
            @_errorMessage
            <button type="button" class="btn btn-icon modal-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">
            @_successMessage
            <button type="button" class="btn btn-icon modal-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @* ── Controls ──────────────────────────────────────────────────────── *@
    <div class="row g-2 mb-4 align-items-center">
        <div class="col-auto flex items-center gap-1">
            <button class="btn btn-outline btn-sm" @onclick="PrevYear">&#8249;</button>
            <span class="font-semibold px-2">FY @_selectedYear / @(_selectedYear + 1)</span>
            <button class="btn btn-outline btn-sm" @onclick="NextYear">&#8250;</button>
        </div>
        <div style="min-width: 220px;">
            <Dropdown Items="_departments"
                      @bind-Value="_selectedDeptId"
                      @bind-Value:after="LoadPlan"
                      ValueSelector="d => d.Id"
                      TextSelector="d => d.Name"
                      Searchable="true"
                      SearchPlaceholder="Search department..."
                      AllowClear="false" />
        </div>
    </div>

    @if (_plan is not null || _loading)
    {
        <AppTable TItem="MonthPlanDto"
                  Items="@_plan?.Months"
                  IsLoading="@_loading"
                  ColSpan="7">
            <TableHeader>
                <th class="sticky-no-col font-bold">NO.</th>
                <th>Month</th>
                <th style="min-width: 200px">Budget (MMK)</th>
                <th class="text-end">Spent (MMK)</th>
                <th class="text-end">Remaining</th>
                <th class="text-end">Used %</th>
                <th>Status</th>
            </TableHeader>
            <RowTemplateWithIndex Context="ctx">
                @{
                    var m = ctx.Item;
                    var i = ctx.Index;
                    var monthName = new DateTime(2000, m.Month, 1).ToString("MMM");
                    var spent = m.ActualSpentInMmk;
                    var limit = m.EffectiveLimit;
                    var remaining = limit - spent;
                    var usedPct = limit > 0 ? Math.Min(100m, Math.Round(spent / limit * 100, 1)) : 0m;
                }
                <tr class="@(m.IsCurrent ? "table-primary" : "")">
                    <td class="sticky-no-col text-muted text-sm text-center">@(i + 1)</td>
                    <td>
                        <strong>@monthName</strong>
                        @if (m.IsCurrent)
                        {
                            <span class="ml-1 badge bg-primary rounded-pill" style="font-size:.65rem">● Current</span>
                        }
                    </td>
                    <td style="min-width:180px">
                        @if (m.IsEditable)
                        {
                            <NumericInput TValue="decimal?" Value="@GetAmount(m.Month)" ValueChanged="@(val => SetAmount(m.Month, val))" Min="0" Step="1000" Placeholder="e.g. 5000000" />
                            <div class="text-muted text-sm mt-1">fallback: @(_plan?.FallbackMonthlyLimit.ToString("N0") ?? "0") MMK</div>
                        }
                        else
                        {
                            <span class="text-muted">@(m.PresetAmount.HasValue ? m.PresetAmount.Value.ToString("N0") : "—")</span>
                            <div class="text-muted text-sm mt-1">fallback: @(_plan?.FallbackMonthlyLimit.ToString("N0") ?? "0") MMK</div>
                        }
                    </td>
                    <td class="text-end font-mono">@spent.ToString("N0")</td>
                    <td class="text-end font-mono @(remaining < 0 ? "text-danger" : "")">@remaining.ToString("N0")</td>
                    <td class="text-end font-mono">@usedPct%</td>
                    <td>
                        @if (m.IsCurrent)
                        {
                            <span class="badge badge-role">Current</span>
                        }
                        else if (!m.IsEditable)
                        {
                            <span class="badge badge-role">Past</span>
                        }
                        else
                        {
                            <span class="badge badge-role">Future</span>
                        }
                    </td>
                </tr>
            </RowTemplateWithIndex>
            <PaginationContent>
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div class="text-sm text-muted">
                        Total Spent: <strong class="text-dark">@(_plan?.Months.Sum(x => x.ActualSpentInMmk).ToString("N0") ?? "—") MMK</strong>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-muted">12 months (@_selectedYear)</span>
                    </div>
                </div>
            </PaginationContent>
        </AppTable>

        @if (_plan is not null)
        {
            <div class="mt-2">
                <button class="btn btn-primary btn-sm" @onclick="SavePlan" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner spinner-sm mr-1"></span>
                    }
                    Save
                </button>
            </div>
        }
    }
</div>

@code {
    private DepartmentBudgetPlanDto? _plan;
    private Dictionary<int, string> _formAmounts = new();
    private List<DepartmentDto> _departments = new();
    private Guid _selectedDeptId;
    private int _selectedYear;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Finance)
        {
            Nav.NavigateTo("/");
            return;
        }

        // Load departments
        var deptsResult = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: false));
        if (deptsResult.IsSuccess && deptsResult.Value.Count > 0)
        {
            _departments = deptsResult.Value.ToList();
        }

        if (FilterState.BudgetPlan is not null)
        {
            _selectedYear = FilterState.BudgetPlan.SelectedYear;
            _selectedDeptId = FilterState.BudgetPlan.SelectedDeptId;
        }
        else
        {
            // Determine default year
            var now = DateTime.UtcNow;
            // FY start month default 4 — use April as approximation here (AppSetting loaded later)
            _selectedYear = now.Month >= 4 ? now.Year : now.Year - 1;

            if (_departments.Count > 0)
                _selectedDeptId = _departments[0].Id;
        }

        await LoadPlan();
    }

    private async Task LoadPlan()
    {
        _loading = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        if (_selectedDeptId == Guid.Empty)
        {
            _loading = false;
            return;
        }

        var result = await Mediator.Send(new GetDepartmentBudgetPlanQuery(_selectedDeptId, _selectedYear));
        if (result.IsSuccess)
        {
            _plan = result.Value;
            FilterState.BudgetPlan = new BudgetPlanFilterState
            {
                SelectedYear = _selectedYear,
                SelectedDeptId = _selectedDeptId
            };
            _formAmounts = new Dictionary<int, string>();
            foreach (var m in _plan.Months)
            {
                if (m.PresetAmount.HasValue)
                    _formAmounts[m.Month] = m.PresetAmount.Value.ToString("F0");
            }
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _loading = false;
    }

    private async Task SavePlan()
    {
        if (_saving) return;
        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        var entries = new List<MonthAmountEntry>();
        if (_plan is not null)
        {
            foreach (var m in _plan.Months.Where(m => m.IsEditable))
            {
                decimal? amount = null;
                if (_formAmounts.TryGetValue(m.Month, out var raw)
                    && !string.IsNullOrWhiteSpace(raw)
                    && decimal.TryParse(raw, out var parsed))
                {
                    amount = parsed;
                }
                entries.Add(new MonthAmountEntry(m.Month, amount));
            }
        }

        var command = new UpsertDepartmentMonthlyBudgetCommand(
            _selectedDeptId,
            _selectedYear,
            entries,
            CurrentUser.UserId);

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            _successMessage = "Budget plan saved.";
            await LoadPlan();
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _saving = false;
    }

    private decimal? GetAmount(int month) =>
        _formAmounts.TryGetValue(month, out var raw) && decimal.TryParse(raw, out var d) ? d : null;

    private void SetAmount(int month, decimal? val)
    {
        if (val.HasValue) _formAmounts[month] = val.Value.ToString("F0");
        else _formAmounts.Remove(month);
    }

    private void OnAmountInput(int month, string? value)
    {
        if (value is null)
            _formAmounts.Remove(month);
        else
            _formAmounts[month] = value;
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedDeptId = id;
            await LoadPlan();
        }
    }

    private async Task PrevYear()
    {
        _selectedYear--;
        await LoadPlan();
    }

    private async Task NextYear()
    {
        _selectedYear++;
        await LoadPlan();
    }
}
