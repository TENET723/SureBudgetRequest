@page "/admin/users"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.Users.Commands.CreateUser
@using SureBudgetRequest.Application.Users.Commands.UpdateUser
@using SureBudgetRequest.Application.Users.Commands.DeactivateUser
@using SureBudgetRequest.Application.Users.Commands.ResetUserPassword
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Users</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Users</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenCreate">+ New User</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">@_errorMessage <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible">@_successMessage <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="row g-2 mb-3">
        <div class="col-auto">
            <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                           Placeholder="Search name, email, or username" Width="260px" />
        </div>
        <div class="col-auto">
            <select class="form-select form-select-sm" @bind="_filterDept" @bind:after="ApplyFilter">
                <option value="">All Departments</option>
                @foreach (var d in _departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select form-select-sm" @bind="_filterRole" @bind:after="ApplyFilter">
                <option value="">All Roles</option>
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@((int)r)">@r</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" id="showInactiveUsers" @bind="_showInactive" @bind:after="LoadUsers" />
                <label class="form-check-label small" for="showInactiveUsers">Show inactive</label>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:1%">#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Username</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login At</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var u = _filtered[i];
                        <tr class="@(!u.IsActive ? "text-muted" : "")">
                            <td class="text-muted small">@(i + 1)</td>
                            <td>@u.FullName</td>
                            <td class="small">@u.Email</td>
                            <td class="text-muted small">@u.Username</td>
                            <td>@(_deptNames.TryGetValue(u.DepartmentId, out var dn) ? dn : "—")</td>
                            <td>
                                <span class="badge @RoleBadge(u.Role)">@u.Role</span>
                                @if (u.Role == UserRole.Finance)
                                {
                                    @if (u.IsFinanceApprover)
                                    {
                                        <span class="badge bg-success ms-1" title="Can approve, reject, send back, and record payments.">Approver</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-1" title="Can only record payments.">Payer only</span>
                                    }
                                }
                            </td>
                            <td class="small">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToLocalTime().ToString("g") : "—")</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(u)">Edit</button>
                                @if (u.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning ms-1" @onclick="() => OpenReset(u)">Reset password</button>
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => ConfirmDeactivate(u)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">No users match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">No users found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit User" : "New User")</h6>
                    <button class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger small py-2">@_formError</div>
                    }
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Full Name</label>
                            <input class="form-control form-control-sm" @bind="_formFullName" />
                        </div>
                        @if (!_editingId.HasValue)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Username</label>
                                <input class="form-control form-control-sm" @bind="_formUsername" />
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Email</label>
                            <input class="form-control form-control-sm" type="email" @bind="_formEmail" placeholder="user@example.com" />
                        </div>
                        @if (!_editingId.HasValue)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Initial Password</label>
                                <input class="form-control form-control-sm" type="text" @bind="_formInitialPassword" />
                                <div class="form-text small">
                                    Min @CreateUserCommandHandler.MinimumPasswordLength characters.
                                    User will be required to change this on first login.
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Department</label>
                            <select class="form-select form-select-sm" @bind="_formDeptId">
                                <option value="">— select —</option>
                                @foreach (var d in _departments.Where(d => d.IsActive))
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Role</label>
                            <select class="form-select form-select-sm" @bind="_formRole" @bind:after="OnRoleChanged">
                                @foreach (var r in Enum.GetValues<UserRole>())
                                {
                                    <option value="@((int)r)">@r</option>
                                }
                            </select>
                        </div>
                        @if (_formRole == (int)UserRole.Finance)
                        {
                            <div class="col-12">
                                <div class="border rounded p-2 bg-light-subtle">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="isFinanceApproverCheck"
                                               @bind="_formIsFinanceApprover" />
                                        <label class="form-check-label small fw-semibold" for="isFinanceApproverCheck">
                                            Finance Approver
                                        </label>
                                    </div>
                                    <div class="form-text small mt-1">
                                        @if (_formIsFinanceApprover)
                                        {
                                            <span><strong>Approver:</strong> can approve, reject, send back, and record payments.</span>
                                        }
                                        else
                                        {
                                            <span><strong>Payer only:</strong> can only record payments. Cannot approve, reject, or send back.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Slack User ID <span class="text-muted fw-normal">(optional)</span></label>
                            <input class="form-control form-control-sm" @bind="_formSlackId" placeholder="U0123ABCDEF" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Reset Password Modal ──────────────────────────────────────────────────── *@
@if (_resettingUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Reset Password</h6>
                    <button class="btn-close" @onclick="CloseReset"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_resetError))
                    {
                        <div class="alert alert-danger small py-2">@_resetError</div>
                    }
                    <p class="small mb-2">
                        Set a new initial password for <strong>@_resettingUser.FullName</strong>.
                        They will be required to change it on next login.
                    </p>
                    <label class="form-label small fw-semibold">New Password</label>
                    <input class="form-control form-control-sm" type="text" @bind="_resetPassword" />
                    <div class="form-text small">
                        Min @ResetUserPasswordCommandHandler.MinimumPasswordLength characters.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseReset">Cancel</button>
                    <button class="btn btn-sm btn-warning" @onclick="DoReset" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate User</h6>
                    <button class="btn-close" @onclick="() => _deactivatingUser = null"></button>
                </div>
                <div class="modal-body small">
                    Deactivate <strong>@_deactivatingUser.FullName</strong>? They won't be able to submit new requests.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _deactivatingUser = null">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> _allUsers = new();
    private List<UserDto> _filtered = new();
    private List<DepartmentDto> _departments = new();
    private Dictionary<Guid, string> _deptNames = new();
    private bool _loading = true;
    private string? _errorMessage;
    private string? _successMessage;

    // Filters
    private string _search = "";
    private string _filterDept = "";
    private string _filterRole = "";
    private bool _showInactive;

    // Form
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formFullName = "";
    private string _formUsername = "";
    private string _formEmail = "";
    private string _formInitialPassword = "";
    private string _formDeptId = "";
    private int _formRole = (int)UserRole.Employee;
    private string? _formSlackId;
    private bool _formIsFinanceApprover;

    // Deactivate
    private UserDto? _deactivatingUser;

    // Reset password
    private UserDto? _resettingUser;
    private string _resetPassword = "";
    private string? _resetError;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
        if (depts.IsSuccess)
        {
            _departments = depts.Value?.ToList() ?? new();
            _deptNames = depts.Value?.ToDictionary(d => d.Id, d => d.Name) ?? new();
        }
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        var result = await Mediator.Send(new ListUsersQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess) _allUsers = result.Value?.ToList() ?? new();
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = _allUsers
            .Where(u => string.IsNullOrEmpty(_filterDept) || u.DepartmentId.ToString() == _filterDept)
            .Where(u => string.IsNullOrEmpty(_filterRole) || (int)u.Role == int.Parse(_filterRole))
            .Where(u => term.Length == 0
                || (u.FullName?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (u.Email?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (u.Username?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (DeptName(u.DepartmentId).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0))
            .OrderBy(u => u.FullName)
            .ToList();
    }

    private string DeptName(Guid id) =>
        _deptNames.TryGetValue(id, out var dn) ? dn : "";

    private void OpenCreate()
    {
        _editingId = null;
        _formFullName = "";
        _formUsername = "";
        _formEmail = "";
        _formInitialPassword = "";
        _formDeptId = "";
        _formRole = (int)UserRole.Employee;
        _formSlackId = null;
        _formIsFinanceApprover = false; // defaults to "payer only" — admin opts in
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(UserDto u)
    {
        _editingId = u.Id;
        _formFullName = u.FullName;
        _formUsername = u.Username;
        _formEmail = u.Email ?? "";
        _formInitialPassword = "";
        _formDeptId = u.DepartmentId.ToString();
        _formRole = (int)u.Role;
        _formSlackId = u.SlackUserId;
        _formIsFinanceApprover = u.IsFinanceApprover;
        _formError = null;
        _showForm = true;
    }

    private void OnRoleChanged()
    {
        // Clear the approver flag whenever the role moves away from Finance — keeps
        // the UI in sync with the domain rule (the approver bit is meaningless
        // off-role and gets stripped server-side anyway).
        if (_formRole != (int)UserRole.Finance)
            _formIsFinanceApprover = false;
    }

    private void CloseForm() { _showForm = false; _formError = null; }

    private async Task SaveForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formFullName)) { _formError = "Full name is required."; return; }
        if (!_editingId.HasValue && string.IsNullOrWhiteSpace(_formUsername)) { _formError = "Username is required."; return; }
        if (string.IsNullOrWhiteSpace(_formEmail)) { _formError = "Email is required."; return; }
        if (!_editingId.HasValue
            && (string.IsNullOrEmpty(_formInitialPassword)
                || _formInitialPassword.Length < CreateUserCommandHandler.MinimumPasswordLength))
        {
            _formError = $"Initial password must be at least {CreateUserCommandHandler.MinimumPasswordLength} characters.";
            return;
        }
        if (!Guid.TryParse(_formDeptId, out var deptId)) { _formError = "Select a department."; return; }

        // Belt-and-braces: never send IsFinanceApprover=true unless role is Finance.
        var isFinanceApprover = _formRole == (int)UserRole.Finance && _formIsFinanceApprover;

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var cmd = new UpdateUserCommand(
                    _editingId.Value,
                    _formFullName,
                    _formEmail,
                    deptId,
                    (UserRole)_formRole,
                    _formSlackId,
                    isFinanceApprover);
                var result = await Mediator.Send(cmd);
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }
            else
            {
                var cmd = new CreateUserCommand(
                    _formUsername,
                    _formFullName,
                    _formEmail,
                    _formInitialPassword,
                    deptId,
                    (UserRole)_formRole,
                    _formSlackId,
                    isFinanceApprover);
                var result = await Mediator.Send(cmd);
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }

            _successMessage = _editingId.HasValue ? "User updated." : "User created.";
            _showForm = false;
            await LoadUsers();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(UserDto u) => _deactivatingUser = u;

    private async Task DoDeactivate()
    {
        if (_deactivatingUser is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateUserCommand(_deactivatingUser.Id));
        _saving = false;
        _deactivatingUser = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = "User deactivated."; await LoadUsers(); }
    }

    private void OpenReset(UserDto u)
    {
        _resettingUser = u;
        _resetPassword = "";
        _resetError = null;
    }

    private void CloseReset()
    {
        _resettingUser = null;
        _resetError = null;
    }

    private async Task DoReset()
    {
        if (_resettingUser is null) return;
        _resetError = null;

        if (string.IsNullOrEmpty(_resetPassword)
            || _resetPassword.Length < ResetUserPasswordCommandHandler.MinimumPasswordLength)
        {
            _resetError = $"Password must be at least {ResetUserPasswordCommandHandler.MinimumPasswordLength} characters.";
            return;
        }

        _saving = true;
        try
        {
            var result = await Mediator.Send(new ResetUserPasswordCommand(_resettingUser.Id, _resetPassword));
            if (result.IsFailure) { _resetError = result.Error.Message; return; }

            _successMessage = $"Password reset for {_resettingUser.FullName}. They must change it on next login.";
            _resettingUser = null;
        }
        finally { _saving = false; }
    }

    private static string RoleBadge(UserRole r) => r switch
    {
        UserRole.Management => "bg-danger",
        UserRole.Admin => "bg-dark",
        UserRole.Finance => "bg-info text-dark",
        UserRole.Accounting => "bg-info-subtle text-info-emphasis border border-info-subtle",
        UserRole.DepartmentHead => "bg-warning text-dark",
        _ => "bg-light text-dark border"
    };
}
