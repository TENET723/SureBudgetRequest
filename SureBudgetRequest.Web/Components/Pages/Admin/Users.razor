@page "/admin/users"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.Users.Commands.CreateUser
@using SureBudgetRequest.Application.Users.Commands.UpdateUser
@using SureBudgetRequest.Application.Users.Commands.DeactivateUser
@using SureBudgetRequest.Application.Users.Commands.ReactivateUser
@using SureBudgetRequest.Application.Users.Commands.ResetUserPassword
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Users</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Users</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New User</button>
    </div>

    

    <div class="form-grid-2 mb-4">
        <div>
            <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                           Placeholder="Search name, email, or username" Width="260px" />
        </div>
        <div>
            <Dropdown Items="_departments"
                      @bind-Value="_filterDept"
                      @bind-Value:after="ApplyFilter"
                      ValueSelector="d => d.Id.ToString()"
                      TextSelector="d => d.Name"
                      Placeholder="All Departments"
                      Searchable="true"
                      SearchPlaceholder="Search department..."
                      AllowClear="true" />
        </div>
        <div>
            <select class="select" @bind="_filterRole" @bind:after="ApplyFilter">
                <option value="">All Roles</option>
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@((int)r)">@r</option>
                }
            </select>
        </div>
        <div class="flex items-center gap-2 mt-1">
            <label class="toggle" title="Show inactive">
                <input type="checkbox" @bind="_showInactive" @bind:after="LoadUsers" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
            </label>
            <span class="text-sm text-muted">Show inactive</span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Username</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login At</th>
                        <th class="sticky-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var u = _filtered[i];
                        <tr class="clickable-row @(!u.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == u.Id ? "menu-open" : "")"
                            @onclick="() => OpenEdit(u)"
                            @oncontextmenu="e => OpenContextMenu(e, u)"
                            @oncontextmenu:preventDefault="true">
                            <td class="text-muted text-sm col-no">@(i + 1)</td>
                            <td><strong>@u.FullName</strong></td>
                            <td class="text-sm">@u.Email</td>
                            <td class="text-muted text-sm font-mono">@u.Username</td>
                            <td>@(_deptNames.TryGetValue(u.DepartmentId, out var dn) ? dn : "—")</td>
                            <td>
                                <span class="badge badge-role">@u.Role</span>
                                @if (u.Role == UserRole.Finance)
                                {
                                    @if (u.IsFinanceApprover)
                                    {
                                        <span class="badge badge-role" title="Can approve, reject, send back, and record payments.">Approver</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-role" title="Can only record payments.">Payer only</span>
                                    }
                                }
                            </td>
                            <td @onclick:stopPropagation="true">
                                @if (u.IsActive)
                                {
                                    <button class="badge badge-active" @onclick="() => ConfirmDeactivate(u)" title="Click to deactivate">Active</button>
                                }
                                else
                                {
                                    <button class="badge badge-inactive" @onclick="() => ConfirmReactivate(u)" title="Click to reactivate">Inactive</button>
                                }
                            </td>
                            <td class="text-sm text-muted">@u.LastLoginAt.ToMyanmarTime()</td>
                            <td class="sticky-action-col" @onclick:stopPropagation="true">
                                <div class="row-hover-btn-wrapper">
                                    <div class="row-hover-backdrop"></div>
                                    <button type="button" class="btn-three-dots" title="Quick actions"
                                            @onclick="e => OpenContextMenuFromButton(e, u)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5" r="2"/>
                                            <circle cx="12" cy="12" r="2"/>
                                            <circle cx="12" cy="19" r="2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="9" class="text-center text-muted ">No users match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted ">No users found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit User" : "New User")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="form-grid-2">
                        <div>
                            <label class="form-label text-sm font-semibold">Full Name</label>
                            <input class="input" @bind="_formFullName" />
                        </div>
                        @if (!_editingId.HasValue)
                        {
                            <div>
                                <label class="form-label text-sm font-semibold">Username</label>
                                <input class="input" @bind="_formUsername" />
                            </div>
                        }
                        <div>
                            <label class="form-label text-sm font-semibold">Email</label>
                            <input class="input" type="email" @bind="_formEmail" placeholder="user@example.com" />
                        </div>
                        @if (!_editingId.HasValue)
                        {
                            <div>
                                <label class="form-label text-sm font-semibold">Initial Password</label>
                                <input class="input" type="text" @bind="_formInitialPassword" />
                                <div class="form-hint">
                                    Min @CreateUserCommandHandler.MinimumPasswordLength characters.
                                    User will be required to change this on first login.
                                </div>
                            </div>
                        }
                        <div>
                            <label class="form-label text-sm font-semibold">Department</label>
                            <Dropdown Items="_departments.Where(d => d.IsActive).ToList()"
                                      @bind-Value="_formDeptId"
                                      ValueSelector="d => d.Id.ToString()"
                                      TextSelector="d => d.Name"
                                      Placeholder="— select —"
                                      Searchable="true"
                                      SearchPlaceholder="Search department..."
                                      AllowClear="false" />
                        </div>
                        <div>
                            <label class="form-label text-sm font-semibold">Role</label>
                            <select class="select" @bind="_formRole" @bind:after="OnRoleChanged">
                                @foreach (var r in Enum.GetValues<UserRole>()
                                    .Where(r => CurrentUser.Role == UserRole.Admin || r != UserRole.Admin))
                                {
                                    <option value="@((int)r)">@r</option>
                                }
                            </select>
                        </div>
                        @if (_formRole == (int)UserRole.Finance)
                        {
                            <div>
                                <div class="border rounded p-2 bg-light-subtle">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="isFinanceApproverCheck"
                                               @bind="_formIsFinanceApprover" />
                                        <label class="form-check-label text-sm font-semibold" for="isFinanceApproverCheck">
                                            Finance Approver
                                        </label>
                                    </div>
                                    <div class="form-text text-sm mt-1">
                                        @if (_formIsFinanceApprover)
                                        {
                                            <span><strong>Approver:</strong> can approve, reject, send back, and record payments.</span>
                                        }
                                        else
                                        {
                                            <span><strong>Payer only:</strong> can only record payments. Cannot approve, reject, or send back.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div>
                            <label class="form-label text-sm font-semibold">Slack User ID <span class="text-muted fw-normal">(optional)</span></label>
                            <input class="input" @bind="_formSlackId" placeholder="U0123ABCDEF" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner spinner-sm mr-1"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Reset Password Modal ──────────────────────────────────────────────────── *@
@if (_resettingUser is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Reset Password</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseReset"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_resetError))
                    {
                        <div class="alert alert-error">@_resetError</div>
                    }
                    <p class="text-sm mb-2">
                        Set a new initial password for <strong>@_resettingUser.FullName</strong>.
                        They will be required to change it on next login.
                    </p>
                    <label class="form-label text-sm font-semibold">New Password</label>
                    <input class="input" type="text" @bind="_resetPassword" />
                    <div class="form-hint">
                        Min @ResetUserPasswordCommandHandler.MinimumPasswordLength characters.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseReset">Cancel</button>
                    <button class="btn btn-warning btn-sm" @onclick="DoReset" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner spinner-sm mr-1"></span>
                        }
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingUser is not null)
{
    <ConfirmDialog Title="Deactivate User"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingUser = null">
        Deactivate account for <strong>@_deactivatingUser.FullName</strong>? This user will no longer be able to log in or take actions.
    </ConfirmDialog>
}

@* ── Reactivate Confirm ──────────────────────────────────────────────────────── *@
@if (_reactivatingUser is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div>
                <div class="modal-header">
                    <h6 class="modal-title">Reactivate User</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _reactivatingUser = null"></button>
                </div>
                <div class="modal-body text-sm">
                    Reactivate <strong>@_reactivatingUser.FullName</strong>? They will be able to log in and submit requests again.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _reactivatingUser = null">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="DoReactivate" disabled="@_saving">Reactivate</button>
                </div>
            </div>
        </div>
    </div>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.FullName</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit User</span>
        </button>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenReset(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2m-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2m3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1c1.71 0 3.1 1.39 3.1 3.1z"/></svg>
                <span>Reset Password</span>
            </button>
        }

        <div class="context-menu-divider"></div>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<UserDto> _allUsers = new();
    private List<UserDto> _filtered = new();
    private List<DepartmentDto> _departments = new();
    private Dictionary<Guid, string> _deptNames = new();
    private bool _loading = true;

    // Filters
    private string _search = "";
    private string _filterDept = "";
    private string _filterRole = "";
    private bool _showInactive;

    // Form
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formFullName = "";
    private string _formUsername = "";
    private string _formEmail = "";
    private string _formInitialPassword = "";
    private string _formDeptId = "";
    private int _formRole = (int)UserRole.Employee;
    private string? _formSlackId;
    private bool _formIsFinanceApprover;

    // Deactivate
    private UserDto? _deactivatingUser;

    // Reactivate
    private UserDto? _reactivatingUser;

    // Reset password
    private UserDto? _resettingUser;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private UserDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, UserDto user)
    {
        _contextMenuTarget = user;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, UserDto user)
    {
        _contextMenuTarget = user;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }

    private string _resetPassword = "";
    private string? _resetError;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role is not (UserRole.Admin or UserRole.Finance or UserRole.Support))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
        if (depts.IsSuccess)
        {
            _departments = depts.Value?.ToList() ?? new();
            _deptNames = depts.Value?.ToDictionary(d => d.Id, d => d.Name) ?? new();
        }

        if (FilterState.Users is not null)
        {
            _search = FilterState.Users.Search;
            _filterDept = FilterState.Users.FilterDept;
            _filterRole = FilterState.Users.FilterRole;
            _showInactive = FilterState.Users.ShowInactive;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        var result = await Mediator.Send(new ListUsersQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess) _allUsers = result.Value?.ToList() ?? new();
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = _allUsers
            .Where(u => string.IsNullOrEmpty(_filterDept) || u.DepartmentId.ToString() == _filterDept)
            .Where(u => string.IsNullOrEmpty(_filterRole) || (int)u.Role == int.Parse(_filterRole))
            .Where(u => term.Length == 0
                || (u.FullName?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (u.Email?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (u.Username?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                || (DeptName(u.DepartmentId).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0))
            .OrderBy(u => u.FullName)
            .ToList();

        FilterState.Users = new UsersFilterState
        {
            Search = _search,
            FilterDept = _filterDept,
            FilterRole = _filterRole,
            ShowInactive = _showInactive
        };
    }

    private string DeptName(Guid id) =>
        _deptNames.TryGetValue(id, out var dn) ? dn : "";

    private void OpenCreate()
    {
        _editingId = null;
        _formFullName = "";
        _formUsername = "";
        _formEmail = "";
        _formInitialPassword = "";
        _formDeptId = "";
        _formRole = (int)UserRole.Employee;
        _formSlackId = null;
        _formIsFinanceApprover = false;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(UserDto u)
    {
        _editingId = u.Id;
        _formFullName = u.FullName;
        _formUsername = u.Username;
        _formEmail = u.Email ?? "";
        _formInitialPassword = "";
        _formDeptId = u.DepartmentId.ToString();
        _formRole = (int)u.Role;
        _formSlackId = u.SlackUserId;
        _formIsFinanceApprover = u.IsFinanceApprover;
        _formError = null;
        _showForm = true;
    }

    private void OnRoleChanged()
    {
        if (_formRole != (int)UserRole.Finance)
            _formIsFinanceApprover = false;
    }

    private void CloseForm() { _showForm = false; _formError = null; }

    private async Task SaveForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formFullName)) { _formError = "Full name is required."; return; }
        if (!_editingId.HasValue && string.IsNullOrWhiteSpace(_formUsername)) { _formError = "Username is required."; return; }
        if (string.IsNullOrWhiteSpace(_formEmail)) { _formError = "Email is required."; return; }
        if (!_editingId.HasValue
            && (string.IsNullOrEmpty(_formInitialPassword)
                || _formInitialPassword.Length < CreateUserCommandHandler.MinimumPasswordLength))
        {
            _formError = $"Initial password must be at least {CreateUserCommandHandler.MinimumPasswordLength} characters.";
            return;
        }
        if (!Guid.TryParse(_formDeptId, out var deptId)) { _formError = "Select a department."; return; }

        var isFinanceApprover = _formRole == (int)UserRole.Finance && _formIsFinanceApprover;

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var cmd = new UpdateUserCommand(
                    _editingId.Value,
                    _formFullName,
                    _formEmail,
                    deptId,
                    (UserRole)_formRole,
                    _formSlackId,
                    isFinanceApprover);
                var result = await Mediator.Send(cmd);
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }
            else
            {
                var cmd = new CreateUserCommand(
                    _formUsername,
                    _formFullName,
                    _formEmail,
                    _formInitialPassword,
                    deptId,
                    (UserRole)_formRole,
                    _formSlackId,
                    isFinanceApprover);
                var result = await Mediator.Send(cmd);
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }

            Toast.Success(_editingId.HasValue ? "User Updated" : "User Created", $"'{_formFullName}' saved successfully.");
            _showForm = false;
            await LoadUsers();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(UserDto u) => _deactivatingUser = u;

    private async Task DoDeactivate()
    {
        if (_deactivatingUser is null) return;
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateUserCommand(_deactivatingUser.Id));
        _saving = false;
        _deactivatingUser = null;
        if (result.IsFailure) { Toast.Error("Load Failed", result.Error.Message); }
        else { _successMessage = "User deactivated."; await LoadUsers(); }
        StateHasChanged();
    }

    private void ConfirmReactivate(UserDto u) => _reactivatingUser = u;

    private async Task DoReactivate()
    {
        if (_reactivatingUser is null) return;
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new ReactivateUserCommand(_reactivatingUser.Id));
        _saving = false;
        _reactivatingUser = null;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("User Reactivated", "User reactivated."); await LoadUsers(); }
        StateHasChanged();
    }

    private void OpenReset(UserDto u)
    {
        _resettingUser = u;
        _resetPassword = "";
        _resetError = null;
    }

    private void CloseReset()
    {
        _resettingUser = null;
        _resetError = null;
    }

    private async Task DoReset()
    {
        if (_resettingUser is null) return;
        _resetError = null;

        if (string.IsNullOrEmpty(_resetPassword)
            || _resetPassword.Length < ResetUserPasswordCommandHandler.MinimumPasswordLength)
        {
            _resetError = $"Password must be at least {ResetUserPasswordCommandHandler.MinimumPasswordLength} characters.";
            return;
        }

        if (_saving) return;
        _saving = true;
        try
        {
            var result = await Mediator.Send(new ResetUserPasswordCommand(_resettingUser.Id, _resetPassword));
            if (result.IsFailure) { _resetError = result.Error.Message; return; }

            _successMessage = $"Password reset for {_resettingUser.FullName}. They must change it on next login.";
            _resettingUser = null;
        }
        finally { _saving = false; }
    }

    private static string RoleBadge(UserRole r) => r switch
    {
        UserRole.Management => "bg-danger",
        UserRole.Admin => "bg-dark",
        UserRole.Finance => "bg-info text-dark",
        UserRole.Accounting => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _ => "bg-light text-dark border"
    };
}
