@page "/admin/budget-categories"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetCategories.Queries
@using SureBudgetRequest.Application.BudgetCategories.Commands.CreateBudgetCategory
@using SureBudgetRequest.Application.BudgetCategories.Commands.UpdateBudgetCategory
@using SureBudgetRequest.Application.BudgetCategories.Commands.DeactivateBudgetCategory
@using SureBudgetRequest.Application.BudgetCategories.Commands.ReactivateBudgetCategory
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Budget Categories</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Budget Categories</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Category</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="showInactiveCategories" @bind="_showInactive" @bind:after="LoadData" />
        <label class="form-label" for="showInactiveCategories">Show inactive</label>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var c = _filtered[i];
                        <tr class="@(!c.IsActive ? "text-muted" : "")">
                            <td class="text-muted text-sm">@(i + 1)</td>
                            <td><strong>@c.Name</strong></td>
                            <td>
                                @if (c.IsActive) { <span class="badge badge-role">Active</span> }
                                else             { <span class="badge badge-role">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline btn-sm" @onclick="() => OpenEdit(c)">Edit</button>
                                @if (c.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-danger ml-1" @onclick="() => ConfirmDeactivate(c)">Deactivate</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success ml-1" @onclick="() => DoReactivate(c)" disabled="@_saving">Reactivate</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="4" class="text-center text-muted ">No budget categories match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted ">No budget categories found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Budget Category" : "New Budget Category")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName"
                               placeholder="e.g. Asset, Expense" maxlength="200" />
                        <div class="form-hint">Shown to requesters and department heads on the request form.</div>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="categoryFormActive" @bind="_formIsActive" />
                            <label class="form-label" for="categoryFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingCategory is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate Budget Category</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _deactivatingCategory = null"></button>
                </div>
                <div class="modal-body">
                    <p class=" text-sm">
                        Deactivate <strong>@_deactivatingCategory.Name</strong>?
                        It won't appear in the request picker. Existing requests keep their link.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _deactivatingCategory = null">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BudgetCategoryDto> _categories = new();
    private List<BudgetCategoryDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private string? _errorMessage;
    private string? _successMessage;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private bool _formIsActive = true;

    // Deactivate confirm
    private BudgetCategoryDto? _deactivatingCategory;

    protected override async Task OnInitializedAsync()
    {
        // Admin owns budget categories.
        if (CurrentUser.Role is not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var result = await Mediator.Send(new ListBudgetCategoriesQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _categories = result.Value.OrderBy(c => c.Name).ToList();
        else
            _errorMessage = result.Error.Message;
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _categories.ToList()
            : _categories
                .Where(c => c.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formIsActive = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(BudgetCategoryDto c)
    {
        _editingId = c.Id;
        _formName = c.Name;
        _formIsActive = c.IsActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateBudgetCategoryCommand(
                    _editingId.Value, _formName, _formIsActive));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Budget category updated.";
            }
            else
            {
                var result = await Mediator.Send(new CreateBudgetCategoryCommand(_formName));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = "Budget category created.";
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(BudgetCategoryDto c) => _deactivatingCategory = c;

    private async Task DoDeactivate()
    {
        if (_deactivatingCategory is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateBudgetCategoryCommand(_deactivatingCategory.Id));
        _saving = false;
        var name = _deactivatingCategory.Name;
        _deactivatingCategory = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{name}' deactivated."; await LoadData(); }
    }

    private async Task DoReactivate(BudgetCategoryDto c)
    {
        _saving = true;
        var result = await Mediator.Send(new ReactivateBudgetCategoryCommand(c.Id));
        _saving = false;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = $"'{c.Name}' reactivated."; await LoadData(); }
    }
}
