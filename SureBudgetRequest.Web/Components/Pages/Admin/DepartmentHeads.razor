@page "/admin/department-heads"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Departments.Commands.AssignDepartmentHead
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Department Heads</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h5>Department Heads</h5>
            <div class="text-muted text-sm">Reassign who leads each department without touching other settings.</div>
        </div>
    </div>

    

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search department or head" Width="260px" />
    </div>

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_filtered.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="DepartmentDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="6">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Department</th>
            <th class="text-end">Budget Limit (MMK)</th>
            <th>Current Head</th>
            <th>Status</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var d = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(!d.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == d.Id ? "menu-open" : "")"
                @onclick="() => { if (d.IsActive) OpenAssign(d); }"
                @oncontextmenu="e => OpenContextMenu(e, d)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong>@d.Name</strong></td>
                <td class="text-end font-mono">@d.BudgetLimit.ToString("N2")</td>
                <td>
                    @if (d.HeadUserId.HasValue && _userNames.TryGetValue(d.HeadUserId.Value, out var name))
                    {
                        @name
                    }
                    else if (d.HeadUserId.HasValue)
                    {
                        <span class="validation-message">Unknown user</span>
                    }
                    else
                    {
                        <span class="text-muted text-sm">— none —</span>
                    }
                </td>
                <td>
                    @if (d.IsActive)
                    { <span class="badge badge-role">Active</span> }
                    else
                    { <span class="badge badge-role">Inactive</span> }
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, d)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <span>No departments match your search.</span>
            }
            else
            {
                <span>No departments found.</span>
            }
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_filtered.Count department(s)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Assign Head Modal ───────────────────────────────────────────────────────── *@
@if (_assigningDept is not null)
{
    <div class="modal-backdrop">
        <div class="modal" style="overflow:visible;">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">
                        @(_assigningDept.HeadUserId.HasValue ? "Change Head" : "Assign Head") — @_assigningDept.Name
                    </h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseAssign"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <label class="form-label text-sm font-semibold">New Department Head</label>
                    <Dropdown Items="_activeHeadUsers"
                              @bind-Value="_formHeadUserId"
                              ValueSelector="u => u.Id.ToString()"
                              TextSelector="FormatHeadUser"
                              Placeholder="— select —"
                              Searchable="true"
                              SearchPlaceholder="Search user..."
                              AllowClear="false" />
                    @if (_assigningDept.HeadUserId.HasValue && _userNames.TryGetValue(_assigningDept.HeadUserId.Value, out var currentHead))
                    {
                        <div class="form-hint">Current: @currentHead</div>
                    }
                    else
                    {
                        <div class="form-hint">Current: — none —</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseAssign">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveAssign" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.Name</span>
        </div>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenAssign(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>@(_contextMenuTarget.HeadUserId.HasValue ? "Change Department Head" : "Assign Department Head")</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<DepartmentDto> _departments = new();
    private List<DepartmentDto> _filtered = new();
    private List<UserDto> _activeHeadUsers = new();
    private Dictionary<Guid, string> _userNames = new();
    private bool _loading = true;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;

    // Assign form
    private DepartmentDto? _assigningDept;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private DepartmentDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, DepartmentDto dept)
    {
        _contextMenuTarget = dept;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, DepartmentDto dept)
    {
        _contextMenuTarget = dept;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }

    private string _formHeadUserId = "";
    private string? _formError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("department_heads") ?? "";
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;

        var usersResult = await Mediator.Send(new ListUsersQuery(IncludeInactive: true));
        if (usersResult.IsSuccess)
        {
            _userNames = usersResult.Value.ToDictionary(u => u.Id, u => u.FullName);
            _activeHeadUsers = usersResult.Value
                .Where(u => u.IsActive && !(u.Role == UserRole.Finance && !u.IsFinanceApprover))
                .ToList();
        }

        var deptsResult = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: false));
        if (deptsResult.IsSuccess)
            _departments = deptsResult.Value.OrderBy(d => d.Name).ToList();

        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        _page = 1;
        FilterState.SetSearch("department_heads", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _departments.ToList()
            : _departments
                .Where(d => d.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || HeadName(d).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private string HeadName(DepartmentDto d) =>
        d.HeadUserId.HasValue && _userNames.TryGetValue(d.HeadUserId.Value, out var name) ? name : "";

    private void OpenAssign(DepartmentDto d)
    {
        _assigningDept = d;
        _formHeadUserId = d.HeadUserId?.ToString() ?? "";
        _formError = null;
    }

    private void CloseAssign()
    {
        _assigningDept = null;
        _formError = null;
    }

    private async Task SaveAssign()
    {
        if (_assigningDept is null) return;
        if (!Guid.TryParse(_formHeadUserId, out var headId))
        {
            _formError = "Please select a user.";
            return;
        }

        if (_saving) return;
        _saving = true;
        try
        {
            var result = await Mediator.Send(new AssignDepartmentHeadCommand(_assigningDept.Id, headId));
            if (result.IsFailure)
            {
                _formError = result.Error.Message;
                return;
            }
            Toast.Success("Department Head Updated", $"Head of {_assigningDept.Name} updated.");
            _assigningDept = null;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private static string FormatHeadUser(UserDto u) => $"{u.FullName} ({u.Role})";
}
