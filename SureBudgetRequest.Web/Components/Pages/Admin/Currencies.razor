@page "/admin/currencies"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Currencies.Commands.CreateCurrency
@using SureBudgetRequest.Application.Currencies.Commands.UpdateCurrencyRate
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Currencies</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Currencies</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Currency</button>
    </div>

    

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search code or name" Width="260px" />
    </div>

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_filtered.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="CurrencyDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="7">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Code</th>
            <th>Name</th>
            <th class="text-end">Rate to MMK</th>
            <th>Last Updated</th>
            <th>Status</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var c = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(!c.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Code == c.Code ? "menu-open" : "")"
                @onclick="() => OpenEdit(c)"
                @oncontextmenu="e => OpenContextMenu(e, c)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong>@c.Code</strong></td>
                <td>@c.Name</td>
                <td class="text-end font-mono">@c.RateToMmk.ToString("N2")</td>
                <td><span class="text-sm text-muted">@c.RateUpdatedAt.ToMyanmarTime()</span></td>
                <td @onclick:stopPropagation="true">
                    @if (c.Code == "MMK")
                    {
                        <span class="badge badge-active" title="Base system currency cannot be deactivated">Active</span>
                    }
                    else if (c.IsActive)
                    {
                        <button class="badge badge-active" @onclick="() => ConfirmDeactivate(c)" title="Click to deactivate">Active</button>
                    }
                    else
                    {
                        <button class="badge badge-inactive" @onclick="() => DoReactivate(c)" title="Click to activate" disabled="@_saving">Inactive</button>
                    }
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, c)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <span>No currencies match your search.</span>
            }
            else
            {
                <span>No currencies found.</span>
            }
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_filtered.Count currency(ies)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingCode is null ? "New Currency" : $"Edit Currency — {_editingCode}")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }

                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Code</label>
                        <input class="input"
                               @bind="_formCode"
                               placeholder="e.g. USD"
                               maxlength="10"
                               disabled="@(_editingCode is not null)" />
                        <div class="form-hint">3-letter ISO code is conventional. Cannot be changed after creation.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName" placeholder="e.g. US Dollar" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Rate to MMK</label>
                        <NumericInput @bind-Value="_formRate" Step="0.01" Min="0" Disabled="@(_editingCode == "MMK")" />
                        <div class="form-hint">
                            1 @(_formCode?.ToUpperInvariant() ?? "unit") = @(_formRate.ToString("N2")) MMK.
                            @if (_editingCode is not null && _originalRate.HasValue && _originalRate.Value != _formRate)
                            {
                                <span class="text-warning">Rate change will be logged.</span>
                            }
                        </div>
                    </div>

                    @if (_editingCode is not null && _editingCode != "MMK")
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="formActive" @bind="_formIsActive" />
                            <label class="form-label" for="formActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Rate History Modal ─────────────────────────────────────────────────────── *@
@if (_historyCode is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-lg">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Rate History — @_historyCode</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _historyCode = null"></button>
                </div>
                <div class="modal-body">
                    @if (_historyLoading)
                    {
                        <div class="text-center "><div class="spinner spinner-sm"></div></div>
                    }
                    else if (!_history.Any())
                    {
                        <p class="text-muted text-sm ">No rate changes recorded.</p>
                    }
                    else
                    {
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th class="text-end">Old Rate</th>
                                    <th class="text-end">New Rate</th>
                                    <th class="text-end">Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _history)
                                {
                                    var delta = h.NewRate - h.OldRate;
                                    <tr>
                                        <td class="text-sm">@h.ChangedAt.ToMyanmarTime()</td>
                                        <td class="text-end">@h.OldRate.ToString("N2")</td>
                                        <td class="text-end">@h.NewRate.ToString("N2")</td>
                                        <td class="text-end @(delta >= 0 ? "text-success" : "text-danger")">
                                            @(delta >= 0 ? "+" : "")@delta.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}



@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingCurrency is not null)
{
    <ConfirmDialog Title="Deactivate Currency"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingCurrency = null">
        Deactivate currency <strong>@_deactivatingCurrency.Code (@_deactivatingCurrency.Name)</strong>? It will no longer appear when selecting currencies for new requests.
    </ConfirmDialog>
}

@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.Code — @_contextMenuTarget.Name</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Rate</span>
        </button>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenHistory(target.Code); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89l.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7s-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18m-1 5v5l4.28 2.54l.72-1.21l-3.5-2.08V8z"/></svg>
            <span>Rate History</span>
        </button>

        <div class="context-menu-divider"></div>
        @if (_contextMenuTarget.Code == "MMK")
        {
            <div class="context-menu-item text-muted" style="cursor: not-allowed; opacity: 0.7;" title="Base system currency cannot be deactivated">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Base Currency (Always Active)</span>
            </div>
        }
        else if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = DoReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<CurrencyDto> _currencies = new();
    private List<CurrencyDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;

    // Create/Edit state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private string? _editingCode;
    private decimal? _originalRate;
    private string _formCode = "";
    private string _formName = "";
    private decimal _formRate;
    private bool _formIsActive = true;

    // Deactivate confirm - active state managed via Edit form (UpdateCurrencyCommand)

    // History state
    private string? _historyCode;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private CurrencyDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, CurrencyDto currency)
    {
        _contextMenuTarget = currency;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, CurrencyDto currency)
    {
        _contextMenuTarget = currency;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }

    private bool _historyLoading;
    private List<CurrencyRateChangeDto> _history = new();

    private CurrencyDto? _deactivatingCurrency;

    private void ConfirmDeactivate(CurrencyDto c) => _deactivatingCurrency = c;

    private async Task DoDeactivate()
    {
        if (_deactivatingCurrency is null || _saving) return;
        _saving = true;
        var target = _deactivatingCurrency;
        _deactivatingCurrency = null;
        var result = await Mediator.Send(new UpdateCurrencyCommand(
            target.Code, target.Name, target.RateToMmk, IsActive: false, ChangedByUserId: CurrentUser.UserId));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Currency Deactivated", $"'{target.Code}' deactivated."); await LoadData(); }
        StateHasChanged();
    }

    private async Task DoReactivate(CurrencyDto c)
    {
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new UpdateCurrencyCommand(
            c.Code, c.Name, c.RateToMmk, IsActive: true, ChangedByUserId: CurrentUser.UserId));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Currency Reactivated", $"'{c.Code}' reactivated."); await LoadData(); }
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("currencies") ?? "";
        if (FilterState.GetFlag("currencies_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("currencies_inactive", _showInactive);
        _loading = true;
        var result = await Mediator.Send(new ListCurrenciesQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _currencies = result.Value.OrderBy(c => c.Code).ToList();
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        _page = 1;
        FilterState.SetSearch("currencies", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _currencies.ToList()
            : _currencies
                .Where(c => c.Code.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || c.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingCode = null;
        _originalRate = null;
        _formCode = "";
        _formName = "";
        _formRate = 1;
        _formIsActive = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(CurrencyDto c)
    {
        _editingCode = c.Code;
        _originalRate = c.RateToMmk;
        _formCode = c.Code;
        _formName = c.Name;
        _formRate = c.RateToMmk;
        _formIsActive = c.IsActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formCode)) { _formError = "Code is required."; return; }
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }
        if (_formRate <= 0) { _formError = "Rate must be greater than zero."; return; }

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editingCode is null)
            {
                var result = await Mediator.Send(new CreateCurrencyCommand(_formCode, _formName, _formRate));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = $"Currency '{result.Value}' created.";
            }
            else
            {
                var result = await Mediator.Send(new UpdateCurrencyCommand(
                    _editingCode, _formName, _formRate, _formIsActive, CurrentUser.UserId));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                _successMessage = $"Currency '{_editingCode}' updated.";
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private async Task OpenHistory(string code)
    {
        _historyCode = code;
        _historyLoading = true;
        _history = new();
        StateHasChanged();

        var result = await Mediator.Send(new ListCurrencyRateChangesQuery(CurrencyCode: code, Take: 100));
        if (result.IsSuccess)
            _history = result.Value.ToList();

        _historyLoading = false;
    }
}
