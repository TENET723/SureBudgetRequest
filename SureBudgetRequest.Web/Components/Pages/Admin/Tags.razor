@page "/tags"
@page "/admin/tags"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Tags.Queries
@using SureBudgetRequest.Application.Tags.Commands.CreateTag
@using SureBudgetRequest.Application.Tags.Commands.UpdateTag
@using SureBudgetRequest.Application.Tags.Commands.DeactivateTag
@using SureBudgetRequest.Application.Tags.Commands.ReactivateTag
@using SureBudgetRequest.Application.Tags.Models
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.AppSettings.Queries
@using SureBudgetRequest.Application.AppSettings.Commands.CreateAppSetting
@using SureBudgetRequest.Application.AppSettings.Commands.UpdateAppSetting
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using System.Text.Json

<PageTitle>Tags Management</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Tags Management</h5>
        <div class="flex items-center gap-2">
            @if (CurrentUser.Role == UserRole.Admin)
            {
                <button class="btn btn-outline btn-sm" @onclick="OpenVisibilitySettings">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="me-1">
                        <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M8 1v2m0 10v2M1 8h2m10 0h2m-2.93-4.93l-1.41 1.41m-7.32 7.32l-1.41 1.41m0-10.14l1.41 1.41m7.32 7.32l1.41 1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    Visibility Settings
                </button>
            }
            @if (CanManageTags)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Tag</button>
            }
        </div>
    </div>

    

    <div class="flex items-center gap-4 mb-3 flex-wrap">
        @if (CurrentUser.Role == UserRole.Admin && _departments.Count > 0)
        {
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold">Department:</span>
                <div style="width: 220px;">
                    <Dropdown Items="_departments"
                              @bind-Value="_selectedDepartmentId"
                              @bind-Value:after="LoadData"
                              ValueSelector="d => d.Id"
                              TextSelector="d => d.Name"
                              Searchable="true"
                              SearchPlaceholder="Search department..."
                              AllowClear="false" />
                </div>
            </div>
        }

        <div class="flex items-center gap-2">
            <label class="toggle" title="Show inactive">
                <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
            </label>
            <span class="text-sm text-muted">Show inactive</span>
        </div>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search tag name" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-no">#</th>
                        <th>Tag</th>
                        <th>Color</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="sticky-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No tags found for this department.</td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        @foreach (var tag in _filtered)
                        {
                            <tr class="clickable-row @(!tag.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == tag.Id ? "menu-open" : "")"
                                @onclick="() => { if (CanManageTags) OpenEdit(tag); }"
                                @oncontextmenu="e => OpenContextMenu(e, tag)"
                                @oncontextmenu:preventDefault="true">
                                <td class="col-no">@(i++)</td>
                                <td>
                                    <span class="badge d-inline-flex align-items-center" style="background-color: @(tag.ColorHex ?? "#6c757d"); color: @tag.EffectiveFontColor; font-size: 0.8rem; padding: 0.35em 0.6em;">
                                        #@tag.Name
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center gap-1" title="Background Color">
                                            <span style="display: inline-block; width: 14px; height: 14px; border-radius: 3px; background-color: @(tag.ColorHex ?? "#6c757d");"></span>
                                            <span class="text-xs text-mono">@(tag.ColorHex ?? "Default")</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1" title="Font Color">
                                            <span style="display: inline-block; width: 14px; height: 14px; border-radius: 3px; background-color: @tag.EffectiveFontColor; border: 1px solid var(--color-border, #ccc);"></span>
                                            <span class="text-xs text-mono text-muted">@(!string.IsNullOrEmpty(tag.FontColorHex) ? tag.FontColorHex : "Auto")</span>
                                        </div>
                                    </div>
                                </td>
                                <td @onclick:stopPropagation="true">
                                    @if (tag.IsActive)
                                    {
                                        <button class="badge badge-active" @onclick="() => { if (CanManageTags) OpenDeactivate(tag); }" title="Click to deactivate">Active</button>
                                    }
                                    else
                                    {
                                        <button class="badge badge-inactive" @onclick="() => { if (CanManageTags) DoReactivate(tag); }" title="Click to reactivate">Inactive</button>
                                    }
                                </td>
                                <td class="text-sm text-muted">@tag.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td class="sticky-action-col" @onclick:stopPropagation="true">
                                    <div class="row-hover-btn-wrapper">
                                        <div class="row-hover-backdrop"></div>
                                        <button type="button" class="btn-three-dots" title="Quick actions"
                                                @onclick="e => OpenContextMenuFromButton(e, tag)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                <circle cx="12" cy="5" r="2"/>
                                                <circle cx="12" cy="12" r="2"/>
                                                <circle cx="12" cy="19" r="2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div>
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Tag" : "New Tag")</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showForm = false" aria-label="Close">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error mb-3">@_formError</div>
                    }
                    <div class="mb-4 p-2 rounded flex items-center justify-between" style="background: var(--color-surface, #f9fafb); border: 1px solid var(--color-border, #e5e7eb);">
                        <span class="text-xs text-muted font-semibold">Preview:</span>
                        <span class="badge d-inline-flex align-items-center" style="background-color: @(_formColorHex); color: @EffectiveFormFontColor; font-size: 0.85rem; padding: 0.4em 0.7em;">
                            #@(!string.IsNullOrWhiteSpace(_formName) ? _formName : "preview")
                        </span>
                    </div>

                    <div class="form-field mb-3">
                        <label class="form-label text-sm font-semibold">Tag Name</label>
                        <input type="text" class="input" placeholder="e.g. Campaign-Q4" @bind="_formName" />
                    </div>

                    <div class="form-field mb-3">
                        <label class="form-label text-sm font-semibold">Background Color</label>
                        <div class="flex items-center gap-2">
                            <input type="color" class="color-picker-input" @bind="_formColorHex" />
                            <input type="text" class="input" placeholder="#3B82F6" @bind="_formColorHex" />
                        </div>
                    </div>

                    <div class="form-field mb-4">
                        <div class="flex items-center justify-between mb-1">
                            <label class="form-label text-sm font-semibold mb-0">Font Color</label>
                            <span class="text-xs text-muted">Contrast: @(string.IsNullOrWhiteSpace(_formFontColorHex) ? "Auto" : "Custom")</span>
                        </div>
                        <div class="flex items-center gap-2 mb-2">
                            <input type="color" class="color-picker-input" value="@EffectiveFormFontColor" @onchange="OnFontColorPickerChange" />
                            <input type="text" class="input" placeholder="Auto contrast" @bind="_formFontColorHex" />
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" class="btn btn-outline btn-xs @(string.IsNullOrWhiteSpace(_formFontColorHex) ? "btn-primary" : "")" @onclick="() => _formFontColorHex = null">Auto</button>
                            <button type="button" class="btn btn-outline btn-xs @(_formFontColorHex == "#1F2937" ? "btn-primary" : "")" @onclick='() => _formFontColorHex = "#1F2937"'>Dark Text</button>
                            <button type="button" class="btn btn-outline btn-xs @(_formFontColorHex == "#FFFFFF" ? "btn-primary" : "")" @onclick='() => _formFontColorHex = "#FFFFFF"'>Light Text</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showForm = false">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-xs me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Modal ────────────────────────────────────────────────────── *@
@if (_deactivatingTag is not null)
{
    <ConfirmDialog Title="Deactivate Tag"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingTag = null">
        Deactivate tag <strong>#@_deactivatingTag.Name</strong>? It will no longer appear in tag suggestions. Existing requests keep this tag.
    </ConfirmDialog>
}

@* ── Visibility Settings Modal ─────────────────────────────────────────── *@
@if (_showVisibilitySettings)
{
    <div class="modal-backdrop">
        <div class="modal" style="max-width: 580px;">
            <div>
                <div class="modal-header">
                    <div>
                        <h6 class="modal-title">Tag Visibility & Department Mapping</h6>
                        <div class="text-xs text-muted mt-1">Configure role read access on ticket details and designate Finance & Management departments.</div>
                    </div>
                    <button class="btn btn-icon modal-close" @onclick="() => _showVisibilitySettings = false" aria-label="Close">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_settingsError))
                    {
                        <div class="alert alert-error mb-3">@_settingsError</div>
                    }

                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold mb-1">Department Designations</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                            <div>
                                <label class="text-xs text-muted mb-1 d-block">Finance Department</label>
                                <Dropdown Items="_departments"
                                          @bind-Value="_settingsFinanceDeptId"
                                          ValueSelector="d => d.Id.ToString()"
                                          TextSelector="d => d.Name"
                                          Placeholder="-- Not Set (Disabled) --"
                                          Searchable="true"
                                          SearchPlaceholder="Search department..."
                                          AllowClear="true" />
                            </div>
                            <div>
                                <label class="text-xs text-muted mb-1 d-block">Management Department</label>
                                <Dropdown Items="_departments"
                                          @bind-Value="_settingsMgmtDeptId"
                                          ValueSelector="d => d.Id.ToString()"
                                          TextSelector="d => d.Name"
                                          Placeholder="-- Not Set (Disabled) --"
                                          Searchable="true"
                                          SearchPlaceholder="Search department..."
                                          AllowClear="true" />
                            </div>
                            <div>
                                <label class="text-xs text-muted mb-1 d-block">Accounting Department</label>
                                <Dropdown Items="_departments"
                                          @bind-Value="_settingsAcctDeptId"
                                          ValueSelector="d => d.Id.ToString()"
                                          TextSelector="d => d.Name"
                                          Placeholder="-- Not Set (Disabled) --"
                                          Searchable="true"
                                          SearchPlaceholder="Search department..."
                                          AllowClear="true" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-section-divider">
                        <span>ROLE READ VISIBILITY (TICKET DETAILS)</span>
                    </div>

                    <div class="flex flex-col gap-3">
                        @* Requester Scope *@
                        <div class="p-3" style="background: #F9FAFB; border-radius: 6px; border: 1px solid var(--color-border);">
                            <div class="font-semibold text-sm mb-1">Requester Role</div>
                            <div class="text-xs text-muted mb-2">When viewing their own ticket (if requester role is Finance/Accounting, role policy applies):</div>
                            <div class="flex items-center gap-4 flex-wrap">
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_reqSeesMgmt" />
                                    <span>Management Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_reqSeesFin" />
                                    <span>Finance Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_reqSeesAcct" />
                                    <span>Accounting Tags</span>
                                </label>
                            </div>
                        </div>

                        @* Management Scope *@
                        <div class="p-3" style="background: #F9FAFB; border-radius: 6px; border: 1px solid var(--color-border);">
                            <div class="font-semibold text-sm mb-1">Management Role</div>
                            <div class="text-xs text-muted mb-2">What Management reviewers can see across departments:</div>
                            <div class="flex items-center gap-4 flex-wrap">
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_mgmtSeesReq" />
                                    <span>Requester Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_mgmtSeesFin" />
                                    <span>Finance Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_mgmtSeesAcct" />
                                    <span>Accounting Tags</span>
                                </label>
                            </div>
                        </div>

                        @* Finance Scope *@
                        <div class="p-3" style="background: #F9FAFB; border-radius: 6px; border: 1px solid var(--color-border);">
                            <div class="font-semibold text-sm mb-1">Finance Role</div>
                            <div class="text-xs text-muted mb-2">What Finance reviewers can see across departments (leave unchecked for own department only):</div>
                            <div class="flex items-center gap-4 flex-wrap">
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_finSeesReq" />
                                    <span>Requester Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_finSeesMgmt" />
                                    <span>Management Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_finSeesAcct" />
                                    <span>Accounting Tags</span>
                                </label>
                            </div>
                        </div>

                        @* Accounting Scope *@
                        <div class="p-3" style="background: #F9FAFB; border-radius: 6px; border: 1px solid var(--color-border);">
                            <div class="font-semibold text-sm mb-1">Accounting Role</div>
                            <div class="text-xs text-muted mb-2">What Accounting reviewers can see across departments:</div>
                            <div class="flex items-center gap-4 flex-wrap">
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_acctSeesReq" />
                                    <span>Requester Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_acctSeesFin" />
                                    <span>Finance Tags</span>
                                </label>
                                <label class="checkbox-row text-sm">
                                    <input type="checkbox" @bind="_acctSeesMgmt" />
                                    <span>Management Tags</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="text-xs text-muted mt-3">
                        <em>* Users always have full visibility of tags belonging to their own department.</em>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showVisibilitySettings = false">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveVisibilitySettings" disabled="@_savingSettings">
                        @if (_savingSettings) { <span class="spinner spinner-xs me-1"></span> }
                        Save Visibility Settings
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>#@_contextMenuTarget.Name</span>
        </div>

        @if (CanManageTags)
        {
            <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit Tag</span>
            </button>

            <div class="context-menu-divider"></div>

            @if (_contextMenuTarget.IsActive)
            {
                <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenDeactivate(target); }">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                    <span>Deactivate</span>
                </button>
            }
            else
            {
                <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = DoReactivate(target); }">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Reactivate</span>
                </button>
            }
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<TagDto> _tags = new();
    private List<TagDto> _filtered = new();
    private List<DepartmentDto> _departments = new();
    private Guid _selectedDepartmentId;
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";

    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private string _formColorHex = "#3B82F6";
    private string? _formFontColorHex;

    private string EffectiveFormFontColor => ColorContrastHelper.GetEffectiveFontColor(_formColorHex, _formFontColorHex);

    private void OnFontColorPickerChange(ChangeEventArgs e)
    {
        _formFontColorHex = e.Value?.ToString();
    }

    private TagDto? _deactivatingTag;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private TagDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, TagDto tag)
    {
        _contextMenuTarget = tag;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, TagDto tag)
    {
        _contextMenuTarget = tag;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }


    private bool CanManageTags => CurrentUser.Role == UserRole.Admin ||
        CurrentUser.DepartmentId == _selectedDepartmentId;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role == UserRole.Support || (CurrentUser.Role != UserRole.Admin && CurrentUser.DepartmentId == Guid.Empty))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (CurrentUser.Role == UserRole.Admin)
        {
            var deptsRes = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: false));
            if (deptsRes.IsSuccess)
            {
                _departments = deptsRes.Value.OrderBy(d => d.Name).ToList();
                _selectedDepartmentId = _departments.FirstOrDefault()?.Id ?? CurrentUser.DepartmentId;
            }
        }
        else
        {
            _selectedDepartmentId = CurrentUser.DepartmentId;
        }

        _search = FilterState.GetSearch("tags") ?? "";
        if (FilterState.GetFlag("tags_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("tags_inactive", _showInactive);
        if (_selectedDepartmentId == Guid.Empty) return;

        _loading = true;
        var res = await Mediator.Send(new ListTagsByDepartmentQuery(_selectedDepartmentId, _showInactive));
        if (res.IsSuccess)
        {
            _tags = res.Value.OrderBy(t => t.Name).ToList();
        }
        else
        {
            _errorMessage = res.Error.Message;
        }
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        FilterState.SetSearch("tags", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _tags.ToList()
            : _tags.Where(t => t.Name.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formColorHex = "#3B82F6";
        _formFontColorHex = null;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(TagDto tag)
    {
        _editingId = tag.Id;
        _formName = tag.Name;
        _formColorHex = tag.ColorHex ?? "#3B82F6";
        _formFontColorHex = tag.FontColorHex;
        _formError = null;
        _showForm = true;
    }

    private async Task SaveForm()
    {
        _saving = true;
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Tag name is required.";
            _saving = false;
            return;
        }

        if (_editingId.HasValue)
        {
            var res = await Mediator.Send(new UpdateTagCommand(_editingId.Value, _formName.Trim(), _formColorHex, CurrentUser.UserId, _formFontColorHex));
            if (res.IsFailure)
            {
                _formError = res.Error.Message;
                _saving = false;
                return;
            }
            _successMessage = $"Tag #{_formName} updated successfully.";
        }
        else
        {
            var res = await Mediator.Send(new CreateTagCommand(_selectedDepartmentId, _formName.Trim(), CurrentUser.UserId, _formColorHex, _formFontColorHex));
            if (res.IsFailure)
            {
                _formError = res.Error.Message;
                _saving = false;
                return;
            }
            _successMessage = $"Tag #{_formName} created successfully.";
        }

        _showForm = false;
        _saving = false;
        await LoadData();
    }

    private void OpenDeactivate(TagDto tag) => _deactivatingTag = tag;

    private async Task DoDeactivate()
    {
        if (_deactivatingTag is null) return;
        _saving = true;
        var res = await Mediator.Send(new DeactivateTagCommand(_deactivatingTag.Id, CurrentUser.UserId));
        if (res.IsSuccess)
        {
            _successMessage = $"Tag #{_deactivatingTag.Name} deactivated.";
            _deactivatingTag = null;
            await LoadData();
        }
        else
        {
            _errorMessage = res.Error.Message;
        }
        _saving = false;
        StateHasChanged();
    }

    private async Task DoReactivate(TagDto tag)
    {
        var res = await Mediator.Send(new ReactivateTagCommand(tag.Id, CurrentUser.UserId));
        if (res.IsSuccess)
        {
            _successMessage = $"Tag #{tag.Name} reactivated.";
            await LoadData();
        }
        else
        {
            _errorMessage = res.Error.Message;
        }
        StateHasChanged();
    }

    // ── Visibility Settings Modal State & Handlers ───────────────────────────
    private bool _showVisibilitySettings;
    private bool _savingSettings;
    private string? _settingsError;
    private string _settingsFinanceDeptId = "";
    private string _settingsMgmtDeptId = "";
    private string _settingsAcctDeptId = "";
    private bool _reqSeesMgmt = true;
    private bool _reqSeesFin = true;
    private bool _reqSeesAcct = true;
    private bool _mgmtSeesReq = true;
    private bool _mgmtSeesFin = false;
    private bool _mgmtSeesAcct = true;
    private bool _finSeesReq = false;
    private bool _finSeesMgmt = false;
    private bool _finSeesAcct = true;
    private bool _acctSeesReq = true;
    private bool _acctSeesFin = true;
    private bool _acctSeesMgmt = true;

    private async Task OpenVisibilitySettings()
    {
        _settingsError = null;
        _savingSettings = true;

        var settingRes = await Mediator.Send(new GetAppSettingByKeyQuery(TagVisibilityConfig.SettingKey));
        var config = TagVisibilityConfig.FromJson(settingRes.Value?.Value);

        _settingsFinanceDeptId = config.FinanceDepartmentId?.ToString() ?? "";
        _settingsMgmtDeptId = config.ManagementDepartmentId?.ToString() ?? "";
        _settingsAcctDeptId = config.AccountingDepartmentId?.ToString() ?? "";

        var matrix = config.RoleVisibilityMatrix;
        _reqSeesMgmt = matrix.TryGetValue("Requester", out var r) && r.Any(x => string.Equals(x, "Management", StringComparison.OrdinalIgnoreCase));
        _reqSeesFin = r != null && r.Any(x => string.Equals(x, "Finance", StringComparison.OrdinalIgnoreCase));
        _reqSeesAcct = r != null && r.Any(x => string.Equals(x, "Accounting", StringComparison.OrdinalIgnoreCase));

        _mgmtSeesReq = matrix.TryGetValue("Management", out var m) && m.Any(x => string.Equals(x, "Requester", StringComparison.OrdinalIgnoreCase));
        _mgmtSeesFin = m != null && m.Any(x => string.Equals(x, "Finance", StringComparison.OrdinalIgnoreCase));
        _mgmtSeesAcct = m != null && m.Any(x => string.Equals(x, "Accounting", StringComparison.OrdinalIgnoreCase));

        _finSeesReq = matrix.TryGetValue("Finance", out var f) && f.Any(x => string.Equals(x, "Requester", StringComparison.OrdinalIgnoreCase));
        _finSeesMgmt = f != null && f.Any(x => string.Equals(x, "Management", StringComparison.OrdinalIgnoreCase));
        _finSeesAcct = f != null && f.Any(x => string.Equals(x, "Accounting", StringComparison.OrdinalIgnoreCase));

        _acctSeesReq = matrix.TryGetValue("Accounting", out var a) && a.Any(x => string.Equals(x, "Requester", StringComparison.OrdinalIgnoreCase));
        _acctSeesFin = a != null && a.Any(x => string.Equals(x, "Finance", StringComparison.OrdinalIgnoreCase));
        _acctSeesMgmt = a != null && a.Any(x => string.Equals(x, "Management", StringComparison.OrdinalIgnoreCase));

        _savingSettings = false;
        _showVisibilitySettings = true;
    }

    private async Task SaveVisibilitySettings()
    {
        _savingSettings = true;
        _settingsError = null;

        var config = new TagVisibilityConfig();
        if (Guid.TryParse(_settingsFinanceDeptId, out var finGuid))
            config.FinanceDepartmentId = finGuid;
        if (Guid.TryParse(_settingsMgmtDeptId, out var mgmtGuid))
            config.ManagementDepartmentId = mgmtGuid;
        if (Guid.TryParse(_settingsAcctDeptId, out var acctGuid))
            config.AccountingDepartmentId = acctGuid;

        var matrix = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);

        var reqList = new List<string>();
        if (_reqSeesMgmt) reqList.Add("Management");
        if (_reqSeesFin) reqList.Add("Finance");
        if (_reqSeesAcct) reqList.Add("Accounting");
        matrix["Requester"] = reqList;

        var mgmtList = new List<string>();
        if (_mgmtSeesReq) mgmtList.Add("Requester");
        if (_mgmtSeesFin) mgmtList.Add("Finance");
        if (_mgmtSeesAcct) mgmtList.Add("Accounting");
        matrix["Management"] = mgmtList;

        var finList = new List<string>();
        if (_finSeesReq) finList.Add("Requester");
        if (_finSeesMgmt) finList.Add("Management");
        if (_finSeesAcct) finList.Add("Accounting");
        matrix["Finance"] = finList;

        var acctList = new List<string>();
        if (_acctSeesReq) acctList.Add("Requester");
        if (_acctSeesFin) acctList.Add("Finance");
        if (_acctSeesMgmt) acctList.Add("Management");
        matrix["Accounting"] = acctList;

        config.RoleVisibilityMatrix = matrix;

        var json = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });

        var existing = await Mediator.Send(new GetAppSettingByKeyQuery(TagVisibilityConfig.SettingKey));
        if (existing.IsSuccess && existing.Value is not null)
        {
            var updateRes = await Mediator.Send(new UpdateAppSettingCommand(
                TagVisibilityConfig.SettingKey,
                json,
                "Tag visibility configuration mapping Finance & Management department IDs and role visibility matrix."));

            if (updateRes.IsFailure)
            {
                _settingsError = updateRes.Error.Message;
                _savingSettings = false;
                return;
            }
        }
        else
        {
            var createRes = await Mediator.Send(new CreateAppSettingCommand(
                TagVisibilityConfig.SettingKey,
                json,
                "Tag visibility configuration mapping Finance & Management department IDs and role visibility matrix."));

            if (createRes.IsFailure)
            {
                _settingsError = createRes.Error.Message;
                _savingSettings = false;
                return;
            }
        }

        _successMessage = "Tag visibility settings updated successfully.";
        _savingSettings = false;
        _showVisibilitySettings = false;
    }
}
