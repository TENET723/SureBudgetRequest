@page "/admin/departments"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Departments.Commands.CreateDepartment
@using SureBudgetRequest.Application.Departments.Commands.UpdateDepartment
@using SureBudgetRequest.Application.Departments.Commands.DeactivateDepartment
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Departments</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Departments</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Department</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage <button type="button" class="btn btn-icon modal-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name or head" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th>Name</th>
                        <th>Department Head</th>
                        <th class="text-end">Budget Limit (MMK)</th>
                        <th class="text-end">Monthly Limit (MMK)</th>
                        <th>Slack</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var d = _filtered[i];
                        <tr class="@(!d.IsActive ? "text-muted" : "")">
                            <td class="text-muted text-sm">@(i + 1)</td>
                            <td>@d.Name</td>
                            <td>
                                @if (d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var head))
                                {
                                    @head
                                }
                                else
                                {
                                    <span class="text-muted text-sm">— none —</span>
                                }
                            </td>
                            <td class="text-end">@d.BudgetLimit.ToString("N2")</td>
                            <td class="text-end">@d.MonthlyLimit.ToString("N2")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.SlackWebhookUrl))
                                {
                                    <span class="badge badge-role">✓ Configured</span>
                                }
                                else
                                {
                                    <span class="badge badge-role">— not set —</span>
                                }
                            </td>
                            <td>
                                @if (d.IsActive)
                                {
                                    <button class="badge badge-active" @onclick="() => ConfirmDeactivate(d)" title="Click to deactivate">Active</button>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-icon" @onclick="() => OpenEdit(d)" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="m14.06 9.02l.92.92L5.92 19H5v-.92zM17.66 3c-.25 0-.51.1-.7.29l-1.83 1.83l3.75 3.75l1.83-1.83a.996.996 0 0 0 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29m-3.6 3.19L3 17.25V21h3.75L17.81 9.94z"/></svg></button>
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="8" class="text-center text-muted ">No departments match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted ">No departments found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Department" : "New Department")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName" placeholder="e.g. Engineering" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Department Head <span class="text-muted fw-normal">(optional)</span></label>
                        <select class="select" @bind="_formHeadUserId">
                            <option value="">— no head —</option>
                            @foreach (var u in _activeUsers)
                            {
                                <option value="@u.Id">@u.FullName (@u.Role.ToString())</option>
                            }
                        </select>
                        <div class="form-hint">Leave empty if no head is assigned yet. Requests cannot be submitted until a head is set.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Budget Limit (MMK)</label>
                        <input class="input" type="number" min="0" @bind="_formBudgetLimit" />
                        <div class="form-hint">Per-request threshold. Requests above this go to the Management Team.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Monthly Limit (MMK)</label>
                        <input class="input" type="number" min="0" step="0.01" @bind="_formMonthlyLimit" />
                        <div class="form-hint">
                            Cumulative monthly spending cap. When a new request would push the department's
                            finance-approved spend for the current calendar month over this amount,
                            the requester must supply a justification. Routing is unchanged.
                        </div>
                    </div>
                    <hr class="my-3" />
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Slack Webhook URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input class="input" type="text"
                               @bind="_formSlackWebhookUrl"
                               placeholder="https://hooks.slack.com/services/T000.../B000.../..." />
                        <div class="form-hint">
                            All notifications for requests from this department are posted to this channel.
                            Leave empty to disable — queued notifications will stay pending until a URL is set.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingDept is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate Department</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _deactivatingDept = null"></button>
                </div>
                <div class="modal-body">
                    <p class=" text-sm">Deactivate <strong>@_deactivatingDept.Name</strong>? This won't affect in-flight requests.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _deactivatingDept = null">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartmentDto> _departments = new();
    private List<DepartmentDto> _filtered = new();
    private Dictionary<Guid, string> _users = new();
    private List<UserDto> _activeUsers = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private string? _errorMessage;
    private string? _successMessage;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private string _formHeadUserId = "";
    private decimal _formBudgetLimit;
    private decimal _formMonthlyLimit;
    private string _formSlackWebhookUrl = "";

    // Deactivate confirm
    private DepartmentDto? _deactivatingDept;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var allUsersResult = await Mediator.Send(new ListUsersQuery(IncludeInactive: true));
        if (allUsersResult.IsSuccess)
        {
            _users = allUsersResult.Value.ToDictionary(u => u.Id, u => u.FullName);
            _activeUsers = allUsersResult.Value.Where(u => u.IsActive).ToList();
        }

        var deptsResult = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: _showInactive));
        if (deptsResult.IsSuccess)
            _departments = deptsResult.Value.OrderBy(d => d.Name).ToList();

        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _departments.ToList()
            : _departments
                .Where(d => d.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || HeadName(d).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private string HeadName(DepartmentDto d) =>
        d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var name) ? name : "";

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formHeadUserId = "";
        _formBudgetLimit = 0;
        _formMonthlyLimit = 0;
        _formSlackWebhookUrl = "";
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(DepartmentDto d)
    {
        _editingId = d.Id;
        _formName = d.Name;
        _formHeadUserId = d.HeadUserId?.ToString() ?? "";
        _formBudgetLimit = d.BudgetLimit;
        _formMonthlyLimit = d.MonthlyLimit;
        _formSlackWebhookUrl = d.SlackWebhookUrl ?? "";
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }
        if (_formBudgetLimit < 0) { _formError = "Budget limit cannot be negative."; return; }
        if (_formMonthlyLimit < 0) { _formError = "Monthly limit cannot be negative."; return; }

        Guid? headId = null;
        if (!string.IsNullOrWhiteSpace(_formHeadUserId))
        {
            if (!Guid.TryParse(_formHeadUserId, out var parsed))
            {
                _formError = "Invalid department head selection.";
                return;
            }
            headId = parsed;
        }

        var webhookUrl = string.IsNullOrWhiteSpace(_formSlackWebhookUrl)
            ? null
            : _formSlackWebhookUrl.Trim();

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateDepartmentCommand(
                    _editingId.Value, _formName, headId, _formBudgetLimit, _formMonthlyLimit, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }
            else
            {
                var result = await Mediator.Send(new CreateDepartmentCommand(
                    _formName, headId, _formBudgetLimit, _formMonthlyLimit, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }

            _successMessage = _editingId.HasValue ? "Department updated." : "Department created.";
            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(DepartmentDto d) => _deactivatingDept = d;

    private async Task DoDeactivate()
    {
        if (_deactivatingDept is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateDepartmentCommand(_deactivatingDept.Id));
        _saving = false;
        _deactivatingDept = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = "Department deactivated."; await LoadData(); }
    }


}
