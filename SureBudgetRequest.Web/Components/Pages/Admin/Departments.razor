@page "/admin/departments"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Departments.Commands.CreateDepartment
@using SureBudgetRequest.Application.Departments.Commands.UpdateDepartment
@using SureBudgetRequest.Application.Departments.Commands.DeactivateDepartment
@using SureBudgetRequest.Application.Departments.Commands.SetDepartmentBudgetPeriod
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Departments</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Departments</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenCreate">+ New Department</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">@_errorMessage <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button></div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible">@_successMessage <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button></div>
    }

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="showInactive" @bind="_showInactive" @bind:after="LoadData" />
        <label class="form-check-label small" for="showInactive">Show inactive</label>
    </div>

    <div class="mb-3">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name or head" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:1%">#</th>
                        <th>Name</th>
                        <th>Department Head</th>
                        <th class="text-end">Budget Limit (MMK)</th>
                        <th>Spending cap</th>
                        <th>Slack</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var d = _filtered[i];
                        <tr class="@(!d.IsActive ? "text-muted" : "")">
                            <td class="text-muted small">@(i + 1)</td>
                            <td>@d.Name</td>
                            <td>
                                @if (d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var head))
                                {
                                    @head
                                }
                                else
                                {
                                    <span class="text-muted small">— none —</span>
                                }
                            </td>
                            <td class="text-end">@d.BudgetLimit.ToString("N2")</td>
                            <td>
                                <div>
                                    <span class="small">FY@(d.CurrentFinancialYear): </span>
                                    @if (d.CurrentPeriodType == BudgetPeriodType.None)
                                    {
                                        <span class="text-muted small">no cap</span>
                                    }
                                    else
                                    {
                                        <span>@PeriodLabel(d.CurrentPeriodType) @d.CurrentPeriodLimit.ToString("N0") MMK</span>
                                    }
                                </div>
                                @if (d.PendingPeriodType.HasValue)
                                {
                                    <div class="small text-info">
                                        → FY@(d.PendingFinancialYear):
                                        @if (d.PendingPeriodType.Value == BudgetPeriodType.None)
                                        {
                                            <span>no cap</span>
                                        }
                                        else
                                        {
                                            <span>@PeriodLabel(d.PendingPeriodType.Value) @((d.PendingPeriodLimit ?? 0m).ToString("N0")) MMK</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.SlackWebhookUrl))
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">✓ Configured</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">— not set —</span>
                                }
                            </td>
                            <td>
                                @if (d.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-xs btn-outline-secondary btn-sm" @onclick="() => OpenEdit(d)">Edit</button>
                                @if (d.IsActive)
                                {
                                    <button class="btn btn-xs btn-outline-danger btn-sm ms-1" @onclick="() => ConfirmDeactivate(d)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">No departments match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">No departments found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Department" : "New Department")</h6>
                    <button class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger small py-2">@_formError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Name</label>
                        <input class="form-control form-control-sm" @bind="_formName" placeholder="e.g. Engineering" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Head <span class="text-muted fw-normal">(optional)</span></label>
                        <select class="form-select form-select-sm" @bind="_formHeadUserId">
                            <option value="">— no head —</option>
                            @foreach (var u in _activeUsers)
                            {
                                <option value="@u.Id">@u.FullName (@u.Role.ToString())</option>
                            }
                        </select>
                        <div class="form-text small">Leave empty if no head is assigned yet. Requests cannot be submitted until a head is set.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Budget Limit (MMK)</label>
                        <input class="form-control form-control-sm" type="number" min="0" @bind="_formBudgetLimit" />
                        <div class="form-text small">Per-request threshold. Requests above this go to the Management Team.</div>
                    </div>

                    @* ── Cumulative spending cap ─────────────────────────────── *@
                    <hr class="my-3" />
                    @if (_editingId.HasValue)
                    {
                        <p class="small fw-semibold mb-1">Cumulative spending cap</p>
                        <div class="alert alert-light border small py-2 mb-2">
                            <span class="text-muted">Current (FY@(_currentFinancialYear)):</span>
                            @if (_currentPeriodType == BudgetPeriodType.None)
                            {
                                <strong>No cap</strong>
                            }
                            else
                            {
                                <strong>@PeriodLabel(_currentPeriodType) — @_currentPeriodLimit.ToString("N2") MMK</strong>
                            }
                            <div class="text-muted mt-1" style="font-size:0.75rem">
                                The current-year configuration is locked. Changes below take effect from
                                <strong>FY@(_currentFinancialYear + 1)</strong>.
                            </div>
                        </div>
                        <label class="form-label small fw-semibold">Scheduled change — from FY@(_currentFinancialYear + 1)</label>
                    }
                    else
                    {
                        <p class="small fw-semibold mb-1">Cumulative spending cap (effective immediately, FY@(_currentFinancialYear))</p>
                    }

                    <div class="row g-2">
                        <div class="col-5">
                            <select class="form-select form-select-sm" @bind="_formPeriodType">
                                <option value="@BudgetPeriodType.None">No cap</option>
                                <option value="@BudgetPeriodType.Monthly">Monthly</option>
                                <option value="@BudgetPeriodType.Quarterly">Quarterly</option>
                                <option value="@BudgetPeriodType.Yearly">Yearly</option>
                            </select>
                        </div>
                        <div class="col-7">
                            <input class="form-control form-control-sm" type="number" min="0" step="0.01"
                                   @bind="_formPeriodAmount"
                                   disabled="@(_formPeriodType == BudgetPeriodType.None)"
                                   placeholder="Amount (MMK)" />
                        </div>
                    </div>
                    <div class="form-text small">
                        Soft cap: when a new request would push the department's finance-approved
                        spending over this amount within the @( _formPeriodType == BudgetPeriodType.None ? "period" : PeriodLabel(_formPeriodType).ToLower()),
                        the requester must supply a justification. Routing is unchanged.
                    </div>

                    <hr class="my-3" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Slack Webhook URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input class="form-control form-control-sm" type="text"
                               @bind="_formSlackWebhookUrl"
                               placeholder="https://hooks.slack.com/services/T000.../B000.../..." />
                        <div class="form-text small">
                            All notifications for requests from this department are posted to this channel.
                            Leave empty to disable — queued notifications will stay pending until a URL is set.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingDept is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Deactivate Department</h6>
                    <button class="btn-close" @onclick="() => _deactivatingDept = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 small">Deactivate <strong>@_deactivatingDept.Name</strong>? This won't affect in-flight requests.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _deactivatingDept = null">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="DoDeactivate" disabled="@_saving">Deactivate</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartmentDto> _departments = new();
    private List<DepartmentDto> _filtered = new();
    private Dictionary<Guid, string> _users = new();
    private List<UserDto> _activeUsers = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private string? _errorMessage;
    private string? _successMessage;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private string _formHeadUserId = "";
    private decimal _formBudgetLimit;
    private string _formSlackWebhookUrl = "";

    // Cumulative-cap editor state
    private int _currentFinancialYear;
    private BudgetPeriodType _formPeriodType = BudgetPeriodType.None;
    private decimal _formPeriodAmount;
    // Current (locked) config captured when opening the edit modal, so we can tell
    // whether the editor actually changed anything (→ schedule a next-FY change).
    private BudgetPeriodType _currentPeriodType = BudgetPeriodType.None;
    private decimal _currentPeriodLimit;

    // Deactivate confirm
    private DepartmentDto? _deactivatingDept;

    private static string PeriodLabel(BudgetPeriodType t) => t switch
    {
        BudgetPeriodType.Monthly => "Monthly",
        BudgetPeriodType.Quarterly => "Quarterly",
        BudgetPeriodType.Yearly => "Yearly",
        _ => "No cap"
    };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var allUsersResult = await Mediator.Send(new ListUsersQuery(IncludeInactive: true));
        if (allUsersResult.IsSuccess)
        {
            _users = allUsersResult.Value.ToDictionary(u => u.Id, u => u.FullName);
            _activeUsers = allUsersResult.Value.Where(u => u.IsActive).ToList();
        }

        var deptsResult = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: _showInactive));
        if (deptsResult.IsSuccess)
            _departments = deptsResult.Value.OrderBy(d => d.Name).ToList();

        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _departments.ToList()
            : _departments
                .Where(d => d.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || HeadName(d).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private string HeadName(DepartmentDto d) =>
        d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var name) ? name : "";

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formHeadUserId = "";
        _formBudgetLimit = 0;
        _formSlackWebhookUrl = "";
        // New departments configure their initial cap immediately (current FY).
        _currentFinancialYear = _departments.FirstOrDefault()?.CurrentFinancialYear ?? 0;
        _formPeriodType = BudgetPeriodType.None;
        _formPeriodAmount = 0;
        _currentPeriodType = BudgetPeriodType.None;
        _currentPeriodLimit = 0;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(DepartmentDto d)
    {
        _editingId = d.Id;
        _formName = d.Name;
        _formHeadUserId = d.HeadUserId?.ToString() ?? "";
        _formBudgetLimit = d.BudgetLimit;
        _formSlackWebhookUrl = d.SlackWebhookUrl ?? "";

        _currentFinancialYear = d.CurrentFinancialYear;
        _currentPeriodType = d.CurrentPeriodType;
        _currentPeriodLimit = d.CurrentPeriodLimit;
        // Pre-fill the next-FY editor with the pending change if one exists,
        // otherwise carry the current config forward as the starting point.
        _formPeriodType = d.PendingPeriodType ?? d.CurrentPeriodType;
        _formPeriodAmount = d.PendingPeriodLimit ?? d.CurrentPeriodLimit;

        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }
        if (_formBudgetLimit < 0) { _formError = "Budget limit cannot be negative."; return; }
        if (_formPeriodType != BudgetPeriodType.None && _formPeriodAmount < 0)
        { _formError = "Spending cap cannot be negative."; return; }

        // Empty selection = no head assigned (allowed).
        Guid? headId = null;
        if (!string.IsNullOrWhiteSpace(_formHeadUserId))
        {
            if (!Guid.TryParse(_formHeadUserId, out var parsed))
            {
                _formError = "Invalid department head selection.";
                return;
            }
            headId = parsed;
        }

        // Empty string = clear the webhook. Domain layer handles format validation.
        var webhookUrl = string.IsNullOrWhiteSpace(_formSlackWebhookUrl)
            ? null
            : _formSlackWebhookUrl.Trim();

        var amount = _formPeriodType == BudgetPeriodType.None ? 0m : _formPeriodAmount;

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateDepartmentCommand(
                    _editingId.Value, _formName, headId, _formBudgetLimit, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }

                // Schedule a next-FY cap change only when the editor differs from the
                // current (locked) config — avoids creating a redundant pending row.
                var changed = _formPeriodType != _currentPeriodType
                    || (_formPeriodType != BudgetPeriodType.None && amount != _currentPeriodLimit);
                if (changed)
                {
                    var periodResult = await Mediator.Send(new SetDepartmentBudgetPeriodCommand(
                        _editingId.Value, _formPeriodType, amount));
                    if (periodResult.IsFailure) { _formError = periodResult.Error.Message; return; }
                }
            }
            else
            {
                var result = await Mediator.Send(new CreateDepartmentCommand(
                    _formName, headId, _formBudgetLimit, _formPeriodType, amount, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }

            _successMessage = _editingId.HasValue ? "Department updated." : "Department created.";
            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(DepartmentDto d) => _deactivatingDept = d;

    private async Task DoDeactivate()
    {
        if (_deactivatingDept is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateDepartmentCommand(_deactivatingDept.Id));
        _saving = false;
        _deactivatingDept = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else { _successMessage = "Department deactivated."; await LoadData(); }
    }
}
