@page "/admin/departments"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Departments.Commands.CreateDepartment
@using SureBudgetRequest.Application.Departments.Commands.UpdateDepartment
@using SureBudgetRequest.Application.Departments.Commands.DeactivateDepartment
@using SureBudgetRequest.Application.Departments.Commands.ReactivateDepartment
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Departments</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Departments</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Department</button>
    </div>

    

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search name or head" Width="260px" />
    </div>

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_filtered.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="DepartmentDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="8">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Name</th>
            <th>Department Head</th>
            <th class="text-end">Budget Limit (MMK)</th>
            <th class="text-end">Monthly Limit (MMK)</th>
            <th>Slack</th>
            <th>Status</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var d = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(!d.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == d.Id ? "menu-open" : "")"
                @onclick="() => OpenEdit(d)"
                @oncontextmenu="e => OpenContextMenu(e, d)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong>@d.Name</strong></td>
                <td>
                    @if (d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var head))
                    {
                        @head
                    }
                    else
                    {
                        <span class="text-muted text-sm">— none —</span>
                    }
                </td>
                <td class="text-end font-mono">@d.BudgetLimit.ToString("N2")</td>
                <td class="text-end font-mono">@d.MonthlyLimit.ToString("N2")</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(d.SlackWebhookUrl))
                    {
                        <span class="badge badge-role">✓ Configured</span>
                    }
                    else
                    {
                        <span class="badge badge-role">— not set —</span>
                    }
                </td>
                <td @onclick:stopPropagation="true">
                    @if (d.IsActive)
                    {
                        <button class="badge badge-active" @onclick="() => ConfirmDeactivate(d)" title="Click to deactivate">Active</button>
                    }
                    else
                    {
                        <button class="badge badge-inactive" @onclick="() => DoReactivate(d)" title="Click to activate" disabled="@_saving">Inactive</button>
                    }
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, d)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <span>No departments match your search.</span>
            }
            else
            {
                <span>No departments found.</span>
            }
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_filtered.Count department(s)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Department" : "New Department")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName" placeholder="e.g. Engineering" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Department Head <span class="text-muted fw-normal">(optional)</span></label>
                        <Dropdown Items="_activeUsers"
                                  @bind-Value="_formHeadUserId"
                                  ValueSelector="u => u.Id.ToString()"
                                  TextSelector="FormatHeadUser"
                                  Placeholder="— no head —"
                                  Searchable="true"
                                  SearchPlaceholder="Search user..."
                                  AllowClear="true" />
                        <div class="form-hint">Leave empty if no head is assigned yet. Requests cannot be submitted until a head is set.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Budget Limit (MMK)</label>
                        <NumericInput @bind-Value="_formBudgetLimit" Min="0" />
                        <div class="form-hint">Per-request threshold. Requests above this go to the Management Team.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Monthly Limit (MMK)</label>
                        <NumericInput @bind-Value="_formMonthlyLimit" Min="0" Step="0.01" />
                        <div class="form-hint">
                            Cumulative monthly spending cap. When a new request would push the department's
                            finance-approved spend for the current calendar month over this amount,
                            the requester must supply a justification. Routing is unchanged.
                        </div>
                    </div>
                    <hr class="my-3" />
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Slack Webhook URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input class="input" type="text"
                               @bind="_formSlackWebhookUrl"
                               placeholder="https://hooks.slack.com/services/T000.../B000.../..." />
                        <div class="form-hint">
                            All notifications for requests from this department are posted to this channel.
                            Leave empty to disable — queued notifications will stay pending until a URL is set.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingDept is not null)
{
    <ConfirmDialog Title="Deactivate Department"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingDept = null">
        Deactivate the <strong>@_deactivatingDept.Name</strong> department? New requests cannot be created under this department. Existing pending requests will continue processing.
    </ConfirmDialog>
}


@* ── Context Menu (handled via ContextMenuService) ── *@

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<DepartmentDto> _departments = new();
    private List<DepartmentDto> _filtered = new();
    private Dictionary<Guid, string> _users = new();
    private List<UserDto> _activeUsers = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formName = "";
    private string _formHeadUserId = "";
    private decimal _formBudgetLimit;
    private decimal _formMonthlyLimit;
    private string _formSlackWebhookUrl = "";

    // Deactivate confirm
    private DepartmentDto? _deactivatingDept;

    // Context menu state
    private DepartmentDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, DepartmentDto dept)
    {
        _contextMenuTarget = dept;
        ContextMenu.Show(e, RenderContextMenu(dept), title: dept.Name, isButton: false, onClose: () => { _contextMenuTarget = null; StateHasChanged(); });
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, DepartmentDto dept)
    {
        _contextMenuTarget = dept;
        ContextMenu.Show(e, RenderContextMenu(dept), title: dept.Name, isButton: true, onClose: () => { _contextMenuTarget = null; StateHasChanged(); });
    }

    private void CloseContextMenu()
    {
        ContextMenu.Close();
        _contextMenuTarget = null;
    }

    private RenderFragment RenderContextMenu(DepartmentDto target) => @<text>
        <button type="button" class="context-menu-item" @onclick="() => { CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Department</span>
        </button>

        <div class="context-menu-divider"></div>
        @if (target.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { CloseContextMenu(); _ = DoReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </text>;


    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("departments") ?? "";
        if (FilterState.GetFlag("departments_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("departments_inactive", _showInactive);
        _loading = true;
        var allUsersResult = await Mediator.Send(new ListUsersQuery(IncludeInactive: true));
        if (allUsersResult.IsSuccess)
        {
            _users = allUsersResult.Value.ToDictionary(u => u.Id, u => u.FullName);
            _activeUsers = allUsersResult.Value.Where(u => u.IsActive).ToList();
        }

        var deptsResult = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: _showInactive));
        if (deptsResult.IsSuccess)
            _departments = deptsResult.Value.OrderBy(d => d.Name).ToList();

        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        _page = 1;
        FilterState.SetSearch("departments", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _departments.ToList()
            : _departments
                .Where(d => d.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || HeadName(d).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private string HeadName(DepartmentDto d) =>
        d.HeadUserId.HasValue && _users.TryGetValue(d.HeadUserId.Value, out var name) ? name : "";

    private void OpenCreate()
    {
        _editingId = null;
        _formName = "";
        _formHeadUserId = "";
        _formBudgetLimit = 0;
        _formMonthlyLimit = 0;
        _formSlackWebhookUrl = "";
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(DepartmentDto d)
    {
        _editingId = d.Id;
        _formName = d.Name;
        _formHeadUserId = d.HeadUserId?.ToString() ?? "";
        _formBudgetLimit = d.BudgetLimit;
        _formMonthlyLimit = d.MonthlyLimit;
        _formSlackWebhookUrl = d.SlackWebhookUrl ?? "";
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }
        if (_formBudgetLimit < 0) { _formError = "Budget limit cannot be negative."; return; }
        if (_formMonthlyLimit < 0) { _formError = "Monthly limit cannot be negative."; return; }

        Guid? headId = null;
        if (!string.IsNullOrWhiteSpace(_formHeadUserId))
        {
            if (!Guid.TryParse(_formHeadUserId, out var parsed))
            {
                _formError = "Invalid department head selection.";
                return;
            }
            headId = parsed;
        }

        var webhookUrl = string.IsNullOrWhiteSpace(_formSlackWebhookUrl)
            ? null
            : _formSlackWebhookUrl.Trim();

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateDepartmentCommand(
                    _editingId.Value, _formName, headId, _formBudgetLimit, _formMonthlyLimit, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }
            else
            {
                var result = await Mediator.Send(new CreateDepartmentCommand(
                    _formName, headId, _formBudgetLimit, _formMonthlyLimit, webhookUrl));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
            }

            Toast.Success(_editingId.HasValue ? "Department Updated" : "Department Created", $"'{_formName}' saved successfully.");
            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(DepartmentDto d) => _deactivatingDept = d;

    private async Task DoReactivate(DepartmentDto d)
    {
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new ReactivateDepartmentCommand(d.Id));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Department Reactivated", $"'{d.Name}' reactivated."); await LoadData(); }
        StateHasChanged();
    }


    private async Task DoDeactivate()
    {
        if (_deactivatingDept is null) return;
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateDepartmentCommand(_deactivatingDept.Id));
        _saving = false;
        var name = _deactivatingDept.Name;
        _deactivatingDept = null;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Department Deactivated", $"'{name}' deactivated."); await LoadData(); }
        StateHasChanged();
    }



    private static string FormatHeadUser(UserDto u) => $"{u.FullName} ({u.Role})";
}
