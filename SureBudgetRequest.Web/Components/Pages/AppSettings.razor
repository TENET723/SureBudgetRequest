@page "/app-settings"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.AppSettings.Queries
@using SureBudgetRequest.Application.AppSettings.Commands.CreateAppSetting
@using SureBudgetRequest.Application.AppSettings.Commands.UpdateAppSetting
@using SureBudgetRequest.Domain.Enums

<PageTitle>Application Settings</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Application Settings</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Setting</button>
    </div>

    

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _settings.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_settings.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="AppSettingDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="5">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Key</th>
            <th>Value</th>
            <th>Description</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var s = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(_contextMenuTarget?.Key == s.Key ? "menu-open" : "")"
                @onclick="() => OpenEdit(s)"
                @oncontextmenu="e => OpenContextMenu(e, s)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong class="font-mono text-sm">@s.Key</strong></td>
                <td class="text-break font-mono text-sm">@s.Value</td>
                <td class="text-sm text-muted">
                    @(string.IsNullOrWhiteSpace(s.Description) ? "—" : s.Description)
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, s)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            <span>No settings found.</span>
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_settings.Count setting(s)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_isEditing ? "Edit Setting" : "New Setting")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Key</label>
                        <input class="form-control form-control-sm @(_isEditing ? "bg-light" : "")" @bind="_formKey"
                               placeholder="e.g. AdvanceBlackoutDays" maxlength="100" readonly="@_isEditing" />
                        @if (!_isEditing)
                        {
                            <div class="form-hint">Must be unique. Used by the system to identify the setting.</div>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Value</label>
                        <input class="input" @bind="_formValue"
                               placeholder="Value" maxlength="500" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Description <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <textarea class="textarea textarea-sm" rows="2" maxlength="1000"
                                  @bind="_formDescription"
                                  placeholder="What is this setting used for?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.Key</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Setting</span>
        </button>
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<AppSettingDto> _settings = new();
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 20;

    // Form state
    private bool _showForm;
    private bool _saving;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private AppSettingDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, AppSettingDto setting)
    {
        _contextMenuTarget = setting;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, AppSettingDto setting)
    {
        _contextMenuTarget = setting;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }

    private string? _formError;
    private bool _isEditing;
    private string _formKey = "";
    private string _formValue = "";
    private string _formDescription = "";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var result = await Mediator.Send(new ListAppSettingsQuery());
        if (result.IsSuccess && result.Value is not null)
            _settings = result.Value.OrderBy(s => s.Key).ToList();
        else if (result.IsFailure)
            Toast.Error("Load Failed", result.Error.Message);
        _loading = false;
    }

    private void OpenCreate()
    {
        _isEditing = false;
        _formKey = "";
        _formValue = "";
        _formDescription = "";
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(AppSettingDto s)
    {
        _isEditing = true;
        _formKey = s.Key;
        _formValue = s.Value;
        _formDescription = s.Description ?? "";
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formKey)) { _formError = "Key is required."; return; }
        if (string.IsNullOrWhiteSpace(_formValue)) { _formError = "Value is required."; return; }

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;

        if (_saving) return;
        _saving = true;
        try
        {
            if (_isEditing)
            {
                var result = await Mediator.Send(new UpdateAppSettingCommand(
                    _formKey, _formValue, desc));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Setting Updated", $"'{_formKey}' updated successfully.");
            }
            else
            {
                var result = await Mediator.Send(new CreateAppSettingCommand(_formKey, _formValue, desc));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Setting Created", $"'{_formKey}' created successfully.");
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }
}
