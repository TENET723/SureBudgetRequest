@page "/coas"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.Coas.Queries
@using SureBudgetRequest.Application.Coas.Commands.CreateCoa
@using SureBudgetRequest.Application.Coas.Commands.UpdateCoa
@using SureBudgetRequest.Application.Coas.Commands.DeactivateCoa
@using SureBudgetRequest.Application.Coas.Commands.ReactivateCoa
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Chart of Accounts</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Chart of Accounts</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Account</button>
    </div>

    

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search code, name, or description" Width="260px" />
    </div>

    @{
        var page = _page;
        var pageSize = _pageSize;
        var paged = _filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        var totalPages = (int)Math.Ceiling(_filtered.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
    }

    <AppTable TItem="CoaDto"
              Items="@paged"
              IsLoading="@_loading"
              ColSpan="6">
        <TableHeader>
            <th class="sticky-no-col font-bold">NO.</th>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th class="sticky-action-col"></th>
        </TableHeader>
        <RowTemplateWithIndex Context="ctx">
            @{
                var c = ctx.Item;
                var i = ctx.Index;
                var rowNo = (page - 1) * pageSize + i + 1;
            }
            <tr class="clickable-row @(!c.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == c.Id ? "menu-open" : "")"
                @onclick="() => OpenEdit(c)"
                @oncontextmenu="e => OpenContextMenu(e, c)"
                @oncontextmenu:preventDefault="true">
                <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                <td><strong>@c.Code</strong></td>
                <td>@c.Name</td>
                <td class="text-sm text-muted">
                    @(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)
                </td>
                <td @onclick:stopPropagation="true">
                    @if (c.IsActive)
                    {
                        <button class="badge badge-active" @onclick="() => ConfirmDeactivate(c)" title="Click to deactivate">Active</button>
                    }
                    else
                    {
                        <button class="badge badge-inactive" @onclick="() => DoReactivate(c)" title="Click to activate" disabled="@_saving">Inactive</button>
                    }
                </td>
                <td class="sticky-action-col" @onclick:stopPropagation="true">
                    <div class="row-hover-btn-wrapper">
                        <div class="row-hover-backdrop"></div>
                        <button type="button" class="btn-three-dots" title="Quick actions"
                                @onclick="e => OpenContextMenuFromButton(e, c)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        </RowTemplateWithIndex>
        <EmptyContent>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <span>No accounts match your search.</span>
            }
            else
            {
                <span>No accounts found.</span>
            }
        </EmptyContent>
        <PaginationContent>
            <div class="flex items-center justify-between flex-wrap gap-3">
                <span class="text-sm text-muted">@_filtered.Count account(s)</span>
                <div class="flex items-center gap-2">
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page <= 1)"
                            @onclick="() => _page--">‹ Prev</button>
                    <span class="text-sm text-muted">Page @(page) of @totalPages</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(page >= totalPages)"
                            @onclick="() => _page++">Next ›</button>

                    <div class="flex items-center gap-2 ml-3">
                        <span class="text-sm text-muted">Per page</span>
                        <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => _page = 1">
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>
        </PaginationContent>
    </AppTable>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Account" : "New Account")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Code</label>
                        <input class="input" @bind="_formCode"
                               placeholder="e.g. 5110" maxlength="32" />
                        <div class="form-hint">Must be unique. Used by Finance to book the transaction.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Name</label>
                        <input class="input" @bind="_formName"
                               placeholder="e.g. Office Supplies" maxlength="200" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Description <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <textarea class="textarea textarea-sm" rows="2" maxlength="1000"
                                  @bind="_formDescription"
                                  placeholder="What kinds of expenses belong in this account?"></textarea>
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="coaFormActive" @bind="_formIsActive" />
                            <label class="form-label" for="coaFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingCoa is not null)
{
    <ConfirmDialog Title="Deactivate Chart of Account"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingCoa = null">
        Deactivate account <strong>@_deactivatingCoa.Code — @_deactivatingCoa.Name</strong>? It will no longer appear in the approval picker. Past records are unaffected.
    </ConfirmDialog>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.Code — @_contextMenuTarget.Name</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Account</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = DoReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<CoaDto> _coas = new();
    private List<CoaDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formCode = "";
    private string _formName = "";
    private string _formDescription = "";
    private bool _formIsActive = true;

    // Deactivate confirm
    private CoaDto? _deactivatingCoa;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private CoaDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, CoaDto coa)
    {
        _contextMenuTarget = coa;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, CoaDto coa)
    {
        _contextMenuTarget = coa;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("coas") ?? "";
        if (FilterState.GetFlag("coas_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("coas_inactive", _showInactive);
        _loading = true;
        var result = await Mediator.Send(new ListCoasQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _coas = result.Value.OrderBy(c => c.Code).ToList();
        else
            Toast.Error("Load Failed", result.Error.Message);
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        _page = 1;
        FilterState.SetSearch("coas", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _coas.ToList()
            : _coas
                .Where(c => c.Code.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || c.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || (c.Description?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0))
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formCode = "";
        _formName = "";
        _formDescription = "";
        _formIsActive = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(CoaDto c)
    {
        _editingId = c.Id;
        _formCode = c.Code;
        _formName = c.Name;
        _formDescription = c.Description ?? "";
        _formIsActive = c.IsActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formCode)) { _formError = "Code is required."; return; }
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "Name is required."; return; }

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;

        if (_saving) return;
        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateCoaCommand(
                    _editingId.Value, _formCode, _formName, desc, _formIsActive));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Account Updated", $"'{_formCode}' updated successfully.");
            }
            else
            {
                var result = await Mediator.Send(new CreateCoaCommand(_formCode, _formName, desc));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Account Created", $"'{_formCode}' created successfully.");
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(CoaDto c) => _deactivatingCoa = c;

    private async Task DoDeactivate()
    {
        if (_deactivatingCoa is null) return;
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateCoaCommand(_deactivatingCoa.Id));
        _saving = false;
        _deactivatingCoa = null;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Account Deactivated", "Account deactivated."); await LoadData(); }
        StateHasChanged();
    }

    private async Task DoReactivate(CoaDto c)
    {
        if (_saving) return;
        _saving = true;
        var result = await Mediator.Send(new ReactivateCoaCommand(c.Id));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Account Reactivated", $"Account '{c.Code}' reactivated."); await LoadData(); }
        StateHasChanged();
    }
}
