@page "/requests/{Id:guid}/edit"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetMonthlySpend
@using SureBudgetRequest.Application.BudgetRequests.Commands.UpdateDraft
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.ResubmitRequest
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Domain.Enums
@using AttachmentCategory = SureBudgetRequest.Domain.Enums.AttachmentCategory
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Edit Request</PageTitle>

<div class="container py-3" style="max-width:640px">

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border"></div></div>
    }
    else if (_request is null)
    {
        <div class="alert alert-warning">Request not found.</div>
        <a href="requests/mine" class="btn btn-sm btn-link">← Back to My Requests</a>
    }
    else if (_request.RequesterId != CurrentUser.UserId)
    {
        <div class="alert alert-danger">You can only edit your own requests.</div>
        <a href="requests/@Id" class="btn btn-sm btn-link">← Back to request</a>
    }
    else if (_request.Status is not RequestStatus.Draft and not RequestStatus.SentBack)
    {
        <div class="alert alert-warning">
            This request is no longer editable (status: <strong>@_request.Status</strong>).
        </div>
        <a href="requests/@Id" class="btn btn-sm btn-link">← Back to request</a>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a href="requests/@Id" class="text-muted small">← Back to detail</a>
            <h5 class="mb-0">Edit Budget Request</h5>
            <span class="text-muted small font-monospace">@_request.Reference</span>
        </div>

        @if (_request.Status == RequestStatus.SentBack && !string.IsNullOrEmpty(_lastSendBackComment))
        {
            <div class="alert alert-warning small">
                <strong>Sent back:</strong> @_lastSendBackComment
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (WouldOverflowMonthly)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2">
                <span style="font-size:1.25rem; line-height:1">⚠</span>
                <div class="small">
                    <strong>This request would push the department over its monthly limit.</strong>
                    <div class="mt-1">
                        This month: <strong>@_monthlySpent.ToString("N0")</strong> MMK used
                        of <strong>@_monthlyLimit!.Value.ToString("N0")</strong> MMK.
                        This request adds <strong>@AmountInMmk.ToString("N0")</strong> MMK
                        (total would be <strong>@((_monthlySpent + AmountInMmk).ToString("N0"))</strong> MMK).
                    </div>
                    <div class="mt-1 text-muted">
                        A written justification will be required when you save or submit.
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Request Type</label>
                    <select class="form-select form-select-sm" @bind="_type" @bind:after="OnTypeChanged">
                        <option value="@BudgetRequestType.Standard">Standard</option>
                        <option value="@BudgetRequestType.Urgent">Urgent</option>
                        <option value="@BudgetRequestType.ProjectProposal">Project Proposal</option>
                        <option value="@BudgetRequestType.Advance">Advance</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Request Date</label>
                    <input class="form-control form-control-sm" type="date" @bind="_requestDate" />
                </div>

                <div class="row g-2 mb-1">
                    <div class="col-4">
                        <label class="form-label small fw-semibold">Currency</label>
                        <select class="form-select form-select-sm" @bind="_currencyCode" @bind:after="OnCurrencyChanged">
                            @foreach (var c in _currencies)
                            {
                                <option value="@c.Code">@c.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-8">
                        <label class="form-label small fw-semibold">Amount</label>
                        <input class="form-control form-control-sm" type="number" min="1" step="0.01" @bind="_amount" @bind:after="OnAmountChanged" />
                    </div>
                    </div>

                    @if (_currencyCode != "MMK")
                    {
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Exchange Rate (MMK per @_currencyCode)</label>
                        <input class="form-control form-control-sm" type="number" step="0.0001" 
                               @bind="_selectedRate" @bind:after="OnAmountChanged"
                               disabled="@(_type == BudgetRequestType.Advance)" />
                        @if (_type == BudgetRequestType.Advance)
                        {
                            <div class="form-text small text-muted">System rate is locked for Advance requests.</div>
                        }
                        else
                        {
                            <div class="form-text small text-muted">Default system rate: @_systemRate.ToString("N4")</div>
                        }
                    </div>
                    }

                    <div class="form-text small mb-3">
                    @if (_currencyCode == "MMK")
                    {
                        <span>Department limit comparison is in MMK.</span>
                    }
                    else if (_selectedRate > 0 && _amount > 0)
                    {
                        <span>
                            ≈ <strong>@((_amount * _selectedRate).ToString("N0"))</strong> MMK
                            <span class="text-muted">(at @_selectedRate.ToString("N4") MMK / @_currencyCode)</span>
                        </span>
                    }
                    else if (_selectedRate > 0)
                    {
                        <span class="text-muted">Current rate: 1 @_currencyCode = @_selectedRate.ToString("N4") MMK</span>
                    }
                    </div>
                @if (_monthlyLimit.HasValue && !WouldOverflowMonthly)
                {
                    <div class="form-text small mb-3 text-muted">
                        Monthly spending so far: @_monthlySpent.ToString("N0") /
                        @_monthlyLimit.Value.ToString("N0") MMK
                        (@((_monthlyLimit.Value - _monthlySpent).ToString("N0")) MMK remaining this month).
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Reason / Purpose</label>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_reason" placeholder="Describe what the budget is for…"></textarea>
                </div>

                @if (SelectedMethodRequiresAttachment)
                {
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Banking info <span class="text-danger">*</span>
                        </label>
                        <div class="form-text small mb-2">
                            The chosen withdraw method requires at least one banking-info file
                            (e.g. bank book photo, account details).
                        </div>
                        <AttachmentList BudgetRequestId="_request.Id"
                                        Attachments="_request.Attachments"
                                        Category="AttachmentCategory.WithdrawMethod"
                                        Editable="true"
                                        OnChanged="ReloadAsync" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Supporting documents</label>
                    <div class="form-text small mb-2">
                        Quotes, receipts, contracts — anything that supports the request.
                    </div>
                    <AttachmentList BudgetRequestId="_request.Id"
                                    Attachments="_request.Attachments"
                                    Category="AttachmentCategory.General"
                                    Editable="true"
                                    OnChanged="ReloadAsync" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Department Head (approver)</label>
                    <input class="form-control form-control-sm" value="@_deptHeadName" disabled />
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="allowsPartialEdit" @bind="_allowsPartial" />
                        <label class="form-check-label small" for="allowsPartialEdit">
                            Accept partial payment (installments)
                        </label>
                    </div>
                    @if (_allowsPartial)
                    {
                        <textarea class="form-control form-control-sm mt-2" rows="2" @bind="_partialDetail"
                                  placeholder="Preferred schedule or notes (optional)"></textarea>
                    }
                    else
                    {
                        <div class="form-text small">Finance must pay the full approved amount in one transaction.</div>
                    }
                </div>

                <hr class="my-3" />
                <p class="small text-muted mb-2">Withdrawer details (who will collect the money)</p>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Full Name</label>
                        <input class="form-control form-control-sm" @bind="_withdrawerName" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Job Title</label>
                        <input class="form-control form-control-sm" @bind="_withdrawerTitle" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Withdraw Method</label>
                    <select class="form-select form-select-sm" @bind="_withdrawMethodId">
                        <option value="">— select a method —</option>
                        @foreach (var m in _withdrawMethods)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </select>
                    @if (!_withdrawMethods.Any())
                    {
                        <div class="form-text small text-danger">
                            No active withdraw methods configured. Ask Finance or Admin to add one.
                        </div>
                    }
                </div>

            </div>
            <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
                <a href="requests/@Id" class="btn btn-sm btn-link text-muted">Cancel</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnSaveClicked(submit: false)" disabled="@_saving">
                    @if (_saving && !_submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @SaveLabel
                </button>
                <button class="btn btn-sm btn-primary" @onclick="() => OnSaveClicked(submit: true)" disabled="@_saving">
                    @if (_saving && _submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @SubmitLabel
                </button>
            </div>
        </div>
    }
</div>

@* ── Monthly overrun justification modal ────────────────────────────────────── *@
@if (_showOverrunModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Monthly limit overrun — justification required</h6>
                    <button class="btn-close" @onclick="CancelOverrunModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-3">
                        This request of <strong>@AmountInMmk.ToString("N0") MMK</strong> would bring
                        your department's monthly total to
                        <strong>@((_monthlySpent + AmountInMmk).ToString("N0")) MMK</strong>,
                        exceeding the configured monthly limit of
                        <strong>@_monthlyLimit!.Value.ToString("N0") MMK</strong>.
                    </p>
                    <label class="form-label small fw-semibold" for="overrunJustificationEdit">
                        Please justify why this overrun is necessary.
                    </label>
                    <textarea id="overrunJustificationEdit" class="form-control form-control-sm" rows="4"
                              @bind="_monthlyOverrunJustification" @bind:event="oninput"
                              placeholder="e.g. Quarter-end software license renewal that cannot be deferred…"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelOverrunModal" disabled="@_saving">Cancel</button>
                    <button class="btn btn-sm btn-primary"
                            @onclick="ConfirmOverrunAndSave"
                            disabled="@(_saving || string.IsNullOrWhiteSpace(_monthlyOverrunJustification))">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @ConfirmLabel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BudgetRequestDto? _request;
    private bool _loading = true;
    private string? _error;
    private bool _saving;
    private bool _submitting;

    // Form state
    private DateTime _requestDate = DateTime.Today;
    private BudgetRequestType _type = BudgetRequestType.Standard;
    private decimal _amount;
    private string _currencyCode = "MMK";
    private decimal _selectedRate = 1m;
    private decimal _systemRate = 1m;
    private List<CurrencyDto> _currencies = new();
    private List<WithdrawMethodDto> _withdrawMethods = new();
    private string _withdrawMethodId = "";
    private string _reason = "";
    private string _withdrawerName = "";
    private string _withdrawerTitle = "";
    private string _deptHeadName = "";
    private bool _allowsPartial;
    private string? _partialDetail;
    private string? _lastSendBackComment;

    // Monthly limit state
    private decimal? _monthlyLimit;
    private decimal _monthlySpent;
    private string _monthlyOverrunJustification = "";

    // Overrun modal state
    private bool _showOverrunModal;
    private bool _pendingSubmit;

    private string SaveLabel => _request?.Status == RequestStatus.SentBack ? "Save" : "Save Draft";
    private string SubmitLabel => _request?.Status == RequestStatus.SentBack ? "Save & Resubmit" : "Save & Submit";
    private string ConfirmLabel => _pendingSubmit
        ? (_request?.Status == RequestStatus.SentBack ? "Confirm and Resubmit" : "Confirm and Submit")
        : (_request?.Status == RequestStatus.SentBack ? "Confirm and Save" : "Confirm and Save Draft");

    private decimal AmountInMmk => _amount * _selectedRate;
    private bool WouldOverflowMonthly =>
        _monthlyLimit.HasValue && (_monthlySpent + AmountInMmk) > _monthlyLimit.Value;

    private bool SelectedMethodRequiresAttachment =>
        !string.IsNullOrEmpty(_withdrawMethodId)
        && _withdrawMethods.Any(m => m.Id.ToString() == _withdrawMethodId && m.RequiresAttachment);

    private bool HasBankingAttachment =>
        _request?.Attachments.Any(a => a.Category == AttachmentCategory.WithdrawMethod) == true;

    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsFailure) { _error = result.Error.Message; _loading = false; return; }

        _request = result.Value;

        // Only populate the form if the request is editable by this user; otherwise
        // the guard branches above handle it.
        if (_request.RequesterId == CurrentUser.UserId
            && _request.Status is RequestStatus.Draft or RequestStatus.SentBack)
        {
            _requestDate = _request.RequestDate;
            _type = _request.Type;
            _amount = _request.RequestedAmount;
            _currencyCode = _request.CurrencyCode;
            _reason = _request.Reasons;
            _withdrawerName = _request.WithdrawerName;
            _withdrawerTitle = _request.WithdrawerJobTitle;
            _allowsPartial = _request.AllowsPartialPayment;
            _partialDetail = _request.PartialPaymentDetail;
            _withdrawMethodId = _request.WithdrawMethodId?.ToString() ?? "";
            // Pre-fill justification from the saved draft so the user doesn't retype it.
            _monthlyOverrunJustification = _request.MonthlyOverrunJustification ?? "";

            // Load active currencies; include the draft's current code even if deactivated
            // so the selector reflects the saved state, but the submit-side handler will
            // still block submission against an inactive currency.
            var currenciesResult = await Mediator.Send(new ListCurrenciesQuery());
            if (currenciesResult.IsSuccess)
            {
                _currencies = currenciesResult.Value
                    .OrderBy(c => c.Code == "MMK" ? 0 : 1)
                    .ThenBy(c => c.Code)
                    .ToList();
                
                var match = _currencies.FirstOrDefault(c => c.Code == _currencyCode);
                _systemRate = match?.RateToMmk ?? 0m;
                _selectedRate = _request.ManualExchangeRate ?? _systemRate;
            }

            // Load active withdraw methods. If the draft references an inactive one,
            // clear the selection so the user is forced to pick a current method.
            var methodsResult = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: false));
            if (methodsResult.IsSuccess)
            {
                _withdrawMethods = methodsResult.Value.OrderBy(m => m.Name).ToList();
                if (!string.IsNullOrEmpty(_withdrawMethodId)
                    && !_withdrawMethods.Any(m => m.Id.ToString() == _withdrawMethodId))
                {
                    _withdrawMethodId = "";
                }
            }

            var headResult = await Mediator.Send(new GetUserQuery(_request.DeptHeadIdAtSubmission));
            if (headResult.IsSuccess) _deptHeadName = headResult.Value.FullName;

            // Pull current monthly position. Use the requester's CURRENT department
            // (CurrentUser.DepartmentId), matching Submit/Resubmit which always re-fetch
            // the current dept. If the user changed dept since first submission, the
            // monthly check applies to the new one — same rule the backend uses.
            var spendResult = await Mediator.Send(new GetMonthlySpendQuery(CurrentUser.DepartmentId));
            if (spendResult.IsSuccess)
            {
                _monthlyLimit = spendResult.Value.MonthlyLimit;
                _monthlySpent = spendResult.Value.SpentInMmk;
            }

            if (_request.Status == RequestStatus.SentBack)
            {
                _lastSendBackComment = _request.ApprovalActions
                    .Where(a => a.Decision == ApprovalDecision.SentBack)
                    .OrderByDescending(a => a.ActionedAt)
                    .Select(a => a.Comment)
                    .FirstOrDefault();
            }
        }

        _loading = false;
    }

    private void OnCurrencyChanged()
    {
        var match = _currencies.FirstOrDefault(c => c.Code == _currencyCode);
        _systemRate = match?.RateToMmk ?? 0m;
        _selectedRate = _systemRate;
    }

    private void OnTypeChanged()
    {
        if (_type == BudgetRequestType.Advance)
        {
            _selectedRate = _systemRate;
        }
    }

    private void OnAmountChanged() { }

    private async Task ReloadAsync()
    {
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsSuccess) { _request = result.Value; StateHasChanged(); }
    }

    private async Task OnSaveClicked(bool submit)
    {
        _error = null;
        if (!ValidateForm()) return;

        // Banking-attachment guard — only blocks Submit / Resubmit, not Save Draft.
        // The user can save partial work; only the submit transition needs the file.
        if (submit && SelectedMethodRequiresAttachment && !HasBankingAttachment)
        {
            _error = "This withdraw method requires a banking-info attachment. " +
                     "Upload at least one banking file before submitting.";
            return;
        }

        // Over monthly? Pop the justification modal and let the user fill it in.
        if (WouldOverflowMonthly)
        {
            _pendingSubmit = submit;
            _showOverrunModal = true;
            return;
        }

        await DoSave(submit);
    }

    private async Task ConfirmOverrunAndSave()
    {
        if (string.IsNullOrWhiteSpace(_monthlyOverrunJustification)) return;
        await DoSave(_pendingSubmit);
        if (string.IsNullOrEmpty(_error))
        {
            _showOverrunModal = false;
        }
    }

    private void CancelOverrunModal()
    {
        _showOverrunModal = false;
        // Intentionally keep _monthlyOverrunJustification so the user doesn't lose their text
        // if they re-open the modal.
    }

    private bool ValidateForm()
    {
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_currencyCode)) { _error = "Currency is required."; return false; }
        if (_selectedRate <= 0) { _error = "Exchange rate must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "Reason is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerName)) { _error = "Withdrawer name is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerTitle)) { _error = "Withdrawer job title is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawMethodId) || !Guid.TryParse(_withdrawMethodId, out _))
        { _error = "Withdraw method is required."; return false; }
        return true;
    }

    private async Task DoSave(bool submit)
    {
        if (_request is null) return;

        _saving = true;
        _submitting = submit;
        try
        {
            decimal? manualRate = (_type != BudgetRequestType.Advance && _selectedRate != _systemRate) 
                ? _selectedRate 
                : null;

            var updateResult = await Mediator.Send(new UpdateDraftCommand(
                BudgetRequestId: Id,
                RequesterId: CurrentUser.UserId,
                Type: _type,
                RequestDate: _requestDate,
                RequestedAmount: _amount,
                CurrencyCode: _currencyCode,
                Reasons: _reason,
                WithdrawerName: _withdrawerName,
                WithdrawerJobTitle: _withdrawerTitle,
                WithdrawMethodId: Guid.Parse(_withdrawMethodId),
                AllowsPartialPayment: _allowsPartial,
                PartialPaymentDetail: _allowsPartial ? _partialDetail : null,
                MonthlyOverrunJustification: string.IsNullOrWhiteSpace(_monthlyOverrunJustification)
                    ? null
                    : _monthlyOverrunJustification,
                ManualExchangeRate: manualRate));

            if (updateResult.IsFailure) { _error = updateResult.Error.Message; return; }

            if (submit)
            {
                // Draft -> SubmitRequest, SentBack -> ResubmitRequest
                if (_request.Status == RequestStatus.SentBack)
                {
                    var resubmit = await Mediator.Send(new ResubmitRequestCommand(Id, CurrentUser.UserId));
                    if (resubmit.IsFailure) { _error = resubmit.Error.Message; return; }
                }
                else
                {
                    var submitResult = await Mediator.Send(new SubmitRequestCommand(Id, CurrentUser.UserId));
                    if (submitResult.IsFailure) { _error = submitResult.Error.Message; return; }
                }
            }

            Nav.NavigateTo($"requests/{Id}");
        }
        finally { _saving = false; _submitting = false; }
    }
}
