@page "/requests/{Id:guid}/edit"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.UpdateDraft
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.ResubmitRequest
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Domain.Enums

<PageTitle>Edit Request</PageTitle>

<div class="container py-3" style="max-width:640px">

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border"></div></div>
    }
    else if (_request is null)
    {
        <div class="alert alert-warning">Request not found.</div>
        <a href="requests/mine" class="btn btn-sm btn-link">← Back to My Requests</a>
    }
    else if (_request.RequesterId != CurrentUser.UserId)
    {
        <div class="alert alert-danger">You can only edit your own requests.</div>
        <a href="requests/@Id" class="btn btn-sm btn-link">← Back to request</a>
    }
    else if (_request.Status is not RequestStatus.Draft and not RequestStatus.SentBack)
    {
        <div class="alert alert-warning">
            This request is no longer editable (status: <strong>@_request.Status</strong>).
        </div>
        <a href="requests/@Id" class="btn btn-sm btn-link">← Back to request</a>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">Edit Budget Request</h5>
            <a href="requests/@Id" class="text-muted small">← Back to detail</a>
        </div>

        @if (_request.Status == RequestStatus.SentBack && !string.IsNullOrEmpty(_lastSendBackComment))
        {
            <div class="alert alert-warning small">
                <strong>Sent back:</strong> @_lastSendBackComment
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Request Type</label>
                    <select class="form-select form-select-sm" @bind="_type">
                        <option value="@BudgetRequestType.Standard">Standard</option>
                        <option value="@BudgetRequestType.Urgent">Urgent</option>
                        <option value="@BudgetRequestType.ProjectProposal">Project Proposal</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Request Date</label>
                    <input class="form-control form-control-sm" type="date" @bind="_requestDate" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Amount (MMK)</label>
                    <input class="form-control form-control-sm" type="number" min="1" step="1000" @bind="_amount" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Reason / Purpose</label>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_reason" placeholder="Describe what the budget is for…"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Department Head (approver)</label>
                    <input class="form-control form-control-sm" value="@_deptHeadName" disabled />
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="allowsPartialEdit" @bind="_allowsPartial" />
                        <label class="form-check-label small" for="allowsPartialEdit">
                            Accept partial payment (installments)
                        </label>
                    </div>
                    @if (_allowsPartial)
                    {
                        <textarea class="form-control form-control-sm mt-2" rows="2" @bind="_partialDetail"
                                  placeholder="Preferred schedule or notes (optional)"></textarea>
                    }
                    else
                    {
                        <div class="form-text small">Finance must pay the full approved amount in one transaction.</div>
                    }
                </div>

                <hr class="my-3" />
                <p class="small text-muted mb-2">Withdrawer details (who will collect the money)</p>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Full Name</label>
                        <input class="form-control form-control-sm" @bind="_withdrawerName" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Job Title</label>
                        <input class="form-control form-control-sm" @bind="_withdrawerTitle" />
                    </div>
                </div>

            </div>
            <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
                <a href="requests/@Id" class="btn btn-sm btn-link text-muted">Cancel</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Save(submit: false)" disabled="@_saving">
                    @if (_saving && !_submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @SaveLabel
                </button>
                <button class="btn btn-sm btn-primary" @onclick="() => Save(submit: true)" disabled="@_saving">
                    @if (_saving && _submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @SubmitLabel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private BudgetRequestDto? _request;
    private bool _loading = true;
    private string? _error;
    private bool _saving;
    private bool _submitting;

    // Form state
    private DateTime _requestDate = DateTime.Today;
    private BudgetRequestType _type = BudgetRequestType.Standard;
    private decimal _amount;
    private string _reason = "";
    private string _withdrawerName = "";
    private string _withdrawerTitle = "";
    private string _deptHeadName = "";
    private bool _allowsPartial;
    private string? _partialDetail;
    private string? _lastSendBackComment;

    private string SaveLabel => _request?.Status == RequestStatus.SentBack ? "Save" : "Save Draft";
    private string SubmitLabel => _request?.Status == RequestStatus.SentBack ? "Save & Resubmit" : "Save & Submit";

    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsFailure) { _error = result.Error; _loading = false; return; }

        _request = result.Value;

        // Only populate the form if the request is editable by this user; otherwise
        // the guard branches above handle it.
        if (_request.RequesterId == CurrentUser.UserId
            && _request.Status is RequestStatus.Draft or RequestStatus.SentBack)
        {
            _requestDate = _request.RequestDate;
            _type = _request.Type;
            _amount = _request.RequestedAmount;
            _reason = _request.Reasons;
            _withdrawerName = _request.WithdrawerName;
            _withdrawerTitle = _request.WithdrawerJobTitle;
            _allowsPartial = _request.AllowsPartialPayment;
            _partialDetail = _request.PartialPaymentDetail;

            var headResult = await Mediator.Send(new GetUserQuery(_request.DeptHeadIdAtSubmission));
            if (headResult.IsSuccess) _deptHeadName = headResult.Value.FullName;

            if (_request.Status == RequestStatus.SentBack)
            {
                _lastSendBackComment = _request.ApprovalActions
                    .Where(a => a.Decision == ApprovalDecision.SentBack)
                    .OrderByDescending(a => a.ActionedAt)
                    .Select(a => a.Comment)
                    .FirstOrDefault();
            }
        }

        _loading = false;
    }

    private async Task Save(bool submit)
    {
        if (_request is null) return;

        _error = null;
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "Reason is required."; return; }
        if (string.IsNullOrWhiteSpace(_withdrawerName)) { _error = "Withdrawer name is required."; return; }
        if (string.IsNullOrWhiteSpace(_withdrawerTitle)) { _error = "Withdrawer job title is required."; return; }

        _saving = true;
        _submitting = submit;
        try
        {
            var updateResult = await Mediator.Send(new UpdateDraftCommand(
                BudgetRequestId: Id,
                RequesterId: CurrentUser.UserId,
                Type: _type,
                RequestDate: _requestDate,
                RequestedAmount: _amount,
                Reasons: _reason,
                WithdrawerName: _withdrawerName,
                WithdrawerJobTitle: _withdrawerTitle,
                AllowsPartialPayment: _allowsPartial,
                PartialPaymentDetail: _allowsPartial ? _partialDetail : null));

            if (updateResult.IsFailure) { _error = updateResult.Error; return; }

            if (submit)
            {
                // Draft -> SubmitRequest, SentBack -> ResubmitRequest
                if (_request.Status == RequestStatus.SentBack)
                {
                    var resubmit = await Mediator.Send(new ResubmitRequestCommand(Id, CurrentUser.UserId));
                    if (resubmit.IsFailure) { _error = resubmit.Error; return; }
                }
                else
                {
                    var submitResult = await Mediator.Send(new SubmitRequestCommand(Id, CurrentUser.UserId));
                    if (submitResult.IsFailure) { _error = submitResult.Error; return; }
                }
            }

            Nav.NavigateTo($"requests/{Id}");
        }
        finally { _saving = false; _submitting = false; }
    }
}
