@page "/requests/{Id:guid}/edit"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetMonthlySpend
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.ResubmitRequest
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Application.BudgetCategories.Queries
@using SureBudgetRequest.Domain.Enums
@using AttachmentCategory = SureBudgetRequest.Domain.Enums.AttachmentCategory
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Edit Request</PageTitle>

<div class="page-wrap" style="max-width:800px; margin: auto;">

    @if (_loading)
    {
        <div class="spinner-wrap"><div class="spinner"></div></div>
    }
    else if (_request is null)
    {
        <div class="alert alert-warning">Request not found.</div>
        <a href="requests/mine" class="btn btn-ghost btn-sm">← Back to My Requests</a>
    }
    else if (!(_request.RequesterId == CurrentUser.UserId || 
              (_request.Status == RequestStatus.PendingDeptHead && CurrentUser.Role == UserRole.DepartmentHead)))
    {
        <div class="alert alert-error">You are not authorized to edit this request.</div>
        <a href="requests/@Id" class="btn btn-ghost btn-sm">← Back to request</a>
    }
    else if (_request.Status is not RequestStatus.Draft and not RequestStatus.SentBack and not RequestStatus.PendingDeptHead)
    {
        <div class="alert alert-warning">
            This request is no longer editable (status: <strong>@_request.Status</strong>).
        </div>
        <a href="requests/@Id" class="btn btn-ghost btn-sm">← Back to request</a>
    }
    else
    {
        <div class="flex items-center justify-between mb-4">
            <a href="requests/@Id" class="text-muted text-sm">← Back to detail</a>
            <h5>
                @(_request.Status == RequestStatus.PendingDeptHead ? "Modify Budget Request" : "Edit Budget Request")
            </h5>
            <span class="text-muted text-sm font-mono">@_request.Reference</span>
        </div>

        @if (_request.Status == RequestStatus.SentBack && !string.IsNullOrEmpty(_lastSendBackComment))
        {
            <div class="alert alert-warning">
                <strong>Sent back:</strong> @_lastSendBackComment
            </div>
        }

        @if (WouldOverflowPeriod)
        {
            <div class="alert alert-warning">
                <span style="font-size:1.25rem; line-height:1">⚠</span>
                <div class="text-sm">
                    <strong>This request would push the department over its monthly limit.</strong>
                    <div class="mt-1">
                        This month: <strong>@_monthlySpent.ToString("N2")</strong> MMK used
                        of <strong>@_monthlyLimit.ToString("N2")</strong> MMK.
                        This request adds <strong>@AmountInMmk.ToString("N2")</strong> MMK
                        (total would be <strong>@((_monthlySpent + AmountInMmk).ToString("N2"))</strong> MMK).
                    </div>
                    <div class="mt-1 text-muted">
                        A written justification will be required when you save or submit.
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Request Type</label>
                    <select class="select" @bind="_type" @bind:after="OnTypeChanged">
                        <option value="@BudgetRequestType.Standard">Standard</option>
                        <option value="@BudgetRequestType.Urgent">Urgent</option>
                        <option value="@BudgetRequestType.ProjectProposal">Project Proposal</option>
                        <option value="@BudgetRequestType.Advance">Advance</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Request Date</label>
                    <input class="input" type="date" @bind="_requestDate" />
                </div>

                <div class="form-grid-2">
                    <div>
                        <label class="form-label text-sm font-semibold">Currency</label>
                        <select class="select" @bind="_currencyCode" @bind:after="OnCurrencyChanged">
                            @foreach (var c in _currencies)
                            {
                                <option value="@c.Code">@c.Code</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label text-sm font-semibold">Amount <span class="text-danger">*</span></label>
                        <input class="input @(ShowError("amount") ? "is-invalid" : null)" type="number" min="1" step="0.01"
                               @bind="_amount" @bind:after="OnAmountChanged"
                               @onfocusout="@(() => Touch("amount"))" />
                        @if (ShowError("amount"))
                        {
                            <div class="invalid-feedback">@FieldError("amount")</div>
                        }
                    </div>
                    </div>

                    @if (_currencyCode != "MMK")
                    {
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Exchange Rate (MMK per @_currencyCode) <span class="text-danger">*</span></label>
                        <input class="input @(ShowError("rate") ? "is-invalid" : null)" type="number" step="0.01"
                               @bind="_selectedRate" @bind:after="OnAmountChanged"
                               @onfocusout="@(() => Touch("rate"))" />
                        @if (ShowError("rate"))
                        {
                            <div class="invalid-feedback">@FieldError("rate")</div>
                        }
                        <div class="form-hint">Default system rate: @_systemRate.ToString("N2")</div>
                    </div>
                    }

                    <div class="form-text text-sm mb-4">
                    @if (_currencyCode == "MMK")
                    {
                        <span>Department limit comparison is in MMK.</span>
                    }
                    else if (_selectedRate > 0 && _amount > 0)
                    {
                        <span>
                            ≈ <strong>@((_amount * _selectedRate).ToString("N2"))</strong> MMK
                            <span class="text-muted">(at @_selectedRate.ToString("N2") MMK / @_currencyCode)</span>
                        </span>
                    }
                    else if (_selectedRate > 0)
                    {
                        <span class="text-muted">Current rate: 1 @_currencyCode = @_selectedRate.ToString("N2") MMK</span>
                    }
                    </div>
                @if (!WouldOverflowPeriod)
                {
                    <div class="form-text text-sm mb-4 text-muted">
                        This month's spending so far: @_monthlySpent.ToString("N2") /
                        @_monthlyLimit.ToString("N2") MMK
                        (@((_monthlyLimit - _monthlySpent).ToString("N2")) MMK remaining this month).
                    </div>
                }

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Reason / Purpose <span class="text-danger">*</span></label>
                    <textarea class="textarea @(ShowError("reason") ? "is-invalid" : null)" rows="3"
                              @bind="_reason" @onfocusout="@(() => Touch("reason"))"
                              placeholder="Describe what the budget is for…"></textarea>
                    @if (ShowError("reason"))
                    {
                        <div class="invalid-feedback">@FieldError("reason")</div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">External References</label>
                    <textarea class="textarea" rows="2"
                              @bind="_externalReferences"
                              placeholder="Optional — voucher / transaction numbers, related references…"></textarea>
                </div>

                @if (SelectedMethodRequiresAttachment)
                {
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Banking info <span class="text-danger">*</span>
                        </label>
                        <div class="form-text text-sm mb-2">
                            The chosen withdraw method requires at least one banking-info file
                            (e.g. bank book photo, account details).
                        </div>
                        <AttachmentList BudgetRequestId="_request.Id"
                                        Attachments="_request.Attachments"
                                        Category="AttachmentCategory.WithdrawMethod"
                                        Editable="true"
                                        OnChanged="ReloadAsync" />
                    </div>
                }

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Supporting documents</label>
                    <div class="form-text text-sm mb-2">
                        Quotes, receipts, contracts — anything that supports the request.
                    </div>
                    <AttachmentList BudgetRequestId="_request.Id"
                                    Attachments="_request.Attachments"
                                    Category="AttachmentCategory.General"
                                    Editable="true"
                                    OnChanged="ReloadAsync" />
                </div>
                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Department Head (approver)</label>
                    <input class="input" value="@_deptHeadName" disabled />
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="allowsPartialEdit" @bind="_allowsPartial" />
                        <label class="form-label" for="allowsPartialEdit">
                            Accept partial payment (installments)
                        </label>
                    </div>
                    @if (_allowsPartial)
                    {
                        <textarea class="textarea textarea-sm mt-2-form" rows="2" @bind="_partialDetail"
                                  placeholder="Preferred schedule or notes (optional)"></textarea>
                    }
                    else
                    {
                        <div class="form-hint">Finance must pay the full approved amount in one transaction.</div>
                    }
                </div>

                <hr class="my-3" />
                <p class="text-sm text-muted mb-2">Withdrawer details (who will collect the money)</p>

                <div class="form-grid-2 mb-4">
                    <div>
                        <label class="form-label text-sm font-semibold">Full Name <span class="text-danger">*</span></label>
                        <input class="input @(ShowError("withdrawerName") ? "is-invalid" : null)"
                               @bind="_withdrawerName" @onfocusout="@(() => Touch("withdrawerName"))" />
                        @if (ShowError("withdrawerName"))
                        {
                            <div class="invalid-feedback">@FieldError("withdrawerName")</div>
                        }
                    </div>
                    <div>
                        <label class="form-label text-sm font-semibold">Job Title <span class="text-danger">*</span></label>
                        <input class="input @(ShowError("withdrawerTitle") ? "is-invalid" : null)"
                               @bind="_withdrawerTitle" @onfocusout="@(() => Touch("withdrawerTitle"))" />
                        @if (ShowError("withdrawerTitle"))
                        {
                            <div class="invalid-feedback">@FieldError("withdrawerTitle")</div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Withdraw Method <span class="text-danger">*</span></label>
                    <select class="select @(ShowError("withdrawMethod") ? "is-invalid" : null)"
                            @bind="_withdrawMethodId" @onfocusout="@(() => Touch("withdrawMethod"))">
                        <option value="">— select a method —</option>
                        @foreach (var m in _withdrawMethods)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </select>
                    @if (ShowError("withdrawMethod"))
                    {
                        <div class="invalid-feedback">@FieldError("withdrawMethod")</div>
                    }
                    @if (!_withdrawMethods.Any())
                    {
                        <div class="form-text text-sm text-danger">
                            No active withdraw methods configured. Ask Finance or Admin to add one.
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label text-sm font-semibold">Budget Category <span class="text-muted fw-normal">(optional)</span></label>
                    <select class="select" @bind="_budgetCategoryId">
                        <option value="">— none —</option>
                        @foreach (var c in _budgetCategories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <div class="form-hint">e.g. Asset or Expense.</div>
                </div>

            </div>
            @if (IsDhModifying)
            {
                <div class="card-body border-top">
                    <label class="form-label text-sm font-semibold">Note (what did you change?)</label>
                    <textarea class="textarea textarea-sm" rows="2" @bind="_modificationNote"
                              placeholder="Optional — describe what you changed and why"></textarea>
                    <div class="form-hint">Saved to the modification history. Optional.</div>
                </div>
            }
            <div class="card-footer">
                <a href="requests/@Id" class="btn btn-ghost btn-sm">Cancel</a>

                @if (IsDhModifying)
                {
                    <button class="btn btn-primary btn-sm" @onclick="() => OnSaveClicked(submit: false)"
                            disabled="@(_saving || HasValidationErrors)">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        Update
                    </button>
                }
                else
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => OnSaveClicked(submit: false)"
                            disabled="@(_saving || HasValidationErrors)">
                        @if (_saving && !_submitting) { <span class="spinner spinner-sm mr-1"></span> }
                        @SaveLabel
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="() => OnSaveClicked(submit: true)"
                            title="@(SelectedMethodRequiresAttachment && !HasBankingAttachment ? "This withdraw method requires a banking-info attachment. Upload at least one banking file before submitting." : null)"
                            disabled="@(_saving || HasValidationErrors || (SelectedMethodRequiresAttachment && !HasBankingAttachment))">
                        @if (_saving && _submitting) { <span class="spinner spinner-sm mr-1"></span> }
                        @SubmitLabel
                    </button>
                }
            </div>
        </div>
    }
</div>

@* ── Monthly overrun justification modal ────────────────────────────────────── *@
@if (_showOverrunModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Budget limit overrun — justification required</h6>
                    <button class="btn btn-icon modal-close" @onclick="CancelOverrunModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm mb-4">
                        This request of <strong>@AmountInMmk.ToString("N2") MMK</strong> would bring
                        your department's monthly total to
                        <strong>@((_monthlySpent + AmountInMmk).ToString("N2")) MMK</strong>,
                        exceeding the monthly limit of
                        <strong>@_monthlyLimit.ToString("N2") MMK</strong>.
                    </p>
                    <label class="form-label text-sm font-semibold" for="overrunJustificationEdit">
                        Please justify why this overrun is necessary.
                    </label>
                    <textarea id="overrunJustificationEdit" class="textarea" rows="4"
                              @bind="_monthlyOverrunJustification" @bind:event="oninput"
                              placeholder="e.g. Quarter-end software license renewal that cannot be deferred…"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CancelOverrunModal" disabled="@_saving">Cancel</button>
                    <button class="btn btn-primary btn-sm"
                            @onclick="ConfirmOverrunAndSave"
                            disabled="@(_saving || string.IsNullOrWhiteSpace(_monthlyOverrunJustification))">
                        @if (_saving) { <span class="spinner spinner-sm mr-1"></span> }
                        @ConfirmLabel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Error modal ────────────────────────────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(_error))
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div>
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Something went wrong</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseErrorModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm">@_error</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary btn-sm" @onclick="CloseErrorModal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BudgetRequestDto? _request;
    private bool _loading = true;
    private string? _error;
    private bool _saving;
    private bool _submitting;

    // Form state
    private DateTime _requestDate = DateTime.Today;
    private BudgetRequestType _type = BudgetRequestType.Standard;
    private decimal _amount;
    private string _currencyCode = "MMK";
    private decimal _selectedRate = 1m;
    private decimal _systemRate = 1m;
    private List<CurrencyDto> _currencies = new();
    private List<WithdrawMethodDto> _withdrawMethods = new();
    private string _withdrawMethodId = "";
    private List<BudgetCategoryDto> _budgetCategories = new();
    private string _budgetCategoryId = "";
    private string _reason = "";
    private string _externalReferences = "";
    private string? _modificationNote;
    private string _withdrawerName = "";
    private string _withdrawerTitle = "";
    private string _deptHeadName = "";
    private bool _allowsPartial;
    private string? _partialDetail;
    private string? _lastSendBackComment;

    // Monthly spending cap state
    private decimal _monthlyLimit;
    private decimal _monthlySpent;
    private string _monthlyOverrunJustification = "";

    // Overrun modal state
    private bool _showOverrunModal;
    private bool _pendingSubmit;

    private bool IsDhModifying => 
        _request?.Status == RequestStatus.PendingDeptHead 
        && CurrentUser.Role == UserRole.DepartmentHead 
        && _request?.DeptHeadIdAtSubmission == CurrentUser.UserId;

    private string SaveLabel => _request?.Status == RequestStatus.SentBack ? "Save" : "Save Draft";
    private string SubmitLabel => _request?.Status == RequestStatus.SentBack ? "Save & Resubmit" : "Save & Submit";
    private string ConfirmLabel => IsDhModifying 
        ? "Confirm and Update"
        : (_pendingSubmit
            ? (_request?.Status == RequestStatus.SentBack ? "Confirm and Resubmit" : "Confirm and Submit")
            : (_request?.Status == RequestStatus.SentBack ? "Confirm and Save" : "Confirm and Save Draft"));

    private decimal AmountInMmk => _amount * _selectedRate;
    private bool WouldOverflowPeriod =>
        (_monthlySpent + AmountInMmk) > _monthlyLimit;

    private bool SelectedMethodRequiresAttachment =>
        !string.IsNullOrEmpty(_withdrawMethodId)
        && _withdrawMethods.Any(m => m.Id.ToString() == _withdrawMethodId && m.RequiresAttachment);

    private bool HasBankingAttachment =>
        _request?.Attachments.Any(a => a.Category == AttachmentCategory.WithdrawMethod) == true;

    // ── Field-level validation (messages appear only after a field is touched) ──
    private readonly HashSet<string> _touched = new();
    private static readonly string[] RequiredFields =
        { "amount", "rate", "reason", "withdrawerName", "withdrawerTitle", "withdrawMethod" };

    private void Touch(string field) => _touched.Add(field);
    private bool ShowError(string field) => _touched.Contains(field) && FieldError(field) is not null;

    private string? FieldError(string field) => field switch
    {
        "amount" => _amount <= 0 ? "Amount must be greater than zero." : null,
        "rate" => _currencyCode != "MMK" && _selectedRate <= 0
            ? "Exchange rate must be greater than zero." : null,
        "reason" => string.IsNullOrWhiteSpace(_reason) ? "Reason is required." : null,
        "withdrawerName" => string.IsNullOrWhiteSpace(_withdrawerName)
            ? "Withdrawer name is required." : null,
        "withdrawerTitle" => string.IsNullOrWhiteSpace(_withdrawerTitle)
            ? "Withdrawer job title is required." : null,
        "withdrawMethod" => string.IsNullOrWhiteSpace(_withdrawMethodId) || !Guid.TryParse(_withdrawMethodId, out _)
            ? "Withdraw method is required." : null,
        _ => null
    };

    private bool HasValidationErrors => RequiredFields.Any(f => FieldError(f) is not null);

    private void CloseErrorModal() => _error = null;

    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsFailure) { _error = result.Error.Message; _loading = false; return; }

        _request = result.Value;

        // Only populate the form if the request is editable by this user; otherwise
        // the guard branches above handle it.
        bool isRequesterEditing = _request.RequesterId == CurrentUser.UserId
            && _request.Status is RequestStatus.Draft or RequestStatus.SentBack;

        bool isDeptHeadModifying = _request.Status == RequestStatus.PendingDeptHead
            && CurrentUser.Role == UserRole.DepartmentHead
            && _request.DeptHeadIdAtSubmission == CurrentUser.UserId;

        if (isRequesterEditing || isDeptHeadModifying)
        {
            _requestDate = _request.RequestDate;
            _type = _request.Type;
            _amount = _request.RequestedAmount;
            _currencyCode = _request.CurrencyCode;
            _reason = _request.Reasons;
            _externalReferences = _request.ExternalReferences ?? "";
            _withdrawerName = _request.WithdrawerName;
            _withdrawerTitle = _request.WithdrawerJobTitle;
            _allowsPartial = _request.AllowsPartialPayment;
            _partialDetail = _request.PartialPaymentDetail;
            _withdrawMethodId = _request.WithdrawMethodId?.ToString() ?? "";
            _budgetCategoryId = _request.BudgetCategoryId?.ToString() ?? "";
            // Pre-fill justification from the saved draft so the user doesn't retype it.
            _monthlyOverrunJustification = _request.MonthlyOverrunJustification ?? "";

            // Load active currencies; include the draft's current code even if deactivated
            // so the selector reflects the saved state, but the submit-side handler will
            // still block submission against an inactive currency.
            var currenciesResult = await Mediator.Send(new ListCurrenciesQuery());
            if (currenciesResult.IsSuccess)
            {
                _currencies = currenciesResult.Value
                    .OrderBy(c => c.Code == "MMK" ? 0 : 1)
                    .ThenBy(c => c.Code)
                    .ToList();

                var match = _currencies.FirstOrDefault(c => c.Code == _currencyCode);
                _systemRate = match?.RateToMmk ?? 0m;
                _selectedRate = _request.ManualExchangeRate ?? _systemRate;
            }

            // Load active withdraw methods. If the draft references an inactive one,
            // clear the selection so the user is forced to pick a current method.
            var methodsResult = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: false));
            if (methodsResult.IsSuccess)
            {
                _withdrawMethods = methodsResult.Value.OrderBy(m => m.Name).ToList();
                if (!string.IsNullOrEmpty(_withdrawMethodId)
                    && !_withdrawMethods.Any(m => m.Id.ToString() == _withdrawMethodId))
                {
                    _withdrawMethodId = "";
                }
            }

            // Load active budget categories. If the request references an inactive
            // one, clear the selection so the editor must re-pick (or leave blank,
            // since the field is optional).
            var categoriesResult = await Mediator.Send(new ListBudgetCategoriesQuery(IncludeInactive: false));
            if (categoriesResult.IsSuccess)
            {
                _budgetCategories = categoriesResult.Value.OrderBy(c => c.Name).ToList();
                if (!string.IsNullOrEmpty(_budgetCategoryId)
                    && !_budgetCategories.Any(c => c.Id.ToString() == _budgetCategoryId))
                {
                    _budgetCategoryId = "";
                }
            }

            var headResult = await Mediator.Send(new GetUserQuery(_request.DeptHeadIdAtSubmission));
            if (headResult.IsSuccess) _deptHeadName = headResult.Value.FullName;

            // Pull the current monthly approved spend + the dept's cap. Uses the
            // requester's CURRENT department, matching Submit/Resubmit — same rule the backend uses.
            var spendResult = await Mediator.Send(new GetMonthlySpendQuery(CurrentUser.DepartmentId));
            if (spendResult.IsSuccess)
            {
                _monthlyLimit = spendResult.Value.EffectiveLimit;
                _monthlySpent = spendResult.Value.SpentInMmk;
            }

            if (_request.Status == RequestStatus.SentBack)
            {
                _lastSendBackComment = _request.ApprovalActions
                    .Where(a => a.Decision == ApprovalDecision.SentBack)
                    .OrderByDescending(a => a.ActionedAt)
                    .Select(a => a.Comment)
                    .FirstOrDefault();
            }
        }

        _loading = false;
    }

    private void OnCurrencyChanged()
    {
        var match = _currencies.FirstOrDefault(c => c.Code == _currencyCode);
        _systemRate = match?.RateToMmk ?? 0m;
        _selectedRate = _systemRate;
    }

    // No-op — Advance requests may now use a manual rate, so type changes no longer reset the rate.
    private void OnTypeChanged() { }

    private void OnAmountChanged() { }

    private async Task ReloadAsync()
    {
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsSuccess) { _request = result.Value; StateHasChanged(); }
    }

    private async Task OnSaveClicked(bool submit)
    {
        _error = null;
        if (!ValidateForm()) return;

        // Banking-attachment guard — only blocks Submit / Resubmit, not Save Draft.
        // The user can save partial work; only the submit transition needs the file.
        if (submit && SelectedMethodRequiresAttachment && !HasBankingAttachment)
        {
            _error = "This withdraw method requires a banking-info attachment. " +
                     "Upload at least one banking file before submitting.";
            return;
        }

        // Over monthly? Pop the justification modal and let the user fill it in.
        if (WouldOverflowPeriod)
        {
            _pendingSubmit = submit;
            _showOverrunModal = true;
            return;
        }

        await DoSave(submit);
    }

    private async Task ConfirmOverrunAndSave()
    {
        if (string.IsNullOrWhiteSpace(_monthlyOverrunJustification)) return;
        await DoSave(_pendingSubmit);
        if (string.IsNullOrEmpty(_error))
        {
            _showOverrunModal = false;
        }
    }

    private void CancelOverrunModal()
    {
        _showOverrunModal = false;
        // Intentionally keep _monthlyOverrunJustification so the user doesn't lose their text
        // if they re-open the modal.
    }

    private bool ValidateForm()
    {
        // Buttons are disabled while errors exist, but keep this as a safety net.
        foreach (var f in RequiredFields) _touched.Add(f);
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_currencyCode)) { _error = "Currency is required."; return false; }
        if (_selectedRate <= 0) { _error = "Exchange rate must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "Reason is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerName)) { _error = "Withdrawer name is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerTitle)) { _error = "Withdrawer job title is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawMethodId) || !Guid.TryParse(_withdrawMethodId, out _))
        { _error = "Withdraw method is required."; return false; }
        return true;
    }

    private async Task DoSave(bool submit)
    {
        if (_request is null) return;

        if (_saving) return;
        _saving = true;
        _submitting = submit;
        try
        {
            decimal? manualRate = (_selectedRate != _systemRate) 
                ? _selectedRate 
                : null;

            var updateResult = await Mediator.Send(new Application.BudgetRequests.Commands.UpdateBudgetRequest.UpdateBudgetRequestCommand(
                BudgetRequestId: Id,
                ActorId: CurrentUser.UserId,
                Type: _type,
                RequestDate: _requestDate,
                RequestedAmount: _amount,
                CurrencyCode: _currencyCode,
                Reasons: _reason,
                WithdrawerName: _withdrawerName,
                WithdrawerJobTitle: _withdrawerTitle,
                WithdrawMethodId: Guid.Parse(_withdrawMethodId),
                AllowsPartialPayment: _allowsPartial,
                PartialPaymentDetail: _allowsPartial ? _partialDetail : null,
                MonthlyOverrunJustification: string.IsNullOrWhiteSpace(_monthlyOverrunJustification)
                    ? null
                    : _monthlyOverrunJustification,
                ManualExchangeRate: manualRate,
                BudgetCategoryId: string.IsNullOrEmpty(_budgetCategoryId)
                    ? (Guid?)null
                    : Guid.Parse(_budgetCategoryId),
                Note: IsDhModifying ? _modificationNote : null,
                ExternalReferences: string.IsNullOrWhiteSpace(_externalReferences)
                    ? null
                    : _externalReferences));

            if (updateResult.IsFailure) { _error = updateResult.Error.Message; return; }

            if (submit)
            {
                // Draft -> SubmitRequest, SentBack -> ResubmitRequest
                if (_request.Status == RequestStatus.SentBack)
                {
                    var resubmit = await Mediator.Send(new ResubmitRequestCommand(Id, CurrentUser.UserId));
                    if (resubmit.IsFailure) { _error = resubmit.Error.Message; return; }
                }
                else
                {
                    var submitResult = await Mediator.Send(new SubmitRequestCommand(Id, CurrentUser.UserId));
                    if (submitResult.IsFailure) { _error = submitResult.Error.Message; return; }
                }
            }

            Nav.NavigateTo($"requests/{Id}");
        }
        finally { _saving = false; _submitting = false; }
    }
}
