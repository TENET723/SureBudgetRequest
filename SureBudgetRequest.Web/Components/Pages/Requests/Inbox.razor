    private bool CanUserAttachTag(BudgetRequestSummaryDto r)
    {
        var role = CurrentUser.Role;
        if (role == UserRole.Admin) return true;
        if (role is UserRole.Finance or UserRole.Management or UserRole.Accounting) return true;
        if (CurrentUser.IsDepartmentHead)
        {
            if (r.DepartmentIdAtSubmission != Guid.Empty && r.DepartmentIdAtSubmission == CurrentUser.DepartmentId)
                return true;
            if (r.DeptHeadIdAtSubmission == CurrentUser.UserId)
                return true;
        }
        if (r.RequesterId == CurrentUser.UserId) return true;
        return false;
    }

