@page "/requests/inbox"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>Inbox</PageTitle>

<div class="page-wrap">
    <h5 class="mb-4">Inbox</h5>

    @if (CurrentUser.Role == UserRole.Employee)
    {
        <div class="alert alert-info">You have no inbox as an employee. <a href="requests/mine">View your requests instead.</a></div>
    }
    else if (CurrentUser.Role == UserRole.Finance && !CurrentUser.IsFinanceApprover)
    {
        <div class="alert alert-info">
            As a Finance Payer your job is recording payments, not approving requests.
            <a href="requests/outstanding">Open the Outstanding Payments queue instead.</a>
        </div>
    }
    else
    {
        @* View toggle — Finance approvers also chase overdue advance reconciliations. *@
        @if (ShowOverdueToggle)
        {
            <div class="btn-group btn-group-sm mb-4" role="group">
                <button class="btn @(_view == "inbox" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => SwitchView("inbox")'>
                    Pending Finance
                </button>
                <button class="btn @(_view == "overdue" ? "btn-danger" : "btn-outline-danger")"
                        @onclick='() => SwitchView("overdue")'>
                    Overdue advances
                </button>
            </div>
        }

        @* ─── Toolbar: search + filter toggle + result count ──────────────── *@
        <div class="flex items-center gap-2 mb-2 flex-wrap">
            <ListSearchBox @bind-Value="_search" OnEnter="Apply"
                           Placeholder="Search reference, reason, or requester" Width="320px" />

            <button type="button" class="btn btn-outline btn-sm" @onclick="ToggleFilters">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Filter
                @if (ActiveFilterCount > 0)
                {
                    <span class="topbar-count-badge ml-1">@ActiveFilterCount</span>
                }
            </button>

            @if (!_loading)
            {
                <span class="text-muted text-sm ml-auto">
                    @(_result?.TotalCount ?? 0) result@((_result?.TotalCount ?? 0) == 1 ? "" : "s")
                </span>
            }
        </div>

        @* ─── Filter modal (same pattern as the budget-request report page) ── *@
        @if (_showFilters)
        {
            <div class="modal-backdrop">
                <div class="modal modal-lg">
                    <div class="modal-header">
                        <h6 class="modal-title">Filter</h6>
                        <button class="btn btn-icon modal-close" @onclick="() => _showFilters = false">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                <div class="form-grid-3">

                    @* Department — privileged roles only; Dept Head's queue stays
                       locked to their own dept (no dropdown). *@
                    @if (SeesAllDepartments)
                    {
                        <div>
                            <label class="form-label text-sm text-muted mb-1">Department</label>
                            <select class="select" @bind="_selectedDepartmentId">
                                <option value="">All departments</option>
                                @foreach (var d in _departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                    }

                    @* Date range *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                        <input type="date" class="input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                        <input type="date" class="input" @bind="_toDate" />
                    </div>

                    @* Amount range (MMK) — inclusive bounds on the MMK-at-submission amount *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount from (MMK)</label>
                        <input type="number" step="any" min="0" class="input"
                               placeholder="No minimum" @bind="_amountMmkFrom" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount to (MMK)</label>
                        <input type="number" step="any" min="0" class="input"
                               placeholder="No maximum" @bind="_amountMmkTo" />
                    </div>

                    @* Type — multi-select via checkboxes *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Type</label>
                        <div class="flex gap-3">
                            @foreach (var t in AllTypes)
                            {
                                var type = t;
                                <label class="form-check text-sm ">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@_selectedTypes.Contains(type)"
                                           @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                    <span class="form-check-label">@TypeLabel(type)</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline btn-sm" @onclick="Clear" disabled="@_loading">Clear</button>
                        <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                            @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="text-center "><div class="spinner spinner-sm"></div></div>
        }
        else
        {
            <p class="text-muted text-sm mb-4">@InboxDescription()</p>

            <div class="table-wrapper">
                <table class="data-table">
                    <thead >
                        <tr>
                            <th class="col-no">#</th>
                            <th>Date</th>
                            <th>Requester</th>
                            <th>Reason</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>@(_view == "overdue" ? "Deadline" : "Submitted")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Items.Count; i++)
                        {
                            var r = Items[i];
                            var rowNo = ((_result?.Page ?? 1) - 1) * (_result?.PageSize ?? 0) + i + 1;
                            <tr>
                                <td class="text-muted text-sm">@rowNo</td>
                                <td class="text-sm">@r.RequestDate.ToString("dd MMM yyyy")</td>
                                <td class="text-sm">@r.RequesterName</td>
                                <td>@Truncate(r.Reasons, 45)</td>
                                <td class="text-end">
                                    @r.RequestedAmount.ToString("N2") <span class="text-muted text-sm">@r.CurrencyCode</span>
                                    @if (r.CurrencyCode != "MMK" && r.RequestedAmountInMmkAtSubmission > 0)
                                    {
                                        <div class="text-sm text-muted">≈ @r.RequestedAmountInMmkAtSubmission.ToString("N2") MMK</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                    <MonthlyLimitBadge MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                </td>
                                <td class="text-sm @(_view == "overdue" ? "text-danger font-semibold" : "text-muted")">
                                    @if (_view == "overdue")
                                    {
                                        @(r.ReconciliationDeadline?.ToString("dd MMM yyyy"))
                                    }
                                    else
                                    {
                                        @TimeDisplay.Mm(r.SubmittedAt)
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="requests/@r.Id" class="btn btn-icon " title="Review"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32"><path d="M0 0h32v32H0z" fill="none"/><circle cx="16" cy="16" r="4" fill="currentColor"/><path fill="currentColor" d="M30.94 15.66A16.69 16.69 0 0 0 16 5A16.69 16.69 0 0 0 1.06 15.66a1 1 0 0 0 0 .68A16.69 16.69 0 0 0 16 27a16.69 16.69 0 0 0 14.94-10.66a1 1 0 0 0 0-.68M16 22.5a6.5 6.5 0 1 1 6.5-6.5a6.51 6.51 0 0 1-6.5 6.5"/></svg></a>
                                </td>
                            </tr>
                        }
                        @if (!Items.Any())
                        {
                            @if (_appliedHasFilters)
                            {
                                <tr><td colspan="8" class="text-center text-muted ">No requests match your search/filters.</td></tr>
                            }
                            else
                            {
                                <tr><td colspan="8" class="text-center text-muted ">@EmptyText()</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* ─── Pager (same pattern as MyRequests / the report page) ──────── *@
            <div class="flex items-center justify-between mt-2">
                <span class="text-sm text-muted">@(_result?.TotalCount ?? 0) request(s)</span>
                <div class="flex items-center gap-2">
                    <label class="text-sm text-muted ">Page size</label>
                    <select class="select" style="width:auto" @bind="_pageSize" @bind:after="() => LoadPageAsync(1)">
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(!(_result?.HasPrev ?? false))"
                            @onclick="() => LoadPageAsync(_currentPage - 1)">Prev</button>
                    <span class="text-sm">Page @(_result?.Page ?? 1) of @(_result?.TotalPages ?? 1)</span>
                    <button class="btn btn-outline btn-sm"
                            disabled="@(!(_result?.HasNext ?? false))"
                            @onclick="() => LoadPageAsync(_currentPage + 1)">Next</button>
                </div>
            </div>
        }
    }
</div>

@code {
    // The four request types, in enum order, for the Type multi-select.
    private static readonly BudgetRequestType[] AllTypes =
    {
        BudgetRequestType.Urgent,
        BudgetRequestType.Standard,
        BudgetRequestType.ProjectProposal,
        BudgetRequestType.Advance,
    };

    private PagedResult<BudgetRequestSummaryDto>? _result;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private bool _loading = true;
    private string _view = "inbox";   // "inbox" | "overdue"

    private IReadOnlyList<BudgetRequestSummaryDto> Items =>
        _result?.Items ?? Array.Empty<BudgetRequestSummaryDto>();

    // ── Reference data for the filter dropdowns ──────────────────────────────
    private List<DepartmentDto> _departments = new();

    // ── Staged filter state ──────────────────────────────────────────────────
    // Filters are staged here and only flow into the query on Apply / Clear.
    private string _search = "";
    private string _selectedDepartmentId = "";   // privileged roles only
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private decimal? _amountMmkFrom;
    private decimal? _amountMmkTo;
    private HashSet<BudgetRequestType> _selectedTypes = new();

    private bool _showFilters;

    // Whether the currently-displayed result set carried any filter — drives the
    // empty-state message ("nothing matches" vs the 🎉 EmptyText).
    private bool _appliedHasFilters;

    private bool ShowOverdueToggle =>
        CurrentUser.Role == UserRole.Finance && CurrentUser.IsFinanceApprover;

    // Roles whose queue spans departments and so get a Department dropdown
    // (Dept Head stays locked to their own dept; Employee/Accounting never reach here).
    private bool SeesAllDepartments =>
        CurrentUser.Role is UserRole.Management
                         or UserRole.Finance
                         or UserRole.Admin;

    // Count of active staged filters, shown as a badge on the Filters toggle.
    private int ActiveFilterCount
    {
        get
        {
            var n = 0;
            if (!string.IsNullOrWhiteSpace(_search)) n++;
            if (SeesAllDepartments && !string.IsNullOrEmpty(_selectedDepartmentId)) n++;
            if (_fromDate.HasValue) n++;
            if (_toDate.HasValue) n++;
            if (_amountMmkFrom.HasValue) n++;
            if (_amountMmkTo.HasValue) n++;
            if (_selectedTypes.Count > 0) n++;
            return n;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The Inbox is an action queue (approve / reject / process). The read-only
        // Accounting role must never reach it — bounce them to the dashboard.
        if (CurrentUser.Role == UserRole.Accounting)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        await LoadReferenceDataAsync();
        await LoadPageAsync(1);
    }

    private async Task LoadReferenceDataAsync()
    {
        // Departments — only needed for the privileged-role dropdown. Mirror the
        // Report/Outstanding pages: load all, show only active ones.
        if (SeesAllDepartments)
        {
            var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
            if (depts.IsSuccess)
                _departments = depts.Value!.Where(d => d.IsActive).OrderBy(d => d.Name).ToList();
        }
    }

    private void ToggleFilters() => _showFilters = !_showFilters;

    private void ToggleType(BudgetRequestType t, bool isChecked)
    {
        if (isChecked) _selectedTypes.Add(t);
        else _selectedTypes.Remove(t);
    }

    private async Task Apply() => await LoadPageAsync(1);

    private async Task ApplyAndClose()
    {
        _showFilters = false;
        await LoadPageAsync(1);
    }

    private async Task Clear()
    {
        _search = "";
        _fromDate = null;
        _toDate = null;
        _amountMmkFrom = null;
        _amountMmkTo = null;
        _selectedTypes.Clear();

        // Dept Heads have no dropdown; privileged roles reset to "All departments".
        if (SeesAllDepartments)
            _selectedDepartmentId = "";

        await LoadPageAsync(1);
    }

    private async Task SwitchView(string view)
    {
        if (_view == view) return;
        _view = view;
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        _loading = true;

        if (CurrentUser.Role == UserRole.Employee) { _loading = false; return; }

        // Payer-only Finance users have no inbox — they work from Outstanding Payments.
        if (CurrentUser.Role == UserRole.Finance && !CurrentUser.IsFinanceApprover)
        {
            _loading = false;
            return;
        }

        // ── Staged filters, resolved once and shared by both branches ─────────
        var term = string.IsNullOrWhiteSpace(_search) ? null : _search;

        IReadOnlyCollection<BudgetRequestType>? types =
            _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null;

        // Amount range — inclusive bounds; a reversed range (from > to) is ignored.
        decimal? amountFrom = _amountMmkFrom;
        decimal? amountTo = _amountMmkTo;
        if (amountFrom.HasValue && amountTo.HasValue && amountFrom.Value > amountTo.Value)
        {
            amountFrom = null;
            amountTo = null;
        }

        // Date bounds: lower inclusive midnight UTC; upper = NEXT day's midnight
        // (exclusive) so the whole "to" day is included. Reversed range ignored.
        DateTime? fromUtc = _fromDate.HasValue
            ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
            : null;
        DateTime? untilUtc = _toDate.HasValue
            ? DateTime.SpecifyKind(_toDate.Value.Date, DateTimeKind.Utc).AddDays(1)
            : null;
        if (fromUtc.HasValue && untilUtc.HasValue && fromUtc.Value >= untilUtc.Value)
        {
            fromUtc = null;
            untilUtc = null;
        }

        // Department: Dept Head is forced to their own dept; privileged roles use
        // the dropdown; everyone else is unscoped.
        Guid? deptFilter;
        if (CurrentUser.Role == UserRole.DepartmentHead)
            deptFilter = CurrentUser.DepartmentId;
        else if (SeesAllDepartments)
            deptFilter = ParseGuid(_selectedDepartmentId);
        else
            deptFilter = null;

        _appliedHasFilters = term is not null
            || types is not null
            || amountFrom.HasValue
            || amountTo.HasValue
            || fromUtc.HasValue
            || untilUtc.HasValue
            || (SeesAllDepartments && !string.IsNullOrEmpty(_selectedDepartmentId));

        if (_view == "overdue")
        {
            // Overdue advances: the OverdueAdvanceOnly filter is the DB-side
            // equivalent of the old in-memory IsOverdueAdvance check, so the
            // page and total count are both computed server-side. Sorted by
            // deadline ascending — most-overdue first (same order as before).
            var overdue = await Mediator.Send(new SearchBudgetRequestsQuery(
                DepartmentId: deptFilter,
                Status: RequestStatus.PendingReconciliation,
                SubmittedFromUtc: fromUtc,
                SubmittedUntilUtc: untilUtc,
                Types: types,
                AmountInMmkFrom: amountFrom,
                AmountInMmkTo: amountTo,
                SearchTerm: term,
                OverdueAdvanceOnly: true,
                SortBy: BudgetRequestSortBy.ReconciliationDeadline,
                SortDescending: false,
                Page: page,
                PageSize: _pageSize));

            if (overdue.IsSuccess)
            {
                _result = overdue.Value;
                _currentPage = _result.Page;
            }
            else
            {
                _result = null;
            }
        }
        else
        {
            var statusFilter = CurrentUser.Role switch
            {
                UserRole.DepartmentHead => RequestStatus.PendingDeptHead,
                UserRole.Management     => RequestStatus.PendingManagement,
                UserRole.Finance        => RequestStatus.PendingFinance,
                _                       => (RequestStatus?)null
            };

            // Oldest-submitted first — same order as before, now applied in SQL.
            var result = await Mediator.Send(new SearchBudgetRequestsQuery(
                DepartmentId: deptFilter,
                Status: statusFilter,
                SubmittedFromUtc: fromUtc,
                SubmittedUntilUtc: untilUtc,
                Types: types,
                AmountInMmkFrom: amountFrom,
                AmountInMmkTo: amountTo,
                SearchTerm: term,
                SortBy: BudgetRequestSortBy.SubmittedAt,
                SortDescending: false,
                Page: page,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _result = result.Value;
                _currentPage = _result.Page;
            }
            else
            {
                _result = null;
            }
        }

        _loading = false;
    }

    private string InboxDescription() => _view == "overdue"
        ? "Advance requests whose reconciliation deadline has already passed."
        : CurrentUser.Role switch
        {
            UserRole.DepartmentHead => "Requests from your department awaiting your approval.",
            UserRole.Management     => "Over-limit requests awaiting Management Team approval.",
            UserRole.Finance        => "Requests awaiting finance processing.",
            UserRole.Admin          => "All pending requests.",
            _                       => ""
        };

    private string EmptyText() => _view == "overdue"
        ? "No overdue advances. 🎉"
        : "Your inbox is empty. 🎉";

    private static Guid? ParseGuid(string s) =>
        Guid.TryParse(s, out var g) ? g : null;

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "Urgent",
        BudgetRequestType.Standard        => "Standard",
        BudgetRequestType.ProjectProposal => "Project Proposal",
        BudgetRequestType.Advance         => "Advance",
        _                                 => t.ToString()
    };

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.PendingDeptHead       => "Pending Head",
        RequestStatus.PendingManagement     => "Pending Management",
        RequestStatus.PendingFinance        => "Pending Finance",
        RequestStatus.PendingReconciliation => "Pending Reconciliation",
        RequestStatus.AwaitingRefund        => "Awaiting Refund",
        RequestStatus.AwaitingReimbursement => "Awaiting Reimb.",
        RequestStatus.Reconciled            => "Reconciled",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft => "badge-draft",
        RequestStatus.PendingDeptHead or RequestStatus.PendingManagement
            or RequestStatus.PendingFinance or RequestStatus.PendingReconciliation
            or RequestStatus.AwaitingRefund => "badge-warning",
        RequestStatus.SentBack or RequestStatus.AwaitingReimbursement => "badge-info",
        RequestStatus.Approved or RequestStatus.PartiallyPaid => "badge-approved",
        RequestStatus.Reconciled or RequestStatus.Paid => "badge-paid",
        RequestStatus.Rejected => "badge-rejected",
        RequestStatus.Cancelled => "badge-inactive",
        _ => "badge-draft"
    };
}
