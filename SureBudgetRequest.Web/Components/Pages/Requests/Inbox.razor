        _quickActionError = null;
    }

    private async Task ExecuteQuickModalActionAsync()
    {
        if (_quickActionTarget == null || _quickActionProcessing) return;
        var target = _quickActionTarget;

        if (_quickActionType == QuickActionType.SendBack)
        {
            if (string.IsNullOrWhiteSpace(_quickActionComment))
            {
                _quickActionError = "Comments are mandatory for audit trail when sending back a request.";
                return;
            }

            _quickActionProcessing = true;
            try
            {
                var cmd = new SendBackRequestCommand(target.Id, CurrentUser.UserId, _quickActionComment.Trim());
                var res = await Mediator.Send(cmd);
                if (res.IsSuccess)
                {
                    CloseQuickActionModal();
                    ShowToast($"Sent back {target.Reference ?? "request"}");
                    await LoadPageAsync(_currentPage);
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.Reject)
        {
            if (string.IsNullOrWhiteSpace(_quickActionComment))
            {
                _quickActionError = "Rejection reason is required.";
                return;
            }

            _quickActionProcessing = true;
            try
            {
                var cmd = new RejectRequestCommand(target.Id, CurrentUser.UserId, _quickActionComment.Trim());
                var res = await Mediator.Send(cmd);
                if (res.IsSuccess)
                {
                    CloseQuickActionModal();
                    ShowToast($"Rejected {target.Reference ?? "request"}");
                    await LoadPageAsync(_currentPage);
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.FinanceApprove)
        {
            if (string.IsNullOrWhiteSpace(_quickFinanceCoaId) || !Guid.TryParse(_quickFinanceCoaId, out var coaGuid))
            {
                _quickActionError = "Please select a Chart of Account.";
                return;
            }

            DateTime? deadlineUtc = null;
            if (target.Type == BudgetRequestType.Advance)
            {
                if (_quickFinanceReconciliationDeadline == default)
                {
                    _quickActionError = "Please select a reconciliation deadline.";
                    return;
                }
                deadlineUtc = DateTime.SpecifyKind(_quickFinanceReconciliationDeadline, DateTimeKind.Utc);
            }

            _quickActionProcessing = true;
            try
            {
                var cmd = new ApproveRequestCommand(target.Id, CurrentUser.UserId, coaGuid, deadlineUtc);
                var res = await Mediator.Send(cmd);
                if (res.IsSuccess)
                {
                    CloseQuickActionModal();
                    ShowToast($"Approved {target.Reference ?? "request"}");
                    await LoadPageAsync(_currentPage);
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.UndoApprove)
        {
            _quickActionProcessing = true;
            try
            {
                var cmd = new UndoApprovalCommand(target.Id, CurrentUser.UserId, string.IsNullOrWhiteSpace(_quickActionComment) ? null : _quickActionComment.Trim());
                var res = await Mediator.Send(cmd);
                if (res.IsSuccess)
                {
                    CloseQuickActionModal();
                    ShowToast($"Undid approval for {target.Reference ?? "request"}");
                    await LoadPageAsync(_currentPage);
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.UndoSubmit)
        {
            _quickActionProcessing = true;
            try
            {
                var cmd = new UndoSubmitCommand(target.Id, CurrentUser.UserId);
                var res = await Mediator.Send(cmd);
                if (res.IsSuccess)
                {
                    CloseQuickActionModal();
                    ShowToast($"Withdrew {target.Reference ?? "request"} to draft");
                    await LoadPageAsync(_currentPage);
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
    }

    private BudgetRequestSummaryDto? _withdrawingReconciliationRequest;
    private BudgetRequestSummaryDto? _undoingRefundRequest;

    private bool CanWithdrawReconciliation(BudgetRequestSummaryDto? r) =>
        r != null
        && r.Type == BudgetRequestType.Advance
        && (CurrentUser.Role is UserRole.Finance or UserRole.Admin)
        && (r.Status == RequestStatus.AwaitingRefund || (r.Status == RequestStatus.Reconciled && !r.RefundReceivedAt.HasValue));

    private bool CanUndoRefund(BudgetRequestSummaryDto? r) =>
        r != null
        && r.Type == BudgetRequestType.Advance
        && r.Status == RequestStatus.Reconciled
        && r.RefundReceivedAt.HasValue
        && CurrentUser.Role == UserRole.Finance;

    private void PromptUndoReconciliationFromContextMenu(BudgetRequestSummaryDto r)
    {
        CloseContextMenu();
        _withdrawingReconciliationRequest = r;
    }

    private void PromptUndoRefundFromContextMenu(BudgetRequestSummaryDto r)
    {
        CloseContextMenu();
        _undoingRefundRequest = r;
    }

    private async Task DoUndoReconciliationSubmit()
    {
        if (_withdrawingReconciliationRequest is null || _quickActionProcessing) return;
        _quickActionProcessing = true;
        var target = _withdrawingReconciliationRequest;
        try
        {
            var result = await Mediator.Send(new UndoReconciliationSubmitCommand(target.Id, CurrentUser.UserId));
            _withdrawingReconciliationRequest = null;
            if (result.IsFailure)
            {
                ShowToast($"Error: {result.Error.Message}");
            }
            else
            {
                ShowToast($"Reconciliation for {target.Reference ?? "advance"} returned to pending");
                await LoadPageAsync(_currentPage);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}");
        }
        finally
        {
            _quickActionProcessing = false;
        }
    }

    private async Task DoUndoRefund()
    {
        if (_undoingRefundRequest is null || _quickActionProcessing) return;
        _quickActionProcessing = true;
        var target = _undoingRefundRequest;
        try
        {
            var result = await Mediator.Send(new UndoRefundCommand(target.Id, CurrentUser.UserId));
            _undoingRefundRequest = null;
            if (result.IsFailure)
            {
                ShowToast($"Error: {result.Error.Message}");
            }
            else
            {
                ShowToast($"Refund for {target.Reference ?? "advance"} undone");
                await LoadPageAsync(_currentPage);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}");
        }
        finally
        {
            _quickActionProcessing = false;
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _showToast = true;
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500, token);
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    _showToast = false;
                    StateHasChanged();
                });
            }
        });
        StateHasChanged();
    }
