    private async Task DoSaveUsage()
    {
        if (_request is null) return;
        _usageError = null;

        if (_usageAmount <= 0) { _usageError = "Amount must be greater than zero."; return; }
        if (string.IsNullOrWhiteSpace(_usageDescription)) { _usageError = "Description is required."; return; }
        // No cap: over-spending the advance is permitted and resolves to a
        // reimbursement at reconciliation-submit time.

        _usageBusy = true;
        try
        {
            // Resolve the receipt attachment: a newly chosen file is uploaded
            // first; otherwise keep whatever the row already had (null when adding).
            Guid? attachmentId = _usageExistingAttachmentId;
            if (_usageReceiptFile is not null)
            {
                if (_usageReceiptFile.Size > AttachmentConstraints.MaxBytes)
                {
                    _usageError = $"Receipt is larger than {AttachmentConstraints.MaxBytes / (1024 * 1024)} MB.";
                    return;
                }
                if (!AttachmentConstraints.IsAllowedContentType(_usageReceiptFile.ContentType))
                {
                    _usageError = $"Receipt file type '{_usageReceiptFile.ContentType}' is not allowed.";
                    return;
                }

                await using var stream = _usageReceiptFile.OpenReadStream(AttachmentConstraints.MaxBytes);
                var upload = await Mediator.Send(new UploadAttachmentCommand(
                    _request.Id,
                    CurrentUser.UserId,
                    _usageReceiptFile.Name,
                    _usageReceiptFile.ContentType,
                    _usageReceiptFile.Size,
                    stream,
                    AttachmentCategory.UsageReceipt));
                if (upload.IsFailure) { _usageError = upload.Error.Message; return; }
                attachmentId = upload.Value;
            }

            if (_editingUsageId.HasValue)
            {
                var res = await Mediator.Send(new UpdateAdvanceUsageCommand(
                    _request.Id, _editingUsageId.Value, CurrentUser.UserId,
                    _usageSpentOn, _usageAmount, _usageDescription, attachmentId));
                if (res.IsFailure) { _usageError = res.Error.Message; return; }
            }
            else
            {
                var res = await Mediator.Send(new AddAdvanceUsageCommand(
                    _request.Id, CurrentUser.UserId,
                    _usageSpentOn, _usageAmount, _usageDescription, attachmentId));
                if (res.IsFailure) { _usageError = res.Error.Message; return; }
            }

            _showUsageModal = false;
            _actionSuccess = "Usage saved.";
            await LoadRequest();
        }
        catch (Exception ex)
        {
            _usageError = $"Save failed: {ex.Message}";
        }
        finally { _usageBusy = false; }
    }

