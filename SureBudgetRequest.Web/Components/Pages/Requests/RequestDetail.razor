    // Lowercase noun for the request's cumulative-cap cadence at submission,


    protected override async Task OnInitializedAsync() => await LoadRequest();

    private async Task LoadRequest()
    {
        _loading = true;
        var result = await Mediator.Send(new GetBudgetRequestQuery(Id));
        if (result.IsSuccess)
        {
            _request = result.Value;
            // Resolve all user IDs in one pass
            var ids = new HashSet<Guid> { _request.RequesterId, _request.DeptHeadIdAtSubmission };
            foreach (var a in _request.ApprovalActions) ids.Add(a.ApproverId);
            foreach (var p in _request.Payments) ids.Add(p.RecordedByUserId);
            foreach (var id in ids)
            {
                if (!_userNames.ContainsKey(id))
                {
                    var u = await Mediator.Send(new GetUserQuery(id));
                    if (u.IsSuccess) _userNames[id] = u.Value.FullName;
                }
            }
        }
        _loading = false;
    }

    private List<string> GetAvailableActions()
    {
        if (_request is null) return new();
        var list = new List<string>();
        var r = _request;
        var uid = CurrentUser.UserId;
        var role = CurrentUser.Role;

        if (r.Status == RequestStatus.Draft && r.RequesterId == uid)
            list.Add("submit");

        if (r.Status is RequestStatus.Draft or RequestStatus.SentBack && r.RequesterId == uid)
            list.Add("edit");

        if (r.Status == RequestStatus.PendingDeptHead && role == UserRole.DepartmentHead && r.DeptHeadIdAtSubmission == uid)
        {
            list.Add("approve");
            list.Add("reject");
            list.Add("sendback");
            list.Add("edit");
        }

        if (r.Status == RequestStatus.PendingManagement && role == UserRole.Management)
        { list.Add("approve"); list.Add("reject"); list.Add("sendback"); }

        // Approve / Reject are role-gated per stage; at Finance, only Finance
        // Approvers (Type 1) qualify. Send Back is available to every approver at
        // their own stage (assigned dept head only at the DeptHead stage).
        if (r.Status == RequestStatus.PendingFinance && role == UserRole.Finance && CurrentUser.IsFinanceApprover)
        { list.Add("approve"); list.Add("reject"); list.Add("sendback"); }

        // Recording payments is allowed for BOTH Finance sub-types.
        if (r.Status is RequestStatus.Approved or RequestStatus.PartiallyPaid && role == UserRole.Finance)
            list.Add("recordpayment");

        if (r.Status == RequestStatus.PendingDeptHead && r.RequesterId == uid)
            list.Add("cancel");

        return list;
    }

    private async Task DoSubmit()
    {
        if (_actioning) return;
        _actioning = true; _actionTarget = "submit";
        var result = await Mediator.Send(new SubmitRequestCommand(Id, CurrentUser.UserId));
        _actioning = false;
        if (result.IsFailure) { _actionError = result.Error.Message; }
        else { _actionSuccess = "Request submitted."; await LoadRequest(); }
    }

    private async Task DoApprove()
    {
        if (_actioning) return;
        _actioning = true; _actionTarget = "approve";
        var result = await Mediator.Send(new ApproveRequestCommand(Id, CurrentUser.UserId));
        _actioning = false;
        if (result.IsFailure) { _actionError = result.Error.Message; }
        else { _actionSuccess = "Request approved."; await LoadRequest(); }
    }

