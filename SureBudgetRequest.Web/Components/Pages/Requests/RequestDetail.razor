    /// Where "← Back" returns to. Driven by the `from` token (whitelist below);
    /// falls back to a role-appropriate list when the token is missing or unknown
    /// (e.g. Slack deep links, page refresh). Tokens map to fixed internal routes,
    /// so an unknown value can never resolve to an off-app URL.
    /// </summary>
    private (string Url, string Label) BackTarget => From switch
    {
        "inbox"       => ("requests/inbox",          "Inbox"),
        "mine"        => ("requests/mine",           "My Requests"),
        "outstanding" => ("requests/outstanding",    "Outstanding Payments"),
        "reports"     => ("reports/budget-requests", "Reports"),
        "home"        => ("/",                       "Dashboard"),
        _ => CurrentUser.Role switch
        {
            UserRole.Employee   => ("requests/mine",           "My Requests"),
