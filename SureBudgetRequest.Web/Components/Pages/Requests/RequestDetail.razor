@page "/requests/{Id:guid}"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject BusyState Busy

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.ApproveRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.RejectRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.SendBackRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.CancelRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.RecordPayment
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.AddAdvanceUsage
@using SureBudgetRequest.Application.BudgetRequests.Commands.UpdateAdvanceUsage
@using SureBudgetRequest.Application.BudgetRequests.Commands.RemoveAdvanceUsage
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitReconciliation
@using SureBudgetRequest.Application.BudgetRequests.Commands.RecordRefund
@using SureBudgetRequest.Application.BudgetRequests.Commands.RecordReimbursement
@using SureBudgetRequest.Application.BudgetRequests.Commands.ExtendReconciliationDeadline
@using SureBudgetRequest.Application.BudgetRequests.Commands.UploadAttachment
@using SureBudgetRequest.Application.BudgetRequests.Commands.RemoveAttachment
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetBudgetRequestHistory
@using SureBudgetRequest.Application.BudgetRequests.Common
@using SureBudgetRequest.Application.Coas.Queries
@using SureBudgetRequest.Application.BankAccounts.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Domain.Enums
@using AttachmentCategory = SureBudgetRequest.Domain.Enums.AttachmentCategory
@using Microsoft.AspNetCore.Components.Forms
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>Request Detail</PageTitle>

@if (_loading)
{
    <div class="spinner-wrap"><div class="spinner"></div></div>
}
else if (_request is null)
{
    <div class="page-wrap alert alert-warning">Request not found.</div>
}
else
{
    <div class="page-wrap" style="max-width:800px; margin: auto;">

        @* ── Header ── *@
        <div class="flex items-start justify-content-between mb-4">
            <div>
                <a href="@BackTarget.Url" class="text-muted text-sm">← Back to @BackTarget.Label</a>
                <div class="flex items-center gap-2 mt-1">
                    <h5>Budget Request</h5>
                    <button class="btn btn-outline btn-xs" @onclick="OpenHistory">History</button>
                </div>
                <span class="text-muted text-sm font-mono">@_request.Reference</span>
            </div>
            <span class="badge badge-role">@StatusLabel(_request.Status)</span>
            <MonthlyLimitBadge
                MonthlyLimitAtSubmission="@_request.MonthlyLimitAtSubmission"
                MonthlySpendBeforeAtSubmission="@_request.MonthlySpendBeforeAtSubmission"
                RequestedAmountInMmkAtSubmission="@_request.RequestedAmountInMmkAtSubmission" />
        </div>

        @if (!string.IsNullOrEmpty(_actionError))
        {
            <div class="alert alert-error">@_actionError <button class="btn btn-icon modal-close" @onclick="() => _actionError = null"></button></div>
        }
        @if (!string.IsNullOrEmpty(_actionSuccess))
        {
            <div class="alert alert-success">@_actionSuccess <button class="btn btn-icon modal-close" @onclick="() => _actionSuccess = null"></button></div>
        }

        @* ── Monthly overrun warning (headline) ──
           Shown when the snapshots indicate this request crossed the monthly
           limit at submission time. Independent of whether justification text
           was preserved — uses the saved snapshot math for truthiness. *@
        @if (_request.MonthlyLimitAtSubmission.HasValue
             && _request.MonthlySpendBeforeAtSubmission.HasValue
             && (_request.MonthlySpendBeforeAtSubmission.Value + _request.RequestedAmountInMmkAtSubmission) > _request.MonthlyLimitAtSubmission.Value)
        {
            <div class="alert alert-warning">
                <span style="font-size:1.25rem; line-height:1">⚠</span>
                <div class="text-sm">
                    <strong>This request exceeded the department's monthly limit at submission.</strong>
                    <div class="mt-1">
                        Already spent this month: <strong>@_request.MonthlySpendBeforeAtSubmission.Value.ToString("N2")</strong> MMK
                        of a <strong>@_request.MonthlyLimitAtSubmission.Value.ToString("N2")</strong> MMK limit.
                        This request adds <strong>@_request.RequestedAmountInMmkAtSubmission.ToString("N2")</strong> MMK,
                        bringing the total to
                        <strong>@((_request.MonthlySpendBeforeAtSubmission.Value + _request.RequestedAmountInMmkAtSubmission).ToString("N2"))</strong> MMK.
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_request.MonthlyOverrunJustification))
                    {
                        <div class="mt-1 text-muted">See justification below.</div>
                    }
                </div>
            </div>
        }

        @* ── Request summary card ── *@
        <div class="card mb-4">
            <div class="card-body">
                <div class="form-grid-3">
                    <div>
                        <div class="text-sm text-muted">Requester</div>
                        <div>@(_userNames.TryGetValue(_request.RequesterId, out var rn) ? rn : "—")</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Request Date</div>
                        <div>@_request.RequestDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Type</div>
                        <div><span class="badge badge-role">@TypeLabel(_request.Type)</span></div>
                    </div>
                    <div>
                        <div class="text-sm text-muted">Amount Requested</div>
                        <div class="font-semibold">@_request.RequestedAmount.ToString("N2") @_request.CurrencyCode</div>
                        @if (_request.CurrencyCode != "MMK" && _request.ExchangeRateAtSubmission > 0)
                        {
                            <div class="text-sm text-muted">
                                ≈ @_request.RequestedAmountInMmkAtSubmission.ToString("N2") MMK
                                <span class="text-muted">(at @_request.ExchangeRateAtSubmission.ToString("N2") MMK/@_request.CurrencyCode)</span>
                            </div>
                        }
                    </div>
                    @if (_request.ApprovedAmount > 0)
                    {
                        <div>
                            <div class="text-sm text-muted">Approved Amount</div>
                            <div class="font-semibold text-success">@_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode</div>
                            @if (_request.CurrencyCode != "MMK" && _request.ExchangeRateAtSubmission > 0)
                            {
                                <div class="text-sm text-muted">
                                    ≈ @((_request.ApprovedAmount * _request.ExchangeRateAtSubmission).ToString("N2")) MMK
                                </div>
                            }
                        </div>
                    }
                    <div>
                        <div class="text-sm text-muted">Reason</div>
                        <div>@_request.Reasons</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_request.ExternalReferences))
                    {
                        <div>
                            <div class="text-sm text-muted">External references</div>
                            <div style="white-space: pre-wrap">@_request.ExternalReferences</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_request.MonthlyOverrunJustification))
                    {
                        <div>
                            <div class="text-sm text-muted">Budget overrun justification</div>
                            <div class="border-start border-warning border-3 ps-2">
                                @_request.MonthlyOverrunJustification
                            </div>
                            @if (_request.MonthlyLimitAtSubmission.HasValue
                                && _request.MonthlySpendBeforeAtSubmission.HasValue)
                            {
                                <div class="text-sm text-muted mt-1">
                                    At submission:
                                    @_request.MonthlySpendBeforeAtSubmission.Value.ToString("N2") MMK already
                                    spent this month against a
                                    @_request.MonthlyLimitAtSubmission.Value.ToString("N2") MMK monthly limit.
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_request.CoaCode))
                    {
                        <div>
                            <div class="text-sm text-muted">Chart of Account</div>
                            <div><strong>@_request.CoaCode</strong> — @_request.CoaName</div>
                        </div>
                    }
                    <div>
                        <div class="text-sm text-muted">Withdrawer</div>
                        <div>@_request.WithdrawerName</div>
                        <div class="text-sm text-muted">@_request.WithdrawerJobTitle</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_request.WithdrawMethodName))
                    {
                        <div>
                            <div class="text-sm text-muted">Withdraw Method</div>
                            <div>@_request.WithdrawMethodName</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_request.BudgetCategoryName))
                    {
                        <div>
                            <div class="text-sm text-muted">Budget Category</div>
                            <div>@_request.BudgetCategoryName</div>
                        </div>
                    }
                    @if (_request.SubmittedAt.HasValue)
                    {
                        <div>
                            <div class="text-sm text-muted">Submitted</div>
                            <div>@_request.SubmittedAt.ToMyanmarTime()</div>
                        </div>
                    }
                    <div>
                        <div class="text-sm text-muted">Partial Payment</div>
                        @if (_request.AllowsPartialPayment)
                        {
                            <div>Allowed (installments)</div>
                            @if (!string.IsNullOrWhiteSpace(_request.PartialPaymentDetail))
                            {
                                <div class="text-sm text-muted fst-italic">@_request.PartialPaymentDetail</div>
                            }
                        }
                        else
                        {
                            <div>Not allowed — must be paid in full</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Attachments (read-only) ── *@
        @{
            var hasBanking = _request.Attachments.Any(a => a.Category == AttachmentCategory.WithdrawMethod);
        }

        @if (hasBanking)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="card-title text-sm font-semibold text-uppercase text-muted mb-4">Banking info</h6>
                    <AttachmentList BudgetRequestId="_request.Id"
                                    Attachments="_request.Attachments"
                                    Category="AttachmentCategory.WithdrawMethod"
                                    Editable="false" />
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title text-sm font-semibold text-uppercase text-muted mb-4">Supporting documents</h6>
                <AttachmentList BudgetRequestId="_request.Id"
                                Attachments="_request.Attachments"
                                Category="AttachmentCategory.General"
                                Editable="false" />
            </div>
        </div>

        @* ── Action buttons ── *@
        @{ var actions = GetAvailableActions(); }
        @if (actions.Any())
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="card-title text-sm font-semibold text-uppercase text-muted mb-4">Your Action</h6>
                    <div class="flex gap-2">

                        @* Submit (Draft) *@
                        @if (actions.Contains("submit"))
                        {
                            <button class="btn btn-primary btn-sm" @onclick="DoSubmit" disabled="@_actioning">Submit for Approval</button>
                        }

                        @* Edit (Draft / SentBack, requester only) *@
                        @if (actions.Contains("edit"))
                        {
                            <a href="requests/@Id/edit" class="btn btn-outline btn-sm">Edit</a>
                        }

                        @* Approve *@
                        @if (actions.Contains("approve"))
                        {
                            @if (_request.Status == RequestStatus.PendingFinance)
                            {
                                @* Finance approval needs a COA — opens the picker modal. *@
                                <button class="btn btn-success btn-sm" @onclick="OpenFinanceApproveModal" disabled="@_actioning">
                                    Approve
                                </button>
                            }
                            else
                            {
                                @* DeptHead and Management approvals are one-click. *@
                                <button class="btn btn-success btn-sm" @onclick="DoApprove" disabled="@_actioning">
                                    @if (_actioning && _actionTarget == "approve") { <span class="spinner spinner-sm mr-1"></span> }
                                    Approve
                                </button>
                            }
                        }

                        @* Reject *@
                        @if (actions.Contains("reject"))
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => _showRejectModal = true">Reject</button>
                        }

                        @* Send Back (any approver at their own stage) *@
                        @if (actions.Contains("sendback"))
                        {
                            <button class="btn btn-warning btn-sm" @onclick="() => _showSendBackModal = true">Send Back to Requester</button>
                        }

                        @* Record Payment (Finance) *@
                        @if (actions.Contains("recordpayment"))
                        {
                            <button class="btn btn-success btn-sm" @onclick="OpenPaymentModal">Record Payment</button>
                        }

                        @* Cancel (Requester, PendingDeptHead) *@
                        @if (actions.Contains("cancel"))
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => _showCancelModal = true">Cancel Request</button>
                        }

                    </div>
                </div>
            </div>
        }

        @* ── Approval Timeline ── *@
        @{ var pendingStage = PendingStageInfo(); }
        @if (_request.ApprovalActions.Any() || pendingStage is not null)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="text-sm font-semibold mb-4">Approval History</h6>
                    <div class="tl">
                        @foreach (var a in _request.ApprovalActions.OrderBy(x => x.ActionedAt))
                        {
                            <div class="tl-item">
                                <div class="tl-node @DecisionNodeClass(a.Decision)">@DecisionGlyph(a.Decision)</div>
                                <div class="tl-body">
                                    <div class="tl-stage">
                                        <span class="tl-stage-name">@StageLabel(a.Stage.ToString())</span>
                                        <span class="badge badge-xs @DecisionBadgeClass(a.Decision)">@DecisionLabel(a.Decision)</span>
                                    </div>
                                    <div class="tl-meta">
                                        @(_userNames.TryGetValue(a.ApproverId, out var an) ? an : "System")
                                        · @a.ActionedAt.ToMyanmarTime()
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Comment))
                                    {
                                        <div class="tl-comment">"@a.Comment"</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (pendingStage is not null)
                        {
                            <div class="tl-item">
                                <div class="tl-node tl-node-pending">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                                </div>
                                <div class="tl-body">
                                    <div class="tl-stage">
                                        <span class="tl-stage-name">@pendingStage.Value.Stage</span>
                                        <span class="badge badge-xs badge-role">PENDING</span>
                                    </div>
                                    <div class="tl-comment">@pendingStage.Value.Awaiting</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Payments ── *@
        @if (_request.Payments.Any() || _request.Status is RequestStatus.Approved or RequestStatus.PartiallyPaid or RequestStatus.Paid)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="section-head">
                        <h6 class="text-sm font-semibold">Payments</h6>
                        @if (_request.Payments.Any())
                        {
                            <span class="badge-total">Total Paid : @_request.Payments.Sum(x => x.Amount).ToString("N2") @_request.CurrencyCode</span>
                        }
                    </div>
                    @if (_request.Payments.Any())
                    {
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th class="col-no">No</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th class="text-end">Amount (@_request.CurrencyCode)</th>
                                        <th>Source Account</th>
                                        <th>Reference</th>
                                        <th>Receipt</th>
                                        <th>Recorded By</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var payNo = 0; }
                                    @foreach (var p in _request.Payments.OrderBy(x => x.PaidAt))
                                    {
                                        payNo++;
                                        var paidLocal = p.PaidAt.ToMyanmarDateTime();
                                        <tr>
                                            <td class="col-no">@payNo</td>
                                            <td class="nowrap">@paidLocal.ToString("d/M/yyyy")</td>
                                            <td class="nowrap text-muted-cell">@paidLocal.ToString("h:mm tt")</td>
                                            <td class="text-end font-semibold tabular">@p.Amount.ToString("N2")</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(p.SourceBankName))
                                                {
                                                    <div>@p.SourceBankName</div>
                                                    <div class="text-muted-cell font-mono">@p.SourceAccountNumber</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-muted-cell">@(p.Reference ?? "—")</td>
                                            <td>
                                                @{
                                                    var paymentAtts = p.AttachmentIds
                                                        .Select(id => FindAttachment(id))
                                                        .Where(a => a != null)
                                                        .Cast<AttachmentDto>()
                                                        .ToList();
                                                }
                                                @if (paymentAtts.Any())
                                                {
                                                    <AttachmentStackGallery Attachments="paymentAtts" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>@(_userNames.TryGetValue(p.RecordedByUserId, out var pn) ? pn : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-muted">No payments recorded yet.</p>
                    }
                </div>
            </div>
        }

        @* ── Advance reconciliation panel ─────────────────────────────────── *@
        @if (_request.Type == BudgetRequestType.Advance
             && _request.Status is RequestStatus.PendingReconciliation
                 or RequestStatus.AwaitingRefund
                 or RequestStatus.AwaitingReimbursement
                 or RequestStatus.Reconciled)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-2" style="flex-wrap:wrap">
                            <h6 class="text-sm font-semibold">Advance Reconciliation</h6>
                            <span class="badge-total">Used : @_request.TotalUsageRecorded.ToString("N2") / @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode</span>
                            @if (_request.RemainingAdvance >= 0)
                            {
                                <span class="badge-total badge-total-success">Remaining : @_request.RemainingAdvance.ToString("N2") @_request.CurrencyCode</span>
                            }
                            else
                            {
                                <span class="badge-total badge-total-danger">Over-spent : @((-_request.RemainingAdvance).ToString("N2")) @_request.CurrencyCode</span>
                            }
                        </div>
                        @if (_request.IsOverdue)
                        {
                            <span class="badge badge-sm badge-rejected">OVERDUE</span>
                        }
                    </div>

                    @if (_request.ReconciliationDeadline.HasValue)
                    {
                        <div class="mb-4">
                            <div class="text-sm text-muted">Reconciliation deadline</div>
                            <div class="font-semibold">@_request.ReconciliationDeadline.ToMyanmarTime()</div>
                            @if (!string.IsNullOrEmpty(CountdownText()))
                            {
                                <div class="text-sm @(_request.IsOverdue ? "text-danger" : "text-muted")">@CountdownText()</div>
                            }
                        </div>
                    }

                    @if (_request.Status == RequestStatus.AwaitingRefund)
                    {
                        <div class="alert alert-warning">
                            Awaiting refund of
                            <strong>@_request.RefundAmount.ToString("N2") @_request.CurrencyCode</strong>
                            — the unspent balance of this advance.
                        </div>
                    }
                    else if (_request.Status == RequestStatus.AwaitingReimbursement)
                    {
                        <div class="alert alert-info">
                            Awaiting reimbursement of
                            <strong>@_request.ReimbursementAmount.ToString("N2") @_request.CurrencyCode</strong>
                            — the over-spent amount the company owes the requester.
                        </div>
                    }
                    else if (_request.Status == RequestStatus.Reconciled)
                    {
                        <div class="alert alert-success">
                            This advance has been fully reconciled.
                            @if (_request.RefundReceivedAt.HasValue)
                            {
                                <span>
                                    Refund of @_request.RefundAmount.ToString("N2") @_request.CurrencyCode
                                    received on @_request.RefundReceivedAt.ToMyanmarTime().
                                </span>
                            }
                            @if (_request.ReimbursementPaidAt.HasValue)
                            {
                                <span>
                                    Reimbursement of @_request.ReimbursementAmount.ToString("N2") @_request.CurrencyCode
                                    paid on @_request.ReimbursementPaidAt.ToMyanmarTime().
                                </span>
                            }
                        </div>
                    }

                    @if (_request.AdvanceUsages.Any())
                    {
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th class="col-no">No</th>
                                        <th>Date</th>
                                        <th class="text-end">Amount (@_request.CurrencyCode)</th>
                                        <th>Description</th>
                                        <th>Receipt</th>
                                        @if (CanEditUsage) { <th class="col-actions"></th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var usageNo = 0; }
                                    @foreach (var u in _request.AdvanceUsages.OrderBy(x => x.SpentOn))
                                    {
                                        usageNo++;
                                        <tr>
                                            <td class="col-no">@usageNo</td>
                                            <td class="nowrap">@u.SpentOn.ToString("dd MMM yyyy")</td>
                                            <td class="text-end font-semibold tabular">@u.Amount.ToString("N2")</td>
                                            <td>@u.Description</td>
                                            <td>
                                                @{
                                                    var rowAtts = u.AttachmentIds
                                                        .Select(id => FindAttachment(id))
                                                        .Where(a => a != null)
                                                        .Cast<AttachmentDto>()
                                                        .ToList();
                                                }
                                                @if (rowAtts.Any())
                                                {
                                                    <AttachmentStackGallery Attachments="rowAtts" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            @if (CanEditUsage)
                                            {
                                                <td class="col-actions nowrap">
                                                    <button class="btn btn-ghost btn-xs" @onclick="() => OpenEditUsageModal(u)">Edit</button>
                                                    <button class="btn btn-ghost btn-xs text-danger" @onclick="() => DoRemoveUsage(u.Id)" disabled="@_actioning">Delete</button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-muted">No usage recorded yet.</p>
                    }

                    @* Requester actions — only while reconciliation is pending. *@
                    @if (CanEditUsage)
                    {
                        <div class="flex gap-2 mt-2">
                            <button class="btn btn-outline btn-sm" @onclick="OpenAddUsageModal" disabled="@_actioning">+ Add usage</button>
                            @if (_request.AdvanceUsages.Any())
                            {
                                <button class="btn btn-success btn-sm" @onclick="() => _showSubmitReconModal = true" disabled="@_actioning">Submit reconciliation</button>
                            }
                        </div>
                    }

                    @* Finance actions. *@
                    @if (IsFinance && _request.Status == RequestStatus.PendingReconciliation)
                    {
                        <div class="flex gap-2 mt-2">
                            <button class="btn btn-outline btn-sm" @onclick="OpenExtendModal" disabled="@_actioning">Extend deadline</button>
                        </div>
                    }
                    @if (IsFinance && _request.Status == RequestStatus.AwaitingRefund)
                    {
                        <div class="flex gap-2 mt-2">
                            <button class="btn btn-success btn-sm" @onclick="OpenRefundModal" disabled="@_actioning">Record refund received</button>
                        </div>
                    }
                    @if (IsFinance && _request.Status == RequestStatus.AwaitingReimbursement)
                    {
                        <div class="flex gap-2 mt-2">
                            <button class="btn btn-success btn-sm" @onclick="OpenReimbursementModal" disabled="@_actioning">Record reimbursement paid</button>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
}

@* ── Finance Approve Modal (COA picker) ─────────────────────────────────────── *@
@if (_showFinanceApproveModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-success">Approve Request</h6>
                    <button class="btn btn-icon modal-close" @onclick="CancelFinanceApproveModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_approveError))
                    {
                        <div class="alert alert-error">@_approveError</div>
                    }
                    <p class="text-sm text-muted mb-4">
                        Select the Chart of Account this expense will be booked against.
                        Only active accounts are shown.
                    </p>
                    <label class="form-label text-sm font-semibold">Chart of Account</label>
                    @if (_coasLoading)
                    {
                        <div class="text-center py-2"><div class="spinner spinner-sm"></div></div>
                    }
                    else
                    {
                        <select class="select" @bind="_selectedCoaId">
                            <option value="">— select an account —</option>
                            @foreach (var c in _availableCoas)
                            {
                                <option value="@c.Id">@c.Code — @c.Name</option>
                            }
                        </select>
                        @if (!_availableCoas.Any())
                        {
                            <div class="form-text text-sm text-warning">
                                No active Chart of Accounts found. Add one under
                                <a href="coas">Chart of accounts</a> before approving.
                            </div>
                        }
                        else if (_request?.CoaId.HasValue == true)
                        {
                            <div class="form-hint">
                                Pre-filled with the previously selected account. You can change it.
                            </div>
                        }
                    }

                    @* Advance requests also need a reconciliation deadline. *@
                    @if (_request?.Type == BudgetRequestType.Advance)
                    {
                        <div class="mt-3">
                            <label class="form-label text-sm font-semibold">Reconciliation deadline</label>
                            <input class="input" type="date" @bind="_reconciliationDeadline" />
                            <div class="form-hint">
                                Default is 3 days from today. Deadline expires at this exact time of day (N × 24 hours).
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CancelFinanceApproveModal" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm"
                            @onclick="DoApproveAsFinance"
                            disabled="@(_actioning || string.IsNullOrWhiteSpace(_selectedCoaId))">
                        @if (_actioning) { <span class="spinner spinner-sm mr-1"></span> }
                        Confirm Approval
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Reject Modal ─────────────────────────────────────────────────────────────── *@
@if (_showRejectModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Reject Request</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showRejectModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label text-sm font-semibold">Reason for rejection</label>
                    <textarea class="textarea" rows="3" @bind="_rejectComment" placeholder="Explain why this request is being rejected…"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showRejectModal = false">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoReject" disabled="@_actioning">Reject</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Send Back Modal ──────────────────────────────────────────────────────────── *@
@if (_showSendBackModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Send Back to Requester</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showSendBackModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm text-muted">The request will return to Draft status. The requester can edit and resubmit.</p>
                    <label class="form-label text-sm font-semibold">Comment</label>
                    <textarea class="textarea" rows="3" @bind="_sendBackComment" placeholder="What needs to be fixed?"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showSendBackModal = false">Cancel</button>
                    <button class="btn btn-warning btn-sm" @onclick="DoSendBack" disabled="@_actioning">Send Back</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Record Payment Modal ─────────────────────────────────────────────────────── *@
@if (_showPaymentModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Record Payment</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showPaymentModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_paymentError))
                    {
                        <div class="alert alert-error">@_paymentError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Amount (@(_request?.CurrencyCode ?? ""))</label>
                        <input class="input" type="number" min="1"
                               @bind="_paymentAmount"
                               readonly="@(_request is not null && !_request.AllowsPartialPayment)" />
                        @if (_request is not null)
                        {
                            @if (_request.AllowsPartialPayment)
                            {
                                <div class="form-hint">Remaining: @_request.RemainingBalance.ToString("N2") @_request.CurrencyCode</div>
                            }
                            else
                            {
                                <div class="form-text text-sm text-warning">
                                    Full payment required: @_request.RemainingBalance.ToString("N2") @_request.CurrencyCode
                                    (this request does not allow installments)
                                </div>
                            }
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Source bank account <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <select class="select" @bind="_selectedBankAccountId">
                            <option value="">— none (e.g. cash) —</option>
                            @foreach (var ba in _bankAccounts)
                            {
                                <option value="@ba.Id">@ba.BankName — @ba.AccountNumber (@ba.AccountHolderName)</option>
                            }
                        </select>
                        <div class="form-hint">Pick the company account the money was paid from. Leave blank for cash.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Reference <span class="text-muted fw-normal">(optional)</span></label>
                        <input class="input" @bind="_paymentRef" placeholder="Bank ref, voucher no…" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Note <span class="text-muted fw-normal">(optional)</span></label>
                        <input class="input" @bind="_paymentNote" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Receipts <span class="text-muted fw-normal">(optional, multiple files allowed)</span>
                        </label>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <InputFile OnChange="OnPaymentReceiptsSelected"
                                       disabled="@_uploadingReceipts"
                                       multiple
                                       class="input" />
                            @if (_uploadingReceipts)
                            {
                                <span class="text-muted small">Uploading…</span>
                            }
                        </div>
                        <div class="form-hint mb-3">
                            Max @(AttachmentConstraints.MaxBytes / (1024 * 1024)) MB per file. PDF, images, Word, Excel, text, CSV.
                        </div>

                        @if (_pendingPaymentReceipts.Count > 0)
                        {
                            <div class="mt-2 mb-3">
                                <AttachmentStackGallery Attachments="_pendingPaymentReceipts"
                                                       AllowDelete="true"
                                                       OnDelete="RemovePaymentReceipt"
                                                       CardWidth="90px"
                                                        CardHeight="70px"
                                                       Disabled="@_uploadingReceipts" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CancelPaymentModal" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="DoRecordPayment" disabled="@(_actioning || _uploadingReceipts)">Record Payment</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Cancel Confirm ───────────────────────────────────────────────────────────── *@
@if (_showCancelModal)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title text-danger">Cancel Request</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showCancelModal = false"></button>
                </div>
                <div class="modal-body text-sm">Are you sure you want to cancel this request? This cannot be undone.</div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showCancelModal = false">No</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoCancel" disabled="@_actioning">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Add / Edit Usage Modal ───────────────────────────────────────────────────── *@
@if (_showUsageModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingUsageId.HasValue ? "Edit Usage" : "Add Usage")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseUsageModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_usageError))
                    {
                        <div class="alert alert-error">@_usageError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Spent On</label>
                        <input class="input" type="date" @bind="_usageSpentOn" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Amount (@(_request?.CurrencyCode ?? ""))</label>
                        <input class="input" type="number" min="1" step="0.01" @bind="_usageAmount" />
                        @if (_request is not null)
                        {
                            <div class="form-hint">
                                Advance: @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode ·
                                Recorded so far: @_request.TotalUsageRecorded.ToString("N2") @_request.CurrencyCode.
                                Over-spending is allowed and will be reimbursed.
                            </div>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Description</label>
                        <textarea class="textarea textarea-sm" rows="2" @bind="_usageDescription"
                                  placeholder="What was this spent on?"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Receipts <span class="text-muted fw-normal">(optional, multiple files allowed)</span>
                        </label>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <InputFile OnChange="OnUsageReceiptsSelected"
                                       disabled="@(_usageBusy || _uploadingUsageReceipts)"
                                       multiple
                                       class="input" />
                            @if (_uploadingUsageReceipts)
                            {
                                <span class="text-muted small">Uploading…</span>
                            }
                        </div>
                        <div class="form-hint mb-3">
                            Max @(AttachmentConstraints.MaxBytes / (1024 * 1024)) MB per file. PDF, images, Word, Excel, text, CSV.
                        </div>

                        @if (_pendingUsageReceipts.Count > 0)
                        {
                            <div class="mt-2 mb-3">
                                <AttachmentStackGallery Attachments="_pendingUsageReceipts"
                                                       AllowDelete="true"
                                                       OnDelete="RemoveUsageReceipt"
                                                       
                                                       Disabled="@(_usageBusy || _uploadingUsageReceipts)" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseUsageModal" disabled="@(_usageBusy || _uploadingUsageReceipts)">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="DoSaveUsage" disabled="@(_usageBusy || _uploadingUsageReceipts)">
                        @if (_usageBusy) { <span class="spinner spinner-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Submit Reconciliation Confirm ────────────────────────────────────────────── *@
@if (_showSubmitReconModal && _request is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Submit Reconciliation</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showSubmitReconModal = false"></button>
                </div>
                <div class="modal-body text-sm">
                    After submitting, you can't change the rows. Continue?
                    @if (_request.RemainingAdvance > 0)
                    {
                        <div class="alert alert-warning">
                            Recorded usage is @_request.TotalUsageRecorded.ToString("N2") of
                            @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode.
                            You will need to refund the unspent
                            <strong>@_request.RemainingAdvance.ToString("N2") @_request.CurrencyCode</strong>.
                        </div>
                    }
                    else if (_request.RemainingAdvance < 0)
                    {
                        <div class="alert alert-info">
                            Recorded usage is @_request.TotalUsageRecorded.ToString("N2") of
                            @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode.
                            The company will reimburse the over-spent
                            <strong>@((-_request.RemainingAdvance).ToString("N2")) @_request.CurrencyCode</strong>.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showSubmitReconModal = false" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="DoSubmitReconciliation" disabled="@_actioning">Continue</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Record Refund Modal ──────────────────────────────────────────────────────── *@
@if (_showRefundModal && _request is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Record Refund Received</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showRefundModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_refundError))
                    {
                        <div class="alert alert-error">@_refundError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Refund amount (@_request.CurrencyCode)</label>
                        <input class="input" type="number" min="0" step="0.01" @bind="_refundAmount" />
                        <div class="form-hint">
                            Must match the outstanding refund of
                            @_request.RefundAmount.ToString("N2") @_request.CurrencyCode exactly.
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showRefundModal = false" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="DoRecordRefund" disabled="@_actioning">Record Refund</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Record Reimbursement Modal ───────────────────────────────────────────────── *@
@if (_showReimbursementModal && _request is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Record Reimbursement Paid</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showReimbursementModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_reimbursementError))
                    {
                        <div class="alert alert-error">@_reimbursementError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Reimbursement amount (@_request.CurrencyCode)</label>
                        <input class="input" type="number" min="0" step="0.01" @bind="_reimbursementAmount" />
                        <div class="form-hint">
                            Must match the outstanding reimbursement of
                            @_request.ReimbursementAmount.ToString("N2") @_request.CurrencyCode exactly.
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showReimbursementModal = false" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="DoRecordReimbursement" disabled="@_actioning">Record Reimbursement</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Extend Deadline Modal ────────────────────────────────────────────────────── *@
@if (_showExtendModal && _request is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Extend Reconciliation Deadline</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showExtendModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_extendError))
                    {
                        <div class="alert alert-error">@_extendError</div>
                    }
                    <p class="text-sm text-muted">
                        Current deadline: <strong>@_request.ReconciliationDeadline.ToMyanmarTime()</strong>.
                        The new deadline must be later than the current one.
                    </p>
                    <label class="form-label text-sm font-semibold">New deadline</label>
                    <input class="input" type="date" @bind="_newDeadline" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showExtendModal = false" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="DoExtendDeadline" disabled="@_actioning">Extend</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Modification History Modal ─────────────────────────────────────────────── *@
@if (_showHistoryModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Modification History</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_historyLoading)
                    {
                        <div class="text-center py-5"><div class="spinner spinner-sm"></div></div>
                    }
                    else if (!_history.Any())
                    {
                        <div class="p-4 text-center text-muted text-sm">No modification logs found for this request.</div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th class="col-no">No</th>
                                        <th>When</th>
                                        <th>Updated By</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var histNo = 0; }
                                    @foreach (var h in _history)
                                    {
                                        histNo++;
                                        <tr>
                                            <td class="col-no">@histNo</td>
                                            <td class="nowrap">@h.ModifiedAt.ToMyanmarTime()</td>
                                            <td>@h.ModifiedByUserName</td>
                                            <td class="text-muted-cell">@(string.IsNullOrWhiteSpace(h.Note) ? "—" : h.Note)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showHistoryModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}




<style>
    /* ============================================================
       19. Request detail — approval timeline, section badges,
           receipt thumbnails (redesign)
       ============================================================ */

    /* Section header inside a card body: title + total badges */
    .section-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: var(--space-4);
        flex-wrap: wrap;
    }

    /* Total pill (e.g. "Total Paid : 5,000,000 MMK") */
    .badge-total {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 10px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-weight: 600;
        background: var(--color-primary-bg);
        color: var(--color-primary);
        white-space: nowrap;
    }

    .badge-total-success {
        background: var(--color-success-bg);
        color: #166534;
    }

    .badge-total-danger {
        background: var(--color-danger-bg);
        color: var(--color-danger);
    }

    /* Extra-small badge (timeline stage decisions) */
    .badge-xs {
        height: 18px;
        font-size: 10px;
        padding: 0 7px;
        font-weight: 700;
        letter-spacing: 0.05em;
        border-radius: var(--radius-sm);
    }

    /* Extra-small button (table row actions, compact links) */
    .btn-xs {
        height: 24px;
        font-size: 12px;
        padding: 0 var(--space-2);
    }

    /* Receipt thumbnail inside tables */
    .receipt-thumb {
        max-width: 56px;
        max-height: 44px;
        object-fit: contain;
        display: block;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-bg-row-alt);
    }

    /* Document card inside poker stack */
    .poker-card-doc {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        text-align: center;
        user-select: none;
    }

    .poker-doc-ext {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-family: system-ui, -apple-system, sans-serif;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    /* Single non-image document thumbnail */
    .single-doc-thumb {
        width: 48px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: 800;
        font-size: 11px;
        letter-spacing: 0.05em;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        border: 1.5px solid #ffffff;
        transition: transform 0.2s ease;
    }

    .single-doc-thumb:hover {
        transform: scale(1.06);
    }

    /* iOS Lightbox Backdrop */
    .ios-lightbox-backdrop {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(4, 6, 12, 0.88);
        backdrop-filter: blur(30px) saturate(180%);
        -webkit-backdrop-filter: blur(30px) saturate(180%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        @@animation: iosFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        user-select: none;
        outline: none;
    }

    @@keyframes iosFadeIn {
        from {
            opacity: 0;
            backdrop-filter: blur(0px);
        }
        to {
            opacity: 1;
            backdrop-filter: blur(30px) saturate(180%);
        }
    }

    .ios-lightbox-header {
        width: 100%;
        max-width: 1000px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #ffffff;
        padding: 4px 0 12px 0;
        z-index: 100001;
    }

    .ios-lightbox-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ios-lightbox-count {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.18);
        padding: 3px 10px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.03em;
        backdrop-filter: blur(10px);
    }

