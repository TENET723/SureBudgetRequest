    private string CountdownText()
    {
        if (_request?.ReconciliationDeadline is null
            || _request.Status != RequestStatus.PendingReconciliation)
            return "";

        var days = (_request.ReconciliationDeadline.Value.Date - DateTime.UtcNow.Date).Days;
        if (days < 0) return $"{-days} day(s) overdue";
        if (days == 0) return "Due today";
        return $"{days} day(s) remaining";
    }

