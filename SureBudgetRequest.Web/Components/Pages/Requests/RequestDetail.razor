            ? _request.RemainingBalance
            : 0;
        _showPaymentModal = true;

        // Load active company bank accounts for the source picker.
        var accounts = await Mediator.Send(new ListBankAccountsQuery(IncludeInactive: false));
        if (accounts.IsSuccess)
            _bankAccounts = accounts.Value.ToList();
    }

    private async Task DoRecordPayment()
    {
        _paymentError = null;
        if (_paymentAmount <= 0) { _paymentError = "Amount must be greater than zero."; return; }
        if (_request is not null && !_request.AllowsPartialPayment && _paymentAmount != _request.RemainingBalance)
        {
            _paymentError = $"This request does not allow partial payments. Amount must equal the full remaining balance ({_request.RemainingBalance:N2} {_request.CurrencyCode}).";
            return;
        }

        _actioning = true;
        try
        {
            Guid? attachmentId = null;
            if (_paymentReceiptFile is not null)
            {
                if (_paymentReceiptFile.Size > AttachmentConstraints.MaxBytes)
                {
                    _paymentError = $"Receipt is larger than {AttachmentConstraints.MaxBytes / (1024 * 1024)} MB.";
                    _actioning = false;
                    return;
                }
                if (!AttachmentConstraints.IsAllowedContentType(_paymentReceiptFile.ContentType))
                {
                    _paymentError = $"Receipt file type '{_paymentReceiptFile.ContentType}' is not allowed.";
                    _actioning = false;
                    return;
                }

                await using var stream = _paymentReceiptFile.OpenReadStream(AttachmentConstraints.MaxBytes);
                var upload = await Mediator.Send(new UploadAttachmentCommand(
                    Id,
                    CurrentUser.UserId,
                    _paymentReceiptFile.Name,
                    _paymentReceiptFile.ContentType,
                    _paymentReceiptFile.Size,
                    stream,
                    AttachmentCategory.PaymentReceipt));

                if (upload.IsFailure)
                {
                    _paymentError = upload.Error.Message;
                    _actioning = false;
                    return;
                }
                attachmentId = upload.Value;
            }

            Guid? sourceBankAccountId = Guid.TryParse(_selectedBankAccountId, out var baId) ? baId : null;

            var result = await Mediator.Send(new RecordPaymentCommand(
                Id,
                CurrentUser.UserId,
                _paymentAmount,
                _paymentDate,
                _paymentRef,
                _paymentNote,
                attachmentId,
                sourceBankAccountId));

            if (result.IsFailure)
            {
                _paymentError = result.Error.Message;
                _actioning = false;
                return;
            }

            _showPaymentModal = false;
            _paymentAmount = 0;
            _paymentRef = null;
            _paymentNote = null;
            _paymentReceiptFile = null;
            _paymentPreviewUrl = null;
            _selectedBankAccountId = "";
            _actionSuccess = "Payment recorded.";
            await LoadRequest();
        }
        catch (Exception ex)
        {
            _paymentError = $"Failed to record payment: {ex.Message}";
        }
        finally
        {
            _actioning = false;
        }
    }

