    private async Task OnPaymentReceiptSelected(InputFileChangeEventArgs e)
    {
        _paymentReceiptFile = e.File;
        _paymentError = null;
        _paymentPreviewUrl = null;

        if (_paymentReceiptFile.ContentType.StartsWith("image/"))
        {
            try
            {
                var resizedFile = await _paymentReceiptFile.RequestImageFileAsync(_paymentReceiptFile.ContentType, 400, 400);
                await using var stream = resizedFile.OpenReadStream();
                var buffer = new byte[resizedFile.Size];
                await stream.ReadExactlyAsync(buffer);
                _paymentPreviewUrl = $"data:{_paymentReceiptFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
            }
            catch { /* ignore preview failures */ }
        }
    }

