@* ── Add / Edit Usage Modal ───────────────────────────────────────────────────── *@
@if (_showUsageModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingUsageId.HasValue ? "Edit Usage" : "Add Usage")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseUsageModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_usageError))
                    {
                        <div class="alert alert-error">@_usageError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Spent On</label>
                        <input class="input" type="date" @bind="_usageSpentOn" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Amount (@(_request?.CurrencyCode ?? ""))</label>
                        <input class="input" type="number" min="1" step="0.01" @bind="_usageAmount" />
                        @if (_request is not null)
                        {
                            <div class="form-hint">
                                Advance: @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode ·
                                Recorded so far: @_request.TotalUsageRecorded.ToString("N2") @_request.CurrencyCode.
                                Over-spending is allowed and will be reimbursed.
                            </div>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Description</label>
                        <textarea class="textarea textarea-sm" rows="2" @bind="_usageDescription"
                                  placeholder="What was this spent on?"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">
                            Receipt <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        @if (_editingUsageId.HasValue && _usageExistingAttachmentId.HasValue)
                        {
                            
                                var currentReceipt = FindAttachment(_usageExistingAttachmentId);
                                var currentReceiptUrl = $"/api/attachments/{_usageExistingAttachmentId.Value}";
                            
                            <div class="text-sm mb-1">
                                @if (currentReceipt is not null && IsImage(currentReceipt.ContentType))
                                {
                                    <div class="mb-1">Current receipt:</div>
                                    <a href="@currentReceiptUrl" target="_blank" rel="noopener" title="@currentReceipt.FileName">
                                        <img src="@currentReceiptUrl" alt="@currentReceipt.FileName" loading="lazy"
                                             style="max-width:200px;max-height:200px;object-fit:contain;display:block;
                                                    border:1px solid #dee2e6;border-radius:6px;background:#f8f9fa;" />
                                    </a>
                                    <div class="text-muted mt-1">Choosing a new file replaces it.</div>
                                }
                                else
                                {
                                    <span>Current: </span>
                                    <a href="@currentReceiptUrl" target="_blank" rel="noopener">view receipt</a>
                                    <span class="text-muted"> — choosing a new file replaces it.</span>
                                }
                            </div>
                        }
                        <InputFile OnChange="OnUsageReceiptSelected" class="input" />
                        <div class="form-hint">
                            Max @(AttachmentConstraints.MaxBytes / (1024 * 1024)) MB. PDF, images, Word, Excel, text, CSV.
                        </div>
                        @if (!string.IsNullOrEmpty(_usagePreviewUrl))
                        {
                            <div class="mt-2">
                                <span class="text-sm d-block mb-1 text-muted">Preview:</span>
                                <img src="@(_usagePreviewUrl)" alt="Usage Receipt Preview"
                                     style="max-width:200px;max-height:200px;object-fit:contain;border:1px solid #dee2e6;border-radius:6px;background:#f8f9fa;" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseUsageModal" disabled="@_usageBusy">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="DoSaveUsage" disabled="@_usageBusy">
                        @if (_usageBusy) { <span class="spinner-border spinner-border-sm mr-1"></span> }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Submit Reconciliation Confirm ────────────────────────────────────────────── *@
@if (_showSubmitReconModal && _request is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Submit Reconciliation</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showSubmitReconModal = false"></button>
                </div>
                <div class="modal-body text-sm">
                    After submitting, you can't change the rows. Continue?
                    @if (_request.RemainingAdvance > 0)
                    {
                        <div class="alert alert-warning">
                            Recorded usage is @_request.TotalUsageRecorded.ToString("N2") of
                            @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode.
                            You will need to refund the unspent
                            <strong>@_request.RemainingAdvance.ToString("N2") @_request.CurrencyCode</strong>.
                        </div>
                    }
                    else if (_request.RemainingAdvance < 0)
                    {
                        <div class="alert alert-info">
                            Recorded usage is @_request.TotalUsageRecorded.ToString("N2") of
                            @_request.ApprovedAmount.ToString("N2") @_request.CurrencyCode.
                            The company will reimburse the over-spent
                            <strong>@((-_request.RemainingAdvance).ToString("N2")) @_request.CurrencyCode</strong>.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showSubmitReconModal = false" disabled="@_actioning">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="DoSubmitReconciliation" disabled="@_actioning">Continue</button>
                </div>
            </div>
        </div>
    </div>
}

