    private async Task DoApproveAsFinance()
    {
        if (string.IsNullOrWhiteSpace(_selectedCoaId)) return;
        if (!Guid.TryParse(_selectedCoaId, out var coaId))
        {
            _approveError = "Invalid Chart of Account selection.";
            return;
        }

        // Advance requests carry a reconciliation deadline; calculate exact 24-hour day blocks
        // from the current approval time based on the selected target date.
        DateTime? deadline = null;
        if (_request?.Type == BudgetRequestType.Advance)
        {
            var days = (_reconciliationDeadline.Date - DateTimeExtensions.MyanmarToday).Days;
            if (days <= 0)
            {
                _approveError = "The reconciliation deadline must be a future date.";
                return;
            }
            deadline = DateTime.UtcNow.AddDays(days);
        }

        if (_actioning) return;
        _actioning = true; _actionTarget = "approve";
        var result = await Mediator.Send(new ApproveRequestCommand(Id, CurrentUser.UserId, coaId, deadline));
        _actioning = false;

        if (result.IsFailure)
        {
            // Keep the modal open so the user can correct (e.g. pick another COA
            // if theirs got deactivated in the meantime).
            _approveError = result.Error.Message;
            return;
        }

        _showFinanceApproveModal = false;
        _actionSuccess = "Request approved.";
        await LoadRequest();
    }

