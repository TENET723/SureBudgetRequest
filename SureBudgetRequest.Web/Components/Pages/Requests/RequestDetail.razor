@* ── Modification History Modal ─────────────────────────────────────────────── *@
@if (_showHistoryModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Modification History</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_historyLoading)
                    {
                        <div class="text-center py-5"><div class="spinner spinner-sm"></div></div>
                    }
                    else if (!_history.Any())
                    {
                        <div class="p-4 text-center text-muted text-sm">No modification logs found for this request.</div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th class="col-no">No</th>
                                        <th>When</th>
                                        <th>Updated By</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var histNo = 0; }
                                    @foreach (var h in _history)
                                    {
                                        histNo++;
                                        <tr>
                                            <td class="col-no">@histNo</td>
                                            <td class="nowrap">@TimeDisplay.Mm(h.ModifiedAt)</td>
                                            <td>@h.ModifiedByUserName</td>
                                            <td class="text-muted-cell">@(string.IsNullOrWhiteSpace(h.Note) ? "—" : h.Note)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showHistoryModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}


<style>
    /* ============================================================
       19. Request detail — approval timeline, section badges,
           receipt thumbnails (redesign)
       ============================================================ */

    /* Section header inside a card body: title + total badges */
    .section-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: var(--space-4);
        flex-wrap: wrap;
    }

    /* Total pill (e.g. "Total Paid : 5,000,000 MMK") */
    .badge-total {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 10px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-weight: 600;
        background: var(--color-primary-bg);
        color: var(--color-primary);
        white-space: nowrap;
    }

    .badge-total-success {
        background: var(--color-success-bg);
        color: #166534;
    }

    .badge-total-danger {
        background: var(--color-danger-bg);
        color: var(--color-danger);
    }

    /* Extra-small badge (timeline stage decisions) */
    .badge-xs {
        height: 18px;
        font-size: 10px;
        padding: 0 7px;
        font-weight: 700;
        letter-spacing: 0.05em;
        border-radius: var(--radius-sm);
    }

    /* Extra-small button (table row actions, compact links) */
    .btn-xs {
        height: 24px;
        font-size: 12px;
        padding: 0 var(--space-2);
    }

    /* Receipt thumbnail inside tables */
    .receipt-thumb {
        max-width: 56px;
        max-height: 44px;
        object-fit: contain;
        display: block;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-bg-row-alt);
    }

    /* Approval timeline */
    .tl {
        position: relative;
    }

    .tl-item {
        position: relative;
        display: flex;
        gap: 14px;
        padding-bottom: 22px;
    }

        .tl-item:last-child {
            padding-bottom: 2px;
        }

        .tl-item::before {
            content: "";
            position: absolute;
            left: 13px;
            top: 30px;
            bottom: 0;
            width: 2px;
            background: var(--color-border);
        }

        .tl-item:last-child::before {
            display: none;
        }

    .tl-node {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: white;
        z-index: 1;
    }

    .tl-node-approved {
        background: var(--color-success);
    }

    .tl-node-rejected {
        background: var(--color-danger);
    }

    .tl-node-sentback {
        background: var(--color-warning);
    }

    .tl-node-pending {
        background: var(--color-primary);
    }

