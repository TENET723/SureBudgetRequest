    /// Current pending stage shown as the last (blue) timeline node.
    /// Only the stage the request is currently waiting on — no future stages.
    private (string Stage, string Awaiting)? PendingStageInfo()
    {
        if (_request is null) return null;
        return _request.Status switch
        {
            RequestStatus.PendingDeptHead => ("Dept Head",
                $"Awaiting approval by {(_userNames.TryGetValue(_request.DeptHeadIdAtSubmission, out var dh) ? dh : "the department head")}."),
            RequestStatus.PendingManagement => ("Management", "Awaiting approval by Management."),
            RequestStatus.PendingFinance => ("Finance", "Awaiting approval by Finance."),
            _ => null
        };
    }

