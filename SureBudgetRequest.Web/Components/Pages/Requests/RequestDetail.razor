    private string CountdownText()
    {
        if (_request?.ReconciliationDeadline is null
            || _request.Status != RequestStatus.PendingReconciliation)
            return "";

        var diff = _request.ReconciliationDeadline.Value - DateTime.UtcNow;
        if (diff < TimeSpan.Zero)
        {
            var overdue = DateTime.UtcNow - _request.ReconciliationDeadline.Value;
            return overdue.TotalHours < 24
                ? $"{(int)Math.Max(1, overdue.TotalHours)} hour(s) overdue"
                : $"{(int)overdue.TotalDays} day(s) overdue";
        }

        return diff.TotalHours < 24
            ? $"{(int)Math.Max(1, diff.TotalHours)} hour(s) remaining"
            : $"{(int)diff.TotalDays} day(s) remaining";
    }

