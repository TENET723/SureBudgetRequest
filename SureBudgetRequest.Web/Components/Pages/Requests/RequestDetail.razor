    private async Task DoRecordPayment()
    {
        if (_actioning || _uploadingReceipts) return;
        Busy.Begin();
        try { await DoRecordPaymentCore(); }
        finally { Busy.End(); }
    }

    private async Task DoRecordPaymentCore()
    {
        _paymentError = null;
        if (_paymentAmount <= 0) { _paymentError = "Amount must be greater than zero."; return; }
        if (_request is not null && !_request.AllowsPartialPayment && _paymentAmount != _request.RemainingBalance)
        {
            _paymentError = $"This request does not allow partial payments. Amount must equal the full remaining balance ({_request.RemainingBalance:N2} {_request.CurrencyCode}).";
            return;
        }

        if (_actioning || _uploadingReceipts) return;
        _actioning = true;
        try
        {
            Guid? sourceBankAccountId = Guid.TryParse(_selectedBankAccountId, out var baId) ? baId : null;
            var attachmentIds = _pendingPaymentReceipts.Select(a => a.Id).ToList();

            var result = await Mediator.Send(new RecordPaymentCommand(
                Id,
                CurrentUser.UserId,
                _paymentAmount,
                _paymentRef,
                _paymentNote,
                attachmentIds.Any() ? attachmentIds : null,
                sourceBankAccountId));

            if (result.IsFailure)
            {
                _paymentError = result.Error.Message;
                _actioning = false;
                return;
            }

            _showPaymentModal = false;
            _paymentAmount = 0;
            _paymentRef = null;
            _paymentNote = null;
            _pendingPaymentReceipts.Clear();
            _selectedBankAccountId = "";
            _actionSuccess = "Payment recorded.";
            await LoadRequest();
        }
        catch (Exception ex)
        {
            _paymentError = $"Failed to record payment: {ex.Message}";
        }
        finally
        {
            _actioning = false;
        }
    }

    private async Task OnPaymentReceiptsSelected(InputFileChangeEventArgs e)
    {
        _paymentError = null;
        var files = e.GetMultipleFiles(10).ToList();
        if (!files.Any()) return;

        _uploadingReceipts = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                if (file.Size > AttachmentConstraints.MaxBytes)
                {
                    _paymentError = $"\"{file.Name}\" is larger than {AttachmentConstraints.MaxBytes / (1024 * 1024)} MB.";
                    continue;
                }

                if (!AttachmentConstraints.IsAllowedContentType(file.ContentType))
                {
                    _paymentError = $"\"{file.Name}\" has an unsupported file type ({file.ContentType}).";
                    continue;
                }

                await using var stream = file.OpenReadStream(AttachmentConstraints.MaxBytes);
                var cmd = new UploadAttachmentCommand(
                    Id,
                    CurrentUser.UserId,
                    file.Name,
                    file.ContentType,
                    file.Size,
                    stream,
                    AttachmentCategory.PaymentReceipt);

                var result = await Mediator.Send(cmd);
                if (result.IsFailure)
                {
                    _paymentError = result.Error.Message;
                }
                else
                {
                    var newAttachmentId = result.Value;
                    var req = await Mediator.Send(new GetBudgetRequestQuery(Id));
                    if (req.IsSuccess)
                    {
                        var attDto = req.Value.Attachments.FirstOrDefault(a => a.Id == newAttachmentId);
                        if (attDto is not null && !_pendingPaymentReceipts.Any(a => a.Id == newAttachmentId))
                        {
                            _pendingPaymentReceipts.Add(attDto);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _paymentError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploadingReceipts = false;
            StateHasChanged();
        }
    }

    private async Task RemovePaymentReceipt(Guid attachmentId)
    {
        _paymentError = null;
        _uploadingReceipts = true;
        try
        {
            var cmd = new RemoveAttachmentCommand(Id, attachmentId, CurrentUser.UserId);
            var res = await Mediator.Send(cmd);
            if (res.IsSuccess)
            {
                _pendingPaymentReceipts.RemoveAll(a => a.Id == attachmentId);
