    private async Task OpenFinanceApproveModal()
    {
        _approveError = null;
        _reconciliationDeadline = DateTime.Today.AddDays(30);
        _coasLoading = true;
        _availableCoas = new();
        // Pre-fill with the previously selected COA (e.g. after a send-back) so the
        // next Finance user just confirms unless they want to change it.
        _selectedCoaId = _request?.CoaId.HasValue == true
            ? _request.CoaId.Value.ToString()
            : "";
        _showFinanceApproveModal = true;
        StateHasChanged();

        var result = await Mediator.Send(new ListCoasQuery(IncludeInactive: false));
        if (result.IsSuccess)
        {
            _availableCoas = result.Value.OrderBy(c => c.Code).ToList();
            // If the pre-filled COA happens to be inactive now, clear the selection
            // so the user explicitly picks an active one.
            if (!string.IsNullOrWhiteSpace(_selectedCoaId)
                && !_availableCoas.Any(c => c.Id.ToString() == _selectedCoaId))
            {
                _selectedCoaId = "";
            }
        }
        _coasLoading = false;
    }

    private void CancelFinanceApproveModal()
    {
        _showFinanceApproveModal = false;
        _approveError = null;
    }

    private async Task DoApproveAsFinance()
    {
        if (string.IsNullOrWhiteSpace(_selectedCoaId)) return;
        if (!Guid.TryParse(_selectedCoaId, out var coaId))
        {
            _approveError = "Invalid Chart of Account selection.";
            return;
        }

        // Advance requests carry a reconciliation deadline; the domain rejects a
        // past one, but check here too so the user gets the error in the modal.
        DateTime? deadline = null;
        if (_request?.Type == BudgetRequestType.Advance)
        {
            if (_reconciliationDeadline.Date <= DateTime.UtcNow.Date)
            {
                _approveError = "The reconciliation deadline must be a future date.";
                return;
            }
            deadline = _reconciliationDeadline;
        }

        _actioning = true; _actionTarget = "approve";
        var result = await Mediator.Send(new ApproveRequestCommand(Id, CurrentUser.UserId, coaId, deadline));
        _actioning = false;

        if (result.IsFailure)
        {
            // Keep the modal open so the user can correct (e.g. pick another COA
            // if theirs got deactivated in the meantime).
            _approveError = result.Error.Message;
            return;
        }

        _showFinanceApproveModal = false;
        _actionSuccess = "Request approved.";
        await LoadRequest();
    }

