@page "/requests/mine"
@implements IDisposable
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Commands.CancelRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoSubmit
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoReconciliationSubmit
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoRefund
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Tags.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>My Requests</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>My Requests</h5>
        <a href="requests/new" class="btn btn-primary btn-sm">+ New Request</a>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage</div>
    }

    <div class="flex items-center gap-2 mb-2 flex-wrap">
        <ListSearchBox @bind-Value="_search" OnEnter="() => LoadPageAsync(1)"
                       Placeholder="Search reference or reason" Width="320px" />

        <button type="button" class="btn btn-outline btn-sm" @onclick="() => _showFilters = true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filter
            @if (_activeFilterCount > 0)
            {
                <span class="topbar-count-badge ml-1">@_activeFilterCount</span>
            }
        </button>
    </div>

        <AppTable TItem="BudgetRequestSummaryDto"
                  Items="@Items"
                  IsLoading="@_loading"
                  ColSpan="7">
            <TableHeader>
                <th class="sticky-no-col font-bold">NO.</th>
                <th role="button" class="sortable col-ref-date"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.SubmittedAt))">
                    Reference @RenderSortIcon(BudgetRequestSortBy.SubmittedAt, BudgetRequestSortBy.Reference)
                </th>
                <th class="col-reason">Reason</th>
                <th class="col-tags">Tags</th>
                <th class="text-end col-requested" role="button"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.AmountInMmk))">
                    Requested @RenderSortIcon(BudgetRequestSortBy.AmountInMmk)
                </th>
                <th role="button" class="sortable col-status"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.Status))">
                    Status @RenderSortIcon(BudgetRequestSortBy.Status)
                </th>
                <th class="sticky-action-col"></th>
            </TableHeader>
            <RowTemplateWithIndex Context="ctx">
                @{
                    var r = ctx.Item;
                    var i = ctx.Index;
                    var rowNo = (_result!.Page - 1) * _result.PageSize + i + 1;
                }
                <tr class="clickable-row @(_contextMenuTarget?.Id == r.Id ? "menu-open" : "")"
                    @onclick="() => NavigateToDetail(r.Id)"
                    @oncontextmenu="e => OpenContextMenu(e, r)"
                    @oncontextmenu:preventDefault="true">
                    <td class="sticky-no-col text-muted text-sm text-center">@rowNo</td>
                    <td class="text-sm col-ref-date">
                        <div class="font-semibold text-dark">@(r.Reference ?? "—")</div>
                        <div class="datetime-tooltip-trigger">
                            <div class="ref-time">
                                <span>@(r.SubmittedAt.HasValue ? r.SubmittedAt.ToMyanmarTime() : r.RequestDate.ToString("dd MMM yyyy"))</span>
                            </div>
                            <div class="datetime-popup">
                                <div class="popup-row">
                                    <span class="popup-label">Submitted:</span>
                                    <span class="popup-val">@(r.SubmittedAt.HasValue ? r.SubmittedAt.ToMyanmarTime() : "Not submitted (Draft)")</span>
                                </div>
                                <div class="popup-row">
                                    <span class="popup-label">Request Date:</span>
                                    <span class="popup-val">@r.RequestDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="col-reason">
                        @if (!string.IsNullOrWhiteSpace(r.Reasons))
                        {
                            <span class="reason-clamp">@r.Reasons</span>
                        }
                        else
                        {
                            <span class="text-muted text-xs">—</span>
                        }
                    </td>
                    <td class="col-tags">
                        @if (r.Tags != null && r.Tags.Count > 0)
                        {
                            <div class="flex items-center gap-1 flex-wrap">
                                @foreach (var tag in r.Tags.Take(5))
                                {
                                    <span class="tag-badge-pill"
                                          style="background-color: @(tag.ColorHex ?? "#6c757d"); color: @tag.EffectiveFontColor;">
                                        #@tag.Name
                                    </span>
                                }
                                @if (r.Tags.Count > 5)
                                {
                                    var overflowCount = r.Tags.Count - 5;
                                    <div class="tag-tooltip-container" @onclick:stopPropagation="true">
                                        <span class="tag-badge-pill" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 600; cursor: pointer;">
                                            +@overflowCount
                                        </span>
                                        <div class="tag-tooltip-popup">
                                            @foreach (var ot in r.Tags.Skip(5))
                                            {
                                                <span>#@ot.Name</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted text-xs">—</span>
                        }
                    </td>
                    <td class="text-end font-semibold col-requested">
                        @r.RequestedAmount.ToString("N2") <span class="ccy-tag">@r.CurrencyCode</span>
                    </td>
                    <td class="col-status">
                        <div class="status-chip-group">
                            <span class="chip @StatusChipClass(r.Status)"><span class="dot"></span>@StatusLabel(r.Status)</span>
                            @if (r.IsOverLimit)
                            {
                                <span class="chip chip-overlimit" title="Routed through Management">Over-limit</span>
                            }
                        </div>
                    </td>
                    <td class="sticky-action-col" @onclick:stopPropagation="true">
                        <div class="row-hover-btn-wrapper">
                            <div class="row-hover-backdrop"></div>
                            <button type="button" class="btn-three-dots" title="Quick actions"
                                    @onclick="e => OpenContextMenuFromButton(e, r)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </RowTemplateWithIndex>
            <EmptyContent>
                @if (_result is not null && _result.TotalCount == 0 && !_appliedHasFilters)
                {
                    <span>No requests yet. <a href="requests/new">Create one.</a></span>
                }
                else
                {
                    <span>No requests match your search/filters.</span>
                }
            </EmptyContent>
            <PaginationContent>
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <span class="text-sm text-muted">@(_result?.TotalCount ?? 0) request(s)</span>
                    <div class="flex items-center gap-2">
                        <button class="btn btn-outline btn-sm"
                                disabled="@(!(_result?.HasPrev ?? false))"
                                @onclick="() => LoadPageAsync(_currentPage - 1)">‹ Prev</button>
                        <span class="text-sm text-muted">Page @(_result?.Page ?? 1) of @(_result?.TotalPages ?? 1)</span>
                        <button class="btn btn-outline btn-sm"
                                disabled="@(!(_result?.HasNext ?? false))"
                                @onclick="() => LoadPageAsync(_currentPage + 1)">Next ›</button>

                        <div class="flex items-center gap-2 ml-3">
                            <span class="text-sm text-muted">Per page</span>
                            <select class="select select-sm" style="width:auto; height: 30px;" @bind="_pageSize" @bind:after="() => LoadPageAsync(1)">
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                    </div>
                </div>
            </PaginationContent>
        </AppTable>
</div>

@if (_cancellingRequest is not null)
{
    <ConfirmDialog Title="Cancel Request"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoCancel"
                   OnCancel="() => _cancellingRequest = null">
        Are you sure you want to cancel request <strong>@(_cancellingRequest.Reference ?? "Draft")</strong> (@_cancellingRequest.RequestedAmount.ToString("N2") @_cancellingRequest.CurrencyCode)? This action cannot be undone.
    </ConfirmDialog>
}

@* ─── Undo Submit confirmation modal ─────────────────────────────────────── *@
@if (_unsubmittingRequest is not null)
{
    <ConfirmDialog Title="Withdraw to Draft"
                   Type="ConfirmType.Warning"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoSubmit"
                   OnCancel="() => _unsubmittingRequest = null">
        Withdraw request <strong>@(_unsubmittingRequest.Reference ?? "this request")</strong> back to draft?
        <div class="alert alert-warning text-xs mt-3">
            The request will return to <strong>Draft</strong> so you can edit details or attachments before resubmitting.
        </div>
    </ConfirmDialog>
}

@* ── Withdraw / Reopen Reconciliation confirmation modal ── *@
@if (_withdrawingReconciliationRequest is not null)
{
    <ConfirmDialog Title="Reopen Reconciliation"
                   Type="ConfirmType.Warning"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoReconciliationSubmit"
                   OnCancel="() => _withdrawingReconciliationRequest = null">
        Reopen reconciliation for advance <strong>@(_withdrawingReconciliationRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the advance to <strong>Reconciliation in Progress</strong> so expense line items can be adjusted. All recorded entries and receipts will be kept.
        </div>
    </ConfirmDialog>
}

@* ── Undo Refund confirmation modal ── *@
@if (_undoingRefundRequest is not null)
{
    <ConfirmDialog Title="Undo Refund Receipt"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoRefund"
                   OnCancel="() => _undoingRefundRequest = null">
        Undo recorded refund receipt for <strong>@(_undoingRefundRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the request to <strong>Awaiting Refund</strong> until the refund payment is confirmed again.
        </div>
    </ConfirmDialog>
}

@* ─── Filter modal (same pattern as the budget-request report page) ─────── *@
@if (_showFilters)
{
    <div class="modal-backdrop">
        <div class="modal modal-lg">
            <div class="modal-header">
                <h6 class="modal-title">Filter</h6>
                <button class="btn btn-icon modal-close" @onclick="() => _showFilters = false">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-grid-3 mb-4">
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                        <input type="date" class="input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                        <input type="date" class="input" @bind="_toDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Tag</label>
                        <Dropdown Items="_availableTags"
                                  @bind-Value="_selectedTagId"
                                  ValueSelector="tag => tag.Id.ToString()"
                                  TextSelector="tag => tag.DisplayName"
                                  Placeholder="All tags"
                                  Searchable="true"
                                  SearchPlaceholder="Search tag..."
                                  AllowClear="true" />
                    </div>
                </div>

                @* Type *@
                <div class="mb-4">
                    <label class="form-label text-sm text-muted mb-2">Type</label>
                    <div class="flex gap-4">
                        @foreach (var t in _allTypes)
                        {
                            var type = t;
                            <label class="flex items-center gap-2 text-sm" style="cursor:pointer">
                                <input type="checkbox"
                                       style="width:14px;height:14px;accent-color:var(--color-primary)"
                                       checked="@_selectedTypes.Contains(type)"
                                       @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                @TypeLabel(type)
                            </label>
                        }
                    </div>
                </div>

                @* Status *@
                <div class="mb-2">
                    <div class="flex items-center justify-between mb-2">
                        <label class="form-label text-sm text-muted">Status</label>
                        <div class="flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_openStatuses))">Open</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_needsAttentionStatuses))">Needs attention</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_closedStatuses))">Closed</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(Array.Empty<RequestStatus>()))">Clear</button>
                        </div>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var s in _allStatuses)
                        {
                            var status = s;
                            <label>
                                <input type="checkbox"
                                       checked="@_selectedStatuses.Contains(status)"
                                       @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                                @StatusLabel(status)
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline btn-sm" @onclick="ClearFilters" disabled="@_loading">Clear</button>
                <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                    @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                    Apply
                </button>
            </div>
        </div>
    </div>
}

@* ── Custom Context Menu / Quick Actions ────────────────────────────────── *@
@if (_showContextMenu && _contextMenuTarget != null)
{
    <div style="position: fixed; inset: 0; z-index: 1045; cursor: default; background: transparent;"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@(_contextMenuTarget.Reference ?? "Draft / No Ref")</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => NavigateToDetail(_contextMenuTarget.Id)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span>Open Details</span>
        </button>

        <button type="button" class="context-menu-item" @onclick="() => OpenInNewTab(_contextMenuTarget.Id)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>Open in New Tab</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (!string.IsNullOrEmpty(_contextMenuTarget.Reference))
        {
            <button type="button" class="context-menu-item" @onclick="() => CopyReferenceAsync(_contextMenuTarget.Reference)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Copy Reference</span>
            </button>
        }

        <button type="button" class="context-menu-item" @onclick="() => OpenTagPopoverFromContextMenu(_contextMenuTarget)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            <span>Manage Tags</span>
        </button>

        @{
            var requiresManagement = _contextMenuTarget.RequestedAmountInMmkAtSubmission > _contextMenuTarget.DepartmentLimitAtSubmission;
            var isDeptHeadRequester = _contextMenuTarget.RequesterId == _contextMenuTarget.DeptHeadIdAtSubmission;
            var canUndoSubmit = (!isDeptHeadRequester && _contextMenuTarget.Status == RequestStatus.PendingDeptHead)
                || (isDeptHeadRequester && (_contextMenuTarget.Status == RequestStatus.PendingManagement || (_contextMenuTarget.Status == RequestStatus.PendingFinance && !requiresManagement)));
            var canCancel = _contextMenuTarget.Status == RequestStatus.PendingDeptHead
                || (isDeptHeadRequester && (_contextMenuTarget.Status == RequestStatus.PendingManagement || (_contextMenuTarget.Status == RequestStatus.PendingFinance && !requiresManagement)));
        }
        <div class="context-menu-divider"></div>
        <div class="menu-section-title">Status Actions</div>
        <button type="button"
                class="status-action-item action-undo"
                disabled="@(!canUndoSubmit || _saving)"
                style="@(!canUndoSubmit ? "opacity: 0.5; cursor: not-allowed;" : "")"
                title="@(canUndoSubmit ? "Withdraw this request to draft" : GetCancelDisabledReason(_contextMenuTarget.Status))"
                @onclick="() => { if (canUndoSubmit) PromptUndoSubmitFromContextMenu(_contextMenuTarget); }">
            <div class="action-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                <span>Unsubmit Request</span>
            </div>
            @if (!canUndoSubmit)
            {
                <span class="action-reason-hint">@GetCancelDisabledReason(_contextMenuTarget.Status)</span>
            }
        </button>
        <button type="button"
                class="status-action-item action-reject"
                disabled="@(!canCancel || _saving)"
                style="@(!canCancel ? "opacity: 0.5; cursor: not-allowed;" : "")"
                title="@(canCancel ? "Cancel this request" : GetCancelDisabledReason(_contextMenuTarget.Status))"
                @onclick="() => { if (canCancel) PromptCancelFromContextMenu(_contextMenuTarget); }">
            <div class="action-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>Cancel Request</span>
            </div>
            @if (!canCancel)
            {
                <span class="action-reason-hint">@GetCancelDisabledReason(_contextMenuTarget.Status)</span>
            }
        </button>

        @if (CanWithdrawReconciliation(_contextMenuTarget))
        {
            <button type="button"
                    class="status-action-item action-undo"
                    disabled="@_saving"
                    title="@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen reconciliation to pending" : "Withdraw reconciliation to pending")"
                    @onclick="() => PromptUndoReconciliationFromContextMenu(_contextMenuTarget)">
                <div class="action-row">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    <span>@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen Reconciliation" : "Withdraw Reconciliation")</span>
                </div>
            </button>
        }

        @if (CanUndoRefund(_contextMenuTarget))
        {
            <button type="button"
                    class="status-action-item action-reject"
                    disabled="@_saving"
                    title="Undo recorded refund"
                    @onclick="() => PromptUndoRefundFromContextMenu(_contextMenuTarget)">
                <div class="action-row">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                    <span>Undo Refund</span>
                </div>
            </button>
        }
    </div>
}

@* ── Anchored Tag Popover Box ─────────────────────────────────────────────── *@
<RequestTagPopover IsOpen="_showTagPopover"
                   Target="_tagPopoverTarget"
                   X="_tagPopoverX"
                   Y="_tagPopoverY"
                   IsButtonAnchor="_tagPopoverIsButton"
                   OnClose="CloseTagPopover"
                   OnTagsChanged="args => UpdateRequestTags(args.RequestId, args.Tags)"
                   OnToast="ShowToast" />

@* ── Toast Notification ───────────────────────────────────────────────────── *@
@if (_showToast)
{
    <div class="toast-notification">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2EC662" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@_toastMessage</span>
    </div>
}

@code {
    // Current page of server-side search results (source of truth for the table).
    private PagedResult<BudgetRequestSummaryDto>? _result;
    private int _currentPage = 1;
    private int _pageSize = 20;

    // ── Sorting ── default: submission time, newest first. Drafts (null
    // SubmittedAt) sort first under PostgreSQL's DESC NULLS FIRST, so they
    // stay pinned on top by default.
    private BudgetRequestSortBy _sortBy = BudgetRequestSortBy.SubmittedAt;
    private bool _sortDescending = true;

    private Task SortByColumn(BudgetRequestSortBy column)
    {
        if (_sortBy == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortBy = column;
            _sortDescending = column is BudgetRequestSortBy.SubmittedAt
                or BudgetRequestSortBy.AmountInMmk
                or BudgetRequestSortBy.RequestDate;
        }
        return LoadPageAsync(1);
    }

    private string SortIndicator(BudgetRequestSortBy column) =>
        _sortBy == column ? (_sortDescending ? "▼" : "▲") : "";

    private RenderFragment RenderSortIcon(params BudgetRequestSortBy[] columns) => builder =>
    {
        if (!columns.Contains(_sortBy)) return;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "sort-icon");
        if (_sortDescending)
        {
            builder.AddMarkupContent(2, "<svg width=\"12\" height=\"12\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6l4 4 4-4\"/></svg>");
        }
        else
        {
            builder.AddMarkupContent(2, "<svg width=\"12\" height=\"12\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 10l4-4 4 4\"/></svg>");
        }
        builder.CloseElement();
    };
    // Snapshot of "were any filters/search applied" for the query that produced
    // _result — drives the empty-state message (set inside LoadPageAsync).
    private bool _appliedHasFilters;

    private bool _loading = true;
    private string? _errorMessage;
    private BudgetRequestSummaryDto? _cancellingRequest;
    private bool _saving;

    private IReadOnlyList<BudgetRequestSummaryDto> Items => _result?.Items ?? Array.Empty<BudgetRequestSummaryDto>();

    // ── Staged filter state (does nothing until Apply / Enter / preset+Apply) ──
    private bool _showFilters;
    private string _search = "";
    private string _selectedTagId = "";
    private List<VisibleTagDto> _availableTags = new();
    private HashSet<RequestStatus> _selectedStatuses = new();
    private HashSet<BudgetRequestType> _selectedTypes = new();
    private DateTime? _fromDate;
