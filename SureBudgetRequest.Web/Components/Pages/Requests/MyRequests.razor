@page "/requests/mine"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser

@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Commands.CancelRequest
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>My Requests</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>My Requests</h5>
        <a href="requests/new" class="btn btn-primary btn-sm">+ New Request</a>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage</div>
    }

    <div class="flex items-center gap-2 mb-2 flex-wrap">
        <ListSearchBox @bind-Value="_search" OnEnter="() => LoadPageAsync(1)"
                       Placeholder="Search reference or reason" Width="320px" />

        <button type="button" class="btn btn-outline btn-sm" @onclick="() => _showFilters = true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filter
            @if (_activeFilterCount > 0)
            {
                <span class="topbar-count-badge ml-1">@_activeFilterCount</span>
            }
        </button>
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.Reference))">
                            Reference @SortIndicator(BudgetRequestSortBy.Reference)
                        </th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.RequestDate))">
                            Request Date @SortIndicator(BudgetRequestSortBy.RequestDate)
                        </th>
                        <th>Reason</th>
                        <th class="text-end" role="button" style="cursor:pointer;text-align:right"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.AmountInMmk))">
                            Amount @SortIndicator(BudgetRequestSortBy.AmountInMmk)
                        </th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.Status))">
                            Status @SortIndicator(BudgetRequestSortBy.Status)
                        </th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.SubmittedAt))">
                            Submitted @SortIndicator(BudgetRequestSortBy.SubmittedAt)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Items.Count; i++)
                    {
                        var r = Items[i];
                        var rowNo = (_result!.Page - 1) * _result.PageSize + i + 1;
                        <tr>
                            <td class="text-muted text-sm">@rowNo</td>
                            <td><strong>@r.Reference</strong></td>
                            <td class="text-sm">@r.RequestDate.ToString("dd MMM yyyy")</td>
                            <td>@Truncate(r.Reasons, 50)</td>
                            <td class="text-end">@r.RequestedAmount.ToString("N2") <span class="text-muted text-sm">@r.CurrencyCode</span></td>
                            <td>
                                <span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                <MonthlyLimitBadge MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                    MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                    RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                            </td>
                            <td class="text-sm text-muted">@TimeDisplay.Mm(r.SubmittedAt)</td>
                            <td class="text-end">
                                <a href="requests/@r.Id?from=mine" class="btn btn-icon " title="View"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32"><path d="M0 0h32v32H0z" fill="none"/><circle cx="16" cy="16" r="4" fill="currentColor"/><path fill="currentColor" d="M30.94 15.66A16.69 16.69 0 0 0 16 5A16.69 16.69 0 0 0 1.06 15.66a1 1 0 0 0 0 .68A16.69 16.69 0 0 0 16 27a16.69 16.69 0 0 0 14.94-10.66a1 1 0 0 0 0-.68M16 22.5a6.5 6.5 0 1 1 6.5-6.5a6.51 6.51 0 0 1-6.5 6.5"/></svg></a>
                                @if (r.Status is RequestStatus.Draft or RequestStatus.SentBack)
                                {
                                    <a href="requests/@r.Id/edit" class="btn btn-icon " title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="m14.06 9.02l.92.92L5.92 19H5v-.92zM17.66 3c-.25 0-.51.1-.7.29l-1.83 1.83l3.75 3.75l1.83-1.83a.996.996 0 0 0 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29m-3.6 3.19L3 17.25V21h3.75L17.81 9.94z"/></svg></a>
                                }
                                @if (r.Status == RequestStatus.PendingDeptHead)
                                {
                                    <button class="btn btn-icon text-danger" @onclick="() => ConfirmCancel(r)" title="Cancel request"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m5 11H7v-2h10z"/></svg></button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Items.Any())
                    {
                        @if (_result is not null && _result.TotalCount == 0 && !_appliedHasFilters)
                        {
                            <tr><td colspan="8" class="text-center text-muted ">No requests yet. <a href="requests/new">Create one.</a></td></tr>
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted ">No requests match your search/filters.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between mt-2">
            <span class="text-sm text-muted">@(_result?.TotalCount ?? 0) request(s)</span>
            <div class="flex items-center gap-2">
                <label class="text-sm text-muted ">Page size</label>
                <select class="select" style="width:auto" @bind="_pageSize" @bind:after="() => LoadPageAsync(1)">
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <button class="btn btn-outline btn-sm"
                        disabled="@(!(_result?.HasPrev ?? false))"
                        @onclick="() => LoadPageAsync(_currentPage - 1)">Prev</button>
                <span class="text-sm">Page @(_result?.Page ?? 1) of @(_result?.TotalPages ?? 1)</span>
                <button class="btn btn-outline btn-sm"
                        disabled="@(!(_result?.HasNext ?? false))"
                        @onclick="() => LoadPageAsync(_currentPage + 1)">Next</button>
            </div>
        </div>
    }
</div>

@if (_cancellingRequest is not null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">Cancel Request</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _cancellingRequest = null"></button>
                </div>
                <div class="modal-body text-sm">
                    Cancel this request for <strong>@_cancellingRequest.RequestedAmount.ToString("N2") @_cancellingRequest.CurrencyCode</strong>? This cannot be undone.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _cancellingRequest = null">No</button>
                    <button class="btn btn-danger btn-sm" @onclick="DoCancel" disabled="@_saving">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── Filter modal (same pattern as the budget-request report page) ─────── *@
@if (_showFilters)
{
    <div class="modal-backdrop">
        <div class="modal modal-lg">
            <div class="modal-header">
                <h6 class="modal-title">Filter</h6>
                <button class="btn btn-icon modal-close" @onclick="() => _showFilters = false">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-grid-3 mb-4">
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                        <input type="date" class="input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                        <input type="date" class="input" @bind="_toDate" />
                    </div>
                </div>

                @* Type *@
                <div class="mb-4">
                    <label class="form-label text-sm text-muted mb-2">Type</label>
                    <div class="flex gap-4">
                        @foreach (var t in _allTypes)
                        {
                            var type = t;
                            <label class="flex items-center gap-2 text-sm" style="cursor:pointer">
                                <input type="checkbox"
                                       style="width:14px;height:14px;accent-color:var(--color-primary)"
                                       checked="@_selectedTypes.Contains(type)"
                                       @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                @TypeLabel(type)
                            </label>
                        }
                    </div>
                </div>

                @* Status *@
                <div class="mb-2">
                    <div class="flex items-center justify-between mb-2">
                        <label class="form-label text-sm text-muted">Status</label>
                        <div class="flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_openStatuses))">Open</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_needsAttentionStatuses))">Needs attention</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(_closedStatuses))">Closed</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(Array.Empty<RequestStatus>()))">Clear</button>
                        </div>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var s in _allStatuses)
                        {
                            var status = s;
                            <label>
                                <input type="checkbox"
                                       checked="@_selectedStatuses.Contains(status)"
                                       @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                                @StatusLabel(status)
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline btn-sm" @onclick="ClearFilters" disabled="@_loading">Clear</button>
                <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                    @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                    Apply
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Current page of server-side search results (source of truth for the table).
    private PagedResult<BudgetRequestSummaryDto>? _result;
    private int _currentPage = 1;
    private int _pageSize = 20;

    // ── Sorting ── default: submission time, newest first. Drafts (null
    // SubmittedAt) sort first under PostgreSQL's DESC NULLS FIRST, so they
    // stay pinned on top by default.
    private BudgetRequestSortBy _sortBy = BudgetRequestSortBy.SubmittedAt;
    private bool _sortDescending = true;

    private Task SortByColumn(BudgetRequestSortBy column)
    {
        if (_sortBy == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortBy = column;
            _sortDescending = column is BudgetRequestSortBy.SubmittedAt
                or BudgetRequestSortBy.AmountInMmk
                or BudgetRequestSortBy.RequestDate;
        }
        return LoadPageAsync(1);
    }

    private string SortIndicator(BudgetRequestSortBy column) =>
        _sortBy == column ? (_sortDescending ? "▼" : "▲") : "";
    // Snapshot of "were any filters/search applied" for the query that produced
    // _result — drives the empty-state message (set inside LoadPageAsync).
    private bool _appliedHasFilters;

    private bool _loading = true;
    private string? _errorMessage;
    private BudgetRequestSummaryDto? _cancellingRequest;
    private bool _saving;

    private IReadOnlyList<BudgetRequestSummaryDto> Items => _result?.Items ?? Array.Empty<BudgetRequestSummaryDto>();

    // ── Staged filter state (does nothing until Apply / Enter / preset+Apply) ──
    private bool _showFilters;
    private string _search = "";
    private HashSet<RequestStatus> _selectedStatuses = new();
    private HashSet<BudgetRequestType> _selectedTypes = new();
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // All statuses in workflow order (includes the four advance states).
    private static readonly RequestStatus[] _allStatuses =
    {
        RequestStatus.Draft,
        RequestStatus.PendingDeptHead,
        RequestStatus.PendingManagement,
        RequestStatus.PendingFinance,
        RequestStatus.SentBack,
        RequestStatus.Approved,
        RequestStatus.PartiallyPaid,
        RequestStatus.Paid,
        RequestStatus.Rejected,
        RequestStatus.Cancelled,
        RequestStatus.PendingReconciliation,
        RequestStatus.AwaitingRefund,
        RequestStatus.AwaitingReimbursement,
        RequestStatus.Reconciled,
    };

    private static readonly BudgetRequestType[] _allTypes =
    {
        BudgetRequestType.Urgent,
        BudgetRequestType.Standard,
        BudgetRequestType.ProjectProposal,
        BudgetRequestType.Advance,
    };

    private static readonly RequestStatus[] _openStatuses =
    {
        RequestStatus.Draft, RequestStatus.PendingDeptHead, RequestStatus.PendingManagement,
        RequestStatus.PendingFinance, RequestStatus.Approved, RequestStatus.PartiallyPaid,
    };

    private static readonly RequestStatus[] _needsAttentionStatuses =
    {
        RequestStatus.Draft, RequestStatus.SentBack, RequestStatus.PendingReconciliation,
        RequestStatus.AwaitingRefund, RequestStatus.AwaitingReimbursement,
    };

    private static readonly RequestStatus[] _closedStatuses =
    {
        RequestStatus.Paid, RequestStatus.Reconciled, RequestStatus.Rejected, RequestStatus.Cancelled,
    };

    private bool HasStagedFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || _selectedStatuses.Count > 0
        || _selectedTypes.Count > 0
        || _fromDate.HasValue
        || _toDate.HasValue;

    // Count of active staged filters, shown as a badge on the Filter button
    // (same convention as the report page; search counts as a filter).
    private int _activeFilterCount => new[]
    {
        !string.IsNullOrWhiteSpace(_search),
        _fromDate.HasValue,
        _toDate.HasValue,
        _selectedStatuses.Count > 0,
        _selectedTypes.Count > 0,
    }.Count(x => x);

    private async Task ApplyAndClose()
    {
        _showFilters = false;
        await LoadPageAsync(1);
    }

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        if (page < 1) page = 1;

        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        // Date range → SubmittedAt bounds. Inputs are calendar dates; treat them
        // as UTC. Upper bound is exclusive next-day midnight so the end day is
        // inclusive. A reversed range (from > to) is ignored rather than erroring.
        DateTime? from = _fromDate.HasValue
            ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
            : null;
        DateTime? until = _toDate.HasValue
            ? DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1), DateTimeKind.Utc)
            : null;
        if (_fromDate.HasValue && _toDate.HasValue && _fromDate.Value.Date > _toDate.Value.Date)
        {
            from = null;
            until = null;
        }

        // Remember whether this query carried any filter/search, for the
        // empty-state message.
        _appliedHasFilters = HasStagedFilters;

        var query = new SearchBudgetRequestsQuery(
            RequesterId: CurrentUser.UserId,
            Statuses: _selectedStatuses.Count > 0 ? _selectedStatuses.ToList() : null,
            Types: _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null,
            SubmittedFromUtc: from,
            SubmittedUntilUtc: until,
            SearchTerm: _search,
            SortBy: _sortBy,
            SortDescending: _sortDescending,
            Page: page,
            PageSize: _pageSize);

        var result = await Mediator.Send(query);
        if (result.IsSuccess)
        {
            _result = result.Value;
            _currentPage = _result.Page;
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _loading = false;
    }

    private void ConfirmCancel(BudgetRequestSummaryDto r) => _cancellingRequest = r;

    private async Task DoCancel()
    {
        if (_cancellingRequest is null) return;
        _saving = true;
        var result = await Mediator.Send(new CancelRequestCommand(_cancellingRequest.Id, CurrentUser.UserId));
        _saving = false;
        _cancellingRequest = null;
        if (result.IsFailure) { _errorMessage = result.Error.Message; }
        else
        {
            // Reload the current page so the cancelled request reflects its new state.
            await LoadPageAsync(_currentPage);
        }
    }

    private void ToggleStatus(RequestStatus s, bool isChecked)
    {
        if (isChecked) _selectedStatuses.Add(s);
        else _selectedStatuses.Remove(s);
    }

    private void ToggleType(BudgetRequestType t, bool isChecked)
    {
        if (isChecked) _selectedTypes.Add(t);
        else _selectedTypes.Remove(t);
    }

    // Presets only stage the selection; they apply on the next Apply.
    private void ApplyStatusPreset(IEnumerable<RequestStatus> statuses)
        => _selectedStatuses = new HashSet<RequestStatus>(statuses);

    private async Task ClearFilters()
    {
        _search = "";
        _selectedStatuses.Clear();
        _selectedTypes.Clear();
        _fromDate = null;
        _toDate = null;
        await LoadPageAsync(1);
    }

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent => "Urgent",
        BudgetRequestType.Standard => "Standard",
        BudgetRequestType.ProjectProposal => "Project Proposal",
        BudgetRequestType.Advance => "Advance",
        _ => t.ToString()
    };

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Draft => "Draft",
        RequestStatus.PendingDeptHead => "Pending Head",
        RequestStatus.PendingManagement => "Pending Management",
        RequestStatus.PendingFinance => "Pending Finance",
        RequestStatus.SentBack => "Sent Back",
        RequestStatus.Approved => "Approved",
        RequestStatus.PartiallyPaid => "Part. Paid",
        RequestStatus.Paid => "Paid",
        RequestStatus.Rejected => "Rejected",
        RequestStatus.Cancelled => "Cancelled",
        RequestStatus.PendingReconciliation => "Pending Reconciliation",
        RequestStatus.AwaitingRefund => "Awaiting Refund",
        RequestStatus.AwaitingReimbursement => "Awaiting Reimb.",
        RequestStatus.Reconciled => "Reconciled",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft => "badge-draft",
        RequestStatus.PendingDeptHead or RequestStatus.PendingManagement or RequestStatus.PendingFinance => "badge-warning",
        RequestStatus.SentBack => "badge-info",
        RequestStatus.Approved or RequestStatus.PartiallyPaid => "badge-approved",
        RequestStatus.Paid => "badge-paid",
        RequestStatus.Rejected => "badge-rejected",
        RequestStatus.Cancelled => "badge-inactive",
        _ => "badge-draft"
    };
}
