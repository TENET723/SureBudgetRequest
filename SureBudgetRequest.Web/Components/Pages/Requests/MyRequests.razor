    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }

    private void OpenContextMenu(MouseEventArgs e, BudgetRequestSummaryDto request)
    {
        _contextMenuTarget = request;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _menuIsButton = false;
        _contextMenuX = Math.Max(10, e.ClientX);
        _contextMenuY = Math.Max(10, e.ClientY);
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, BudgetRequestSummaryDto request)
    {
        _contextMenuTarget = request;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _menuIsButton = true;
        _contextMenuX = Math.Max(10, e.ClientX - 220);
        _contextMenuY = e.ClientY > 400 ? Math.Max(10, e.ClientY - 210) : e.ClientY + 6;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

