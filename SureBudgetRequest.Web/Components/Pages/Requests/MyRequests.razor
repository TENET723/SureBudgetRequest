    private void UpdateRequestTags(Guid requestId, IReadOnlyList<RequestTagSummaryDto> updatedTags)
    {
        if (_result?.Items != null)
        {
            var newItems = _result.Items
                .Select(item => item.Id == requestId ? item with { Tags = updatedTags } : item)
                .ToList();

            _result = _result with { Items = newItems };
        }

        if (_tagPopoverTarget != null && _tagPopoverTarget.Id == requestId)
        {
            _tagPopoverTarget = _tagPopoverTarget with { Tags = updatedTags };
        }

        InvokeAsync(StateHasChanged);
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _showToast = true;
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500, token);
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    _showToast = false;
                    StateHasChanged();
                });
            }
        }, token);
        StateHasChanged();
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
