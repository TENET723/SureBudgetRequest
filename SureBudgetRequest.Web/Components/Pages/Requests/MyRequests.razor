    private bool HasStagedFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrEmpty(_selectedTagId)
        || _selectedStatuses.Count > 0
        || _selectedTypes.Count > 0
        || _fromDate.HasValue
        || _toDate.HasValue;

    // Count of active staged filters, shown as a badge on the Filter button
    // (same convention as the report page; search counts as a filter).
    private int _activeFilterCount => new[]
    {
        !string.IsNullOrWhiteSpace(_search),
        !string.IsNullOrEmpty(_selectedTagId),
        _fromDate.HasValue,
        _toDate.HasValue,
        _selectedStatuses.Count > 0,    
        _selectedTypes.Count > 0,
    }.Count(x => x);

    private async Task ApplyAndClose()
    {
        _showFilters = false;
        await LoadPageAsync(1);
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role == UserRole.Support)
        {
            Nav.NavigateTo("/admin/users", replace: true);
            return;
        }

        var tagsRes = await Mediator.Send(new ListVisibleTagsForUserQuery(CurrentUser.UserId));
        if (tagsRes.IsSuccess && tagsRes.Value is not null)
            _availableTags = tagsRes.Value.ToList();

        if (FilterState.MyRequests is not null)
        {
            var s = FilterState.MyRequests;
            _search = s.Search;
            _selectedTagId = s.SelectedTagId;
            _selectedStatuses = new HashSet<RequestStatus>(s.SelectedStatuses);
            _selectedTypes = new HashSet<BudgetRequestType>(s.SelectedTypes);
            _fromDate = s.FromDate;
            _toDate = s.ToDate;
            _sortBy = s.SortBy;
            _sortDescending = s.SortDescending;
            _pageSize = s.PageSize;
            await LoadPageAsync(s.Page);
        }
        else
        {
            await LoadPageAsync(1);
        }
    }

    private async Task LoadPageAsync(int page)
    {
        if (page < 1) page = 1;

        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        // Date range → SubmittedAt bounds. Inputs are calendar dates; treat them
        // as UTC. Upper bound is exclusive next-day midnight so the end day is
        // inclusive. A reversed range (from > to) is ignored rather than erroring.
        DateTime? from = _fromDate.HasValue
            ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
            : null;
        DateTime? until = _toDate.HasValue
            ? DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1), DateTimeKind.Utc)
            : null;
        if (_fromDate.HasValue && _toDate.HasValue && _fromDate.Value.Date > _toDate.Value.Date)
        {
            from = null;
            until = null;
        }

        // Remember whether this query carried any filter/search, for the
        // empty-state message.
        _appliedHasFilters = HasStagedFilters;

        Guid? tagFilter = Guid.TryParse(_selectedTagId, out var parsedTag) ? parsedTag : null;

        var query = new SearchBudgetRequestsQuery(
            RequesterId: CurrentUser.UserId,
            Statuses: _selectedStatuses.Count > 0 ? _selectedStatuses.ToList() : null,
            Types: _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null,
            SubmittedFromUtc: from,
            SubmittedUntilUtc: until,
            SearchTerm: _search,
            SortBy: _sortBy,
            SortDescending: _sortDescending,
            Page: page,
            PageSize: _pageSize,
            TagId: tagFilter,
            ViewerUserId: CurrentUser.UserId);

        var result = await Mediator.Send(query);
        if (result.IsSuccess)
        {
            _result = result.Value;
            _currentPage = _result.Page;
            FilterState.MyRequests = new MyRequestsFilterState
            {
                Search = _search,
                SelectedTagId = _selectedTagId,
                SelectedStatuses = new HashSet<RequestStatus>(_selectedStatuses),
                SelectedTypes = new HashSet<BudgetRequestType>(_selectedTypes),
                FromDate = _fromDate,
                ToDate = _toDate,
                SortBy = _sortBy,
                SortDescending = _sortDescending,
                Page = _currentPage,
                PageSize = _pageSize
            };
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _loading = false;
    }

    private void ConfirmCancel(BudgetRequestSummaryDto r) => _cancellingRequest = r;

    private BudgetRequestSummaryDto? _unsubmittingRequest;

    private void PromptUndoSubmitFromContextMenu(BudgetRequestSummaryDto r)
    {
        CloseContextMenu();
        _unsubmittingRequest = r;
    }

    private async Task DoUndoSubmit()
    {
        if (_unsubmittingRequest is null || _saving) return;
        _saving = true;
        var target = _unsubmittingRequest;
        var result = await Mediator.Send(new UndoSubmitCommand(target.Id, CurrentUser.UserId));
        _saving = false;
        _unsubmittingRequest = null;
        if (result.IsFailure)
        {
            _errorMessage = result.Error.Message;
        }
        else
        {
            UpdateRequestStatus(target.Id, RequestStatus.Draft);
            ShowToast($"Withdrew {target.Reference ?? "request"} to draft");
        }
    }

    // ── Reconciliation Undo / Refund Undo Flow ──────────────────────────────
    private BudgetRequestSummaryDto? _withdrawingReconciliationRequest;
    private BudgetRequestSummaryDto? _undoingRefundRequest;

    private bool CanWithdrawReconciliation(BudgetRequestSummaryDto? r) =>
        r != null
        && r.Type == BudgetRequestType.Advance
        && (CurrentUser.Role is UserRole.Finance or UserRole.Admin)
        && (r.Status == RequestStatus.AwaitingRefund || (r.Status == RequestStatus.Reconciled && !r.RefundReceivedAt.HasValue));

    private bool CanUndoRefund(BudgetRequestSummaryDto? r) =>
        r != null
        && r.Type == BudgetRequestType.Advance
        && r.Status == RequestStatus.Reconciled
        && r.RefundReceivedAt.HasValue
        && CurrentUser.Role == UserRole.Finance;

    private void PromptUndoReconciliationFromContextMenu(BudgetRequestSummaryDto r)
    {
        CloseContextMenu();
        _withdrawingReconciliationRequest = r;
    }

    private void PromptUndoRefundFromContextMenu(BudgetRequestSummaryDto r)
    {
        CloseContextMenu();
        _undoingRefundRequest = r;
    }

    private async Task DoUndoReconciliationSubmit()
    {
        if (_withdrawingReconciliationRequest is null || _saving) return;
        _saving = true;
        var target = _withdrawingReconciliationRequest;
        var result = await Mediator.Send(new UndoReconciliationSubmitCommand(target.Id, CurrentUser.UserId));
        _saving = false;
        _withdrawingReconciliationRequest = null;
        if (result.IsFailure)
        {
            _errorMessage = result.Error.Message;
        }
        else
        {
            UpdateRequestStatus(target.Id, RequestStatus.PendingReconciliation);
            ShowToast($"Reconciliation for {target.Reference ?? "advance"} returned to pending");
        }
    }

    private async Task DoUndoRefund()
    {
        if (_undoingRefundRequest is null || _saving) return;
        _saving = true;
        var target = _undoingRefundRequest;
        var result = await Mediator.Send(new UndoRefundCommand(target.Id, CurrentUser.UserId));
        _saving = false;
        _undoingRefundRequest = null;
        if (result.IsFailure)
        {
            _errorMessage = result.Error.Message;
        }
        else
        {
            UpdateRequestStatus(target.Id, RequestStatus.AwaitingRefund);
            ShowToast($"Refund for {target.Reference ?? "advance"} undone");
        }
    }

    private async Task DoCancel()
    {
        if (_cancellingRequest is null) return;
        if (_saving) return;
        _saving = true;
        var target = _cancellingRequest;
        var result = await Mediator.Send(new CancelRequestCommand(target.Id, CurrentUser.UserId));
        _saving = false;
        _cancellingRequest = null;
        if (result.IsFailure)
        {
            _errorMessage = result.Error.Message;
        }
        else
        {
            UpdateRequestStatus(target.Id, RequestStatus.Cancelled);
            ShowToast($"Cancelled {target.Reference ?? "request"}");
        }
    }

    private void UpdateRequestStatus(Guid requestId, RequestStatus newStatus)
    {
        if (_result?.Items != null)
        {
            var newItems = _result.Items
                .Select(item => item.Id == requestId ? item with { Status = newStatus } : item)
                .ToList();

            _result = _result with { Items = newItems };
        }

        if (_contextMenuTarget != null && _contextMenuTarget.Id == requestId)
        {
            _contextMenuTarget = _contextMenuTarget with { Status = newStatus };
        }

        InvokeAsync(StateHasChanged);
    }

    private void ToggleStatus(RequestStatus s, bool isChecked)
    {
        if (isChecked) _selectedStatuses.Add(s);
        else _selectedStatuses.Remove(s);
    }

    private void ToggleType(BudgetRequestType t, bool isChecked)
    {
        if (isChecked) _selectedTypes.Add(t);
        else _selectedTypes.Remove(t);
    }

    // Presets only stage the selection; they apply on the next Apply.
    private void ApplyStatusPreset(IEnumerable<RequestStatus> statuses)
        => _selectedStatuses = new HashSet<RequestStatus>(statuses);

    private async Task ClearFilters()
    {
        _search = "";
        _selectedTagId = "";
        _selectedStatuses.Clear();
        _selectedTypes.Clear();
        _fromDate = null;
        _toDate = null;
        FilterState.MyRequests = null;
        await LoadPageAsync(1);
    }

