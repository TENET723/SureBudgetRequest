@page "/requests/outstanding"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser

@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Outstanding Payments</PageTitle>

<div class="page-wrap">
    <h5 class="mb-4">Outstanding Payments</h5>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage</div>
    }

    @* ─── Toolbar: search + filter toggle + result count ──────────────────── *@
    <div class="flex items-center gap-2 mb-2 flex-wrap">
        <ListSearchBox @bind-Value="_search" OnEnter="Apply"
                       Placeholder="Search reference, reason, or requester" Width="320px" />

        <button type="button" class="btn btn-outline btn-sm" @onclick="ToggleFilters">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Filter
            @if (ActiveFilterCount > 0)
            {
                <span class="topbar-count-badge ml-1">@ActiveFilterCount</span>
            }
        </button>

        @if (!_loading)
        {
            <span class="text-muted text-sm ml-auto">
                @(_result?.TotalCount ?? 0) result@((_result?.TotalCount ?? 0) == 1 ? "" : "s")
            </span>
        }
    </div>

    @* ─── Filter modal (same pattern as the budget-request report page) ───── *@
    @if (_showFilters)
    {
        <div class="modal-backdrop">
            <div class="modal modal-lg">
                <div class="modal-header">
                    <h6 class="modal-title">Filter</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showFilters = false">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
            <div class="form-grid-3">

                @* Department — privileged roles only; Dept Head keeps the existing
                   lock (no dropdown), Employee never sees it. *@
                @if (SeesAllDepartments)
                {
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Department</label>
                        <select class="select" @bind="_selectedDepartmentId">
                            <option value="">All departments</option>
                            @foreach (var d in _departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                }

                @* Currency *@
                <div>
                    <label class="form-label text-sm text-muted mb-1">Currency</label>
                    <select class="select" @bind="_selectedCurrencyCode">
                        <option value="">All currencies</option>
                        @foreach (var c in _currencies)
                        {
                            <option value="@c.Code">@c.Code — @c.Name</option>
                        }
                    </select>
                </div>

                @* Date range *@
                <div>
                    <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                    <input type="date" class="input" @bind="_fromDate" />
                </div>
                <div>
                    <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                    <input type="date" class="input" @bind="_toDate" />
                </div>

                @* Type — multi-select via checkboxes *@
                <div>
                    <label class="form-label text-sm text-muted mb-1">Type</label>
                    <div class="flex gap-3">
                        @foreach (var t in AllTypes)
                        {
                            var type = t;
                            <label class="form-check text-sm ">
                                <input class="form-check-input" type="checkbox"
                                       checked="@_selectedTypes.Contains(type)"
                                       @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                <span class="form-check-label">@TypeLabel(type)</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="Clear" disabled="@_loading">Clear</button>
                    <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                        @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                        Apply
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <p class="text-muted text-sm mb-4">@ScopeDescription()</p>

        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.RequestDate))">
                            Date @SortIndicator(BudgetRequestSortBy.RequestDate)
                        </th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.Requester))">
                            Requester @SortIndicator(BudgetRequestSortBy.Requester)
                        </th>
                        <th>Reason</th>
                        <th>Ccy</th>
                        <th class="text-end" role="button" style="cursor:pointer;text-align:right"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.OutstandingSince))"
                            title="Sort by how long the request has been waiting for payment">
                            Approved @SortIndicator(BudgetRequestSortBy.OutstandingSince)
                        </th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Outstanding</th>
                        <th role="button" style="cursor:pointer"
                            @onclick="@(() => SortByColumn(BudgetRequestSortBy.Status))">
                            Status @SortIndicator(BudgetRequestSortBy.Status)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Items.Count; i++)
                    {
                        var r = Items[i];
                        var rowNo = ((_result?.Page ?? 1) - 1) * (_result?.PageSize ?? 0) + i + 1;
                        <tr>
                            <td class="text-muted text-sm">@rowNo</td>
                            <td class="text-sm">@r.RequestDate.ToString("dd MMM yyyy")</td>
                            <td class="text-sm">@r.RequesterName</td>
                            <td>@Truncate(r.Reasons, 40)</td>
                            <td class="text-sm text-muted">@r.CurrencyCode</td>
                            <td class="text-end">@r.ApprovedAmount.ToString("N2")</td>
                            <td class="text-end">@r.TotalPaid.ToString("N2")</td>
                            <td class="text-end font-semibold">@r.RemainingBalance.ToString("N2")</td>
                            <td><span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                <MonthlyLimitBadge MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                    MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                    RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                            </td>
                            <td class="text-end">
                                <a href="requests/@r.Id" class="btn btn-icon " title="View"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32"><path d="M0 0h32v32H0z" fill="none"/><circle cx="16" cy="16" r="4" fill="currentColor"/><path fill="currentColor" d="M30.94 15.66A16.69 16.69 0 0 0 16 5A16.69 16.69 0 0 0 1.06 15.66a1 1 0 0 0 0 .68A16.69 16.69 0 0 0 16 27a16.69 16.69 0 0 0 14.94-10.66a1 1 0 0 0 0-.68M16 22.5a6.5 6.5 0 1 1 6.5-6.5a6.51 6.51 0 0 1-6.5 6.5"/></svg></a>
                            </td>
                        </tr>
                    }
                    @if (!Items.Any())
                    {
                        @if (_appliedHasFilters)
                        {
                            <tr><td colspan="10" class="text-center text-muted ">No outstanding payments match your search/filters.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="10" class="text-center text-muted ">Nothing outstanding. 🎉</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ─── Pager (same pattern as MyRequests / the report page) ─────────── *@
        <div class="flex items-center justify-between mt-2">
            <span class="text-sm text-muted">@(_result?.TotalCount ?? 0) request(s)</span>
            <div class="flex items-center gap-2">
                <label class="text-sm text-muted ">Page size</label>
                <select class="select" style="width:auto" @bind="_pageSize" @bind:after="() => LoadPageAsync(1)">
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <button class="btn btn-outline btn-sm"
                        disabled="@(!(_result?.HasPrev ?? false))"
                        @onclick="() => LoadPageAsync(_currentPage - 1)">Prev</button>
                <span class="text-sm">Page @(_result?.Page ?? 1) of @(_result?.TotalPages ?? 1)</span>
                <button class="btn btn-outline btn-sm"
                        disabled="@(!(_result?.HasNext ?? false))"
                        @onclick="() => LoadPageAsync(_currentPage + 1)">Next</button>
            </div>
        </div>

        @if (Items.Any())
        {
            <div class="flex justify-content-end mt-2">
                <div class="text-sm text-muted text-end">
                    @* Sums cover the current page only — the full result set is
                       no longer loaded client-side now that the list is paged. *@
                    <div>Total outstanding on this page (@Items.Count request@(Items.Count == 1 ? "" : "s")):</div>
                    @foreach (var grp in Items.GroupBy(r => r.CurrencyCode).OrderBy(g => g.Key == "MMK" ? 0 : 1).ThenBy(g => g.Key))
                    {
                        <div><strong class="text-dark">@grp.Sum(r => r.RemainingBalance).ToString("N2") @grp.Key</strong></div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private static readonly RequestStatus[] OutstandingStatuses =
        { RequestStatus.Approved, RequestStatus.PartiallyPaid };

    // The four request types, in enum order, for the Type multi-select.
    private static readonly BudgetRequestType[] AllTypes =
    {
        BudgetRequestType.Urgent,
        BudgetRequestType.Standard,
        BudgetRequestType.ProjectProposal,
        BudgetRequestType.Advance,
    };

    private PagedResult<BudgetRequestSummaryDto>? _result;
    private int _currentPage = 1;
    private int _pageSize = 20;

    // ── Sorting ── default: submission time, newest first. The "Approved"
    // header sorts by OutstandingSince (how long the request has been
    // waiting), which ascending restores the old longest-waiting-first
    // payment-queue order.
    private BudgetRequestSortBy _sortBy = BudgetRequestSortBy.SubmittedAt;
    private bool _sortDescending = true;

    private Task SortByColumn(BudgetRequestSortBy column)
    {
        if (_sortBy == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortBy = column;
            // Time/amount columns start descending; OutstandingSince starts
            // ascending (longest-waiting first — the useful queue order).
            _sortDescending = column is BudgetRequestSortBy.SubmittedAt
                or BudgetRequestSortBy.AmountInMmk
                or BudgetRequestSortBy.RequestDate;
        }
        return LoadPageAsync(1);
    }

    private string SortIndicator(BudgetRequestSortBy column) =>
        _sortBy == column ? (_sortDescending ? "▼" : "▲") : "";
    private bool _loading = true;
    private string? _errorMessage;

    private IReadOnlyList<BudgetRequestSummaryDto> Items =>
        _result?.Items ?? Array.Empty<BudgetRequestSummaryDto>();

    // ── Reference data for the filter dropdowns ──────────────────────────────
    private List<DepartmentDto> _departments = new();
    private List<CurrencyDto> _currencies = new();

    // ── Staged filter state ──────────────────────────────────────────────────
    // Filters are staged here and only flow into the query on Apply / Clear.
    private string _search = "";
    private string _selectedDepartmentId = "";   // privileged roles only
    private string _selectedCurrencyCode = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private HashSet<BudgetRequestType> _selectedTypes = new();

    private bool _showFilters;

    // Whether the currently-displayed result set carried any filter — drives the
    // empty-state message ("nothing matches" vs "nothing outstanding").
    private bool _appliedHasFilters;

    // Roles that may filter across all departments (vs. Dept Head's locked dept
    // and Employee's own requests).
    private bool SeesAllDepartments =>
        CurrentUser.Role is UserRole.Finance
                         or UserRole.Accounting
                         or UserRole.Management
                         or UserRole.Admin;

    // Count of active staged filters, shown as a badge on the Filters toggle.
    private int ActiveFilterCount
    {
        get
        {
            var n = 0;
            if (!string.IsNullOrWhiteSpace(_search)) n++;
            if (SeesAllDepartments && !string.IsNullOrEmpty(_selectedDepartmentId)) n++;
            if (!string.IsNullOrEmpty(_selectedCurrencyCode)) n++;
            if (_fromDate.HasValue) n++;
            if (_toDate.HasValue) n++;
            if (_selectedTypes.Count > 0) n++;
            return n;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
        await LoadPageAsync(1);
    }

    private async Task LoadReferenceDataAsync()
    {
        // Departments — only needed for the privileged-role dropdown. Mirror the
        // Report page: load all, but only show active ones in the dropdown.
        if (SeesAllDepartments)
        {
            var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
            if (depts.IsSuccess)
                _departments = depts.Value!.Where(d => d.IsActive).OrderBy(d => d.Name).ToList();
        }

        // Currencies — same load as the Report page (MMK first).
        var ccys = await Mediator.Send(new ListCurrenciesQuery(IncludeInactive: true));
        if (ccys.IsSuccess)
            _currencies = ccys.Value!.OrderBy(c => c.Code == "MMK" ? 0 : 1).ThenBy(c => c.Code).ToList();
    }

    private void ToggleFilters() => _showFilters = !_showFilters;

    private void ToggleType(BudgetRequestType t, bool isChecked)
    {
        if (isChecked) _selectedTypes.Add(t);
        else _selectedTypes.Remove(t);
    }

    private async Task Apply() => await LoadPageAsync(1);

    private async Task ApplyAndClose()
    {
        _showFilters = false;
        await LoadPageAsync(1);
    }

    private async Task Clear()
    {
        _search = "";
        _selectedCurrencyCode = "";
        _fromDate = null;
        _toDate = null;
        _selectedTypes.Clear();

        // Dept Heads have no dropdown; privileged roles reset to "All departments".
        if (SeesAllDepartments)
            _selectedDepartmentId = "";

        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        // Role-based scoping mirrors how Inbox.razor narrows visibility:
        // Finance/Accounting/Management/Admin see everything (optionally filtered
        // by the Department dropdown); Dept Head is forced to their own dept;
        // Employee sees only their own requests.
        Guid? requesterFilter = CurrentUser.Role == UserRole.Employee
            ? CurrentUser.UserId
            : null;

        Guid? deptFilter;
        if (CurrentUser.Role == UserRole.DepartmentHead)
            deptFilter = CurrentUser.DepartmentId;
        else if (SeesAllDepartments)
            deptFilter = ParseGuid(_selectedDepartmentId);
        else
            deptFilter = null;

        var term = string.IsNullOrWhiteSpace(_search) ? null : _search;

        IReadOnlyCollection<BudgetRequestType>? types =
            _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null;

        var currency = string.IsNullOrEmpty(_selectedCurrencyCode) ? null : _selectedCurrencyCode;

        // Date bounds: lower is inclusive midnight UTC, upper is the NEXT day's
        // midnight (exclusive) so the whole "to" day is included. A reversed
        // range (from > to) is ignored rather than returning an empty set.
        DateTime? fromUtc = _fromDate.HasValue
            ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
            : null;
        DateTime? untilUtc = _toDate.HasValue
            ? DateTime.SpecifyKind(_toDate.Value.Date, DateTimeKind.Utc).AddDays(1)
            : null;
        if (fromUtc.HasValue && untilUtc.HasValue && fromUtc.Value >= untilUtc.Value)
        {
            fromUtc = null;
            untilUtc = null;
        }

        // Record whether this load carried any user filter, to pick the right
        // empty-state message.
        _appliedHasFilters = term is not null
            || types is not null
            || currency is not null
            || fromUtc.HasValue
            || untilUtc.HasValue
            || (SeesAllDepartments && !string.IsNullOrEmpty(_selectedDepartmentId));

        var result = await Mediator.Send(new SearchBudgetRequestsQuery(
            RequesterId: requesterFilter,
            DepartmentId: deptFilter,
            Statuses: OutstandingStatuses,
            SubmittedFromUtc: fromUtc,
            SubmittedUntilUtc: untilUtc,
            CurrencyCode: currency,
            Types: types,
            SearchTerm: term,
            SortBy: _sortBy,
            SortDescending: _sortDescending,
            Page: page,
            PageSize: _pageSize));

        if (result.IsSuccess)
        {
            _result = result.Value;
            _currentPage = _result.Page;
        }
        else
        {
            _result = null;
            _errorMessage = result.Error.Message;
        }

        _loading = false;
    }

    private static Guid? ParseGuid(string s) =>
        Guid.TryParse(s, out var g) ? g : null;

    private string ScopeDescription() => CurrentUser.Role switch
    {
        UserRole.Finance        => "Approved requests still awaiting full payment.",
        UserRole.Accounting     => "All approved requests still awaiting full payment.",
        UserRole.Admin          => "All approved requests still awaiting full payment.",
        UserRole.Management     => "All approved requests still awaiting full payment.",
        UserRole.DepartmentHead => "Approved requests from your department still awaiting full payment.",
        UserRole.Employee       => "Your approved requests still awaiting full payment.",
        _                       => ""
    };

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "Urgent",
        BudgetRequestType.Standard        => "Standard",
        BudgetRequestType.ProjectProposal => "Project Proposal",
        BudgetRequestType.Advance         => "Advance",
        _                                 => t.ToString()
    };

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Approved      => "Approved",
        RequestStatus.PartiallyPaid => "Part. Paid",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Approved      => "badge-approved",
        RequestStatus.PartiallyPaid => "badge-info",
        _ => "badge-draft"
    };
}
