@page "/requests/new"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Commands.CreateDraft
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest
@using SureBudgetRequest.Application.BudgetRequests.Queries.GetMonthlySpend
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Application.BudgetCategories.Queries
@using SureBudgetRequest.Domain.Enums

<PageTitle>New Budget Request</PageTitle>

<div class="container py-3" style="max-width:640px">
    <h5 class="mb-4">New Budget Request</h5>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (WouldOverflowMonthly)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <span style="font-size:1.25rem; line-height:1">⚠</span>
            <div class="small">
                <strong>This request would push the department over its monthly limit.</strong>
                <div class="mt-1">
                    This month: <strong>@_monthlySpent.ToString("N2")</strong> MMK used
                    of <strong>@_monthlyLimit!.Value.ToString("N2")</strong> MMK.
                    This request adds <strong>@AmountInMmk.ToString("N2")</strong> MMK
                    (total would be <strong>@((_monthlySpent + AmountInMmk).ToString("N2"))</strong> MMK).
                </div>
                <div class="mt-1 text-muted">
                    A written justification will be required when you save or submit.
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label small fw-semibold">Request Type</label>
                <select class="form-select form-select-sm" @bind="_type" @bind:after="OnTypeChanged">
                    <option value="@BudgetRequestType.Standard">Standard</option>
                    <option value="@BudgetRequestType.Urgent">Urgent</option>
                    <option value="@BudgetRequestType.ProjectProposal">Project Proposal</option>
                    <option value="@BudgetRequestType.Advance">Advance</option>
                </select>
                @if (_type == BudgetRequestType.Advance)
                {
                    <div class="form-text small text-muted">
                        An advance is drawn before the spend is known. Finance will set a
                        reconciliation deadline when they approve; you report how the money
                        was spent after it is paid out.
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Request Date</label>
                <input class="form-control form-control-sm" type="date" @bind="_requestDate" />
            </div>

            <div class="row g-2 mb-1">
                <div class="col-4">
                    <label class="form-label small fw-semibold">Currency</label>
                    <select class="form-select form-select-sm" @bind="_currencyCode" @bind:after="OnCurrencyChanged">
                        @foreach (var c in _currencies)
                        {
                            <option value="@c.Code">@c.Code</option>
                        }
                    </select>
                </div>
                <div class="col-8">
                    <label class="form-label small fw-semibold">Amount</label>
                    <input class="form-control form-control-sm" type="number" min="1" step="0.01" @bind="_amount" @bind:after="OnAmountChanged" />
                </div>
            </div>

            @if (_currencyCode != "MMK")
            {
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Exchange Rate (MMK per @_currencyCode)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" 
                           @bind="_selectedRate" @bind:after="OnAmountChanged" />
                    <div class="form-text small text-muted">Default system rate: @_systemRate.ToString("N2")</div>
                </div>
            }

            <div class="form-text small mb-3">
                @if (_currencyCode == "MMK")
                {
                    <span>Department limit comparison is in MMK.</span>
                }
                else if (_selectedRate > 0 && _amount > 0)
                {
                    <span>
                        ≈ <strong>@((_amount * _selectedRate).ToString("N2"))</strong> MMK
                        <span class="text-muted">(at @_selectedRate.ToString("N2") MMK / @_currencyCode)</span>
                    </span>
                }
                else if (_selectedRate > 0)
                {
                    <span class="text-muted">Current rate: 1 @_currencyCode = @_selectedRate.ToString("N2") MMK</span>
                }
            </div>

            @if (_monthlyLimit.HasValue && !WouldOverflowMonthly)
            {
                <div class="form-text small mb-3 text-muted">
                    Monthly spending so far: @_monthlySpent.ToString("N2") /
                    @_monthlyLimit.Value.ToString("N2") MMK
                    (@((_monthlyLimit.Value - _monthlySpent).ToString("N2")) MMK remaining this month).
                </div>
            }

            <div class="mb-3">
                <label class="form-label small fw-semibold">Reason / Purpose</label>
                <textarea class="form-control form-control-sm" rows="3" @bind="_reason" placeholder="Describe what the budget is for…"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Department Head (approver)</label>
                <input class="form-control form-control-sm"
                       value="@(string.IsNullOrEmpty(_deptHeadName) ? "— not assigned —" : _deptHeadName)"
                       disabled />
                @if (_deptHeadId == Guid.Empty)
                {
                    <div class="form-text small text-danger">
                        Your department has no head assigned. Contact admin before submitting a request.
                    </div>
                }
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="allowsPartialNew" @bind="_allowsPartial" />
                    <label class="form-check-label small" for="allowsPartialNew">
                        Accept partial payment (installments)
                    </label>
                </div>
                @if (_allowsPartial)
                {
                    <textarea class="form-control form-control-sm mt-2" rows="2" @bind="_partialDetail"
                              placeholder="Preferred schedule or notes (optional)"></textarea>
                }
                else
                {
                    <div class="form-text small">Finance must pay the full approved amount in one transaction.</div>
                }
            </div>

            <hr class="my-3" />
            <p class="small text-muted mb-2">Withdrawer details (who will collect the money)</p>

            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Full Name</label>
                    <input class="form-control form-control-sm" @bind="_withdrawerName" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Job Title</label>
                    <input class="form-control form-control-sm" @bind="_withdrawerTitle" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Withdraw Method</label>
                <select class="form-select form-select-sm" @bind="_withdrawMethodId">
                    <option value="">— select a method —</option>
                    @foreach (var m in _withdrawMethods)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
                @if (!_withdrawMethods.Any())
                {
                    <div class="form-text small text-danger">
                        No active withdraw methods configured. Ask Finance or Admin to add one.
                    </div>
                }
                @if (SelectedMethodRequiresAttachment)
                {
                    <div class="form-text small text-warning mt-1">
                        ⚠ This method requires a banking-info attachment. You'll be able to
                        upload it after saving the draft. Submission will be blocked until
                        at least one banking file is attached.
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Budget Category <span class="text-muted fw-normal">(optional)</span></label>
                <select class="form-select form-select-sm" @bind="_budgetCategoryId">
                    <option value="">— none —</option>
                    @foreach (var c in _budgetCategories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <div class="form-text small">e.g. Asset or Expense. Your department head can change this during review.</div>
            </div>

        </div>
        <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
            <a href="requests/mine" class="btn btn-sm btn-link text-muted">Cancel</a>
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="() => OnSaveClicked(submit: false)"
                    disabled="@(_saving || _deptHeadId == Guid.Empty)">
                @if (_saving && !_submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Save Draft
            </button>
            <button class="btn btn-sm btn-primary"
                    @onclick="() => OnSaveClicked(submit: true)"
                    disabled="@(_saving || _deptHeadId == Guid.Empty)">
                @if (_saving && _submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Submit
            </button>
        </div>
    </div>
</div>

@* ── Monthly overrun justification modal ────────────────────────────────────── *@
@if (_showOverrunModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Monthly limit overrun — justification required</h6>
                    <button class="btn-close" @onclick="CancelOverrunModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-3">
                        This request of <strong>@AmountInMmk.ToString("N2") MMK</strong> would bring
                        your department's monthly total to
                        <strong>@((_monthlySpent + AmountInMmk).ToString("N2")) MMK</strong>,
                        exceeding the configured monthly limit of
                        <strong>@_monthlyLimit!.Value.ToString("N2") MMK</strong>.
                    </p>
                    <label class="form-label small fw-semibold" for="overrunJustification">
                        Please justify why this overrun is necessary.
                    </label>
                    <textarea id="overrunJustification" class="form-control form-control-sm" rows="4"
                              @bind="_monthlyOverrunJustification" @bind:event="oninput"
                              placeholder="e.g. Quarter-end software license renewal that cannot be deferred…"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelOverrunModal" disabled="@_saving">Cancel</button>
                    <button class="btn btn-sm btn-primary"
                            @onclick="ConfirmOverrunAndSave"
                            disabled="@(_saving || string.IsNullOrWhiteSpace(_monthlyOverrunJustification))">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(_pendingSubmit ? "Confirm and Submit" : "Confirm and Save Draft")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime _requestDate = DateTime.Today;
    private BudgetRequestType _type = BudgetRequestType.Standard;
    private decimal _amount;
    private string _currencyCode = "MMK";
    private decimal _selectedRate = 1m;
    private decimal _systemRate = 1m;
    private string _reason = "";
    private string _withdrawerName = "";
    private string _withdrawerTitle = "";
    private Guid _deptHeadId;
    private string _deptHeadName = "";
    private bool _allowsPartial;
    private string? _partialDetail;
    private string? _error;
    private bool _saving;
    private bool _submitting;
    private List<CurrencyDto> _currencies = new();
    private List<WithdrawMethodDto> _withdrawMethods = new();
    private string _withdrawMethodId = "";
    private List<BudgetCategoryDto> _budgetCategories = new();
    private string _budgetCategoryId = "";

    // Monthly limit state
    private decimal? _monthlyLimit;
    private decimal _monthlySpent;
    private string _monthlyOverrunJustification = "";

    // Overrun modal state
    private bool _showOverrunModal;
    private bool _pendingSubmit;  // true if modal was triggered by "Submit", false if by "Save Draft"

    private decimal AmountInMmk => _amount * _selectedRate;
    private bool WouldOverflowMonthly =>
        _monthlyLimit.HasValue && (_monthlySpent + AmountInMmk) > _monthlyLimit.Value;

    private bool SelectedMethodRequiresAttachment =>
        !string.IsNullOrEmpty(_withdrawMethodId)
        && _withdrawMethods.Any(m => m.Id.ToString() == _withdrawMethodId && m.RequiresAttachment);

    protected override async Task OnInitializedAsync()
    {
        _withdrawerName = CurrentUser.FullName;

        // Load active currencies for the selector
        var currenciesResult = await Mediator.Send(new ListCurrenciesQuery());
        if (currenciesResult.IsSuccess)
        {
            _currencies = currenciesResult.Value.OrderBy(c => c.Code == "MMK" ? 0 : 1).ThenBy(c => c.Code).ToList();
            if (_currencies.Any(c => c.Code == "MMK"))
            {
                _currencyCode = "MMK";
                _systemRate = 1m;
                _selectedRate = 1m;
            }
            else if (_currencies.Any())
            {
                _currencyCode = _currencies[0].Code;
                _systemRate = _currencies[0].RateToMmk;
                _selectedRate = _systemRate;
            }
        }

        // Load active withdraw methods for the selector
        var methodsResult = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: false));
        if (methodsResult.IsSuccess)
        {
            _withdrawMethods = methodsResult.Value.OrderBy(m => m.Name).ToList();
        }

        // Load active budget categories for the optional selector.
        var categoriesResult = await Mediator.Send(new ListBudgetCategoriesQuery(IncludeInactive: false));
        if (categoriesResult.IsSuccess)
        {
            _budgetCategories = categoriesResult.Value.OrderBy(c => c.Name).ToList();
        }

        var deptResult = await Mediator.Send(new GetDepartmentQuery(CurrentUser.DepartmentId));
        if (deptResult.IsFailure) { _error = deptResult.Error.Message; return; }

        // Department may have no head assigned yet (vacancy / fresh-bootstrap case).
        if (!deptResult.Value.HeadUserId.HasValue)
        {
            _error = "Your department has no head assigned. Contact admin before creating a request.";
            StateHasChanged();
            return;
        }

        var headResult = await Mediator.Send(new GetUserQuery(deptResult.Value.HeadUserId.Value));
        if (headResult.IsFailure) { _error = headResult.Error.Message; return; }

        _deptHeadId = headResult.Value.Id;
        _deptHeadName = headResult.Value.FullName;

        // Pull current month's approved spend + the dept's monthly limit so we can
        // show the warning banner and trigger the justification modal as the user types.
        var spendResult = await Mediator.Send(new GetMonthlySpendQuery(CurrentUser.DepartmentId));
        if (spendResult.IsSuccess)
        {
            _monthlyLimit = spendResult.Value.MonthlyLimit;
            _monthlySpent = spendResult.Value.SpentInMmk;
        }

        StateHasChanged();
    }

    private void OnCurrencyChanged()
    {
        var match = _currencies.FirstOrDefault(c => c.Code == _currencyCode);
        _systemRate = match?.RateToMmk ?? 0m;
        _selectedRate = _systemRate;
    }

    // No-op — Advance requests may now use a manual rate, so type changes no longer reset the rate.
    private void OnTypeChanged() { }

    // No-op — needed so the after-binding hook fires and the MMK preview re-renders.
    private void OnAmountChanged() { }

    private async Task OnSaveClicked(bool submit)
    {
        _error = null;
        if (!ValidateForm()) return;

        // If the chosen method requires a banking attachment, direct submissions
        // from this page can't succeed — attachments are added on the Edit page,
        // which only exists after the draft is saved. Save-as-draft is fine and
        // will land the user on the Edit page where they can upload + submit.
        if (submit && SelectedMethodRequiresAttachment)
        {
            _error = "This withdraw method requires a banking-info attachment. " +
                     "Save the draft first, then upload the banking file before submitting.";
            return;
        }

        // Over monthly? Pop the justification modal and let the user fill it in.
        // Submission only proceeds after they hit "Confirm" in the modal.
        if (WouldOverflowMonthly)
        {
            _pendingSubmit = submit;
            _showOverrunModal = true;
            return;
        }

        // Under monthly (or monthly not enforced) — just persist.
        await DoSave(submit);
    }

    private async Task ConfirmOverrunAndSave()
    {
        if (string.IsNullOrWhiteSpace(_monthlyOverrunJustification)) return;
        // Keep the modal open until the save completes; the domain will validate again.
        await DoSave(_pendingSubmit);
        if (string.IsNullOrEmpty(_error))
        {
            _showOverrunModal = false;
        }
    }

    private void CancelOverrunModal()
    {
        _showOverrunModal = false;
        // Intentionally keep _monthlyOverrunJustification so the user doesn't lose their text
        // if they re-open the modal.
    }

    private bool ValidateForm()
    {
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_currencyCode)) { _error = "Currency is required."; return false; }
        if (_selectedRate <= 0) { _error = "Exchange rate must be greater than zero."; return false; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "Reason is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerName)) { _error = "Withdrawer name is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawerTitle)) { _error = "Withdrawer job title is required."; return false; }
        if (string.IsNullOrWhiteSpace(_withdrawMethodId) || !Guid.TryParse(_withdrawMethodId, out _))
        { _error = "Withdraw method is required."; return false; }
        if (_deptHeadId == Guid.Empty || string.IsNullOrWhiteSpace(_deptHeadName))
        { _error = "Department head is not set for your department."; return false; }
        return true;
    }

    private async Task DoSave(bool submit)
    {
        _saving = true;
        _submitting = submit;
        try
        {
            decimal? manualRate = (_selectedRate != _systemRate) 
                ? _selectedRate 
                : null;

            var draftResult = await Mediator.Send(new CreateDraftCommand(
                RequesterId: CurrentUser.UserId,
                DeptHeadId: _deptHeadId,
                Type: _type,
                DeptHeadName: _deptHeadName,
                RequestDate: _requestDate,
                RequestedAmount: _amount,
                CurrencyCode: _currencyCode,
                Reasons: _reason,
                WithdrawerName: _withdrawerName,
                WithdrawerJobTitle: _withdrawerTitle,
                WithdrawMethodId: Guid.Parse(_withdrawMethodId),
                AllowsPartialPayment: _allowsPartial,
                PartialPaymentDetail: _allowsPartial ? _partialDetail : null,
                MonthlyOverrunJustification: string.IsNullOrWhiteSpace(_monthlyOverrunJustification)
                    ? null
                    : _monthlyOverrunJustification,
                ManualExchangeRate: manualRate,
                BudgetCategoryId: string.IsNullOrEmpty(_budgetCategoryId)
                    ? (Guid?)null
                    : Guid.Parse(_budgetCategoryId)));

            if (draftResult.IsFailure) { _error = draftResult.Error.Message; return; }

            if (submit)
            {
                var submitResult = await Mediator.Send(new SubmitRequestCommand(draftResult.Value, CurrentUser.UserId));
                if (submitResult.IsFailure) { _error = submitResult.Error.Message; return; }

                // Submitted → go to read-only Detail page.
                Nav.NavigateTo($"requests/{draftResult.Value}");
            }
            else
            {
                // Draft saved → land on the Edit page so the user can attach files and review before submitting.
                Nav.NavigateTo($"requests/{draftResult.Value}/edit");
            }
        }
        finally { _saving = false; _submitting = false; }
    }
}
