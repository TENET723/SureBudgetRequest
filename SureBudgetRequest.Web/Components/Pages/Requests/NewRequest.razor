@page "/requests/new"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Commands.CreateDraft
@using SureBudgetRequest.Application.BudgetRequests.Commands.SubmitRequest

<PageTitle>New Budget Request</PageTitle>

<div class="container py-3" style="max-width:640px">
    <h5 class="mb-4">New Budget Request</h5>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label small fw-semibold">Request Date</label>
                <input class="form-control form-control-sm" type="date" @bind="_requestDate" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Amount (MMK)</label>
                <input class="form-control form-control-sm" type="number" min="1" step="1000" @bind="_amount" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Reason / Purpose</label>
                <textarea class="form-control form-control-sm" rows="3" @bind="_reason" placeholder="Describe what the budget is for…"></textarea>
            </div>

            <hr class="my-3" />
            <p class="small text-muted mb-2">Withdrawer details (who will collect the money)</p>

            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Full Name</label>
                    <input class="form-control form-control-sm" @bind="_withdrawerName" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold">Job Title</label>
                    <input class="form-control form-control-sm" @bind="_withdrawerTitle" />
                </div>
            </div>

        </div>
        <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
            <a href="requests/mine" class="btn btn-sm btn-link text-muted">Cancel</a>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Save(submit: false)" disabled="@_saving">
                @if (_saving && !_submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Save Draft
            </button>
            <button class="btn btn-sm btn-primary" @onclick="() => Save(submit: true)" disabled="@_saving">
                @if (_saving && _submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Submit
            </button>
        </div>
    </div>
</div>

@code {
    private DateTime _requestDate = DateTime.Today;
    private decimal _amount;
    private string _reason = "";
    private string _withdrawerName = "";
    private string _withdrawerTitle = "";
    private string? _error;
    private bool _saving;
    private bool _submitting;

    protected override void OnInitialized()
    {
        _withdrawerName = CurrentUser.FullName;
    }

    private async Task Save(bool submit)
    {
        _error = null;
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return; }
        if (string.IsNullOrWhiteSpace(_reason)) { _error = "Reason is required."; return; }
        if (string.IsNullOrWhiteSpace(_withdrawerName)) { _error = "Withdrawer name is required."; return; }
        if (string.IsNullOrWhiteSpace(_withdrawerTitle)) { _error = "Withdrawer job title is required."; return; }

        _saving = true;
        _submitting = submit;
        try
        {
            var draftResult = await Mediator.Send(new CreateDraftCommand(
                RequesterId: CurrentUser.UserId,
                RequestDate: _requestDate,
                RequestedAmount: _amount,
                Reasons: _reason,
                WithdrawerName: _withdrawerName,
                WithdrawerJobTitle: _withdrawerTitle,
                AllowsPartialPayment: false,
                PartialPaymentDetail: null));

            if (draftResult.IsFailure) { _error = draftResult.Error; return; }

            if (submit)
            {
                var submitResult = await Mediator.Send(new SubmitRequestCommand(draftResult.Value, CurrentUser.UserId));
                if (submitResult.IsFailure) { _error = submitResult.Error; return; }
            }

            Nav.NavigateTo($"requests/{draftResult.Value}");
        }
        finally { _saving = false; }
    }
}
