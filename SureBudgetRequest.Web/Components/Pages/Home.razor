@page "/"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.BudgetRequests.Commands.ApproveRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.CancelRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.RejectRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.SendBackRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoApproval
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoSubmit
@using SureBudgetRequest.Application.Coas.Queries
@using SureBudgetRequest.Application.Tags.Models
@using SureBudgetRequest.Domain.Common

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetDashboard
@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoReconciliationSubmit
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoRefund
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>Dashboard</PageTitle>

<div class="page-wrap">

    @* ── Header ────────────────────────────────────────────────────────── *@
    <div class="flex items-center justify-between mb-6">
        <h4 style="font-weight:700;text-transform:uppercase;letter-spacing:0.3px">
            WELCOME @CurrentUser.FullName.ToUpper() !
        </h4>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error mb-4">@_errorMessage</div>
    }

    @if (_loading && _data is null)
    {
        <div class="spinner-wrap"><div class="spinner"></div></div>
    }
    else if (_data is not null)
    {
        @* ── Stat cards (role-conditional) ───────────────────────────── *@
        <div class="dash-stat-row">
            @foreach (var card in GetCards())
            {
                <div class="dash-stat-card">
                    <div class="dash-stat-label">@card.Label</div>
                    <div class="dash-stat-value">@card.Value</div>
                    <div class="dash-stat-icon @card.IconClass">
                        @CardIcon(card.IconKey)
                    </div>
                    <div class="dash-stat-sub">@card.Subtitle</div>
                </div>
            }
        </div>

        @* ── Tabs + table ─────────────────────────────────────────────── *@
        <div class="dash-tab-bar">
            @if (ShowApprove)
            {
                <button class="dash-tab @(_activeTab == "approve" ? "active" : "")" @onclick='() => SetTab("approve")'>To Approve</button>
            }
            @if (ShowPay)
            {
                <button class="dash-tab @(_activeTab == "pay" ? "active" : "")" @onclick='() => SetTab("pay")'>@PayLabel</button>
            }
            @if (ShowSettle)
            {
                <button class="dash-tab @(_activeTab == "settle" ? "active" : "")" @onclick='() => SetTab("settle")'>
                    @SettleLabel
                    @if (_data.SettlementQueue!.TotalCount > 0)
                    {
                        <span class="topbar-count-badge ml-1">@_data.SettlementQueue.TotalCount</span>
                    }
                </button>
            }
            <button class="dash-tab @(_activeTab == "actions"   ? "active" : "")" @onclick='() => SetTab("actions")'>My Actions</button>
            <button class="dash-tab @(_activeTab == "inflight"  ? "active" : "")" @onclick='() => SetTab("inflight")'>In Flight</button>
            <button class="dash-tab @(_activeTab == "completed" ? "active" : "")" @onclick='() => SetTab("completed")'>Recently Completed</button>
            @if (ShowStuck)
            {
                <button class="dash-tab @(_activeTab == "stuck" ? "active" : "")" @onclick='() => SetTab("stuck")'>
                    No Movement In 7+ Days
                    @if (_data.StuckRequests!.TotalCount > 0)
                    {
                        <span class="topbar-count-badge ml-1">@_data.StuckRequests.TotalCount</span>
                    }
                </button>
            }
            <span class="dash-tab-spacer"></span>
            <div class="dash-tab-actions">
                <button class="btn btn-icon btn-outline" @onclick="RefreshAsync" disabled="@_loading" title="Refresh">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M4 12a8 8 0 0 1 14.93-4M20 12a8 8 0 0 1-14.93 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M19 4v4h-4M5 20v-4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <a href="requests/new" class="btn btn-primary btn-sm" style="@(CurrentUser.Role == UserRole.Support ? "display:none" : "")">+ New Request</a>
            </div>
        </div>

        @* ── Table body ───────────────────────────────────────────────── *@
        <div class="dash-table-wrapper">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th class="col-no">No</th>
                        <th role="button" style="cursor:pointer"
                            @onclick='() => SortByColumn("submitted")'>
                            Request ID & Date @(SortIndicator("submitted") != "" ? SortIndicator("submitted") : SortIndicator("ref"))
                        </th>
                        <th role="button" style="cursor:pointer"
                            @onclick='() => SortByColumn("name")'>
                            Name @SortIndicator("name")
                        </th>
                        <th>Description</th>
                        <th>Tags</th>
                        <th role="button" style="cursor:pointer"
                            @onclick='() => SortByColumn("status")'>
                            Status @SortIndicator("status")
                        </th>
                        <th class="sticky-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rows = SortRows(GetActiveTabRows());
                        var page = _page;
                        var pageSize = 14;
                        var paged = rows.Skip((page - 1) * pageSize).Take(pageSize).ToList();
                        var totalPages = (int)Math.Ceiling(rows.Count / (double)pageSize);
                        if (totalPages < 1) totalPages = 1;
                    }
                    @if (!paged.Any())
                    {
                        <tr><td colspan="7" class="empty-cell">Nothing here.</td></tr>
                    }
                    else
                    {
                        var globalIdx = (page - 1) * pageSize;
                        @foreach (var r in paged)
                        {
                            globalIdx++;
                            var idx = globalIdx;
                            <tr class="clickable-row @(_contextMenuTarget?.Id == r.Id ? "menu-open" : "")"
                                @onclick="() => OpenRequestSmart(r)"
                                @oncontextmenu="e => OpenContextMenu(e, r)"
                                @oncontextmenu:preventDefault="true">
                                <td class="col-no">@idx</td>
                                <td class="text-sm">
                                    <div><strong>@(r.Reference ?? ShortId(r.Id))</strong></div>
                                    <div class="text-muted text-xs">@r.SubmittedAt.ToMyanmarTime()</div>
                                </td>
                                <td class="text-sm">@RequesterName(r.RequesterId)</td>
                                <td class="text-sm text-muted">@Truncate(r.Reasons, 40)</td>
                                <td class="text-sm">
                                    @if (r.Tags != null && r.Tags.Count > 0)
                                    {
                                        <div class="flex items-center gap-1 flex-wrap">
                                            @foreach (var tag in r.Tags.Take(5))
                                            {
                                                <span class="tag-badge-pill"
                                                      style="background-color: @(tag.ColorHex ?? "#6c757d"); color: @tag.EffectiveFontColor;">
                                                    #@tag.Name
                                                </span>
                                            }
                                            @if (r.Tags.Count > 5)
                                            {
                                                var overflowCount = r.Tags.Count - 5;
                                                <div class="tag-tooltip-container" @onclick:stopPropagation="true">
                                                    <span class="tag-badge-pill" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 600; cursor: pointer;">
                                                        +@overflowCount
                                                    </span>
                                                    <div class="tag-tooltip-popup">
                                                        @foreach (var ot in r.Tags.Skip(5))
                                                        {
                                                            <span>#@ot.Name</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs">—</span>
                                    }
                                </td>
                                <td><span class="@StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span></td>
                                <td class="sticky-action-col" @onclick:stopPropagation="true">
                                    <div class="row-hover-btn-wrapper">
                                        <div class="row-hover-backdrop"></div>
                                        <button type="button" class="btn-three-dots" title="Quick actions"
                                                @onclick="e => OpenContextMenuFromButton(e, r)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                <circle cx="12" cy="5" r="2"/>
                                                <circle cx="12" cy="12" r="2"/>
                                                <circle cx="12" cy="19" r="2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ── Pagination ───────────────────────────────────────────────── *@
        @if (totalPages > 1)
        {
            <div class="dash-pagination">
                <button class="dash-page-btn" @onclick="() => SetPage(_page - 1)" disabled="@(_page <= 1)">‹</button>
                @for (var p = 1; p <= totalPages; p++)
                {
                    var pg = p;
                    @if (p <= 2 || p >= totalPages - 1 || Math.Abs(p - _page) <= 1)
                    {
                        <button class="dash-page-btn @(_page == pg ? "active" : "")" @onclick="() => SetPage(pg)">@pg</button>
                    }
                    else if (p == 3 && _page > 4)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                }
                <button class="dash-page-btn" @onclick="() => SetPage(_page + 1)" disabled="@(_page >= totalPages)">›</button>
            </div>
        }
    }
</div>

@* ── Cancel confirmation modal ────────────────────────────────────────────── *@
@if (_cancellingRequest is not null)
{
    <ConfirmDialog Title="Cancel Request"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoCancel"
                   OnCancel="() => _cancellingRequest = null">
        Are you sure you want to cancel request <strong>@(_cancellingRequest.Reference ?? "Draft")</strong> (@_cancellingRequest.RequestedAmount.ToString("N2") @_cancellingRequest.CurrencyCode)? This action cannot be undone.
    </ConfirmDialog>
}

@if (_unsubmittingRequest is not null)
{
    <ConfirmDialog Title="Withdraw to Draft"
                   Type="ConfirmType.Warning"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoSubmit"
                   OnCancel="() => _unsubmittingRequest = null">
        Withdraw request <strong>@(_unsubmittingRequest.Reference ?? "this request")</strong> back to draft?
        <div class="alert alert-warning text-xs mt-3">
            The request will return to <strong>Draft</strong> so you can edit details or attachments before resubmitting.
        </div>
    </ConfirmDialog>
}

@* ── Withdraw / Reopen Reconciliation confirmation modal ── *@
@if (_withdrawingReconciliationRequest is not null)
{
    <ConfirmDialog Title="Reopen Reconciliation"
                   Type="ConfirmType.Warning"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoReconciliationSubmit"
                   OnCancel="() => _withdrawingReconciliationRequest = null">
        Reopen reconciliation for advance <strong>@(_withdrawingReconciliationRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the advance to <strong>Reconciliation in Progress</strong> so expense line items can be adjusted. All recorded entries and receipts will be kept.
        </div>
    </ConfirmDialog>
}

@* ── Undo Refund confirmation modal ── *@
@if (_undoingRefundRequest is not null)
{
    <ConfirmDialog Title="Undo Refund Receipt"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoRefund"
                   OnCancel="() => _undoingRefundRequest = null">
        Undo recorded refund receipt for <strong>@(_undoingRefundRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the request to <strong>Awaiting Refund</strong> until the refund payment is confirmed again.
        </div>
    </ConfirmDialog>
}

@* ── Custom Context Menu / Quick Actions ────────────────────────────────── *@
@if (_showContextMenu && _contextMenuTarget != null)
{
    <div style="position: fixed; inset: 0; z-index: 1045; cursor: default; background: transparent;"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@(_contextMenuTarget.Reference ?? "Draft / No Ref")</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => NavigateToDetail(_contextMenuTarget.Id)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span>Open Details</span>
        </button>

        @if (_contextMenuTarget.Status is RequestStatus.Draft or RequestStatus.SentBack && _contextMenuTarget.RequesterId == CurrentUser.UserId)
        {
            <button type="button" class="context-menu-item" @onclick="() => NavigateToEdit(_contextMenuTarget.Id)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit Request</span>
            </button>
        }

        <button type="button" class="context-menu-item" @onclick="() => OpenInNewTab(_contextMenuTarget)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>Open in New Tab</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (!string.IsNullOrEmpty(_contextMenuTarget.Reference))
        {
            <button type="button" class="context-menu-item" @onclick="() => CopyReferenceAsync(_contextMenuTarget.Reference)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Copy Reference</span>
            </button>
        }

        @if (CanUserAttachTag(_contextMenuTarget))
        {
            <button type="button" class="context-menu-item" @onclick="() => OpenTagPopoverFromContextMenu(_contextMenuTarget)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <span>Manage Tags</span>
            </button>
        }

        @{
            var undoApproveState = GetUndoApproveActionState(_contextMenuTarget);
            var undoSubmitState = GetUndoSubmitActionState(_contextMenuTarget);
            var showApproverActions = CurrentUser.Role != UserRole.Admin && _activeTab == "approve" && ShouldShowStatusActionsSection();

            var isRequester = _contextMenuTarget.RequesterId == CurrentUser.UserId;
            var requiresManagement = _contextMenuTarget.RequestedAmountInMmkAtSubmission > _contextMenuTarget.DepartmentLimitAtSubmission;
            var isDeptHeadRequester = _contextMenuTarget.RequesterId == _contextMenuTarget.DeptHeadIdAtSubmission;
            var canCancel = isRequester && (_contextMenuTarget.Status == RequestStatus.PendingDeptHead
                || (isDeptHeadRequester && (_contextMenuTarget.Status == RequestStatus.PendingManagement || (_contextMenuTarget.Status == RequestStatus.PendingFinance && !requiresManagement))));
            var showRequesterActions = _activeTab == "inflight" && isRequester;

            var showStatusSection = showApproverActions || CurrentUser.Role == UserRole.Admin || showRequesterActions;
        }

        @if (showStatusSection)
        {
            var approveState = GetApproveActionState(_contextMenuTarget);
            var sendBackState = GetSendBackActionState(_contextMenuTarget);
            var rejectState = GetRejectActionState(_contextMenuTarget);

            <div class="context-menu-divider"></div>
            <div class="menu-section-title">Status Actions</div>

            @if (showApproverActions)
            {
                <button type="button"
                        class="status-action-item action-approve"
                        disabled="@(!approveState.Enabled || _quickActionProcessing)"
                        @onclick="() => ExecuteQuickApproveAsync(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Approve</span>
                    </div>
                    @if (!approveState.Enabled && !string.IsNullOrEmpty(approveState.Reason))
                    {
                        <span class="action-reason-hint">@approveState.Reason</span>
                    }
                </button>

                <button type="button"
                        class="status-action-item action-sendback"
                        disabled="@(!sendBackState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.SendBack)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
                        <span>Send Back</span>
                    </div>
                    @if (!sendBackState.Enabled && !string.IsNullOrEmpty(sendBackState.Reason))
                    {
                        <span class="action-reason-hint">@sendBackState.Reason</span>
                    }
                </button>

                <button type="button"
                        class="status-action-item action-reject"
                        disabled="@(!rejectState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.Reject)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span>Reject</span>
                    </div>
                    @if (!rejectState.Enabled && !string.IsNullOrEmpty(rejectState.Reason))
                    {
                        <span class="action-reason-hint">@rejectState.Reason</span>
                    }
                </button>
            }

            @if (CurrentUser.Role == UserRole.Admin)
            {
                var undoInfo = GetUndoApprovalTargetInfo(_contextMenuTarget);
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@(!undoApproveState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.UndoApprove)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>@(string.IsNullOrEmpty(undoInfo.Stage) ? "Undo Approval" : $"Undo {undoInfo.Stage} Approval")</span>
                    </div>
                    @if (undoApproveState.Enabled && !string.IsNullOrEmpty(undoInfo.TargetStatus))
                    {
                        <span class="action-reason-hint" style="color: var(--color-warning);">Reverts to @undoInfo.TargetStatus</span>
                    }
                    else if (!string.IsNullOrEmpty(undoApproveState.Reason))
                    {
                        <span class="action-reason-hint">@undoApproveState.Reason</span>
                    }
                </button>
            }

            @if (showRequesterActions)
            {
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@(!undoSubmitState.Enabled || _quickActionProcessing)"
                        style="@(!undoSubmitState.Enabled ? "opacity: 0.5; cursor: not-allowed;" : "")"
                        title="@(undoSubmitState.Enabled ? "Withdraw this request to draft" : GetCancelDisabledReason(_contextMenuTarget.Status))"
                        @onclick="() => { if (undoSubmitState.Enabled) PromptUndoSubmitFromContextMenu(_contextMenuTarget); }">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>Unsubmit Request</span>
                    </div>
                    @if (!undoSubmitState.Enabled)
                    {
                        <span class="action-reason-hint">@GetCancelDisabledReason(_contextMenuTarget.Status)</span>
                    }
                </button>

                <button type="button"
                        class="status-action-item action-reject"
                        disabled="@(!canCancel || _quickActionProcessing)"
                        style="@(!canCancel ? "opacity: 0.5; cursor: not-allowed;" : "")"
                        title="@(canCancel ? "Cancel this request" : GetCancelDisabledReason(_contextMenuTarget.Status))"
                        @onclick="() => { if (canCancel) PromptCancelFromContextMenu(_contextMenuTarget); }">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        <span>Cancel Request</span>
                    </div>
                    @if (!canCancel)
                    {
                        <span class="action-reason-hint">@GetCancelDisabledReason(_contextMenuTarget.Status)</span>
                    }
                </button>
            }

            @if (CanWithdrawReconciliation(_contextMenuTarget))
            {
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@_quickActionProcessing"
                        title="@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen reconciliation to pending" : "Withdraw reconciliation to pending")"
                        @onclick="() => PromptUndoReconciliationFromContextMenu(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen Reconciliation" : "Withdraw Reconciliation")</span>
                    </div>
                </button>
            }

            @if (CanUndoRefund(_contextMenuTarget))
            {
                <button type="button"
                        class="status-action-item action-reject"
                        disabled="@_quickActionProcessing"
                        title="Undo recorded refund"
                        @onclick="() => PromptUndoRefundFromContextMenu(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                        <span>Undo Refund</span>
                    </div>
                </button>
            }
        }
    </div>
}

@* ── Anchored Tag Popover Box ─────────────────────────────────────────────── *@
<RequestTagPopover IsOpen="_showTagPopover"
                   Target="_tagPopoverTarget"
                   X="_tagPopoverX"
                   Y="_tagPopoverY"
                   IsButtonAnchor="_tagPopoverIsButton"
                   OnClose="CloseTagPopover"
                   OnTagsChanged="args => UpdateDashboardTags(args.RequestId, args.Tags)"
                   OnToast="ShowToast" />

@* ── Quick Status Action Popover (Anchored like Tag Management) ───────────── *@
@if (_showQuickActionModal && _quickActionTarget != null)
{
    <div style="position: fixed; inset: 0; z-index: 1055; cursor: default; background: transparent;"
         @onclick="CloseQuickActionModal"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseQuickActionModal"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_quickActionRef" class="tag-popover-box"
         style="left: @(_quickActionX)px; top: @(_quickActionY)px; width: 310px;"
         @onclick:stopPropagation="true">
        <div class="popover-header">
            <div>
                <div class="popover-title">
                    @if (_quickActionType == QuickActionType.SendBack)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Send Back Request</span>
                    }
                    else if (_quickActionType == QuickActionType.Reject)
                    {
                        <span style="color: var(--color-danger); font-weight: 700;">✕</span>
                        <span>Reject Request</span>
                    }
                    else if (_quickActionType == QuickActionType.FinanceApprove)
                    {
                        <span style="color: var(--color-success); font-weight: 700;">✓</span>
                        <span>Finance Approval</span>
                    }
                    else if (_quickActionType == QuickActionType.UndoApprove)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Undo Approval</span>
                    }
                    else if (_quickActionType == QuickActionType.UndoSubmit)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Undo Submission</span>
                    }
                </div>
                <div class="popover-ref-subtitle">
                    @(_quickActionTarget.Reference ?? "Draft / No Ref")
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-xs"
                    style="padding: 1px 4px; border: none; background: transparent; color: var(--color-text-muted); cursor: pointer;"
                    @onclick="CloseQuickActionModal" title="Close">✕</button>
        </div>

        @if (!string.IsNullOrEmpty(_quickActionError))
        {
            <div class="alert alert-error" style="font-size: 11px; padding: 4px 8px; margin: 6px 10px 0;">
                @_quickActionError
            </div>
        }

        <div style="padding: 10px 12px;">
            @if (_quickActionType == QuickActionType.FinanceApprove)
            {
                <div class="mb-2">
                    <label class="form-label text-xs font-semibold mb-1 block" style="font-size: 11px;">Chart of Account (COA) <span style="color: var(--color-danger);">*</span></label>
                    <select class="input input-sm w-full" @bind="_quickFinanceCoaId">
                        <option value="">-- Select Chart of Account --</option>
                        @foreach (var c in _coas.Where(c => c.IsActive))
                        {
                            <option value="@c.Id">@c.Code - @c.Name</option>
                        }
                    </select>
                </div>
                @if (_quickActionTarget.Type == BudgetRequestType.Advance)
                {
                    <div class="mb-2">
                        <label class="form-label text-xs font-semibold mb-1 block" style="font-size: 11px;">Reconciliation Deadline <span style="color: var(--color-danger);">*</span></label>
                        <input type="date" class="input input-sm w-full" @bind="_quickFinanceReconciliationDeadline" />
                    </div>
                }
            }
            else if (_quickActionType == QuickActionType.UndoSubmit)
            {
                <p class="text-xs text-muted mb-2">
                    Withdraw this submission and return it to <strong>Draft</strong> status so you can edit details or attachments.
                </p>
            }
            else if (_quickActionType == QuickActionType.UndoApprove)
            {
                var undoInfo = GetUndoApprovalTargetInfo(_quickActionTarget);
                <p class="text-xs text-muted mb-2">
                    Revoke <strong>@(undoInfo.Stage)</strong> approval and revert this request back to <strong>@(undoInfo.TargetStatus)</strong>.
                </p>
                <label class="block text-xs font-semibold mb-1" style="font-size: 11.5px; color: var(--color-text-dark);">
                    Reason / Comment <span class="text-muted">(optional)</span>
                </label>
                <textarea class="input input-sm w-full" rows="2"
                          style="resize: none; font-size: 12px; padding: 6px 8px;"
                          placeholder="Optional reason for undoing approval..."
                          @bind="_quickActionComment"
                          @bind:event="oninput"></textarea>
            }
            else
            {
                <label class="block text-xs font-semibold mb-1" style="font-size: 11.5px; color: var(--color-text-dark);">
                    @(_quickActionType == QuickActionType.SendBack ? "Reason / Comments for Requester" : "Rejection Reason")
                    <span style="color: var(--color-danger);">*</span>
                </label>
                <textarea class="input input-sm w-full" rows="3"
                          style="resize: none; font-size: 12px; padding: 6px 8px;"
                          placeholder="@(_quickActionType == QuickActionType.SendBack ? "Explain what needs revision..." : "Explain why this request is rejected...")"
                          @bind="_quickActionComment"
                          @bind:event="oninput"
                          autofocus></textarea>
                <div class="flex justify-between items-center text-muted mt-1" style="font-size: 10px;">
                    <span>Mandatory for audit trail</span>
                    <span>@(_quickActionComment?.Length ?? 0) chars</span>
                </div>
            }
        </div>

        <div class="popover-footer-action" style="display: flex; justify-content: flex-end; gap: 6px; padding: 8px 12px; background: #fafafa; border-top: 1px solid var(--color-border);">
            <button type="button" class="btn btn-outline btn-xs"
                    style="padding: 3px 8px; font-size: 11.5px;"
                    @onclick="CloseQuickActionModal" disabled="@_quickActionProcessing">
                Cancel
            </button>
            <button type="button"
                    class="btn btn-xs @(_quickActionType == QuickActionType.Reject ? "btn-danger" : (_quickActionType == QuickActionType.SendBack || _quickActionType == QuickActionType.UndoApprove || _quickActionType == QuickActionType.UndoSubmit) ? "btn-warning" : "btn-success")"
                    style="padding: 3px 10px; font-size: 11.5px; font-weight: 600;"
                    @onclick="ExecuteQuickModalActionAsync"
                    disabled="@_quickActionProcessing">
                @if (_quickActionProcessing)
                {
                    <span class="spinner spinner-xs me-1"></span>
                }
                @(_quickActionType == QuickActionType.Reject ? "Confirm Reject" :
                  _quickActionType == QuickActionType.SendBack ? "Confirm Send Back" :
                  _quickActionType == QuickActionType.UndoApprove ? "Confirm Undo" :
                  _quickActionType == QuickActionType.UndoSubmit ? "Withdraw to Draft" : "Confirm Approval")
            </button>
        </div>
    </div>
}

@* ── Toast Notification ───────────────────────────────────────────────────── *@
@if (_showToast)
{
    <div class="toast-notification">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2EC662" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@_toastMessage</span>
    </div>
}

@code {
    private DashboardDto? _data;
    private bool _loading = true;
    private string? _errorMessage;
    private string _activeTab = "inflight";
    private int _page = 1;

    // ── Role-conditional visibility ───────────────────────────────────────
    //
    // The query already populates sections per role; the flags below only
    // decide what to RENDER. Finance payer-only users (IsFinanceApprover ==
    // false) get the approval queue from the query but never see it — hiding
    // is intentionally client-side (display concern, no domain guard needed).

    private bool ShowApprove =>
        _data?.MyApprovalQueue is not null &&
        (CurrentUser.Role != UserRole.Finance || CurrentUser.IsFinanceApprover);

    private bool ShowPay => _data?.PaymentQueue is not null;   // Finance + Accounting

    private bool ShowSettle =>
        _data?.SettlementQueue is not null;   // Finance + Accounting

    private bool ShowStuck => _data?.StuckRequests is not null; // Admin

    // Accounting is read-only — frame the queue as awareness, not action.
    private string PayLabel =>
        CurrentUser.Role == UserRole.Accounting ? "Awaiting Payment" : "To Pay";

    private string SettleLabel =>
        CurrentUser.Role == UserRole.Accounting ? "Awaiting Settlement" : "To Settle";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role == UserRole.Support)
        {
            Nav.NavigateTo("/admin/users", replace: true);
            return;
        }
        await LoadAsync();
        if (FilterState.Dashboard is not null)
        {
            _activeTab = FilterState.Dashboard.ActiveTab;
            _page = FilterState.Dashboard.Page;
            _sortCol = FilterState.Dashboard.SortColumn;
            _sortDesc = FilterState.Dashboard.SortDescending;
        }
        else
        {
            SetDefaultTab();
        }
    }

    private async Task RefreshAsync() => await LoadAsync(); // keeps current tab

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var result = await Mediator.Send(new GetDashboardQuery());
            if (result.IsSuccess)
                _data = result.Value;
            else
                _errorMessage = result.Error.Message;

            if (CurrentUser.Role == UserRole.Finance && CurrentUser.IsFinanceApprover && !_coas.Any())
            {
                var coas = await Mediator.Send(new ListCoasQuery(IncludeInactive: true));
                if (coas.IsSuccess)
                    _coas = coas.Value!.OrderBy(c => c.Code).ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    // Default tab by role priority: the user's most actionable queue wins.
    // Single chain works for every role because the sections are role-gated:
    //   approve (DeptHead/Mgmt/Finance-approver) → pay (Finance/Accounting)
    //   → stuck (Admin) → my actions → in flight.
    private void SetDefaultTab()
    {
        if (_data is null) return;

        if (ShowApprove && _data.MyApprovalQueue!.TotalCount > 0)      _activeTab = "approve";
        else if (ShowPay && _data.PaymentQueue!.TotalCount > 0)        _activeTab = "pay";
        else if (ShowSettle && _data.SettlementQueue!.TotalCount > 0)  _activeTab = "settle";
        else if (ShowStuck && _data.StuckRequests!.TotalCount > 0)     _activeTab = "stuck";
        else if (_data.Employee.ActionRequired.Count > 0)              _activeTab = "actions";
        else                                                           _activeTab = "inflight";
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        _page = 1;
        // Each tab starts from the default order: newest-submitted first.
        _sortCol = "submitted";
        _sortDesc = true;
        SaveDashboardState();
    }

    private void SetPage(int p)
    {
        _page = p;
        SaveDashboardState();
    }

    private void SaveDashboardState()
    {
        FilterState.Dashboard = new DashboardFilterState
        {
            ActiveTab = _activeTab,
            Page = _page,
            SortColumn = _sortCol,
            SortDescending = _sortDesc
        };
    }

    // ── Sorting (client-side — dashboard rows are already in memory) ──────
    // Default: submission time, newest first. Drafts (null SubmittedAt) are
    // treated as newest so they stay on top in the My Actions tab.
    private string _sortCol = "submitted";   // "ref" | "name" | "submitted" | "status"
    private bool _sortDesc = true;

    private void SortByColumn(string col)
    {
        if (_sortCol == col)
            _sortDesc = !_sortDesc;
        else
        {
            _sortCol = col;
            _sortDesc = col == "submitted";
        }
        _page = 1;
        SaveDashboardState();
    }

    private string SortIndicator(string col) =>
        _sortCol == col ? (_sortDesc ? "▼" : "▲") : "";

    private List<BudgetRequestSummaryDto> SortRows(IReadOnlyList<BudgetRequestSummaryDto> rows)
    {
        IOrderedEnumerable<BudgetRequestSummaryDto> ordered = _sortCol switch
        {
            "ref" => _sortDesc
                ? rows.OrderByDescending(r => r.Reference ?? "")
                : rows.OrderBy(r => r.Reference ?? ""),
            "name" => _sortDesc
                ? rows.OrderByDescending(r => RequesterName(r.RequesterId))
                : rows.OrderBy(r => RequesterName(r.RequesterId)),
            "status" => _sortDesc
                ? rows.OrderByDescending(r => r.Status)
                : rows.OrderBy(r => r.Status),
            // "submitted" is the default. Null SubmittedAt (drafts) sorts as
            // MaxValue: first when descending, last when ascending.
            _ => _sortDesc
                ? rows.OrderByDescending(r => r.SubmittedAt ?? DateTime.MaxValue)
                : rows.OrderBy(r => r.SubmittedAt ?? DateTime.MaxValue),
        };

        return ordered.ThenByDescending(r => r.CreatedAt).ToList();
    }

    private IReadOnlyList<BudgetRequestSummaryDto> GetActiveTabRows()
    {
        if (_data is null) return Array.Empty<BudgetRequestSummaryDto>();

        var empty = (IReadOnlyList<BudgetRequestSummaryDto>)Array.Empty<BudgetRequestSummaryDto>();
        return _activeTab switch
        {
            "approve"   => _data.MyApprovalQueue?.TopItems ?? empty,
            "pay"       => _data.PaymentQueue?.TopItems ?? empty,
            "settle"    => _data.SettlementQueue?.TopItems ?? empty,
            "actions"   => _data.Employee.ActionRequired,
            "inflight"  => _data.Employee.InFlight,
            "completed" => _data.Employee.RecentlyCompleted,
            "stuck"     => _data.StuckRequests?.TopItems ?? empty,
            _           => empty
        };
    }

    // ── Stat cards ────────────────────────────────────────────────────────

    private sealed record CardSpec(string Label, string Value, string IconKey, string IconClass, string Subtitle);

    // Max 4 cards per role, most actionable first. Subtitles are real data
    // (oldest item age) or plain descriptions — never decorative trends.
    private IEnumerable<CardSpec> GetCards()
    {
        if (_data is null) yield break;

        if (ShowApprove)
        {
            var q = _data.MyApprovalQueue!;
            yield return new("To Approve", q.TotalCount.ToString(),
                "approve", "dash-stat-icon-pending", QueueSubtitle(q.TopItems));
        }

        if (ShowPay)
        {
            var q = _data.PaymentQueue!;
            yield return new(PayLabel, q.TotalCount.ToString(),
                "pay", "dash-stat-icon-pay", QueueSubtitle(q.TopItems));
        }

        if (_data.FinanceMetrics is not null)
        {
            yield return new("Outstanding (MMK)", FormatCompact(_data.FinanceMetrics.OutstandingTotalMmk),
                "money", "dash-stat-icon-money", "Approved, awaiting payment");
        }

        if (ShowStuck)
        {
            yield return new("Stuck Requests", _data.StuckRequests!.TotalCount.ToString(),
                "stuck", "dash-stat-icon-stuck", "No movement in 7+ days");
        }

        yield return new("Needs My Attention", _data.Employee.ActionRequired.Count.ToString(),
            "action", "dash-stat-icon-action", "Drafts & sent-back requests");

        // Fill remaining slots up to 4 with the user's own pipeline.
        var used = (ShowApprove ? 1 : 0) + (ShowPay ? 1 : 0)
                 + (_data.FinanceMetrics is not null ? 1 : 0) + (ShowStuck ? 1 : 0) + 1;

        if (used < 4)
        {
            yield return new("In Flight", _data.Employee.InFlight.Count.ToString(),
                "flight", "dash-stat-icon-flight", "Awaiting approval or payment");
            used++;
        }
        if (used < 4)
        {
            yield return new("Recently Completed", _data.Employee.RecentlyCompleted.Count.ToString(),
                "complete", "dash-stat-icon-complete", "Last finalized requests");
        }
    }

    private static string QueueSubtitle(IReadOnlyList<BudgetRequestSummaryDto> items)
    {
        if (items.Count == 0) return "Queue is clear";

        var oldest = items
            .Where(i => i.SubmittedAt.HasValue)
            .Select(i => i.SubmittedAt!.Value)
            .DefaultIfEmpty(DateTime.UtcNow)
            .Min();

        var days = (int)(DateTime.UtcNow - oldest).TotalDays;
        return days switch
        {
            <= 0 => "Newest arrived today",
            1    => "Oldest waiting 1 day",
            _    => $"Oldest waiting {days} days"
        };
    }

    // Compact MMK formatting so large totals fit the stat-value slot.
    private static string FormatCompact(decimal v) => v switch
    {
        >= 1_000_000_000m => $"{v / 1_000_000_000m:0.#}B",
        >= 1_000_000m     => $"{v / 1_000_000m:0.#}M",
        >= 10_000m        => $"{v / 1_000m:0.#}K",
        _                 => v.ToString("N0")
    };

