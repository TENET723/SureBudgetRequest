@page "/"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetDashboard
@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Dashboard</PageTitle>

<div class="page-wrap">

    @* ── Header ────────────────────────────────────────────────────────── *@
    <div class="flex items-center justify-between mb-6">
        <h4 style="font-weight:700;text-transform:uppercase;letter-spacing:0.3px">
            WELCOME @CurrentUser.FullName.ToUpper() !
        </h4>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error mb-4">@_errorMessage</div>
    }

    @if (_loading && _data is null)
    {
        <div class="spinner-wrap"><div class="spinner"></div></div>
    }
    else if (_data is not null)
    {
        @* ── Stat cards ──────────────────────────────────────────────── *@
        <div class="dash-stat-row">
            <div class="dash-stat-card">
                <div class="dash-stat-label">Pending Requests</div>
                <div class="dash-stat-value">@_pendingCount</div>
                <div class="dash-stat-icon dash-stat-icon-pending">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M3 9h18M8 4V2M16 4V2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M8 13h4M8 16h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="dash-stat-trend">
                    <span class="trend-up">↑ Pending</span> approvals in queue
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-label">Pending Actions</div>
                <div class="dash-stat-value">@_data.Employee.ActionRequired.Count</div>
                <div class="dash-stat-icon dash-stat-icon-action">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                </div>
                <div class="dash-stat-trend">
                    <span class="trend-up">↑</span> Action required from you
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-label">Request In Flight</div>
                <div class="dash-stat-value">@_data.Employee.InFlight.Count</div>
                <div class="dash-stat-icon dash-stat-icon-flight">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M6 14h4M14 14h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="dash-stat-trend">
                    <span class="trend-down">↓</span> Currently in progress
                </div>
            </div>
            <div class="dash-stat-card">
                <div class="dash-stat-label">Completed</div>
                <div class="dash-stat-value">@_data.Employee.RecentlyCompleted.Count</div>
                <div class="dash-stat-icon dash-stat-icon-complete">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M8 12l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="dash-stat-trend">
                    <span class="trend-up">↑</span> Recently finalized
                </div>
            </div>
        </div>

        @* ── Tabs + table ─────────────────────────────────────────────── *@
        <div class="dash-tab-bar">
            <button class="dash-tab @(_activeTab == "pending"   ? "active" : "")" @onclick='() => SetTab("pending")'>Pending Requests</button>
            <button class="dash-tab @(_activeTab == "actions"   ? "active" : "")" @onclick='() => SetTab("actions")'>Pending Actions</button>
            <button class="dash-tab @(_activeTab == "inflight"  ? "active" : "")" @onclick='() => SetTab("inflight")'>Request in flight</button>
            <button class="dash-tab @(_activeTab == "completed" ? "active" : "")" @onclick='() => SetTab("completed")'>Recently completed</button>
            @if (_data.StuckRequests is not null && _data.StuckRequests.TotalCount > 0)
            {
                <button class="dash-tab @(_activeTab == "stuck" ? "active" : "")" @onclick='() => SetTab("stuck")'>
                    No Movements In +7 Days
                    <span class="topbar-count-badge ml-1">@_data.StuckRequests.TotalCount</span>
                </button>
            }
            <span class="dash-tab-spacer"></span>
            <div class="dash-tab-actions">
                <button class="btn btn-icon btn-outline" @onclick="RefreshAsync" disabled="@_loading" title="Refresh">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M4 12a8 8 0 0 1 14.93-4M20 12a8 8 0 0 1-14.93 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M19 4v4h-4M5 20v-4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <a href="requests/new" class="btn btn-primary btn-sm">+ New Request</a>
            </div>
        </div>

        @* ── Table body ───────────────────────────────────────────────── *@
        <div class="dash-table-wrapper">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th class="col-no">No</th>
                        <th>Request ID</th>
                        <th>Name</th>
                        <th>Submitted At</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rows = GetActiveTabRows();
                        var page = _page;
                        var pageSize = 14;
                        var paged = rows.Skip((page - 1) * pageSize).Take(pageSize).ToList();
                        var totalPages = (int)Math.Ceiling(rows.Count / (double)pageSize);
                        if (totalPages < 1) totalPages = 1;
                    }
                    @if (!paged.Any())
                    {
                        <tr><td colspan="7" class="empty-cell">Nothing here.</td></tr>
                    }
                    else
                    {
                        var globalIdx = (page - 1) * pageSize;
                        @foreach (var r in paged)
                        {
                            globalIdx++;
                            var idx = globalIdx;
                            <tr @onclick="() => OpenRequestSmart(r)" class="clickable-row">
                                <td class="col-no">@idx</td>
                                <td class="text-sm"><strong>@(r.Reference ?? ShortId(r.Id))</strong></td>
                                <td class="text-sm">@RequesterName(r.RequesterId)</td>
                                <td class="text-sm text-muted">
                                    @(r.SubmittedAt.HasValue
                                        ? r.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                        : "—")
                                </td>
                                <td class="text-sm text-muted">@Truncate(r.Reasons, 40)</td>
                                <td><span class="@StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span></td>
                                <td>
                                    <button class="row-kebab" @onclick:stopPropagation="true"
                                            @onclick="() => OpenRequest(r.Id)" title="View">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                            <circle cx="12" cy="5"  r="1.5" fill="currentColor"/>
                                            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                                            <circle cx="12" cy="19" r="1.5" fill="currentColor"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ── Pagination ───────────────────────────────────────────────── *@
        @if (totalPages > 1)
        {
            <div class="dash-pagination">
                <button class="dash-page-btn" @onclick="() => _page--" disabled="@(_page <= 1)">‹</button>
                @for (var p = 1; p <= totalPages; p++)
                {
                    var pg = p;
                    @if (p <= 2 || p >= totalPages - 1 || Math.Abs(p - _page) <= 1)
                    {
                        <button class="dash-page-btn @(_page == pg ? "active" : "")" @onclick="() => { _page = pg; }">@pg</button>
                    }
                    else if (p == 3 && _page > 4)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                }
                <button class="dash-page-btn" @onclick="() => _page++" disabled="@(_page >= totalPages)">›</button>
            </div>
        }
    }
</div>

@code {
    private DashboardDto? _data;
    private bool _loading = true;
    private string? _errorMessage;
    private string _activeTab = "pending";
    private int _page = 1;

    // Computed pending count: approval queue + payment queue
    private int _pendingCount =>
        (_data?.MyApprovalQueue?.TotalCount ?? 0) +
        (_data?.PaymentQueue?.TotalCount ?? 0);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var result = await Mediator.Send(new GetDashboardQuery());
            if (result.IsSuccess)
                _data = result.Value;
            else
                _errorMessage = result.Error.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        _page = 1;
    }

    private IReadOnlyList<BudgetRequestSummaryDto> GetActiveTabRows()
    {
        if (_data is null) return Array.Empty<BudgetRequestSummaryDto>();

        var empty = (IReadOnlyList<BudgetRequestSummaryDto>)Array.Empty<BudgetRequestSummaryDto>();
        return _activeTab switch
        {
            "pending"   => (_data.MyApprovalQueue?.TopItems ?? empty)
                           .Concat(_data.PaymentQueue?.TopItems ?? empty)
                           .DistinctBy(r => r.Id).ToList(),
            "actions"   => _data.Employee.ActionRequired,
            "inflight"  => _data.Employee.InFlight,
            "completed" => _data.Employee.RecentlyCompleted,
            "stuck"     => _data.StuckRequests?.TopItems ?? empty,
            _           => empty
        };
    }

    // ── Navigation ────────────────────────────────────────────────────────

    private void OpenRequest(Guid id) => Nav.NavigateTo($"requests/{id}");

    private void OpenRequestSmart(BudgetRequestSummaryDto r)
    {
        var url = (_activeTab == "actions" &&
                   r.Status is RequestStatus.Draft or RequestStatus.SentBack)
            ? $"requests/{r.Id}/edit"
            : $"requests/{r.Id}";
        Nav.NavigateTo(url);
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private string RequesterName(Guid id) =>
        _data is not null && _data.RequesterNames.TryGetValue(id, out var name) ? name : "—";

    private static string ShortId(Guid id) => id.ToString()[..8];

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s[..max] + "…");

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Draft             => "Draft",
        RequestStatus.PendingDeptHead   => "Pending Head",
        RequestStatus.PendingManagement => "Pending Mgmt",
        RequestStatus.PendingFinance    => "Pending Finance",
        RequestStatus.SentBack          => "Sent Back",
        RequestStatus.Approved          => "Approved",
        RequestStatus.PartiallyPaid     => "Part. Paid",
        RequestStatus.Paid              => "Paid",
        RequestStatus.Rejected          => "Rejected",
        RequestStatus.Cancelled         => "Cancelled",
        _                               => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft                                   => "status-badge-draft",
        RequestStatus.PendingDeptHead
            or RequestStatus.PendingManagement
            or RequestStatus.PendingFinance
            or RequestStatus.SentBack                         => "status-badge-pending",
        RequestStatus.Approved or RequestStatus.PartiallyPaid => "status-badge-approved",
        RequestStatus.Paid or RequestStatus.Reconciled        => "status-badge-paid",
        RequestStatus.Rejected or RequestStatus.Cancelled     => "status-badge-rejected",
        _                                                     => "status-badge-draft"
    };

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "Urgent",
        BudgetRequestType.Standard        => "Standard",
        BudgetRequestType.ProjectProposal => "Proposal",
        _                                 => t.ToString()
    };
}
