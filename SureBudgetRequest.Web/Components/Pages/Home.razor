    private static (string Stage, string TargetStatus) GetUndoApprovalTargetInfo(BudgetRequestSummaryDto? r)
    {
        if (r == null) return (string.Empty, string.Empty);
        var requiresManagement = r.RequestedAmountInMmkAtSubmission > r.DepartmentLimitAtSubmission;
        return r.Status switch
        {
            RequestStatus.PendingManagement => ("Dept Head", "Pending Dept Head"),
            RequestStatus.PendingFinance when requiresManagement => ("Management", "Pending Management"),
            RequestStatus.PendingFinance => ("Dept Head", "Pending Dept Head"),
            RequestStatus.Approved => ("Finance", "Pending Finance"),
            _ => (string.Empty, string.Empty)
        };
    }

    private QuickActionState GetUndoApproveActionState(BudgetRequestSummaryDto? r)
    {
        if (r == null || CurrentUser.Role != UserRole.Admin) return new(false, null);

        var requiresManagement = r.RequestedAmountInMmkAtSubmission > r.DepartmentLimitAtSubmission;
        var isAutoApprovedDeptHead = r.RequesterId == r.DeptHeadIdAtSubmission;

        switch (r.Status)
        {
            case RequestStatus.PendingManagement:
                if (!isAutoApprovedDeptHead)
                    return new(true, null);
                return new(false, "Auto-approved by Department Head");

            case RequestStatus.PendingFinance:
                if (requiresManagement || !isAutoApprovedDeptHead)
                    return new(true, null);
                return new(false, "Auto-approved by Department Head");

            case RequestStatus.Approved:
                if (r.TotalPaid == 0)
                    return new(true, null);
                return new(false, "Payments already recorded");

            default:
                return new(false, $"Cannot undo in {r.Status}");
        }
    }

    private QuickActionState GetUndoSubmitActionState(BudgetRequestSummaryDto? r)
    {
        if (r == null) return new(false, null);
        if (r.RequesterId != CurrentUser.UserId) return new(false, null);

        var requiresManagement = r.RequestedAmountInMmkAtSubmission > r.DepartmentLimitAtSubmission;
        var isDeptHeadRequester = r.RequesterId == r.DeptHeadIdAtSubmission;

        var canUndo = (!isDeptHeadRequester && r.Status == RequestStatus.PendingDeptHead)
            || (isDeptHeadRequester && (r.Status == RequestStatus.PendingManagement || (r.Status == RequestStatus.PendingFinance && !requiresManagement)));

        if (canUndo)
            return new(true, null);

        return new(false, "Review already started or finalized");
    }

    private QuickActionState GetApproveActionState(BudgetRequestSummaryDto? r)
    {
        if (r == null) return new(false, null);

        var role = CurrentUser.Role;
        var uid = CurrentUser.UserId;

        switch (r.Status)
        {
            case RequestStatus.PendingDeptHead:
                if (r.DeptHeadIdAtSubmission != Guid.Empty && r.DeptHeadIdAtSubmission == uid && r.RequesterId != uid)
                    return new(true, null);
                if (CurrentUser.IsDepartmentHead && r.DepartmentIdAtSubmission != Guid.Empty && r.DepartmentIdAtSubmission == CurrentUser.DepartmentId && r.RequesterId != uid)
                    return new(true, null);
                return new(false, "Waiting for Dept Head approval");

            case RequestStatus.PendingManagement:
                if (role == UserRole.Management)
                    return new(true, null);
                if (CurrentUser.IsDepartmentHead)
                    return new(false, "Already approved by Dept Head");
                return new(false, "Waiting for Management approval");

            case RequestStatus.PendingFinance:
                if (role == UserRole.Finance)
                {
                    if (CurrentUser.IsFinanceApprover)
                        return new(true, null);
                    return new(false, "Restricted: Payer only");
                }
                if (CurrentUser.IsDepartmentHead || role == UserRole.Management)
                    return new(false, "Already approved; pending Finance");
                return new(false, "Waiting for Finance approval");

            case RequestStatus.Approved:
                return new(false, "Already approved");

            case RequestStatus.Draft:
                return new(false, "Still in Draft");

            case RequestStatus.SentBack:
                return new(false, "Sent back to requester");

            case RequestStatus.Rejected or RequestStatus.Cancelled or RequestStatus.Paid or RequestStatus.PartiallyPaid:
                return new(false, "Request is finalized");

            default:
                return new(false, "Not available at this stage");
        }
    }

    private QuickActionState GetSendBackActionState(BudgetRequestSummaryDto? r)
    {
        if (r == null) return new(false, null);

        var role = CurrentUser.Role;
        var uid = CurrentUser.UserId;

        switch (r.Status)
        {
            case RequestStatus.PendingDeptHead:
                if (r.DeptHeadIdAtSubmission != Guid.Empty && r.DeptHeadIdAtSubmission == uid && r.RequesterId != uid)
                    return new(true, null);
                if (CurrentUser.IsDepartmentHead && r.DepartmentIdAtSubmission != Guid.Empty && r.DepartmentIdAtSubmission == CurrentUser.DepartmentId && r.RequesterId != uid)
                    return new(true, null);
                return new(false, "Waiting for Dept Head approval");

            case RequestStatus.PendingManagement:
                if (role == UserRole.Management)
                    return new(true, null);
                if (CurrentUser.IsDepartmentHead)
                    return new(false, "Stage passed to Management");
                return new(false, "Waiting for Management approval");

            case RequestStatus.PendingFinance:
                if (role == UserRole.Finance)
                {
                    if (CurrentUser.IsFinanceApprover)
                        return new(true, null);
                    return new(false, "Restricted: Payer only");
                }
                return new(false, "Pending Finance review");

            case RequestStatus.Approved:
                if (role == UserRole.Finance && CurrentUser.IsFinanceApprover && r.TotalPaid == 0)
                    return new(true, "Allowed before payment");
                if (r.TotalPaid > 0)
                    return new(false, "Payment has been recorded");
                return new(false, "Already approved");

            case RequestStatus.Draft:
                return new(false, "Still in Draft");

            case RequestStatus.SentBack:
                return new(false, "Already sent back");

            case RequestStatus.Rejected or RequestStatus.Cancelled or RequestStatus.Paid:
                return new(false, "Request is finalized");

            default:
                return new(false, "Not available at this stage");
        }
    }

