        "money"   => @<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M9.5 14.5c.5 1 1.4 1.5 2.5 1.5 1.5 0 2.5-.8 2.5-2s-1-1.7-2.5-2-2.5-.8-2.5-2 1-2 2.5-2c1.1 0 2 .5 2.5 1.5M12 6.5V8m0 8v1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>,
        "stuck"   => @<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M12 3l9.5 16.5h-19L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M12 10v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="12" cy="17" r="1" fill="currentColor"/>
                      </svg>,
        "action"  => @<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                      </svg>,
        "flight"  => @<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M6 14h4M14 14h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>,
        _         => @<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M8 12l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
    };

    // ── Navigation ────────────────────────────────────────────────────────

    private void OpenRequest(Guid id) => Nav.NavigateTo($"requests/{id}?from=home");

    private void OpenRequestSmart(BudgetRequestSummaryDto r)
    {
        var url = (_activeTab == "actions" &&
                   r.Status is RequestStatus.Draft or RequestStatus.SentBack)
            ? $"requests/{r.Id}/edit"
            : $"requests/{r.Id}";
        Nav.NavigateTo(url);
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private string RequesterName(Guid id) =>
        _data is not null && _data.RequesterNames.TryGetValue(id, out var name) ? name : "—";

    private static string ShortId(Guid id) => id.ToString()[..8];

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s[..max] + "…");

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Draft                 => "Draft",
        RequestStatus.PendingDeptHead       => "Pending Head",
        RequestStatus.PendingManagement     => "Pending Mgmt",
        RequestStatus.PendingFinance        => "Pending Finance",
        RequestStatus.SentBack              => "Sent Back",
        RequestStatus.Approved              => "Approved",
        RequestStatus.PartiallyPaid         => "Part. Paid",
        RequestStatus.Paid                  => "Paid",
        RequestStatus.Rejected              => "Rejected",
        RequestStatus.Cancelled             => "Cancelled",
        RequestStatus.PendingReconciliation => "Pending Recon",
        RequestStatus.AwaitingRefund        => "Awaiting Refund",
        RequestStatus.AwaitingReimbursement => "Awaiting Reimb.",
        RequestStatus.Reconciled            => "Reconciled",
        _                                   => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft                                   => "status-badge-draft",
        RequestStatus.PendingDeptHead
            or RequestStatus.PendingManagement
            or RequestStatus.PendingFinance
            or RequestStatus.SentBack
            or RequestStatus.PendingReconciliation
            or RequestStatus.AwaitingRefund
            or RequestStatus.AwaitingReimbursement           => "status-badge-pending",
        RequestStatus.Approved or RequestStatus.PartiallyPaid => "status-badge-approved",
        RequestStatus.Paid or RequestStatus.Reconciled        => "status-badge-paid",
        RequestStatus.Rejected or RequestStatus.Cancelled     => "status-badge-rejected",
        _                                                     => "status-badge-draft"
    };

    private List<CoaDto> _coas = new();
    private bool _quickActionProcessing;

    // ── In-Memory Dashboard Mutation ─────────────────────────────────────────
    private void UpdateDashboardItem(Guid requestId, Func<BudgetRequestSummaryDto, BudgetRequestSummaryDto> transform)
    {
        if (_data is null) return;

        static IReadOnlyList<BudgetRequestSummaryDto> UpdateList(
            IReadOnlyList<BudgetRequestSummaryDto>? list,
            Guid id,
            Func<BudgetRequestSummaryDto, BudgetRequestSummaryDto> fn,
            out bool changed)
        {
            changed = false;
            if (list == null || list.Count == 0) return list ?? Array.Empty<BudgetRequestSummaryDto>();
            var modified = false;
            var newList = new List<BudgetRequestSummaryDto>(list.Count);
            foreach (var item in list)
            {
                if (item.Id == id)
                {
                    newList.Add(fn(item));
                    modified = true;
                }
                else
                {
                    newList.Add(item);
                }
            }
            changed = modified;
            return modified ? newList : list;
        }

        var emp = _data.Employee;
        var act = UpdateList(emp.ActionRequired, requestId, transform, out var c1);
        var inf = UpdateList(emp.InFlight, requestId, transform, out var c2);
        var cmp = UpdateList(emp.RecentlyCompleted, requestId, transform, out var c3);
        if (c1 || c2 || c3)
        {
            emp = emp with { ActionRequired = act, InFlight = inf, RecentlyCompleted = cmp };
        }

        var app = _data.MyApprovalQueue;
        if (app != null)
        {
            var appItems = UpdateList(app.TopItems, requestId, transform, out var cApp);
            if (cApp) app = app with { TopItems = appItems };
        }

        var pay = _data.PaymentQueue;
        if (pay != null)
        {
            var payItems = UpdateList(pay.TopItems, requestId, transform, out var cPay);
            if (cPay) pay = pay with { TopItems = payItems };
        }

        var set = _data.SettlementQueue;
        if (set != null)
        {
            var setItems = UpdateList(set.TopItems, requestId, transform, out var cSet);
            if (cSet) set = set with { TopItems = setItems };
        }

        var stk = _data.StuckRequests;
        if (stk != null)
        {
            var stkItems = UpdateList(stk.TopItems, requestId, transform, out var cStk);
            if (cStk) stk = stk with { TopItems = stkItems };
        }

        _data = _data with
        {
            Employee = emp,
            MyApprovalQueue = app,
            PaymentQueue = pay,
            SettlementQueue = set,
            StuckRequests = stk
        };

        if (_contextMenuTarget != null && _contextMenuTarget.Id == requestId)
        {
            _contextMenuTarget = transform(_contextMenuTarget);
        }

        InvokeAsync(StateHasChanged);
    }

    private void UpdateRequestStatus(Guid requestId, RequestStatus newStatus, Guid? coaId = null, string? coaCode = null, string? coaName = null)
    {
        UpdateDashboardItem(requestId, item => item with
        {
            Status = newStatus,
            CoaId = coaId ?? item.CoaId,
            CoaCode = coaCode ?? item.CoaCode,
            CoaName = coaName ?? item.CoaName
        });
    }

    private void UpdateDashboardTags(Guid requestId, IReadOnlyList<RequestTagSummaryDto> tags)
    {
        UpdateDashboardItem(requestId, item => item with { Tags = tags });
    }

    // ── Context menu & Quick actions ─────────────────────────────────────────
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private BudgetRequestSummaryDto? _contextMenuTarget;
    private ElementReference _contextMenuRef;
    private bool _menuPendingPosition;
    private double _menuClickX;
    private double _menuClickY;
