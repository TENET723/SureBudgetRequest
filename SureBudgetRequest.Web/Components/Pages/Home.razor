@page "/"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetDashboard
@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Dashboard</PageTitle>

<div class="  dashboard">

    <div class="flex items-center justify-between mb-4">
        <div>
            <h4 class="mb-1">Welcome, @CurrentUser.FullName</h4>
            <p class="text-muted text-sm ">Signed in as @CurrentUser.Role.</p>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-outline btn-sm"
                    @onclick="RefreshAsync" disabled="@_loading">
                @(_loading ? "Refreshing…" : "Refresh")
            </button>
            <a href="requests/new" class="btn btn-primary btn-sm">+ New request</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage</div>
    }

    @if (_loading && _data is null)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else if (_data is not null)
    {
        @* ====== Role-specific sections (render only when present) ====== *@

        @if (_data.FinanceMetrics is not null)
        {
            <div class="form-grid-3 mb-4">
                <div>
                    <div class="card h-100"><div class="card-body ">
                        <div class="text-sm text-muted">Pending approval</div>
                        <div class="fs-4 font-semibold">@_data.FinanceMetrics.PendingApprovalCount</div>
                    </div></div>
                </div>
                <div>
                    <div class="card h-100"><div class="card-body ">
                        <div class="text-sm text-muted">Awaiting payment</div>
                        <div class="fs-4 font-semibold">@_data.FinanceMetrics.AwaitingPaymentCount</div>
                    </div></div>
                </div>
                <div>
                    <div class="card h-100"><div class="card-body ">
                        <div class="text-sm text-muted">Outstanding total</div>
                        <div class="fs-4 font-semibold">@_data.FinanceMetrics.OutstandingTotalMmk.ToString("N2") <span class="text-sm text-muted">MMK</span></div>
                    </div></div>
                </div>
            </div>
        }

        @if (_data.MyApprovalQueue is not null)
        {
            <div class="card mb-4">
                <div class="card-header flex justify-content-between align-items-center">
                    <div>
                        <strong>Pending my approval</strong>
                        <span class="badge badge-role"bg-danger" : "bg-primary") ml-2">
                            @_data.MyApprovalQueue.TotalCount
                        </span>
                    </div>
                    @if (_data.MyApprovalQueue.TotalCount > 0)
                    {
                        <a href="requests/inbox" class="text-sm">View all →</a>
                    }
                </div>
                @if (_data.MyApprovalQueue.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted ">Nothing pending your approval. 🎉</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.MyApprovalQueue.TopItems)
                        {
                            <li class="list-group-item flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate mr-3">
                                    <span class="text-muted text-sm mr-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge badge-role">@TypeLabel(r.Type)</span>
                                    <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="mr-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted text-sm">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end text-sm flex-shrink-0">
                                    <div>@r.RequestedAmount.ToString("N2") <span class="text-muted">@r.CurrencyCode</span></div>
                                    <div class="text-muted @WaitingClass(r.SubmittedAt)">@WaitingLabel(r.SubmittedAt)</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_data.PaymentQueue is not null)
        {
            <div class="card mb-4">
                <div class="card-header flex justify-content-between align-items-center">
                    <div>
                        <strong>Approved — awaiting payment</strong>
                        <span class="badge badge-role">@_data.PaymentQueue.TotalCount</span>
                    </div>
                    @if (_data.PaymentQueue.TotalCount > 0)
                    {
                        <a href="requests/outstanding" class="text-sm">View all →</a>
                    }
                </div>
                @if (_data.PaymentQueue.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted ">Nothing outstanding. 🎉</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.PaymentQueue.TopItems)
                        {
                            <li class="list-group-item flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate mr-3">
                                    <span class="text-muted text-sm mr-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge badge-role">@TypeLabel(r.Type)</span>
                                    <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="mr-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted text-sm">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end text-sm flex-shrink-0">
                                    <div class="font-semibold">@r.RemainingBalance.ToString("N2") <span class="text-muted">@r.CurrencyCode</span></div>
                                    <div class="text-muted">remaining of @r.ApprovedAmount.ToString("N2")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_data.StuckRequests is not null)
        {
            <div class="card mb-4">
                <div class="card-header flex justify-content-between align-items-center">
                    <div>
                        <strong>Stuck requests</strong>
                        <span class="text-muted text-sm ml-1">(no movement in 7+ days)</span>
                        <span class="badge badge-role"bg-danger" : "bg-secondary") ml-2">
                            @_data.StuckRequests.TotalCount
                        </span>
                    </div>
                </div>
                @if (_data.StuckRequests.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted ">No stuck requests.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.StuckRequests.TopItems)
                        {
                            <li class="list-group-item flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate mr-3">
                                    <span class="text-muted text-sm mr-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge badge-role">@StatusLabel(r.Status)</span>
                                    <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="mr-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted text-sm">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end text-sm text-danger flex-shrink-0">
                                    @WaitingLabel(r.SubmittedAt)
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @* ====== Base section — every user sees these ====== *@

        <div class="card mb-4">
            <div class="card-header flex justify-content-between align-items-center">
                <div>
                    <strong>Action required from you</strong>
                    <span class="badge badge-role"bg-warning text-dark" : "bg-secondary") ml-2">
                        @_data.Employee.ActionRequired.Count
                    </span>
                </div>
            </div>
            @if (_data.Employee.ActionRequired.Count == 0)
            {
                <div class="card-body text-center text-muted  text-sm">Nothing to do here.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var r in _data.Employee.ActionRequired)
                    {
                        <li class="list-group-item flex justify-content-between align-items-center request-row"
                            @onclick="() => OpenRequestEdit(r)">
                            <div class="text-truncate mr-3">
                                <span class="badge badge-role">@StatusLabel(r.Status)</span>
                                <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                    MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                    RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                <span class="text-muted text-sm mr-2">@(r.Reference ?? ShortId(r.Id))</span>
                                <span class="text-muted text-sm">@Truncate(r.Reasons, 50)</span>
                            </div>
                            <div class="text-end text-sm text-muted flex-shrink-0">
                                @r.RequestedAmount.ToString("N2") <span>@r.CurrencyCode</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="form-grid-3">
            <div>
                <div class="card h-100">
                    <div class="card-header flex justify-content-between align-items-center">
                        <strong>My requests in flight</strong>
                        @if (_data.Employee.InFlight.Count > 0)
                        {
                            <a href="requests/mine" class="text-sm">View all →</a>
                        }
                    </div>
                    @if (_data.Employee.InFlight.Count == 0)
                    {
                        <div class="card-body text-center text-muted  text-sm">No requests in flight.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var r in _data.Employee.InFlight)
                            {
                                <li class="list-group-item text-sm request-row" @onclick="() => OpenRequest(r.Id)">
                                    <div class="flex justify-content-between align-items-center">
                                        <span class="text-muted">@(r.Reference ?? ShortId(r.Id))</span>
                                        <div>
                                            <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                                MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                                RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                            <span class="badge badge-role">@StatusLabel(r.Status)</span>
                                        </div>
                                    </div>
                                    <div class="flex justify-content-between align-items-center mt-1">
                                        <span class="text-truncate mr-2">@Truncate(r.Reasons, 35)</span>
                                        <span class="text-nowrap">@r.RequestedAmount.ToString("N2") <span class="text-muted">@r.CurrencyCode</span></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div>
                <div class="card h-100">
                    <div class="card-header flex justify-content-between align-items-center">
                        <strong>Recently completed</strong>
                        @if (_data.Employee.RecentlyCompleted.Count > 0)
                        {
                            <a href="requests/mine" class="text-sm">View all →</a>
                        }
                    </div>
                    @if (_data.Employee.RecentlyCompleted.Count == 0)
                    {
                        <div class="card-body text-center text-muted  text-sm">Nothing completed yet.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var r in _data.Employee.RecentlyCompleted)
                            {
                                <li class="list-group-item text-sm request-row" @onclick="() => OpenRequest(r.Id)">
                                    <div class="flex justify-content-between align-items-center">
                                        <span class="text-muted">@(r.Reference ?? ShortId(r.Id))</span>
                                        <div>
                                            <MonthlyLimitBadge Compact="true" MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                                MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                                RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                            <span class="badge badge-role">@StatusLabel(r.Status)</span>
                                        </div>
                                    </div>
                                    <div class="flex justify-content-between align-items-center mt-1">
                                        <span class="text-truncate mr-2">@Truncate(r.Reasons, 35)</span>
                                        <span class="text-nowrap text-muted">@(r.FinalizedAt?.ToString("dd MMM") ?? "—")</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardDto? _data;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var result = await Mediator.Send(new GetDashboardQuery());
            if (result.IsSuccess)
                _data = result.Value;
            else
                _errorMessage = result.Error.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Navigation helpers ────────────────────────────────────────────────

    private void OpenRequest(Guid id) => Nav.NavigateTo($"requests/{id}");

    // Drafts/SentBack open the edit page; otherwise the detail view.
    private void OpenRequestEdit(BudgetRequestSummaryDto r)
    {
        var url = r.Status is RequestStatus.Draft or RequestStatus.SentBack
            ? $"requests/{r.Id}/edit"
            : $"requests/{r.Id}";
        Nav.NavigateTo(url);
    }

    // ── Display helpers ───────────────────────────────────────────────────

    private string RequesterName(Guid id) =>
        _data is not null && _data.RequesterNames.TryGetValue(id, out var name) ? name : "—";

    private static string ShortId(Guid id) => id.ToString()[..8];

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s[..max] + "…");

    private static string WaitingLabel(DateTime? submittedAt)
    {
        if (!submittedAt.HasValue) return "—";
        var days = (int)(DateTime.UtcNow - submittedAt.Value).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1    => "1 day",
            _    => $"{days} days"
        };
    }

    private static string WaitingClass(DateTime? submittedAt)
    {
        if (!submittedAt.HasValue) return "";
        var days = (DateTime.UtcNow - submittedAt.Value).TotalDays;
        return days > 3 ? "text-danger fw-semibold" : "";
    }

    private bool HasStaleItem(IReadOnlyList<BudgetRequestSummaryDto> items) =>
        items.Any(r => r.SubmittedAt.HasValue
                       && (DateTime.UtcNow - r.SubmittedAt.Value).TotalDays > 3);

    // ── Labels / badges (matches conventions used in Inbox.razor) ────────

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Draft             => "Draft",
        RequestStatus.PendingDeptHead   => "Pending Head",
        RequestStatus.PendingManagement => "Pending Mgmt",
        RequestStatus.PendingFinance    => "Pending Finance",
        RequestStatus.SentBack          => "Sent back",
        RequestStatus.Approved          => "Approved",
        RequestStatus.PartiallyPaid     => "Part. paid",
        RequestStatus.Paid              => "Paid",
        RequestStatus.Rejected          => "Rejected",
        RequestStatus.Cancelled         => "Cancelled",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft             => "bg-light text-dark border",
        RequestStatus.PendingDeptHead
            or RequestStatus.PendingManagement
            or RequestStatus.PendingFinance => "bg-warning text-dark",
        RequestStatus.SentBack          => "bg-danger",
        RequestStatus.Approved          => "bg-primary",
        RequestStatus.PartiallyPaid     => "bg-info text-dark",
        RequestStatus.Paid              => "bg-success",
        RequestStatus.Rejected          => "bg-secondary",
        RequestStatus.Cancelled         => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "Urgent",
        BudgetRequestType.Standard        => "Standard",
        BudgetRequestType.ProjectProposal => "Proposal",
        _ => t.ToString()
    };

    private static string TypeBadgeClass(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "bg-danger",
        BudgetRequestType.Standard        => "bg-secondary",
        BudgetRequestType.ProjectProposal => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
