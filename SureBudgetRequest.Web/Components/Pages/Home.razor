@page "/"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@using SureBudgetRequest.Application.BudgetRequests.Queries.GetDashboard
@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-3 dashboard">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-1">Welcome, @CurrentUser.FullName</h4>
            <p class="text-muted small mb-0">Signed in as @CurrentUser.Role.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="RefreshAsync" disabled="@_loading">
                @(_loading ? "Refreshing…" : "Refresh")
            </button>
            <a href="requests/new" class="btn btn-sm btn-primary">+ New request</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_loading && _data is null)
    {
        <div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>
    }
    else if (_data is not null)
    {
        @* ====== Role-specific sections (render only when present) ====== *@

        @if (_data.FinanceMetrics is not null)
        {
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card h-100"><div class="card-body py-3">
                        <div class="small text-muted">Pending approval</div>
                        <div class="fs-4 fw-semibold">@_data.FinanceMetrics.PendingApprovalCount</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100"><div class="card-body py-3">
                        <div class="small text-muted">Awaiting payment</div>
                        <div class="fs-4 fw-semibold">@_data.FinanceMetrics.AwaitingPaymentCount</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100"><div class="card-body py-3">
                        <div class="small text-muted">Outstanding total</div>
                        <div class="fs-4 fw-semibold">@_data.FinanceMetrics.OutstandingTotalMmk.ToString("N0") <span class="small text-muted">MMK</span></div>
                    </div></div>
                </div>
            </div>
        }

        @if (_data.MyApprovalQueue is not null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Pending my approval</strong>
                        <span class="badge @(HasStaleItem(_data.MyApprovalQueue.TopItems) ? "bg-danger" : "bg-primary") ms-2">
                            @_data.MyApprovalQueue.TotalCount
                        </span>
                    </div>
                    @if (_data.MyApprovalQueue.TotalCount > 0)
                    {
                        <a href="requests/inbox" class="small">View all →</a>
                    }
                </div>
                @if (_data.MyApprovalQueue.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Nothing pending your approval. 🎉</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.MyApprovalQueue.TopItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate me-3">
                                    <span class="text-muted small me-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge @TypeBadgeClass(r.Type) me-2">@TypeLabel(r.Type)</span>
                                    <MonthlyOverrunBadge Compact="true"
                                        MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="me-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted small">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end small flex-shrink-0">
                                    <div>@r.RequestedAmount.ToString("N0") <span class="text-muted">@r.CurrencyCode</span></div>
                                    <div class="text-muted @WaitingClass(r.SubmittedAt)">@WaitingLabel(r.SubmittedAt)</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_data.PaymentQueue is not null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Approved — awaiting payment</strong>
                        <span class="badge bg-warning text-dark ms-2">@_data.PaymentQueue.TotalCount</span>
                    </div>
                    @if (_data.PaymentQueue.TotalCount > 0)
                    {
                        <a href="requests/outstanding" class="small">View all →</a>
                    }
                </div>
                @if (_data.PaymentQueue.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">Nothing outstanding. 🎉</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.PaymentQueue.TopItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate me-3">
                                    <span class="text-muted small me-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge @TypeBadgeClass(r.Type) me-2">@TypeLabel(r.Type)</span>
                                    <MonthlyOverrunBadge Compact="true"
                                        MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="me-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted small">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end small flex-shrink-0">
                                    <div class="fw-semibold">@r.RemainingBalance.ToString("N0") <span class="text-muted">@r.CurrencyCode</span></div>
                                    <div class="text-muted">remaining of @r.ApprovedAmount.ToString("N0")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_data.StuckRequests is not null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Stuck requests</strong>
                        <span class="text-muted small ms-1">(no movement in 7+ days)</span>
                        <span class="badge @(_data.StuckRequests.TotalCount > 0 ? "bg-danger" : "bg-secondary") ms-2">
                            @_data.StuckRequests.TotalCount
                        </span>
                    </div>
                </div>
                @if (_data.StuckRequests.TopItems.Count == 0)
                {
                    <div class="card-body text-center text-muted py-4">No stuck requests.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in _data.StuckRequests.TopItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center request-row"
                                @onclick="() => OpenRequest(r.Id)">
                                <div class="text-truncate me-3">
                                    <span class="text-muted small me-2">@(r.Reference ?? ShortId(r.Id))</span>
                                    <span class="badge @StatusBadgeClass(r.Status) me-2">@StatusLabel(r.Status)</span>
                                    <MonthlyOverrunBadge Compact="true"
                                        MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                        MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                        RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                    <span class="me-2">@RequesterName(r.RequesterId)</span>
                                    <span class="text-muted small">@Truncate(r.Reasons, 40)</span>
                                </div>
                                <div class="text-end small text-danger flex-shrink-0">
                                    @WaitingLabel(r.SubmittedAt)
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @* ====== Base section — every user sees these ====== *@

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>Action required from you</strong>
                    <span class="badge @(_data.Employee.ActionRequired.Count > 0 ? "bg-warning text-dark" : "bg-secondary") ms-2">
                        @_data.Employee.ActionRequired.Count
                    </span>
                </div>
            </div>
            @if (_data.Employee.ActionRequired.Count == 0)
            {
                <div class="card-body text-center text-muted py-3 small">Nothing to do here.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var r in _data.Employee.ActionRequired)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center request-row"
                            @onclick="() => OpenRequestEdit(r)">
                            <div class="text-truncate me-3">
                                <span class="badge @StatusBadgeClass(r.Status) me-2">@StatusLabel(r.Status)</span>
                                <MonthlyOverrunBadge Compact="true"
                                    MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                    MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                    RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                <span class="text-muted small me-2">@(r.Reference ?? ShortId(r.Id))</span>
                                <span class="text-muted small">@Truncate(r.Reasons, 50)</span>
                            </div>
                            <div class="text-end small text-muted flex-shrink-0">
                                @r.RequestedAmount.ToString("N0") <span>@r.CurrencyCode</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>My requests in flight</strong>
                        @if (_data.Employee.InFlight.Count > 0)
                        {
                            <a href="requests/mine" class="small">View all →</a>
                        }
                    </div>
                    @if (_data.Employee.InFlight.Count == 0)
                    {
                        <div class="card-body text-center text-muted py-3 small">No requests in flight.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var r in _data.Employee.InFlight)
                            {
                                <li class="list-group-item small request-row" @onclick="() => OpenRequest(r.Id)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">@(r.Reference ?? ShortId(r.Id))</span>
                                        <div>
                                            <MonthlyOverrunBadge Compact="true"
                                                MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                                MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                                RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                            <span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="text-truncate me-2">@Truncate(r.Reasons, 35)</span>
                                        <span class="text-nowrap">@r.RequestedAmount.ToString("N0") <span class="text-muted">@r.CurrencyCode</span></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Recently completed</strong>
                        @if (_data.Employee.RecentlyCompleted.Count > 0)
                        {
                            <a href="requests/mine" class="small">View all →</a>
                        }
                    </div>
                    @if (_data.Employee.RecentlyCompleted.Count == 0)
                    {
                        <div class="card-body text-center text-muted py-3 small">Nothing completed yet.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var r in _data.Employee.RecentlyCompleted)
                            {
                                <li class="list-group-item small request-row" @onclick="() => OpenRequest(r.Id)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">@(r.Reference ?? ShortId(r.Id))</span>
                                        <div>
                                            <MonthlyOverrunBadge Compact="true"
                                                MonthlyLimitAtSubmission="@r.MonthlyLimitAtSubmission"
                                                MonthlySpendBeforeAtSubmission="@r.MonthlySpendBeforeAtSubmission"
                                                RequestedAmountInMmkAtSubmission="@r.RequestedAmountInMmkAtSubmission" />
                                            <span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="text-truncate me-2">@Truncate(r.Reasons, 35)</span>
                                        <span class="text-nowrap text-muted">@(r.FinalizedAt?.ToString("dd MMM") ?? "—")</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardDto? _data;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var result = await Mediator.Send(new GetDashboardQuery());
            if (result.IsSuccess)
                _data = result.Value;
            else
                _errorMessage = result.Error.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Navigation helpers ────────────────────────────────────────────────

    private void OpenRequest(Guid id) => Nav.NavigateTo($"requests/{id}");

    // Drafts/SentBack open the edit page; otherwise the detail view.
    private void OpenRequestEdit(BudgetRequestSummaryDto r)
    {
        var url = r.Status is RequestStatus.Draft or RequestStatus.SentBack
            ? $"requests/{r.Id}/edit"
            : $"requests/{r.Id}";
        Nav.NavigateTo(url);
    }

    // ── Display helpers ───────────────────────────────────────────────────

    private string RequesterName(Guid id) =>
        _data is not null && _data.RequesterNames.TryGetValue(id, out var name) ? name : "—";

    private static string ShortId(Guid id) => id.ToString()[..8];

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s[..max] + "…");

    private static string WaitingLabel(DateTime? submittedAt)
    {
        if (!submittedAt.HasValue) return "—";
        var days = (int)(DateTime.UtcNow - submittedAt.Value).TotalDays;
        return days switch
        {
            <= 0 => "today",
            1    => "1 day",
            _    => $"{days} days"
        };
    }

    private static string WaitingClass(DateTime? submittedAt)
    {
        if (!submittedAt.HasValue) return "";
        var days = (DateTime.UtcNow - submittedAt.Value).TotalDays;
        return days > 3 ? "text-danger fw-semibold" : "";
    }

    private bool HasStaleItem(IReadOnlyList<BudgetRequestSummaryDto> items) =>
        items.Any(r => r.SubmittedAt.HasValue
                       && (DateTime.UtcNow - r.SubmittedAt.Value).TotalDays > 3);

    // ── Labels / badges (matches conventions used in Inbox.razor) ────────

    private static string StatusLabel(RequestStatus s) => s switch
    {
        RequestStatus.Draft             => "Draft",
        RequestStatus.PendingDeptHead   => "Pending Head",
        RequestStatus.PendingManagement => "Pending Mgmt",
        RequestStatus.PendingFinance    => "Pending Finance",
        RequestStatus.SentBack          => "Sent back",
        RequestStatus.Approved          => "Approved",
        RequestStatus.PartiallyPaid     => "Part. paid",
        RequestStatus.Paid              => "Paid",
        RequestStatus.Rejected          => "Rejected",
        RequestStatus.Cancelled         => "Cancelled",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(RequestStatus s) => s switch
    {
        RequestStatus.Draft             => "bg-light text-dark border",
        RequestStatus.PendingDeptHead
            or RequestStatus.PendingManagement
            or RequestStatus.PendingFinance => "bg-warning text-dark",
        RequestStatus.SentBack          => "bg-danger",
        RequestStatus.Approved          => "bg-primary",
        RequestStatus.PartiallyPaid     => "bg-info text-dark",
        RequestStatus.Paid              => "bg-success",
        RequestStatus.Rejected          => "bg-secondary",
        RequestStatus.Cancelled         => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string TypeLabel(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "Urgent",
        BudgetRequestType.Standard        => "Standard",
        BudgetRequestType.ProjectProposal => "Proposal",
        _ => t.ToString()
    };

    private static string TypeBadgeClass(BudgetRequestType t) => t switch
    {
        BudgetRequestType.Urgent          => "bg-danger",
        BudgetRequestType.Standard        => "bg-secondary",
        BudgetRequestType.ProjectProposal => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
