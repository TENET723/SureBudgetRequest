    private async Task ExecuteQuickApproveAsync(BudgetRequestSummaryDto? target)
    {
        if (target == null || _quickActionProcessing) return;

        if (target.Status == RequestStatus.PendingFinance)
        {
            OpenQuickActionModal(target, QuickActionType.FinanceApprove);
            return;
        }

        CloseContextMenu();
        _quickActionProcessing = true;
        try
        {
            var res = await Mediator.Send(new ApproveRequestCommand(target.Id, CurrentUser.UserId));
            if (res.IsSuccess)
            {
                var nextStatus = target.Status switch
                {
                    RequestStatus.PendingDeptHead => (target.RequestedAmountInMmkAtSubmission > target.DepartmentLimitAtSubmission)
                        ? RequestStatus.PendingManagement
                        : RequestStatus.PendingFinance,
                    RequestStatus.PendingManagement => RequestStatus.PendingFinance,
                    _ => RequestStatus.Approved
                };

                UpdateRequestStatus(target.Id, nextStatus);
                ShowToast($"Approved {target.Reference ?? "request"}");
            }
            else
            {
                ShowToast($"Error approving: {res.Error.Message}");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}");
        }
        finally
        {
            _quickActionProcessing = false;
        }
    }

    private void OpenQuickActionModal(BudgetRequestSummaryDto? target, QuickActionType actionType)
    {
        if (target == null) return;
        var x = _menuClickX > 0 ? _menuClickX : _contextMenuX;
        var y = _menuClickY > 0 ? _menuClickY : _contextMenuY;
        CloseContextMenu();
        _quickActionTarget = target;
        _quickActionType = actionType;
        _quickActionComment = "";
        _quickActionError = null;
        _quickActionProcessing = false;
        _quickFinanceCoaId = target.CoaId?.ToString() ?? "";
        _quickFinanceReconciliationDeadline = DateTimeExtensions.MyanmarToday.AddDays(3);
        _quickActionX = x;
        _quickActionY = y;
        _quickActionPendingPosition = true;
        _showQuickActionModal = true;
    }

    private void CloseQuickActionModal()
    {
        _showQuickActionModal = false;
        _quickActionTarget = null;
        _quickActionType = QuickActionType.None;
        _quickActionComment = "";
        _quickActionError = null;
    }

    private async Task ExecuteQuickModalActionAsync()
    {
        if (_quickActionTarget == null || _quickActionProcessing) return;
        var target = _quickActionTarget;

        if (_quickActionType == QuickActionType.SendBack)
        {
            if (string.IsNullOrWhiteSpace(_quickActionComment))
            {
                _quickActionError = "A comment is required when sending back.";
                return;
            }

            _quickActionProcessing = true;
            _quickActionError = null;
            try
            {
                var res = await Mediator.Send(new SendBackRequestCommand(target.Id, CurrentUser.UserId, _quickActionComment.Trim()));
                if (res.IsSuccess)
                {
                    UpdateRequestStatus(target.Id, RequestStatus.SentBack);
                    CloseQuickActionModal();
                    ShowToast($"Sent back {target.Reference ?? "request"} to requester");
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.Reject)
        {
            if (string.IsNullOrWhiteSpace(_quickActionComment))
            {
                _quickActionError = "A rejection reason is required.";
                return;
            }

            _quickActionProcessing = true;
            _quickActionError = null;
            try
            {
                var res = await Mediator.Send(new RejectRequestCommand(target.Id, CurrentUser.UserId, _quickActionComment.Trim()));
                if (res.IsSuccess)
                {
                    UpdateRequestStatus(target.Id, RequestStatus.Rejected);
                    CloseQuickActionModal();
                    ShowToast($"Rejected {target.Reference ?? "request"}");
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.FinanceApprove)
        {
            if (!Guid.TryParse(_quickFinanceCoaId, out var coaId) || coaId == Guid.Empty)
            {
                _quickActionError = "Please select a valid Chart of Account.";
                return;
            }

            DateTime? deadline = null;
            if (target.Type == BudgetRequestType.Advance)
            {
                var days = (_quickFinanceReconciliationDeadline.Date - DateTimeExtensions.MyanmarToday).Days;
                if (days <= 0)
                {
                    _quickActionError = "The reconciliation deadline must be a future date.";
                    return;
                }
                deadline = DateTime.UtcNow.AddDays(days);
            }

            _quickActionProcessing = true;
            _quickActionError = null;
            try
            {
                var res = await Mediator.Send(new ApproveRequestCommand(target.Id, CurrentUser.UserId, coaId, deadline));
                if (res.IsSuccess)
                {
                    var selectedCoa = _coas.FirstOrDefault(c => c.Id == coaId);
                    UpdateRequestStatus(target.Id, RequestStatus.Approved, coaId, selectedCoa?.Code, selectedCoa?.Name);
                    CloseQuickActionModal();
                    ShowToast($"Approved {target.Reference ?? "request"}");
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.UndoApprove)
        {
            _quickActionProcessing = true;
            _quickActionError = null;
            try
            {
                var res = await Mediator.Send(new UndoApprovalCommand(target.Id, CurrentUser.UserId, string.IsNullOrWhiteSpace(_quickActionComment) ? null : _quickActionComment.Trim()));
                if (res.IsSuccess)
                {
                    var requiresManagement = target.RequestedAmountInMmkAtSubmission > target.DepartmentLimitAtSubmission;
                    var prevStatus = target.Status switch
                    {
                        RequestStatus.PendingManagement => RequestStatus.PendingDeptHead,
                        RequestStatus.PendingFinance => requiresManagement ? RequestStatus.PendingManagement : RequestStatus.PendingDeptHead,
                        RequestStatus.Approved => RequestStatus.PendingFinance,
                        _ => target.Status
                    };
                    UpdateRequestStatus(target.Id, prevStatus);
                    CloseQuickActionModal();
                    ShowToast($"Undid approval for {target.Reference ?? "request"}");
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
        else if (_quickActionType == QuickActionType.UndoSubmit)
        {
            _quickActionProcessing = true;
            _quickActionError = null;
            try
            {
                var res = await Mediator.Send(new UndoSubmitCommand(target.Id, CurrentUser.UserId));
                if (res.IsSuccess)
                {
                    UpdateRequestStatus(target.Id, RequestStatus.Draft);
                    CloseQuickActionModal();
                    ShowToast($"Withdrew {target.Reference ?? "request"} to draft");
                }
                else
                {
                    _quickActionError = res.Error.Message;
                }
            }
            catch (Exception ex)
            {
                _quickActionError = ex.Message;
            }
            finally
            {
                _quickActionProcessing = false;
            }
        }
    }

