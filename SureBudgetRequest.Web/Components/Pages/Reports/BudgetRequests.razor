    private bool _showColumnModal;
    private int? _dragIndex;
    private List<ColumnChoice> _columns = new();
    private ElementReference _pickerRef;
    private bool _dndWired;

    private int SelectedColumnCount => _columns.Count(c => c.Selected);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wire the native drag-cursor handlers onto the picker list once it's in
        // the DOM. The list is a fresh element each time the modal opens, so we
        // re-wire per open (tracked by _dndWired, reset in OpenColumnModal).
        if (_showColumnModal && !_dndWired)
        {
            _dndWired = true;
            await JS.InvokeVoidAsync("columnPickerDnd.enable", _pickerRef);
        }

        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }

        if (_showQuickActionModal && _quickActionPendingPosition)
        {
            _quickActionPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _quickActionRef, _quickActionX, _quickActionY, false);
        }
    }

    private void OpenColumnModal()
    {
        // No persistence: rebuild from the canonical registry on every open —
        // all columns selected, in default order.
        _columns = ExportColumns.DefaultOrder
            .Select(c => new ColumnChoice(c.Key, c.Header))
            .ToList();
        _dragIndex = null;
        _dndWired = false;   // re-wire the native handlers on the new list element
        _showColumnModal = true;
    }

    private void SelectAllColumns() { foreach (var c in _columns) c.Selected = true; }
    private void SelectNoColumns()  { foreach (var c in _columns) c.Selected = false; }

    // Native HTML5 drag-and-drop reorder — no JS library.
    //
    // The list reorders LIVE as the dragged row passes over another row
    // (ondragenter); we deliberately do NOT rely on the ondrop event. ondrop only
    // fires when the drop target cancels the dragover/dragenter default, which is
    // unreliable here because each row contains interactive children (checkbox +
    // label) that the browser treats as the event target — so drops get swallowed.
    // Reordering on dragenter sidesteps that entirely; ondragend just clears state.
    private void OnDragStart(int index) => _dragIndex = index;
    private void OnDragEnd() => _dragIndex = null;

    private void OnDragEnter(int index)
    {
        if (_dragIndex is not int from || from == index
            || from < 0 || from >= _columns.Count
            || index < 0 || index >= _columns.Count)
            return;

        var item = _columns[from];
        _columns.RemoveAt(from);
        _columns.Insert(index, item);
        _dragIndex = index;   // the dragged item now lives at the row it entered
    }

    private sealed class ColumnChoice
    {
        public ColumnChoice(ExportColumn key, string header)
        {
            Key = key;
            Header = header;
        }

        public ExportColumn Key { get; }
        public string Header { get; }
        public bool Selected { get; set; } = true;
    }

    private async Task ExportAsync()
    {
        var query = new List<string>();
        void Add(string key, string? value)
        {
            if (!string.IsNullOrEmpty(value))
                query.Add($"{key}={Uri.EscapeDataString(value)}");
        }

        Add("search", _search);
        if (_fromDate.HasValue) Add("from", _fromDate.Value.ToString("yyyy-MM-dd"));
        if (_toDate.HasValue) Add("to", _toDate.Value.ToString("yyyy-MM-dd"));
        Add("departmentId", _selectedDepartmentId);
        Add("coaId", _selectedCoaId);
        Add("tagId", _selectedTagId);
        Add("currency", _selectedCurrencyCode);
        Add("withdrawMethodId", _selectedWithdrawMethodId);
        Add("requesterId", _selectedRequesterId);
        Add("approverId", _selectedApproverId);
        if (_overLimitFilter != "any") Add("overLimit", _overLimitFilter);
        foreach (var s in _selectedStatuses)
            Add("statuses", s.ToString());

        // Mirror EVERY remaining on-screen filter so the export matches the
        // table exactly (these were missing before — the cause of UI/export
        // row-count mismatches).
        foreach (var t in _selectedTypes)
            Add("types", t.ToString());
        if (_amountMmkFrom.HasValue)
            Add("amountFrom", _amountMmkFrom.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_amountMmkTo.HasValue)
            Add("amountTo", _amountMmkTo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_periodOverrunOnly)
            Add("periodOverrun", "true");

        // Sort selection, so the file rows come out in the on-screen order.
        Add("sortBy", _sortBy.ToString());
        Add("sortDesc", _sortDescending ? "true" : "false");

        // Selected export columns, in the user's chosen (drag-ordered) order.
        // Repeated params preserve order server-side. None selected → no params →
        // the endpoint falls back to all columns.
        foreach (var c in _columns.Where(c => c.Selected))
            Add("columns", c.Key.ToString());

        var url = "/api/reports/budget-requests/export";
        if (query.Count > 0)
            url += "?" + string.Join("&", query);

        await JS.InvokeVoidAsync("open", url, "_blank");
        _showColumnModal = false;
    }

