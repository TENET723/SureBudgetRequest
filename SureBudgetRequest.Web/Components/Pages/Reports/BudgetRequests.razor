    private async Task ToggleTagAsync(TagDto tag)
    {
        var target = _tagPopoverTarget;
        if (target == null || _processingTagIds.Contains(tag.Id)) return;
        var requestId = target.Id;

        _processingTagIds.Add(tag.Id);
        _tagPopoverError = null;

        try
        {
            var currentTags = _result?.Items?.FirstOrDefault(i => i.Id == requestId)?.Tags
                              ?? target.Tags
                              ?? Array.Empty<RequestTagSummaryDto>();

            bool isAttached = currentTags.Any(rt => rt.TagId == tag.Id);
            if (isAttached)
            {
                var res = await Mediator.Send(new RemoveTagFromRequestCommand(requestId, tag.Id, CurrentUser.UserId));
                if (res.IsSuccess)
                {
                    var latest = _result?.Items?.FirstOrDefault(i => i.Id == requestId)?.Tags
                                 ?? currentTags;
                    var updated = latest.Where(rt => rt.TagId != tag.Id).ToList();
                    UpdateRequestTags(requestId, updated);
                    ShowToast($"Removed #{tag.Name}");
                }
                else
                {
                    if (_tagPopoverTarget != null && _tagPopoverTarget.Id == requestId)
                    {
                        _tagPopoverError = res.Error.Message;
                    }
                    else
                    {
                        ShowToast($"Error: {res.Error.Message}");
                    }
                }
            }
            else
            {
                var deptId = CurrentUser.DepartmentId != Guid.Empty
                    ? CurrentUser.DepartmentId
                    : target.DepartmentIdAtSubmission;

                var attachedCount = currentTags.Count(t => t.DepartmentId == deptId);
                if (attachedCount + _attachingTagIds.Count >= 5)
                {
                    _tagPopoverError = "Maximum 5 tags per department reached.";
                    return;
                }

                _attachingTagIds.Add(tag.Id);
                try
                {
                    var res = await Mediator.Send(new AddTagToRequestCommand(requestId, tag.Id, CurrentUser.UserId));
                    if (res.IsSuccess)
                    {
                        var latest = _result?.Items?.FirstOrDefault(i => i.Id == requestId)?.Tags
                                     ?? currentTags;
                        var newSummary = new RequestTagSummaryDto(
                            tag.Id,
                            tag.Name,
                            tag.ColorHex,
                            tag.FontColorHex,
                            tag.DepartmentId);
                        var updated = latest.Where(rt => rt.TagId != tag.Id).Concat(new[] { newSummary }).ToList();
                        UpdateRequestTags(requestId, updated);
                        ShowToast($"Attached #{tag.Name}");
                    }
                    else
                    {
                        if (_tagPopoverTarget != null && _tagPopoverTarget.Id == requestId)
                        {
                            _tagPopoverError = res.Error.Message;
                        }
                        else
                        {
                            ShowToast($"Error: {res.Error.Message}");
                        }
                    }
                }
                finally
                {
                    _attachingTagIds.Remove(tag.Id);
                }
            }
        }
        catch (Exception ex)
        {
            if (_tagPopoverTarget != null && _tagPopoverTarget.Id == requestId)
            {
                _tagPopoverError = ex.Message;
            }
            else
            {
                ShowToast($"Error toggling #{tag.Name}: {ex.Message}");
            }
        }
        finally
        {
            _attachingTagIds.Remove(tag.Id);
            _processingTagIds.Remove(tag.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateAndAttachNewTagAsync()
    {
        var target = _tagPopoverTarget;
        if (target == null) return;
        var requestId = target.Id;

        if (string.IsNullOrWhiteSpace(_newTagName))
        {
            _tagPopoverError = "Tag name is required.";
            return;
        }

        var deptId = CurrentUser.DepartmentId != Guid.Empty
            ? CurrentUser.DepartmentId
            : target.DepartmentIdAtSubmission;

        if (deptId == Guid.Empty)
        {
            _tagPopoverError = "Cannot determine department for tag creation.";
            return;
        }

        var currentTags = _result?.Items?.FirstOrDefault(i => i.Id == requestId)?.Tags
                          ?? target.Tags
                          ?? Array.Empty<RequestTagSummaryDto>();

        var attachedCount = currentTags.Count(t => t.DepartmentId == deptId);
        if (attachedCount + _attachingTagIds.Count >= 5)
        {
            _tagPopoverError = "Maximum 5 tags per department reached.";
            return;
        }

        _tagPopoverSaving = true;
        _tagPopoverError = null;

        try
        {
            var createRes = await Mediator.Send(new CreateTagCommand(
                deptId,
                _newTagName.Trim(),
                CurrentUser.UserId,
                _newTagColor));

            if (createRes.IsFailure)
            {
                _tagPopoverError = createRes.Error.Message;
                _tagPopoverSaving = false;
                _tagPopoverPendingPosition = true;
                return;
            }

            var newTagId = createRes.Value;

            var attachRes = await Mediator.Send(new AddTagToRequestCommand(requestId, newTagId, CurrentUser.UserId));
            if (attachRes.IsFailure)
            {
                _tagPopoverError = attachRes.Error.Message;
                _tagPopoverSaving = false;
                _tagPopoverPendingPosition = true;
                return;
            }

            var newTagDto = new TagDto(
                newTagId,
                deptId,
                _newTagName.Trim(),
                _newTagColor,
                null,
                true,
                CurrentUser.UserId,
                DateTime.UtcNow);

            _availableDeptTags.Add(newTagDto);

            var newSummaryDto = new RequestTagSummaryDto(
                newTagId,
                _newTagName.Trim(),
                _newTagColor,
                null,
                deptId);

            var latest = _result?.Items?.FirstOrDefault(i => i.Id == requestId)?.Tags
                         ?? currentTags;
            var updated = latest.Where(rt => rt.TagId != newTagId).Concat(new[] { newSummaryDto }).ToList();

            UpdateRequestTags(requestId, updated);

            _newTagName = "";
            _showInlineCreateTag = false;
            _tagPopoverSaving = false;
            _tagPopoverPendingPosition = true;
            ShowToast($"Created & attached #{newTagDto.Name}");
        }
        catch (Exception ex)
        {
            _tagPopoverError = ex.Message;
            _tagPopoverSaving = false;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateRequestTags(Guid requestId, IReadOnlyList<RequestTagSummaryDto> updatedTags)
    {
        if (_result?.Items != null)
        {
            var newItems = _result.Items
                .Select(item => item.Id == requestId ? item with { Tags = updatedTags } : item)
                .ToList();

            _result = _result with { Items = newItems };
        }

        if (_tagPopoverTarget != null && _tagPopoverTarget.Id == requestId)
        {
            _tagPopoverTarget = _tagPopoverTarget with { Tags = updatedTags };
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _showToast = true;
        _toastCts?.Cancel();
        _toastCts = new System.Threading.CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500, token);
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    _showToast = false;
                    StateHasChanged();
                });
            }
        }, token);
        StateHasChanged();
    }
}
