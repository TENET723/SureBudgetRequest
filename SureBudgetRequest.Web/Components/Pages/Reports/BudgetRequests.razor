    private async Task ExecuteQuickApproveAsync(BudgetRequestSummaryDto? target)
    {
        if (target == null || _quickActionProcessing) return;

        // If target is at PendingFinance, Finance approval requires COA selection
        if (target.Status == RequestStatus.PendingFinance)
        {
            OpenQuickActionModal(target, QuickActionType.FinanceApprove);
            return;
        }

        CloseContextMenu();
        _quickActionProcessing = true;
        try
        {
            var res = await Mediator.Send(new ApproveRequestCommand(target.Id, CurrentUser.UserId));
            if (res.IsSuccess)
            {
                ShowToast($"Approved {target.Reference ?? "request"}");
                await RunQueryAsync();
            }
            else
            {
                ShowToast($"Error approving: {res.Error.Message}");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}");
        }
        finally
        {
            _quickActionProcessing = false;
        }
    }

