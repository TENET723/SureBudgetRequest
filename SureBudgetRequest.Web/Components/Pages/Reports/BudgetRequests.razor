@page "/reports/budget-requests"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS

@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.ExportBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Coas.Queries
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>Budget Request Report</PageTitle>

<div class="page-wrap">

    <div class="flex items-center justify-between mb-4">
        <h5>Budget Request Report</h5>
        @if (!_loading && _result is not null)
        {
            <span class="text-muted text-sm">
                @_result.TotalCount result@(_result.TotalCount == 1 ? "" : "s")
            </span>
        }
    </div>

    @if (CurrentUser.Role == UserRole.Employee)
    {
        <div class="alert alert-info">
            Reports are not available for the Employee role.
            <a href="requests/mine">View your own requests instead.</a>
        </div>
    }
    else
    {
        @* ─── Toolbar ─────────────────────────────────────────────────── *@
        <div class="toolbar mb-4">
            <ListSearchBox @bind-Value="_search" OnEnter="ApplyAsync"
                           Placeholder="Search by reference, request, reason" />
            <button class="btn btn-outline btn-sm" @onclick="() => _showFilter = true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Filter
                @if (_activeFilterCount > 0)
                {
                    <span class="topbar-count-badge ml-1">@_activeFilterCount</span>
                }
            </button>
            <div class="toolbar-right">
                <button class="btn btn-success btn-sm" @onclick="OpenColumnModal" disabled="@_loading">Export to Excel</button>
            </div>
        </div>

        @* ─── Results ──────────────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        @if (_loading)
        {
            <div class="text-center">
                <div class="spinner spinner-sm"></div>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="col-no">#</th>
                            <th role="button" style="cursor:pointer"
                                @onclick="@(() => SortByColumn(BudgetRequestSortBy.Reference))">
                                Reference @SortIndicator(BudgetRequestSortBy.Reference)
                            </th>
                            <th role="button" style="cursor:pointer"
                                @onclick="@(() => SortByColumn(BudgetRequestSortBy.SubmittedAt))">
                                Submitted @SortIndicator(BudgetRequestSortBy.SubmittedAt)
                            </th>
                            <th role="button" style="cursor:pointer"
                                @onclick="@(() => SortByColumn(BudgetRequestSortBy.Requester))">
                                Requester @SortIndicator(BudgetRequestSortBy.Requester)
                            </th>
                            <th>Department</th>
                            <th>Reason</th>
                            <th class="text-end">Ccy</th>
                            <th class="text-end">Requested</th>
                            <th class="text-end" role="button" style="cursor:pointer;text-align:right"
                                @onclick="@(() => SortByColumn(BudgetRequestSortBy.AmountInMmk))">≈ MMK @SortIndicator(BudgetRequestSortBy.AmountInMmk)</th>
                            <th role="button" style="cursor:pointer"
                                @onclick="@(() => SortByColumn(BudgetRequestSortBy.Status))">
                                Status @SortIndicator(BudgetRequestSortBy.Status)
                            </th>
                            <th>COA</th>
                            <th>Withdraw</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < (_result?.Items.Count ?? 0); i++)
                        {
                            var r = _result!.Items[i];
                            <tr>
                                <td class="text-muted text-sm">@((_result.Page - 1) * _result.PageSize + i + 1)</td>
                                <td class="text-sm"><strong>@(r.Reference ?? "—")</strong></td>
                                <td class="text-sm text-muted">@r.SubmittedAt.ToMyanmarTime()</td>
                                <td class="text-sm">@LookupUser(r.RequesterId)</td>
                                <td class="text-sm">@LookupDepartment(r.DepartmentIdAtSubmission)</td>
                                <td>@Truncate(r.Reasons, 40)</td>
                                <td class="text-end text-sm text-muted">@r.CurrencyCode</td>
                                <td class="text-end">@r.RequestedAmount.ToString("N2")</td>
                                <td class="text-end text-sm text-muted">@r.RequestedAmountInMmkAtSubmission.ToString("N2")</td>
                                <td>
                                    <span class="badge @StatusBadgeClass(r.Status)">@StatusLabel(r.Status)</span>
                                    @if (r.IsOverLimit)
                                    {
                                        <span class="badge badge-warning" title="Routed through Management">Over-limit</span>
                                    }
                                </td>
                                <td class="text-sm">
                                    @if (!string.IsNullOrEmpty(r.CoaCode))
                                    {
                                        <span title="@r.CoaName">@r.CoaCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-sm">
                                    @if (!string.IsNullOrEmpty(r.WithdrawMethodName))
                                    {
                                        @r.WithdrawMethodName
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="requests/@r.Id?from=reports" class="btn btn-icon " title="View"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32"><path d="M0 0h32v32H0z" fill="none"/><circle cx="16" cy="16" r="4" fill="currentColor"/><path fill="currentColor" d="M30.94 15.66A16.69 16.69 0 0 0 16 5A16.69 16.69 0 0 0 1.06 15.66a1 1 0 0 0 0 .68A16.69 16.69 0 0 0 16 27a16.69 16.69 0 0 0 14.94-10.66a1 1 0 0 0 0-.68M16 22.5a6.5 6.5 0 1 1 6.5-6.5a6.51 6.51 0 0 1-6.5 6.5"/></svg></a>
                                </td>
                            </tr>
                        }
                        @if (_result is null || _result.Items.Count == 0)
                        {
                            <tr><td colspan="13" class="text-center text-muted">No requests match the current filters.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_result is not null && _result.Items.Count > 0)
            {
                <div class="flex items-center justify-between flex-wrap gap-2 mt-2">
                    <div class="flex items-center gap-2">
                        <button class="btn btn-outline btn-sm" @onclick="PrevPage"
                                disabled="@(_loading || !_result.HasPrev)">
                            ‹ Prev
                        </button>
                        <span class="text-sm text-muted">Page @_result.Page of @_result.TotalPages</span>
                        <button class="btn btn-outline btn-sm" @onclick="NextPage"
                                disabled="@(_loading || !_result.HasNext)">
                            Next ›
                        </button>

                        <div class="flex items-center gap-1 ml-3">
                            <span class="text-sm text-muted">Per page</span>
                            <select class="select" style="width:auto"
                                    @bind="_pageSize" @bind:after="OnPageSizeChanged">
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                    </div>

                    <div class="text-sm text-muted text-end">
                        <div>Page subtotal (MMK):
                            <strong class="text-dark">@_result.Items.Sum(r => r.RequestedAmountInMmkAtSubmission).ToString("N2")</strong>
                        </div>
                        <div class="fst-italic">Full total available via Export to Excel.</div>
                    </div>
                </div>
            }
        }
    }
</div>

@* ─── Filter Modal ─────────────────────────────────────────────────────────── *@
@if (_showFilter)
{
    <div class="modal-backdrop">
        <div class="modal modal-lg">
            <div class="modal-header">
                <h6 class="modal-title">Filter</h6>
                <button class="btn btn-icon modal-close" @onclick="() => _showFilter = false">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-grid-3 mb-4">

                    @* Date range *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                        <input type="date" class="input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                        <input type="date" class="input" @bind="_toDate" />
                    </div>

                    @* Department *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Department</label>
                        @if (_departmentLocked)
                        {
                            <input type="text" class="input" readonly
                                   value="@(_departments.FirstOrDefault(d => d.Id == CurrentUser.DepartmentId)?.Name ?? "—")" />
                        }
                        else
                        {
                            <select class="select" @bind="_selectedDepartmentId">
                                <option value="">All departments</option>
                                @foreach (var d in _departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        }
                    </div>

                    @* COA *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Chart Of Account</label>
                        <select class="select" @bind="_selectedCoaId">
                            <option value="">All accounts</option>
                            @foreach (var c in _coas)
                            {
                                <option value="@c.Id">@c.Code — @c.Name@(c.IsActive ? "" : " (inactive)")</option>
                            }
                        </select>
                    </div>

                    @* Currency *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Currency</label>
                        <select class="select" @bind="_selectedCurrencyCode">
                            <option value="">All currencies</option>
                            @foreach (var c in _currencies)
                            {
                                <option value="@c.Code">@c.Code — @c.Name</option>
                            }
                        </select>
                    </div>

                    @* Withdraw Method *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Withdraw Method</label>
                        <select class="select" @bind="_selectedWithdrawMethodId">
                            <option value="">All withdraw methods</option>
                            @foreach (var m in _withdrawMethods)
                            {
                                <option value="@m.Id">@m.Name@(m.IsActive ? "" : " (inactive)")</option>
                            }
                        </select>
                    </div>

                    @* Requester *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Requester</label>
                        <select class="select" @bind="_selectedRequesterId">
                            <option value="">All requesters</option>
                            @foreach (var u in _allUsers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                    </div>

                    @* Approver *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Approved by</label>
                        <select class="select" @bind="_selectedApproverId">
                            <option value="">All approvers</option>
                            @foreach (var u in _approverCandidates)
                            {
                                <option value="@u.Id">@u.FullName (@RoleLabel(u.Role))</option>
                            }
                        </select>
                    </div>

                    @* Over-limit *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Over Limit</label>
                        <select class="select" @bind="_overLimitFilter">
                            <option value="any">All limits</option>
                            <option value="over">Over-limit only</option>
                            <option value="within">Within-limit only</option>
                        </select>
                    </div>

                    @* Amount from *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount from (MMK)</label>
                        <input type="number" step="any" min="0" class="input"
                               placeholder="No minimum" @bind="_amountMmkFrom" />
                    </div>

                    @* Amount to *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount to (MMK)</label>
                        <input type="number" step="any" min="0" class="input"
                               placeholder="No maximum" @bind="_amountMmkTo" />
                    </div>

                    @* Department (Standard filter) *@
                    @* <div>
                        <label class="form-label text-sm text-muted mb-1">Department</label>
                        <select class="select" @bind="_selectedDepartmentId">
                            <option value="">Standard</option>
                            @foreach (var d in _departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div> *@
                </div>

                @* Type *@
                <div class="mb-4">
                    <label class="form-label text-sm text-muted mb-2">Type</label>
                    <div class="flex gap-4">
                        @foreach (var t in AllTypes)
                        {
                            var type = t;
                            <label class="flex items-center gap-2 text-sm" style="cursor:pointer">
                                <input type="checkbox"
                                       style="width:14px;height:14px;accent-color:var(--color-primary)"
                                       checked="@_selectedTypes.Contains(type)"
                                       @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                @TypeLabel(type)
                            </label>
                        }
                    </div>
                </div>

                @* Status *@
                <div class="mb-2">
                    <div class="flex items-center justify-between mb-2">
                        <label class="form-label text-sm text-muted">Status</label>
                        <div class="flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Active))">Active</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Closed))">Closed</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.NeedsAttention))">Needs attention</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Clear))">Clear</button>
                        </div>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var s in AllStatuses)
                        {
                            var status = s;
                            <label>
                                <input type="checkbox"
                                       checked="@_selectedStatuses.Contains(status)"
                                       @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                                @StatusLabel(status)
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline btn-sm" @onclick="ClearAsync">Clear</button>
                <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                    @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                    Apply
                </button>
            </div>
        </div>
    </div>
}

@* ── Export column picker ─────────────────────────────────────────────────── *@
@if (_showColumnModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div>
                <div class="modal-header">
                    <h6 class="modal-title">Choose export columns</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showColumnModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm text-muted">
                        Tick the columns to include, and drag the handle (⠿) to reorder them.
                        The order here is the order they appear in the file.
                    </p>

                    <div class="mb-3">
                        <button class="btn btn-outline btn-sm" style="margin-right:.5rem" @onclick="SelectAllColumns">Select all</button>
                        <button class="btn btn-outline btn-sm" @onclick="SelectNoColumns">Select none</button>
                    </div>

                    <ul class="column-picker" @ref="_pickerRef">
                        @for (var i = 0; i < _columns.Count; i++)
                        {
                            var index = i;
                            var col = _columns[index];
                            <li class="column-picker-item @(_dragIndex == index ? "is-dragging" : "")"
                                draggable="true"
                                @ondragstart="() => OnDragStart(index)"
                                @ondragenter="() => OnDragEnter(index)"
                                @ondragover:preventDefault="true"
                                @ondragend="OnDragEnd">
                                <span class="column-picker-handle" title="Drag to reorder">⠿</span>
                                <label class="column-picker-label">
                                    <input type="checkbox" @bind="col.Selected" />
                                    <span>@col.Header</span>
                                </label>
                            </li>
                        }
                    </ul>

                    <p class="text-sm text-muted mb-0">@SelectedColumnCount of @_columns.Count columns selected.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showColumnModal = false">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="ExportAsync" disabled="@(SelectedColumnCount == 0)">Export</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .column-picker { list-style: none; margin: 0; padding: 0; max-height: 22rem; overflow-y: auto; border: 1px solid var(--border, #e2e2e2); border-radius: .5rem; }
        .column-picker-item { display: flex; align-items: center; gap: .5rem; padding: .4rem .6rem; border-bottom: 1px solid var(--border, #eee); background: var(--surface, #fff); cursor: default; }
        .column-picker-item:last-child { border-bottom: none; }
        .column-picker-item.is-dragging { opacity: .5; cursor: grabbing; }
        .column-picker-handle { cursor: grab; user-select: none; color: var(--text-muted, #999); font-size: 1rem; line-height: 1; }
        .column-picker-handle:active { cursor: grabbing; }
        .column-picker-item.is-dragging .column-picker-handle { cursor: grabbing; }
        .column-picker-label { display: flex; align-items: center; gap: .5rem; margin: 0; flex: 1; cursor: pointer; }
    </style>
}

@code {
    // ── Filter state ─────────────────────────────────────────────────────────
    private string _search = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _selectedDepartmentId = "";
    private string _selectedCoaId = "";
    private string _selectedCurrencyCode = "";
    private string _selectedWithdrawMethodId = "";
    private string _selectedRequesterId = "";
    private string _selectedApproverId = "";
    private string _overLimitFilter = "any";
    private HashSet<RequestStatus> _selectedStatuses = new();
    private HashSet<BudgetRequestType> _selectedTypes = new();
    private decimal? _amountMmkFrom;
    private decimal? _amountMmkTo;
    private bool _periodOverrunOnly;
    private bool _departmentLocked;

    // ── UI state ─────────────────────────────────────────────────────────────
    private bool _showFilter;

    private int _activeFilterCount => new[]
    {
        !string.IsNullOrEmpty(_search),
        _fromDate.HasValue,
        _toDate.HasValue,
        !string.IsNullOrEmpty(_selectedDepartmentId),
        !string.IsNullOrEmpty(_selectedCoaId),
        !string.IsNullOrEmpty(_selectedCurrencyCode),
        !string.IsNullOrEmpty(_selectedWithdrawMethodId),
        !string.IsNullOrEmpty(_selectedRequesterId),
        !string.IsNullOrEmpty(_selectedApproverId),
        _overLimitFilter != "any",
        _selectedStatuses.Count > 0,
        _selectedTypes.Count > 0,
        _amountMmkFrom.HasValue,
        _amountMmkTo.HasValue,
        _periodOverrunOnly,
    }.Count(x => x);

    // ── Reference data ───────────────────────────────────────────────────────
    private List<DepartmentDto> _departments = new();
    private List<CoaDto> _coas = new();
    private List<CurrencyDto> _currencies = new();
    private List<WithdrawMethodDto> _withdrawMethods = new();
    private List<UserDto> _allUsers = new();
    private List<UserDto> _approverCandidates = new();
    private Dictionary<Guid, string> _userNames = new();
    private Dictionary<Guid, string> _departmentNames = new();

    // ── Paging & sort ────────────────────────────────────────────────────────
    private int _page = 1;
    private int _pageSize = 50;
    private BudgetRequestSortBy _sortBy = BudgetRequestSortBy.SubmittedAt;
    private bool _sortDescending = true;

    // ── Results ──────────────────────────────────────────────────────────────
    private PagedResult<BudgetRequestSummaryDto>? _result;
    private bool _loading = true;
    private string? _errorMessage;

    private static readonly RequestStatus[] AllStatuses =
    {
        RequestStatus.Draft,
        RequestStatus.PendingDeptHead,
        RequestStatus.PendingManagement,
        RequestStatus.PendingFinance,
        RequestStatus.SentBack,
        RequestStatus.Approved,
        RequestStatus.PartiallyPaid,
        RequestStatus.Paid,
        RequestStatus.Rejected,
        RequestStatus.Cancelled,
        RequestStatus.PendingReconciliation,
        RequestStatus.AwaitingRefund,
        RequestStatus.AwaitingReimbursement,
        RequestStatus.Reconciled,
    };

    private static readonly BudgetRequestType[] AllTypes =
    {
        BudgetRequestType.Urgent,
        BudgetRequestType.Standard,
        BudgetRequestType.ProjectProposal,
        BudgetRequestType.Advance,
    };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role == UserRole.Employee)
        {
            _loading = false;
            return;
        }

        // Use Myanmar business time so the default month/day is correct even
        // when opened between 00:00-06:30 AM MMT (where UTC is still yesterday).
        var nowMm = DateTime.UtcNow.ToMyanmarDateTime();
        _fromDate = new DateTime(nowMm.Year, nowMm.Month, 1);
        _toDate = nowMm.Date;

        if (CurrentUser.Role == UserRole.DepartmentHead)
        {
            _selectedDepartmentId = CurrentUser.DepartmentId.ToString();
            _departmentLocked = true;
        }

        await LoadReferenceDataAsync();
        await RunQueryAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
        if (depts.IsSuccess)
        {
            _departments = depts.Value!.Where(d => d.IsActive).OrderBy(d => d.Name).ToList();
            _departmentNames = depts.Value!.ToDictionary(d => d.Id, d => d.Name);
        }

        var coas = await Mediator.Send(new ListCoasQuery(IncludeInactive: true));
        if (coas.IsSuccess)
            _coas = coas.Value!.OrderBy(c => c.Code).ToList();

        var ccys = await Mediator.Send(new ListCurrenciesQuery(IncludeInactive: true));
        if (ccys.IsSuccess)
            _currencies = ccys.Value!.OrderBy(c => c.Code == "MMK" ? 0 : 1).ThenBy(c => c.Code).ToList();

        var methods = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: true));
        if (methods.IsSuccess)
            _withdrawMethods = methods.Value!.OrderBy(m => m.Name).ToList();

        var users = await Mediator.Send(new ListUsersQuery(IncludeInactive: false));
        if (users.IsSuccess)
        {
            _allUsers = users.Value!.OrderBy(u => u.FullName).ToList();
            _approverCandidates = _allUsers
                .Where(u => u.Role is UserRole.DepartmentHead
                                   or UserRole.Management
                                   or UserRole.Finance
                                   or UserRole.Admin)
                .ToList();
            _userNames = _allUsers.ToDictionary(u => u.Id, u => u.FullName);
        }
    }

    private async Task RunQueryAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            DateTime? fromUtc = _fromDate.HasValue
                ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
                : null;
            DateTime? untilUtc = _toDate.HasValue
                ? DateTime.SpecifyKind(_toDate.Value.Date, DateTimeKind.Utc).AddDays(1)
                : null;

            bool? overLimitOnly = _overLimitFilter switch
            {
                "over"   => true,
                "within" => false,
                _        => null
            };

            IReadOnlyCollection<RequestStatus>? statuses =
                _selectedStatuses.Count > 0 ? _selectedStatuses.ToList() : null;

            IReadOnlyCollection<BudgetRequestType>? types =
                _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null;

            decimal? amountFrom = _amountMmkFrom;
            decimal? amountTo = _amountMmkTo;
            if (amountFrom.HasValue && amountTo.HasValue && amountFrom.Value > amountTo.Value)
            {
                amountFrom = null;
                amountTo = null;
            }

            var result = await Mediator.Send(new SearchBudgetRequestsQuery(
                RequesterId: ParseGuid(_selectedRequesterId),
                DepartmentId: ParseGuid(_selectedDepartmentId),
                Status: null,
                Statuses: statuses,
                SubmittedFromUtc: fromUtc,
                SubmittedUntilUtc: untilUtc,
                CoaId: ParseGuid(_selectedCoaId),
                CurrencyCode: string.IsNullOrEmpty(_selectedCurrencyCode) ? null : _selectedCurrencyCode,
                ApproverId: ParseGuid(_selectedApproverId),
                OverLimitOnly: overLimitOnly,
                Types: types,
                AmountInMmkFrom: amountFrom,
                AmountInMmkTo: amountTo,
                PeriodOverrunOnly: _periodOverrunOnly ? true : null,
                SearchTerm: string.IsNullOrWhiteSpace(_search) ? null : _search,
                SortBy: _sortBy,
                SortDescending: _sortDescending,
                Page: _page,
                PageSize: _pageSize,
                WithdrawMethodId: ParseGuid(_selectedWithdrawMethodId)));

            if (result.IsSuccess)
                _result = result.Value!;
            else
            {
                _errorMessage = result.Error.Message;
                _result = null;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task ApplyAsync()
    {
        _page = 1;
        return RunQueryAsync();
    }

    private async Task ApplyAndClose()
    {
        _showFilter = false;
        await ApplyAsync();
    }

    private Task SortByColumn(BudgetRequestSortBy column)
    {
        if (_sortBy == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortBy = column;
            _sortDescending = column is BudgetRequestSortBy.SubmittedAt or BudgetRequestSortBy.AmountInMmk;
        }
        _page = 1;
        return RunQueryAsync();
    }

    private string SortIndicator(BudgetRequestSortBy column) =>
        _sortBy == column ? (_sortDescending ? "▼" : "▲") : "";

    private Task PrevPage()
    {
        if (_result is null || !_result.HasPrev) return Task.CompletedTask;
        _page--;
        return RunQueryAsync();
    }

    private Task NextPage()
    {
        if (_result is null || !_result.HasNext) return Task.CompletedTask;
        _page++;
        return RunQueryAsync();
    }

    private Task OnPageSizeChanged()
    {
        _page = 1;
        return RunQueryAsync();
    }

    // ── Export column picker ──────────────────────────────────────────────────
    private bool _showColumnModal;
    private int? _dragIndex;
    private List<ColumnChoice> _columns = new();
    private ElementReference _pickerRef;
    private bool _dndWired;

    private int SelectedColumnCount => _columns.Count(c => c.Selected);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wire the native drag-cursor handlers onto the picker list once it's in
        // the DOM. The list is a fresh element each time the modal opens, so we
        // re-wire per open (tracked by _dndWired, reset in OpenColumnModal).
        if (_showColumnModal && !_dndWired)
        {
            _dndWired = true;
            await JS.InvokeVoidAsync("columnPickerDnd.enable", _pickerRef);
        }
    }

    private void OpenColumnModal()
    {
        // No persistence: rebuild from the canonical registry on every open —
        // all columns selected, in default order.
        _columns = ExportColumns.DefaultOrder
            .Select(c => new ColumnChoice(c.Key, c.Header))
            .ToList();
        _dragIndex = null;
        _dndWired = false;   // re-wire the native handlers on the new list element
        _showColumnModal = true;
    }

    private void SelectAllColumns() { foreach (var c in _columns) c.Selected = true; }
    private void SelectNoColumns()  { foreach (var c in _columns) c.Selected = false; }

    // Native HTML5 drag-and-drop reorder — no JS library.
    //
    // The list reorders LIVE as the dragged row passes over another row
    // (ondragenter); we deliberately do NOT rely on the ondrop event. ondrop only
    // fires when the drop target cancels the dragover/dragenter default, which is
    // unreliable here because each row contains interactive children (checkbox +
    // label) that the browser treats as the event target — so drops get swallowed.
    // Reordering on dragenter sidesteps that entirely; ondragend just clears state.
    private void OnDragStart(int index) => _dragIndex = index;
    private void OnDragEnd() => _dragIndex = null;

    private void OnDragEnter(int index)
    {
        if (_dragIndex is not int from || from == index
            || from < 0 || from >= _columns.Count
            || index < 0 || index >= _columns.Count)
            return;

        var item = _columns[from];
        _columns.RemoveAt(from);
        _columns.Insert(index, item);
        _dragIndex = index;   // the dragged item now lives at the row it entered
    }

    private sealed class ColumnChoice
    {
        public ColumnChoice(ExportColumn key, string header)
        {
            Key = key;
            Header = header;
        }

        public ExportColumn Key { get; }
        public string Header { get; }
        public bool Selected { get; set; } = true;
    }

    private async Task ExportAsync()
    {
        var query = new List<string>();
        void Add(string key, string? value)
        {
            if (!string.IsNullOrEmpty(value))
                query.Add($"{key}={Uri.EscapeDataString(value)}");
        }

        Add("search", _search);
        if (_fromDate.HasValue) Add("from", _fromDate.Value.ToString("yyyy-MM-dd"));
        if (_toDate.HasValue) Add("to", _toDate.Value.ToString("yyyy-MM-dd"));
        Add("departmentId", _selectedDepartmentId);
        Add("coaId", _selectedCoaId);
        Add("currency", _selectedCurrencyCode);
        Add("withdrawMethodId", _selectedWithdrawMethodId);
        Add("requesterId", _selectedRequesterId);
        Add("approverId", _selectedApproverId);
        if (_overLimitFilter != "any") Add("overLimit", _overLimitFilter);
        foreach (var s in _selectedStatuses)
            Add("statuses", s.ToString());

        // Mirror EVERY remaining on-screen filter so the export matches the
        // table exactly (these were missing before — the cause of UI/export
        // row-count mismatches).
        foreach (var t in _selectedTypes)
            Add("types", t.ToString());
        if (_amountMmkFrom.HasValue)
            Add("amountFrom", _amountMmkFrom.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_amountMmkTo.HasValue)
            Add("amountTo", _amountMmkTo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_periodOverrunOnly)
            Add("periodOverrun", "true");

        // Sort selection, so the file rows come out in the on-screen order.
        Add("sortBy", _sortBy.ToString());
        Add("sortDesc", _sortDescending ? "true" : "false");

        // Selected export columns, in the user's chosen (drag-ordered) order.
        // Repeated params preserve order server-side. None selected → no params →
        // the endpoint falls back to all columns.
        foreach (var c in _columns.Where(c => c.Selected))
            Add("columns", c.Key.ToString());

        var url = "/api/reports/budget-requests/export";
        if (query.Count > 0)
            url += "?" + string.Join("&", query);

        await JS.InvokeVoidAsync("open", url, "_blank");
        _showColumnModal = false;
    }

    private async Task ClearAsync()
    {
        _search = "";
        _fromDate = null;
        _toDate = null;
        _selectedCoaId = "";
        _selectedCurrencyCode = "";
        _selectedWithdrawMethodId = "";
        _selectedRequesterId = "";
        _selectedApproverId = "";
        _overLimitFilter = "any";
        _selectedStatuses.Clear();
        _selectedTypes.Clear();
        _amountMmkFrom = null;
        _amountMmkTo = null;
        _periodOverrunOnly = false;

        if (!_departmentLocked)
            _selectedDepartmentId = "";

        _page = 1;
        await RunQueryAsync();
    }

    private void ToggleStatus(RequestStatus s, bool isChecked)
    {
        if (isChecked) _selectedStatuses.Add(s);
        else _selectedStatuses.Remove(s);
    }

    private void ToggleType(BudgetRequestType t, bool isChecked)
    {
        if (isChecked) _selectedTypes.Add(t);
        else _selectedTypes.Remove(t);
    }

    private enum StatusPreset { Active, Closed, NeedsAttention, Clear }

    private void ApplyStatusPreset(StatusPreset preset)
    {
        _selectedStatuses = preset switch
        {
            StatusPreset.Active => new()
            {
                RequestStatus.PendingDeptHead,
                RequestStatus.PendingManagement,
                RequestStatus.PendingFinance,
                RequestStatus.Approved,
                RequestStatus.PartiallyPaid,
            },
            StatusPreset.Closed => new()
            {
                RequestStatus.Paid,
                RequestStatus.Reconciled,
                RequestStatus.Rejected,
                RequestStatus.Cancelled,
            },
            StatusPreset.NeedsAttention => new()
            {
                RequestStatus.SentBack,
                RequestStatus.PendingReconciliation,
                RequestStatus.AwaitingRefund,
                RequestStatus.AwaitingReimbursement,
            },
            _ => new(),
        };
    }

    private static Guid? ParseGuid(string s) =>
        Guid.TryParse(s, out var g) ? g : null;

    private string LookupUser(Guid id) =>
        _userNames.TryGetValue(id, out var name) ? name : "—";

    private string LookupDepartment(Guid id) =>
        _departmentNames.TryGetValue(id, out var name) ? name : "—";

