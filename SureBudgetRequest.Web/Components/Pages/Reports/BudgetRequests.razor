@page "/reports/budget-requests"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.AppSettings.Queries
@using SureBudgetRequest.Application.BudgetRequests.Commands.AddTagToRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.ApproveRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.RejectRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.RemoveTagFromRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.SendBackRequest
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoApproval
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoReconciliationSubmit
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoRefund
@using SureBudgetRequest.Application.BudgetRequests.Commands.UndoSubmit
@using SureBudgetRequest.Application.BudgetRequests.Queries.ListBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.ExportBudgetRequests
@using SureBudgetRequest.Application.BudgetRequests.Queries.SearchBudgetRequests
@using SureBudgetRequest.Application.Common
@using SureBudgetRequest.Application.Coas.Queries
@using SureBudgetRequest.Application.Currencies.Queries
@using SureBudgetRequest.Application.Departments.Queries
@using SureBudgetRequest.Application.Tags.Commands.CreateTag
@using SureBudgetRequest.Application.Tags.Models
@using SureBudgetRequest.Application.Tags.Queries
@using SureBudgetRequest.Application.Users.Queries
@using SureBudgetRequest.Application.WithdrawMethods.Queries
@using SureBudgetRequest.Domain.Enums
@using SureBudgetRequest.Web.Components.Shared
@using SureBudgetRequest.Web.Services

<PageTitle>Budget Request Report</PageTitle>

<div class="page-wrap">

    <div class="flex items-center justify-between mb-4">
        <h5>Budget Request Report</h5>
        @if (!_loading && _result is not null)
        {
            <span class="text-muted text-sm">
                @_result.TotalCount result@(_result.TotalCount == 1 ? "" : "s")
            </span>
        }
    </div>

    @if (CurrentUser.Role == UserRole.Employee && !CurrentUser.IsDepartmentHead)
    {
        <div class="alert alert-info">
            Reports are not available for the Employee role.
            <a href="requests/mine">View your own requests instead.</a>
        </div>
    }
    else
    {
        @* ─── Toolbar ─────────────────────────────────────────────────── *@
        <div class="toolbar mb-4">
            <ListSearchBox @bind-Value="_search" OnEnter="ApplyAsync"
                           Placeholder="Search by reference, request, reason" />
            <button class="btn btn-outline btn-sm" @onclick="() => _showFilter = true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M1 3h12M3 7h8M5 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Filter
                @if (_activeFilterCount > 0)
                {
                    <span class="topbar-count-badge ml-1">@_activeFilterCount</span>
                }
            </button>
            <div class="toolbar-right">
                <button class="btn btn-success btn-sm" @onclick="OpenColumnModal" disabled="@_loading">Export to Excel</button>
            </div>
        </div>

        @* ─── Results ──────────────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <AppTable TItem="BudgetRequestSummaryDto"
                  Items="@_result?.Items"
                  IsLoading="@_loading"
                  ColSpan="11">
            <TableHeader>
                <th class="sticky-no-col font-bold">NO.</th>
                <th role="button" class="sortable"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.SubmittedAt))">
                    Reference & Date @RenderSortIcon(BudgetRequestSortBy.SubmittedAt, BudgetRequestSortBy.Reference)
                </th>
                <th role="button" class="sortable col-requester"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.Requester))">
                    Requester @RenderSortIcon(BudgetRequestSortBy.Requester)
                </th>
                <th class="col-reason">Reason</th>
                <th style="min-width: 180px">Tags</th>
                <th class="text-end col-requested">Requested</th>
                <th class="text-end sortable col-mmk" role="button"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.AmountInMmk))">≈ MMK @RenderSortIcon(BudgetRequestSortBy.AmountInMmk)</th>
                <th role="button" class="sortable col-status"
                    @onclick="@(() => SortByColumn(BudgetRequestSortBy.Status))">
                    Status @RenderSortIcon(BudgetRequestSortBy.Status)
                </th>
                <th class="col-coa">COA</th>
                <th class="col-withdraw">Withdraw</th>
                <th class="sticky-action-col"></th>
            </TableHeader>
            <RowTemplateWithIndex Context="ctx">
                @{
                    var r = ctx.Item;
                    var i = ctx.Index;
                }
                <tr class="clickable-row @(_contextMenuTarget?.Id == r.Id ? "menu-open" : "")"
                    @onclick="() => NavigateToDetail(r.Id)"
                    @oncontextmenu="e => OpenContextMenu(e, r)"
                    @oncontextmenu:preventDefault="true">
                    <td class="sticky-no-col text-muted text-sm text-center">@((_result!.Page - 1) * _result.PageSize + i + 1)</td>
                    <td class="text-sm">
                        <div class="font-semibold text-dark">@(r.Reference ?? "—")</div>
                        <div class="text-muted text-xs">@r.SubmittedAt.ToMyanmarTime()</div>
                    </td>
                    <td class="text-sm col-requester">
                        <div>@LookupUser(r.RequesterId)</div>
                        <div class="text-muted text-xs">@LookupDepartment(r.DepartmentIdAtSubmission)</div>
                    </td>
                    <td class="col-reason">
                        @if (!string.IsNullOrWhiteSpace(r.Reasons))
                        {
                            <span class="reason-clamp">
                                @r.Reasons
                            </span>
                        }
                        else
                        {
                            <span class="text-muted text-xs">—</span>
                        }
                    </td>
                    <td>
                        @if (r.Tags != null && r.Tags.Count > 0)
                        {
                            <div class="flex items-center gap-1 flex-wrap">
                                @foreach (var tag in r.Tags.Take(5))
                                {
                                    <span class="tag-badge-pill"
                                          style="background-color: @(tag.ColorHex ?? "#6c757d"); color: @tag.EffectiveFontColor;">
                                        #@tag.Name
                                    </span>
                                }
                                @if (r.Tags.Count > 5)
                                {
                                    var overflowCount = r.Tags.Count - 5;
                                    <div class="tag-tooltip-container" @onclick:stopPropagation="true">
                                        <span class="tag-badge-pill" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 600; cursor: pointer;">
                                            +@overflowCount
                                        </span>
                                        <div class="tag-tooltip-popup">
                                            @foreach (var ot in r.Tags.Skip(5))
                                            {
                                                <span>#@ot.Name</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted text-xs">—</span>
                        }
                    </td>
                    <td class="text-end font-semibold col-requested">
                        @r.RequestedAmount.ToString("N2") <span class="ccy-tag">@r.CurrencyCode</span>
                    </td>
                    <td class="text-end text-sm text-muted col-mmk">@r.RequestedAmountInMmkAtSubmission.ToString("N2")</td>
                    <td class="col-status">
                        <div class="status-chip-group">
                            <span class="chip @StatusChipClass(r.Status)"><span class="dot"></span>@StatusLabel(r.Status)</span>
                            @if (r.IsOverLimit)
                            {
                                <span class="chip chip-overlimit" title="Routed through Management">Over-limit</span>
                            }
                        </div>
                    </td>
                    <td class="text-sm col-coa">
                        @if (!string.IsNullOrEmpty(r.CoaCode))
                        {
                            <span title="@r.CoaName">@r.CoaCode</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-sm col-withdraw">
                        @if (!string.IsNullOrEmpty(r.WithdrawMethodName))
                        {
                            @r.WithdrawMethodName
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="sticky-action-col" @onclick:stopPropagation="true">
                        <div class="row-hover-btn-wrapper">
                            <div class="row-hover-backdrop"></div>
                            <button type="button" class="btn-three-dots" title="Quick actions"
                                    @onclick="e => OpenContextMenuFromButton(e, r)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </RowTemplateWithIndex>
            <EmptyContent>
                No requests match the current filters.
            </EmptyContent>
            <PaginationContent>
                @if (_result is not null && _result.Items.Count > 0)
                {
                    <div class="flex items-center justify-between flex-wrap gap-3 w-full">
                        <div class="text-sm text-muted">
                            Page subtotal (MMK): <strong class="text-dark">@_result.Items.Sum(r => r.RequestedAmountInMmkAtSubmission).ToString("N2")</strong>
                        </div>

                        <div class="flex items-center gap-2">
                            <button class="btn btn-outline btn-sm" @onclick="PrevPage"
                                    disabled="@(_loading || !_result.HasPrev)">
                                ‹ Prev
                            </button>
                            <span class="text-sm text-muted">Page @_result.Page of @_result.TotalPages</span>
                            <button class="btn btn-outline btn-sm" @onclick="NextPage"
                                    disabled="@(_loading || !_result.HasNext)">
                                Next ›
                            </button>

                            <div class="flex items-center gap-2 ml-3">
                                <span class="text-sm text-muted">Per page</span>
                                <select class="select select-sm" style="width:auto; height: 30px;"
                                        @bind="_pageSize" @bind:after="OnPageSizeChanged">
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </PaginationContent>
        </AppTable>
    }
</div>

@* ─── Filter Modal ─────────────────────────────────────────────────────────── *@
@if (_showFilter)
{
    <div class="modal-backdrop">
        <div class="modal modal-lg">
            <div class="modal-header">
                <h6 class="modal-title">Filter</h6>
                <button class="btn btn-icon modal-close" @onclick="() => _showFilter = false">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-grid-3 mb-4">

                    @* Date range *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted from</label>
                        <input type="date" class="input" @bind="_fromDate" />
                    </div>
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Submitted to</label>
                        <input type="date" class="input" @bind="_toDate" />
                    </div>

                    @* Department *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Department</label>
                        @if (_departmentLocked)
                        {
                            <input type="text" class="input" readonly
                                   value="@(_departments.FirstOrDefault(d => d.Id.ToString() == _selectedDepartmentId)?.Name ?? _departments.FirstOrDefault(d => d.Id == CurrentUser.DepartmentId)?.Name ?? "—")" />
                        }
                        else
                        {
                            <Dropdown Items="_departments"
                                      @bind-Value="_selectedDepartmentId"
                                      @bind-Value:after="OnDepartmentFilterChanged"
                                      ValueSelector="d => d.Id.ToString()"
                                      TextSelector="d => d.Name"
                                      Placeholder="All departments"
                                      Searchable="true"
                                      SearchPlaceholder="Search department..."
                                      AllowClear="true" />
                        }
                    </div>

                    @* COA *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Chart Of Account</label>
                        <Dropdown Items="_coas"
                                  @bind-Value="_selectedCoaId"
                                  ValueSelector="c => c.Id.ToString()"
                                  TextSelector="FormatCoa"
                                  Placeholder="All accounts"
                                  Searchable="true"
                                  SearchPlaceholder="Search code or account..."
                                  AllowClear="true" />
                    </div>

                    @* Currency *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Currency</label>
                        <Dropdown Items="_currencies"
                                  @bind-Value="_selectedCurrencyCode"
                                  ValueSelector="c => c.Code"
                                  TextSelector="FormatCurrency"
                                  Placeholder="All currencies"
                                  AllowClear="true" />
                    </div>

                    @* Withdraw Method *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Withdraw Method</label>
                        <Dropdown Items="_withdrawMethods"
                                  @bind-Value="_selectedWithdrawMethodId"
                                  ValueSelector="m => m.Id.ToString()"
                                  TextSelector="FormatWithdrawMethod"
                                  Placeholder="All withdraw methods"
                                  AllowClear="true" />
                    </div>

                    @* Requester *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Requester</label>
                        <Dropdown Items="_allUsers"
                                  @bind-Value="_selectedRequesterId"
                                  ValueSelector="u => u.Id.ToString()"
                                  TextSelector="u => u.FullName"
                                  Placeholder="All requesters"
                                  Searchable="true"
                                  SearchPlaceholder="Search requester..."
                                  AllowClear="true" />
                    </div>

                    @* Approver *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Approved by</label>
                        <Dropdown Items="_approverCandidates"
                                  @bind-Value="_selectedApproverId"
                                  ValueSelector="u => u.Id.ToString()"
                                  TextSelector="FormatApprover"
                                  Placeholder="All approvers"
                                  Searchable="true"
                                  SearchPlaceholder="Search approver..."
                                  AllowClear="true" />
                    </div>

                    @* Over-limit *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Over Limit</label>
                        <select class="select" @bind="_overLimitFilter">
                            <option value="any">All limits</option>
                            <option value="over">Over-limit only</option>
                            <option value="within">Within-limit only</option>
                        </select>
                    </div>

                    @* Amount from *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount from (MMK)</label>
                        <NumericInput Min="0" Step="any" Placeholder="No minimum" @bind-Value="_amountMmkFrom" />
                    </div>

                    @* Amount to *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Amount to (MMK)</label>
                        <NumericInput Min="0" Step="any" Placeholder="No maximum" @bind-Value="_amountMmkTo" />
                    </div>

                    @* Tag *@
                    <div>
                        <label class="form-label text-sm text-muted mb-1">Tag</label>
                        <Dropdown Items="AvailableTagsForDepartment"
                                  @bind-Value="_selectedTagId"
                                  ValueSelector="tag => tag.Id.ToString()"
                                  TextSelector="FormatTag"
                                  Placeholder="All tags"
                                  Searchable="true"
                                  SearchPlaceholder="Search tag..."
                                  AllowClear="true" />
                    </div>
                </div>

                @* Type *@
                <div class="mb-4">
                    <label class="form-label text-sm text-muted mb-2">Type</label>
                    <div class="flex gap-4">
                        @foreach (var t in AllTypes)
                        {
                            var type = t;
                            <label class="flex items-center gap-2 text-sm" style="cursor:pointer">
                                <input type="checkbox"
                                       style="width:14px;height:14px;accent-color:var(--color-primary)"
                                       checked="@_selectedTypes.Contains(type)"
                                       @onchange="@((ChangeEventArgs e) => ToggleType(type, (bool)e.Value!))" />
                                @TypeLabel(type)
                            </label>
                        }
                    </div>
                </div>

                @* Status *@
                <div class="mb-2">
                    <div class="flex items-center justify-between mb-2">
                        <label class="form-label text-sm text-muted">Status</label>
                        <div class="flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Active))">Active</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Closed))">Closed</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.NeedsAttention))">Needs attention</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => ApplyStatusPreset(StatusPreset.Clear))">Clear</button>
                        </div>
                    </div>
                    <div class="checkbox-grid">
                        @foreach (var s in AllStatuses)
                        {
                            var status = s;
                            <label>
                                <input type="checkbox"
                                       checked="@_selectedStatuses.Contains(status)"
                                       @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                                @StatusLabel(status)
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline btn-sm" @onclick="ClearAsync">Clear</button>
                <button class="btn btn-primary btn-sm" @onclick="ApplyAndClose" disabled="@_loading">
                    @if (_loading) { <span class="spinner spinner-sm mr-1"></span> }
                    Apply
                </button>
            </div>
        </div>
    </div>
}

@* ── Export column picker ─────────────────────────────────────────────────── *@
@if (_showColumnModal)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div>
                <div class="modal-header">
                    <h6 class="modal-title">Choose export columns</h6>
                    <button class="btn btn-icon modal-close" @onclick="() => _showColumnModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm text-muted">
                        Tick the columns to include, and drag the handle (⠿) to reorder them.
                        The order here is the order they appear in the file.
                    </p>

                    <div class="mb-3">
                        <button class="btn btn-outline btn-sm" style="margin-right:.5rem" @onclick="SelectAllColumns">Select all</button>
                        <button class="btn btn-outline btn-sm" @onclick="SelectNoColumns">Select none</button>
                    </div>

                    <ul class="column-picker" @ref="_pickerRef">
                        @for (var i = 0; i < _columns.Count; i++)
                        {
                            var index = i;
                            var col = _columns[index];
                            <li class="column-picker-item @(_dragIndex == index ? "is-dragging" : "")"
                                draggable="true"
                                @ondragstart="() => OnDragStart(index)"
                                @ondragenter="() => OnDragEnter(index)"
                                @ondragover:preventDefault="true"
                                @ondragend="OnDragEnd">
                                <span class="column-picker-handle" title="Drag to reorder">⠿</span>
                                <label class="column-picker-label">
                                    <input type="checkbox" @bind="col.Selected" />
                                    <span>@col.Header</span>
                                </label>
                            </li>
                        }
                    </ul>

                    <p class="text-sm text-muted mb-0">@SelectedColumnCount of @_columns.Count columns selected.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="() => _showColumnModal = false">Cancel</button>
                    <button class="btn btn-success btn-sm" @onclick="ExportAsync" disabled="@(SelectedColumnCount == 0)">Export</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .column-picker { list-style: none; margin: 0; padding: 0; max-height: 22rem; overflow-y: auto; border: 1px solid var(--border, #e2e2e2); border-radius: .5rem; }
        .column-picker-item { display: flex; align-items: center; gap: .5rem; padding: .4rem .6rem; border-bottom: 1px solid var(--border, #eee); background: var(--surface, #fff); cursor: default; }
        .column-picker-item:last-child { border-bottom: none; }
        .column-picker-item.is-dragging { opacity: .5; cursor: grabbing; }
        .column-picker-handle { cursor: grab; user-select: none; color: var(--text-muted, #999); font-size: 1rem; line-height: 1; }
        .column-picker-handle:active { cursor: grabbing; }
        .column-picker-item.is-dragging .column-picker-handle { cursor: grabbing; }
        .column-picker-label { display: flex; align-items: center; gap: .5rem; margin: 0; flex: 1; cursor: pointer; }
    </style>
}

@* ── Context Menu ────────────────────────────────────────────────────────── *@
@if (_showContextMenu && _contextMenuTarget != null)
{
    <div style="position: fixed; inset: 0; z-index: 1040; cursor: default; background: transparent;"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@(_contextMenuTarget.Reference ?? "Request")</span>
            @* <span class="badge @StatusBadgeClass(_contextMenuTarget.Status)" style="font-size: 10px; padding: 1px 6px;">
                @StatusLabel(_contextMenuTarget.Status)
            </span> *@
        </div>

        <button type="button" class="context-menu-item" @onclick="() => NavigateToDetail(_contextMenuTarget.Id)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span>Open Details</span>
        </button>

        <button type="button" class="context-menu-item" @onclick="() => OpenInNewTab(_contextMenuTarget.Id)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            <span>Open in New Tab</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (!string.IsNullOrEmpty(_contextMenuTarget.Reference))
        {
            <button type="button" class="context-menu-item" @onclick="() => CopyReferenceAsync(_contextMenuTarget.Reference)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Copy Reference</span>
            </button>
        }

        @if (CanUserAttachTag(_contextMenuTarget))
        {
            <button type="button" class="context-menu-item" @onclick="() => OpenTagPopoverFromContextMenuAsync(_contextMenuTarget)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <span>Manage Tags</span>
            </button>
        }

        @if (ShouldShowStatusActionsSection())
        {
            var approveState = GetApproveActionState(_contextMenuTarget);
            var sendBackState = GetSendBackActionState(_contextMenuTarget);
            var rejectState = GetRejectActionState(_contextMenuTarget);
            var undoApproveState = GetUndoApproveActionState(_contextMenuTarget);
            var undoSubmitState = GetUndoSubmitActionState(_contextMenuTarget);

            <div class="context-menu-divider"></div>
            <div class="menu-section-title">Status Actions</div>

            @if (CurrentUser.Role != UserRole.Admin)
            {
                <button type="button"
                        class="status-action-item action-approve"
                        disabled="@(!approveState.Enabled || _quickActionProcessing)"
                        @onclick="() => ExecuteQuickApproveAsync(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Approve</span>
                    </div>
                    @if (!approveState.Enabled && !string.IsNullOrEmpty(approveState.Reason))
                    {
                        <span class="action-reason-hint">@approveState.Reason</span>
                    }
                </button>

                <button type="button"
                        class="status-action-item action-sendback"
                        disabled="@(!sendBackState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.SendBack)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
                        <span>Send Back</span>
                    </div>
                    @if (!sendBackState.Enabled && !string.IsNullOrEmpty(sendBackState.Reason))
                    {
                        <span class="action-reason-hint">@sendBackState.Reason</span>
                    }
                </button>

                <button type="button"
                        class="status-action-item action-reject"
                        disabled="@(!rejectState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.Reject)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span>Reject</span>
                    </div>
                    @if (!rejectState.Enabled && !string.IsNullOrEmpty(rejectState.Reason))
                    {
                        <span class="action-reason-hint">@rejectState.Reason</span>
                    }
                </button>
            }

            @if (CurrentUser.Role == UserRole.Admin)
            {
                var undoInfo = GetUndoApprovalTargetInfo(_contextMenuTarget);
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@(!undoApproveState.Enabled || _quickActionProcessing)"
                        @onclick="() => OpenQuickActionModal(_contextMenuTarget, QuickActionType.UndoApprove)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>@(string.IsNullOrEmpty(undoInfo.Stage) ? "Undo Approval" : $"Undo {undoInfo.Stage} Approval")</span>
                    </div>
                    @if (undoApproveState.Enabled && !string.IsNullOrEmpty(undoInfo.TargetStatus))
                    {
                        <span class="action-reason-hint" style="color: var(--color-warning);">Reverts to @undoInfo.TargetStatus</span>
                    }
                    else if (!string.IsNullOrEmpty(undoApproveState.Reason))
                    {
                        <span class="action-reason-hint">@undoApproveState.Reason</span>
                    }
                </button>
            }

            @if (_contextMenuTarget.RequesterId == CurrentUser.UserId)
            {
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@(!undoSubmitState.Enabled || _quickActionProcessing)"
                        style="@(!undoSubmitState.Enabled ? "opacity: 0.5; cursor: not-allowed;" : "")"
                        title="@(undoSubmitState.Enabled ? "Withdraw this request to draft" : (undoSubmitState.Reason ?? "Not allowed"))"
                        @onclick="() => { if (undoSubmitState.Enabled) OpenQuickActionModal(_contextMenuTarget, QuickActionType.UndoSubmit); }">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>Unsubmit Request</span>
                    </div>
                    @if (!undoSubmitState.Enabled && !string.IsNullOrEmpty(undoSubmitState.Reason))
                    {
                        <span class="action-reason-hint">@undoSubmitState.Reason</span>
                    }
                </button>
            }

            @if (CanWithdrawReconciliation(_contextMenuTarget))
            {
                <button type="button"
                        class="status-action-item action-undo"
                        disabled="@_quickActionProcessing"
                        title="@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen reconciliation to pending" : "Withdraw reconciliation to pending")"
                        @onclick="() => PromptUndoReconciliationFromContextMenu(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>@(_contextMenuTarget.Status == RequestStatus.Reconciled ? "Reopen Reconciliation" : "Withdraw Reconciliation")</span>
                    </div>
                </button>
            }

            @if (CanUndoRefund(_contextMenuTarget))
            {
                <button type="button"
                        class="status-action-item action-reject"
                        disabled="@_quickActionProcessing"
                        title="Undo recorded refund"
                        @onclick="() => PromptUndoRefundFromContextMenu(_contextMenuTarget)">
                    <div class="action-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                        <span>Undo Refund</span>
                    </div>
                </button>
            }
        }
    </div>
}

@* ── Anchored Tag Popover Box ─────────────────────────────────────────────── *@
<RequestTagPopover IsOpen="_showTagPopover"
                   Target="_tagPopoverTarget"
                   X="_tagPopoverX"
                   Y="_tagPopoverY"
                   IsButtonAnchor="_tagPopoverIsButton"
                   OnClose="CloseTagPopover"
                   OnTagsChanged="args => UpdateRequestTags(args.RequestId, args.Tags)"
                   OnToast="ShowToast" />

@* ── Quick Status Action Popover (Anchored like Tag Management) ───────────── *@
@if (_showQuickActionModal && _quickActionTarget != null)
{
    <div style="position: fixed; inset: 0; z-index: 1055; cursor: default; background: transparent;"
         @onclick="CloseQuickActionModal"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseQuickActionModal"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_quickActionRef" class="tag-popover-box"
         style="left: @(_quickActionX)px; top: @(_quickActionY)px; width: 310px;"
         @onclick:stopPropagation="true">
        <div class="popover-header">
            <div>
                <div class="popover-title">
                    @if (_quickActionType == QuickActionType.SendBack)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Send Back Request</span>
                    }
                    else if (_quickActionType == QuickActionType.Reject)
                    {
                        <span style="color: var(--color-danger); font-weight: 700;">✕</span>
                        <span>Reject Request</span>
                    }
                    else if (_quickActionType == QuickActionType.FinanceApprove)
                    {
                        <span style="color: var(--color-success); font-weight: 700;">✓</span>
                        <span>Finance Approval</span>
                    }
                    else if (_quickActionType == QuickActionType.UndoApprove)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Undo Approval</span>
                    }
                    else if (_quickActionType == QuickActionType.UndoSubmit)
                    {
                        <span style="color: var(--color-warning); font-weight: 700;">↩</span>
                        <span>Undo Submission</span>
                    }
                </div>
                <div class="popover-ref-subtitle">
                    @(_quickActionTarget.Reference ?? "Draft / No Ref")
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-xs"
                    style="padding: 1px 4px; border: none; background: transparent; color: var(--color-text-muted); cursor: pointer;"
                    @onclick="CloseQuickActionModal" title="Close">✕</button>
        </div>

        @if (!string.IsNullOrEmpty(_quickActionError))
        {
            <div class="alert alert-error" style="font-size: 11px; padding: 4px 8px; margin: 6px 10px 0;">
                @_quickActionError
            </div>
        }

        <div style="padding: 10px 12px;">
            @if (_quickActionType == QuickActionType.FinanceApprove)
            {
                <div class="mb-2">
                    <label class="form-label text-xs font-semibold mb-1 block" style="font-size: 11px;">Chart of Account (COA) <span style="color: var(--color-danger);">*</span></label>
                    <select class="input input-sm w-full" @bind="_quickFinanceCoaId">
                        <option value="">-- Select Chart of Account --</option>
                        @foreach (var c in _coas.Where(c => c.IsActive))
                        {
                            <option value="@c.Id">@c.Code - @c.Name</option>
                        }
                    </select>
                </div>
                @if (_quickActionTarget.Type == BudgetRequestType.Advance)
                {
                    <div class="mb-2">
                        <label class="form-label text-xs font-semibold mb-1 block" style="font-size: 11px;">Reconciliation Deadline <span style="color: var(--color-danger);">*</span></label>
                        <input type="date" class="input input-sm w-full" @bind="_quickFinanceReconciliationDeadline" />
                    </div>
                }
            }
            else if (_quickActionType == QuickActionType.UndoSubmit)
            {
                <p class="text-xs text-muted mb-2">
                    Withdraw this submission and return it to <strong>Draft</strong> status so you can edit details or attachments.
                </p>
            }
            else if (_quickActionType == QuickActionType.UndoApprove)
            {
                var undoInfo = GetUndoApprovalTargetInfo(_quickActionTarget);
                <p class="text-xs text-muted mb-2">
                    Revoke <strong>@(undoInfo.Stage)</strong> approval and revert this request back to <strong>@(undoInfo.TargetStatus)</strong>.
                </p>
                <label class="block text-xs font-semibold mb-1" style="font-size: 11.5px; color: var(--color-text-dark);">
                    Reason / Comment <span class="text-muted">(optional)</span>
                </label>
                <textarea class="input input-sm w-full" rows="2"
                          style="resize: none; font-size: 12px; padding: 6px 8px;"
                          placeholder="Optional reason for undoing approval..."
                          @bind="_quickActionComment"
                          @bind:event="oninput"></textarea>
            }
            else
            {
                <label class="block text-xs font-semibold mb-1" style="font-size: 11.5px; color: var(--color-text-dark);">
                    @(_quickActionType == QuickActionType.SendBack ? "Reason / Comments for Requester" : "Rejection Reason")
                    <span style="color: var(--color-danger);">*</span>
                </label>
                <textarea class="input input-sm w-full" rows="3"
                          style="resize: none; font-size: 12px; padding: 6px 8px;"
                          placeholder="@(_quickActionType == QuickActionType.SendBack ? "Explain what needs revision..." : "Explain why this request is rejected...")"
                          @bind="_quickActionComment"
                          @bind:event="oninput"
                          autofocus></textarea>
                <div class="flex justify-between items-center text-muted mt-1" style="font-size: 10px;">
                    <span>Mandatory for audit trail</span>
                    <span>@(_quickActionComment?.Length ?? 0) chars</span>
                </div>
            }
        </div>

        <div class="popover-footer-action" style="display: flex; justify-content: flex-end; gap: 6px; padding: 8px 12px; background: #fafafa; border-top: 1px solid var(--color-border);">
            <button type="button" class="btn btn-outline btn-xs"
                    style="padding: 3px 8px; font-size: 11.5px;"
                    @onclick="CloseQuickActionModal" disabled="@_quickActionProcessing">
                Cancel
            </button>
            <button type="button"
                    class="btn btn-xs @(_quickActionType == QuickActionType.Reject ? "btn-danger" : (_quickActionType == QuickActionType.SendBack || _quickActionType == QuickActionType.UndoApprove || _quickActionType == QuickActionType.UndoSubmit) ? "btn-warning" : "btn-success")"
                    style="padding: 3px 10px; font-size: 11.5px; font-weight: 600;"
                    @onclick="ExecuteQuickModalActionAsync"
                    disabled="@_quickActionProcessing">
                @if (_quickActionProcessing)
                {
                    <span class="spinner spinner-xs me-1"></span>
                }
                @(_quickActionType == QuickActionType.Reject ? "Confirm Reject" :
                  _quickActionType == QuickActionType.SendBack ? "Confirm Send Back" :
                  _quickActionType == QuickActionType.UndoApprove ? "Confirm Undo" :
                  _quickActionType == QuickActionType.UndoSubmit ? "Withdraw to Draft" : "Confirm Approval")
            </button>
        </div>
    </div>
}

@* ── Withdraw / Reopen Reconciliation confirmation modal ────────────────────── *@
@if (_withdrawingReconciliationRequest is not null)
{
    <ConfirmDialog Title="Reopen Reconciliation"
                   Type="ConfirmType.Warning"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoReconciliationSubmit"
                   OnCancel="() => _withdrawingReconciliationRequest = null">
        Reopen reconciliation for advance <strong>@(_withdrawingReconciliationRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the advance to <strong>Reconciliation in Progress</strong> so expense line items can be adjusted. All recorded entries and receipts will be kept.
        </div>
    </ConfirmDialog>
}

@* ── Undo Refund confirmation modal ─────────────────────────────────────────── *@
@if (_undoingRefundRequest is not null)
{
    <ConfirmDialog Title="Undo Refund Receipt"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoUndoRefund"
                   OnCancel="() => _undoingRefundRequest = null">
        Undo recorded refund receipt for <strong>@(_undoingRefundRequest.Reference ?? "this advance")</strong>?
        <div class="alert alert-warning text-xs mt-3">
            This will return the request to <strong>Awaiting Refund</strong> until the refund payment is confirmed again.
        </div>
    </ConfirmDialog>
}

@* ── Toast Notification ───────────────────────────────────────────────────── *@
@if (_showToast)
{
    <div class="toast-notification">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2EC662" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@_toastMessage</span>
    </div>
}

@code {
    // ── Filter state ─────────────────────────────────────────────────────────
    private string _search = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _selectedDepartmentId = "";
    private string _selectedCoaId = "";
    private string _selectedTagId = "";
    private string _selectedCurrencyCode = "";
    private string _selectedWithdrawMethodId = "";
    private string _selectedRequesterId = "";
    private string _selectedApproverId = "";
    private string _overLimitFilter = "any";
    private HashSet<RequestStatus> _selectedStatuses = new();
    private HashSet<BudgetRequestType> _selectedTypes = new();
    private decimal? _amountMmkFrom;
    private decimal? _amountMmkTo;
    private bool _periodOverrunOnly;
    private bool _departmentLocked;

    // ── UI state ─────────────────────────────────────────────────────────────
    private bool _showFilter;

    private int _activeFilterCount => new[]
    {
        !string.IsNullOrEmpty(_search),
        _fromDate.HasValue,
        _toDate.HasValue,
        !string.IsNullOrEmpty(_selectedDepartmentId),
        !string.IsNullOrEmpty(_selectedCoaId),
        !string.IsNullOrEmpty(_selectedTagId),
        !string.IsNullOrEmpty(_selectedCurrencyCode),
        !string.IsNullOrEmpty(_selectedWithdrawMethodId),
        !string.IsNullOrEmpty(_selectedRequesterId),
        !string.IsNullOrEmpty(_selectedApproverId),
        _overLimitFilter != "any",
        _selectedStatuses.Count > 0,
        _selectedTypes.Count > 0,
        _amountMmkFrom.HasValue,
        _amountMmkTo.HasValue,
        _periodOverrunOnly,
    }.Count(x => x);

    // ── Reference data ───────────────────────────────────────────────────────
    private List<DepartmentDto> _departments = new();
    private List<VisibleTagDto> _availableTags = new();

    private List<VisibleTagDto> AvailableTagsForDepartment
    {
        get
        {
            if (Guid.TryParse(_selectedDepartmentId, out var deptId) && deptId != Guid.Empty)
            {
                return _availableTags.Where(t => t.DepartmentId == deptId).ToList();
            }

            if (CurrentUser.IsDepartmentHead || CurrentUser.Role != UserRole.Admin)
            {
                return _availableTags.Where(t => t.DepartmentId == CurrentUser.DepartmentId).ToList();
            }

            return _availableTags;
        }
    }

    private void OnDepartmentFilterChanged()
    {
        if (!string.IsNullOrEmpty(_selectedTagId))
        {
            if (!AvailableTagsForDepartment.Any(t => t.Id.ToString() == _selectedTagId))
            {
                _selectedTagId = "";
            }
        }
    }
    private List<CoaDto> _coas = new();
    private List<CurrencyDto> _currencies = new();
    private List<WithdrawMethodDto> _withdrawMethods = new();
    private List<UserDto> _allUsers = new();
    private List<UserDto> _approverCandidates = new();
    private Dictionary<Guid, string> _userNames = new();
    private Dictionary<Guid, string> _departmentNames = new();

    // ── Context menu & Quick actions ─────────────────────────────────────────
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private BudgetRequestSummaryDto? _contextMenuTarget;

    // ── Quick status actions & popup state ───────────────────────────────────
    private enum QuickActionType
    {
        None,
        SendBack,
        Reject,
        FinanceApprove,
        UndoApprove,
        UndoSubmit
    }

    private sealed record QuickActionState(bool Enabled, string? Reason);

    private bool _showQuickActionModal;
    private QuickActionType _quickActionType = QuickActionType.None;
    private BudgetRequestSummaryDto? _quickActionTarget;
    private string _quickActionComment = "";
    private string? _quickActionError;
    private bool _quickActionProcessing;
    private string _quickFinanceCoaId = "";
    private DateTime _quickFinanceReconciliationDeadline = DateTimeExtensions.MyanmarToday.AddDays(3);
    private ElementReference _quickActionRef;
    private bool _quickActionPendingPosition;
    private double _quickActionX;
    private double _quickActionY;

    // ── Tag Popover ──────────────────────────────────────────────────────────
    private bool _showTagPopover;
    private BudgetRequestSummaryDto? _tagPopoverTarget;
    private double _tagPopoverX;
    private double _tagPopoverY;
    private bool _tagPopoverIsButton;
    private TagVisibilityConfig? _tagVisibilityConfig;

    private bool _showToast;
    private string _toastMessage = "";
    private System.Threading.CancellationTokenSource? _toastCts;

    // ── Paging & sort ────────────────────────────────────────────────────────
    private int _page = 1;
    private int _pageSize = 50;
    private BudgetRequestSortBy _sortBy = BudgetRequestSortBy.SubmittedAt;
    private bool _sortDescending = true;

    // ── Results ──────────────────────────────────────────────────────────────
    private PagedResult<BudgetRequestSummaryDto>? _result;
    private bool _loading = true;
    private string? _errorMessage;

    private static readonly RequestStatus[] AllStatuses =
    {
        RequestStatus.Draft,
        RequestStatus.PendingDeptHead,
        RequestStatus.PendingManagement,
        RequestStatus.PendingFinance,
        RequestStatus.SentBack,
        RequestStatus.Approved,
        RequestStatus.PartiallyPaid,
        RequestStatus.Paid,
        RequestStatus.Rejected,
        RequestStatus.Cancelled,
        RequestStatus.PendingReconciliation,
        RequestStatus.AwaitingRefund,
        RequestStatus.Reconciled,
    };

    private static readonly BudgetRequestType[] AllTypes =
    {
        BudgetRequestType.Urgent,
        BudgetRequestType.Standard,
        BudgetRequestType.ProjectProposal,
        BudgetRequestType.Advance,
    };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role == UserRole.Employee && !CurrentUser.IsDepartmentHead)
        {
            _loading = false;
            return;
        }

        if (FilterState.BudgetReport is not null)
        {
            var s = FilterState.BudgetReport;
            _search = s.Search;
            _fromDate = s.FromDate;
            _toDate = s.ToDate;
            _selectedDepartmentId = s.SelectedDepartmentId;
            _selectedCoaId = s.SelectedCoaId;
            _selectedTagId = s.SelectedTagId;
            _selectedCurrencyCode = s.SelectedCurrencyCode;
            _selectedWithdrawMethodId = s.SelectedWithdrawMethodId;
            _selectedRequesterId = s.SelectedRequesterId;
            _selectedApproverId = s.SelectedApproverId;
            _overLimitFilter = s.OverLimitFilter;
            _selectedStatuses = new HashSet<RequestStatus>(s.SelectedStatuses);
            _selectedTypes = new HashSet<BudgetRequestType>(s.SelectedTypes);
            _amountMmkFrom = s.AmountMmkFrom;
            _amountMmkTo = s.AmountMmkTo;
            _periodOverrunOnly = s.PeriodOverrunOnly;
            _sortBy = s.SortBy;
            _sortDescending = s.SortDescending;
            _page = s.Page;
            _pageSize = s.PageSize;
        }
        else
        {
            // Use Myanmar business time so the default month/day is correct even
            // when opened between 00:00-06:30 AM MMT (where UTC is still yesterday).
            var nowMm = DateTime.UtcNow.ToMyanmarDateTime();
            _fromDate = new DateTime(nowMm.Year, nowMm.Month, 1);
            _toDate = nowMm.Date;
        }

        if (CurrentUser.IsDepartmentHead  && CurrentUser.Role == UserRole.Employee)
        {
            _selectedDepartmentId = CurrentUser.DepartmentId.ToString();
            _departmentLocked = true;
        }

        await LoadReferenceDataAsync();
        await RunQueryAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        var depts = await Mediator.Send(new ListDepartmentsQuery(IncludeInactive: true));
        if (depts.IsSuccess)
        {
            _departments = depts.Value!.Where(d => d.IsActive).OrderBy(d => d.Name).ToList();
            _departmentNames = depts.Value!.ToDictionary(d => d.Id, d => d.Name);
        }

        var coas = await Mediator.Send(new ListCoasQuery(IncludeInactive: true));
        if (coas.IsSuccess)
            _coas = coas.Value!.OrderBy(c => c.Code).ToList();

        var ccys = await Mediator.Send(new ListCurrenciesQuery(IncludeInactive: true));
        if (ccys.IsSuccess)
            _currencies = ccys.Value!.OrderBy(c => c.Code == "MMK" ? 0 : 1).ThenBy(c => c.Code).ToList();

        var methods = await Mediator.Send(new ListWithdrawMethodsQuery(IncludeInactive: true));
        if (methods.IsSuccess)
            _withdrawMethods = methods.Value!.OrderBy(m => m.Name).ToList();

        var users = await Mediator.Send(new ListUsersQuery(IncludeInactive: false));
        if (users.IsSuccess)
        {
            _allUsers = users.Value!.OrderBy(u => u.FullName).ToList();
            _approverCandidates = _allUsers
                .Where(u => u.Role is UserRole.Management
                                   or UserRole.Finance
                                   or UserRole.Admin
                            || _departments.Any(d => d.HeadUserId == u.Id))
                .ToList();
            _userNames = _allUsers.ToDictionary(u => u.Id, u => u.FullName);
        }

        var tagsRes = await Mediator.Send(new ListVisibleTagsForUserQuery(CurrentUser.UserId));
        if (tagsRes.IsSuccess && tagsRes.Value is not null)
            _availableTags = tagsRes.Value.ToList();

        var configRes = await Mediator.Send(new GetAppSettingByKeyQuery(TagVisibilityConfig.SettingKey));
        if (configRes.IsSuccess)
            _tagVisibilityConfig = TagVisibilityConfig.FromJson(configRes.Value?.Value);
    }

    private async Task RunQueryAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            DateTime? fromUtc = _fromDate.HasValue
                ? DateTime.SpecifyKind(_fromDate.Value.Date, DateTimeKind.Utc)
                : null;
            DateTime? untilUtc = _toDate.HasValue
                ? DateTime.SpecifyKind(_toDate.Value.Date, DateTimeKind.Utc).AddDays(1)
                : null;

            bool? overLimitOnly = _overLimitFilter switch
            {
                "over"   => true,
                "within" => false,
                _        => null
            };

            IReadOnlyCollection<RequestStatus>? statuses =
                _selectedStatuses.Count > 0 ? _selectedStatuses.ToList() : null;

            IReadOnlyCollection<BudgetRequestType>? types =
                _selectedTypes.Count > 0 ? _selectedTypes.ToList() : null;

            decimal? amountFrom = _amountMmkFrom;
            decimal? amountTo = _amountMmkTo;
            if (amountFrom.HasValue && amountTo.HasValue && amountFrom.Value > amountTo.Value)
            {
                amountFrom = null;
                amountTo = null;
            }

            if (_departmentLocked)
            {
                _selectedDepartmentId = CurrentUser.DepartmentId.ToString();
            }

            var result = await Mediator.Send(new SearchBudgetRequestsQuery(
                RequesterId: ParseGuid(_selectedRequesterId),
                DepartmentId: ParseGuid(_selectedDepartmentId),
                Status: null,
                Statuses: statuses,
                SubmittedFromUtc: fromUtc,
                SubmittedUntilUtc: untilUtc,
                CoaId: ParseGuid(_selectedCoaId),
                CurrencyCode: string.IsNullOrEmpty(_selectedCurrencyCode) ? null : _selectedCurrencyCode,
                ApproverId: ParseGuid(_selectedApproverId),
                OverLimitOnly: overLimitOnly,
                Types: types,
                AmountInMmkFrom: amountFrom,
                AmountInMmkTo: amountTo,
                PeriodOverrunOnly: _periodOverrunOnly ? true : null,
                SearchTerm: string.IsNullOrWhiteSpace(_search) ? null : _search,
                SortBy: _sortBy,
                SortDescending: _sortDescending,
                Page: _page,
                PageSize: _pageSize,
                WithdrawMethodId: ParseGuid(_selectedWithdrawMethodId),
                TagId: ParseGuid(_selectedTagId),
                ViewerUserId: CurrentUser.UserId));

            if (result.IsSuccess)
            {
                _result = result.Value!;
                FilterState.BudgetReport = new BudgetReportFilterState
                {
                    Search = _search,
                    FromDate = _fromDate,
                    ToDate = _toDate,
                    SelectedDepartmentId = _selectedDepartmentId,
                    SelectedCoaId = _selectedCoaId,
                    SelectedTagId = _selectedTagId,
                    SelectedCurrencyCode = _selectedCurrencyCode,
                    SelectedWithdrawMethodId = _selectedWithdrawMethodId,
                    SelectedRequesterId = _selectedRequesterId,
                    SelectedApproverId = _selectedApproverId,
                    OverLimitFilter = _overLimitFilter,
                    SelectedStatuses = new HashSet<RequestStatus>(_selectedStatuses),
                    SelectedTypes = new HashSet<BudgetRequestType>(_selectedTypes),
                    AmountMmkFrom = _amountMmkFrom,
                    AmountMmkTo = _amountMmkTo,
                    PeriodOverrunOnly = _periodOverrunOnly,
                    SortBy = _sortBy,
                    SortDescending = _sortDescending,
                    Page = _page,
                    PageSize = _pageSize
                };
            }
            else
            {
                _errorMessage = result.Error.Message;
                _result = null;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

