@page "/bank-accounts"
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject FilterStateService FilterState

@using SureBudgetRequest.Application.BankAccounts.Queries
@using SureBudgetRequest.Application.BankAccounts.Commands.CreateBankAccount
@using SureBudgetRequest.Application.BankAccounts.Commands.UpdateBankAccount
@using SureBudgetRequest.Application.BankAccounts.Commands.DeactivateBankAccount
@using SureBudgetRequest.Application.BankAccounts.Commands.ReactivateBankAccount
@using SureBudgetRequest.Web.Components.Shared

<PageTitle>Bank Accounts</PageTitle>

<div class="page-wrap">
    <div class="flex items-center justify-between mb-4">
        <h5>Company Bank Accounts</h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ New Account</button>
    </div>

    

    <div class="flex items-center gap-2 mb-2">
        <label class="toggle" title="Show inactive">
            <input type="checkbox" @bind="_showInactive" @bind:after="LoadData" />
            <span class="toggle-track"></span>
            <span class="toggle-thumb"></span>
        </label>
        <span class="text-sm text-muted">Show inactive</span>
    </div>

    <div class="mb-4">
        <ListSearchBox @bind-Value="_search" @bind-Value:after="ApplyFilter"
                       Placeholder="Search bank, number, or holder" Width="260px" />
    </div>

    @if (_loading)
    {
        <div class="text-center "><div class="spinner spinner-sm"></div></div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead >
                    <tr>
                        <th class="col-no">#</th>
                        <th>Bank</th>
                        <th>Account number</th>
                        <th>Account holder</th>
                        <th>Status</th>
                        <th class="sticky-action-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var a = _filtered[i];
                        <tr class="clickable-row @(!a.IsActive ? "text-muted" : "") @(_contextMenuTarget?.Id == a.Id ? "menu-open" : "")"
                            @onclick="() => OpenEdit(a)"
                            @oncontextmenu="e => OpenContextMenu(e, a)"
                            @oncontextmenu:preventDefault="true">
                            <td class="text-muted text-sm col-no">@(i + 1)</td>
                            <td><strong>@a.BankName</strong></td>
                            <td class="font-mono text-sm">@a.AccountNumber</td>
                            <td>@a.AccountHolderName</td>
                            <td @onclick:stopPropagation="true">
                                @if (a.IsActive)
                                {
                                    <button class="badge badge-active" @onclick="() => ConfirmDeactivate(a)" title="Click to deactivate">Active</button>
                                }
                                else
                                {
                                    <AsyncButton Class="badge badge-inactive" OnClick="@(() => DoReactivate(a))" title="Click to activate">Inactive</AsyncButton>
                                }
                            </td>
                            <td class="sticky-action-col" @onclick:stopPropagation="true">
                                <div class="row-hover-btn-wrapper">
                                    <div class="row-hover-backdrop"></div>
                                    <button type="button" class="btn-three-dots" title="Quick actions"
                                            @onclick="e => OpenContextMenuFromButton(e, a)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5" r="2"/>
                                            <circle cx="12" cy="12" r="2"/>
                                            <circle cx="12" cy="19" r="2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!_filtered.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <tr><td colspan="6" class="text-center text-muted ">No bank accounts match your search.</td></tr>
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted ">No bank accounts found.</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────────── *@
@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div >
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingId.HasValue ? "Edit Bank Account" : "New Bank Account")</h6>
                    <button class="btn btn-icon modal-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-error">@_formError</div>
                    }
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Bank name</label>
                        <input class="input" @bind="_formBankName"
                               placeholder="e.g. KBZ Bank" maxlength="200" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Account number</label>
                        <input class="input" @bind="_formAccountNumber"
                               placeholder="e.g. 0012-3456-7890-1234" maxlength="100" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-sm font-semibold">Account holder name</label>
                        <input class="input" @bind="_formAccountHolderName"
                               placeholder="e.g. aSure Co., Ltd." maxlength="200" />
                    </div>
                    @if (_editingId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="accountFormActive" @bind="_formIsActive" />
                            <label class="form-label" for="accountFormActive">Active</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CloseForm">Cancel</button>
                    <AsyncButton Class="btn btn-primary btn-sm" OnClick="SaveForm">Save</AsyncButton>
                </div>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm ─────────────────────────────────────────────────────── *@
@if (_deactivatingAccount is not null)
{
    <ConfirmDialog Title="Deactivate Bank Account"
                   Type="ConfirmType.Danger"
                   ConfirmText="Yes"
                   OnConfirm="DoDeactivate"
                   OnCancel="() => _deactivatingAccount = null">
        Deactivate <strong>@_deactivatingAccount.BankName (@_deactivatingAccount.AccountNumber)</strong>? It will no longer appear when recording new payments. Historical records remain unchanged.
    </ConfirmDialog>
}


@* ── Context Menu ── *@
@if (_showContextMenu && _contextMenuTarget is not null)
{
    <div class="context-menu-backdrop"
         @onclick="CloseContextMenu"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="true"
         @oncontextmenu="CloseContextMenu"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true">
    </div>

    <div @ref="_contextMenuRef" class="custom-context-menu"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true">
        <div class="context-menu-header">
            <span>@_contextMenuTarget.BankName</span>
        </div>

        <button type="button" class="context-menu-item" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); OpenEdit(target); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Account</span>
        </button>

        <div class="context-menu-divider"></div>

        @if (_contextMenuTarget.IsActive)
        {
            <button type="button" class="context-menu-item text-danger" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); ConfirmDeactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span>Deactivate</span>
            </button>
        }
        else
        {
            <button type="button" class="context-menu-item text-success" @onclick="() => { var target = _contextMenuTarget; CloseContextMenu(); _ = DoReactivate(target); }">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Reactivate</span>
            </button>
        }
    </div>
}

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private List<BankAccountDto> _accounts = new();
    private List<BankAccountDto> _filtered = new();
    private bool _loading = true;
    private bool _showInactive;
    private string _search = "";

    // Form state
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private string _formBankName = "";
    private string _formAccountNumber = "";
    private string _formAccountHolderName = "";
    private bool _formIsActive = true;

    // Deactivate confirm
    private BankAccountDto? _deactivatingAccount;

    // Context menu state
    private bool _showContextMenu;
    private double _contextMenuX;
    private double _contextMenuY;
    private double _menuClickX;
    private double _menuClickY;
    private bool _menuIsButton;
    private bool _menuPendingPosition;
    private ElementReference _contextMenuRef;
    private BankAccountDto? _contextMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, BankAccountDto account)
    {
        _contextMenuTarget = account;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = false;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void OpenContextMenuFromButton(MouseEventArgs e, BankAccountDto account)
    {
        _contextMenuTarget = account;
        _menuClickX = e.ClientX;
        _menuClickY = e.ClientY;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _menuIsButton = true;
        _menuPendingPosition = true;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTarget = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showContextMenu && _menuPendingPosition)
        {
            _menuPendingPosition = false;
            await JS.InvokeVoidAsync("positionContextMenu", _contextMenuRef, _menuClickX, _menuClickY, _menuIsButton);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Role is not UserRole.Finance and not UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _search = FilterState.GetSearch("bank_accounts") ?? "";
        if (FilterState.GetFlag("bank_accounts_inactive") is bool flag)
            _showInactive = flag;

        await LoadData();
    }

    private async Task LoadData()
    {
        FilterState.SetFlag("bank_accounts_inactive", _showInactive);
        _loading = true;
        var result = await Mediator.Send(new ListBankAccountsQuery(IncludeInactive: _showInactive));
        if (result.IsSuccess)
            _accounts = result.Value.ToList();
        else
            Toast.Error("Load Failed", result.Error.Message);
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        FilterState.SetSearch("bank_accounts", _search);
        var term = _search.Trim();
        _filtered = term.Length == 0
            ? _accounts.ToList()
            : _accounts
                .Where(a => a.BankName.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || a.AccountNumber?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0
                         || a.AccountHolderName?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _formBankName = "";
        _formAccountNumber = "";
        _formAccountHolderName = "";
        _formIsActive = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(BankAccountDto a)
    {
        _editingId = a.Id;
        _formBankName = a.BankName;
        _formAccountNumber = a.AccountNumber ?? "";
        _formAccountHolderName = a.AccountHolderName ?? "";
        _formIsActive = a.IsActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveForm()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_formBankName)) { _formError = "Bank name is required."; return; }

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                var result = await Mediator.Send(new UpdateBankAccountCommand(
                    _editingId.Value, _formBankName, _formAccountNumber, _formAccountHolderName, _formIsActive));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Account Updated", $"'{_formBankName}' updated successfully.");
            }
            else
            {
                var result = await Mediator.Send(new CreateBankAccountCommand(
                    _formBankName, _formAccountNumber, _formAccountHolderName));
                if (result.IsFailure) { _formError = result.Error.Message; return; }
                Toast.Success("Account Created", $"'{_formBankName}' created successfully.");
            }

            _showForm = false;
            await LoadData();
        }
        finally { _saving = false; }
    }

    private void ConfirmDeactivate(BankAccountDto a) => _deactivatingAccount = a;

    private async Task DoDeactivate()
    {
        if (_deactivatingAccount is null) return;
        _saving = true;
        var result = await Mediator.Send(new DeactivateBankAccountCommand(_deactivatingAccount.Id));
        _saving = false;
        var name = _deactivatingAccount.BankName;
        _deactivatingAccount = null;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Account Deactivated", $"'{name}' deactivated."); await LoadData(); }
        StateHasChanged();
    }

    private async Task DoReactivate(BankAccountDto a)
    {
        _saving = true;
        var result = await Mediator.Send(new ReactivateBankAccountCommand(a.Id));
        _saving = false;
        if (result.IsFailure) { Toast.Error("Action Failed", result.Error.Message); }
        else { Toast.Success("Account Reactivated", $"'{a.BankName}' reactivated."); await LoadData(); }
        StateHasChanged();
    }
}
