@page "/login"
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using MediatR
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SureBudgetRequest.Application.Users.Commands.AuthenticateUser
@using SureBudgetRequest.Web.Components.Layout
@using SureBudgetRequest.Web.Services
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Sign in — aSure Budget</PageTitle>

<div class="login-card">
    <div class="login-logo">
        a <span style="font-weight:800">Sure</span> company
    </div>

    <h1 class="login-heading">Welcome Back</h1>
    <p class="login-sub">Enter your credentials to access your account</p>

    <EditForm Model="Input" method="post" OnValidSubmit="HandleLogin"
              FormName="login" Enhance="false">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error" style="margin-bottom:16px">@_errorMessage</div>
        }

        <div class="form-field" style="margin-bottom:20px">
            <label class="form-label" for="login-email">Name</label>
            <InputText id="login-email"
                       @bind-Value="Input.Email"
                       class="input"
                       placeholder="Enter name"
                       autocomplete="username"
                       autofocus />
            <ValidationMessage For="@(() => Input.Email)" class="validation-message" />
        </div>

        <div class="form-field" style="margin-bottom:24px">
            <label class="form-label" for="login-password">Password</label>
            <div style="position:relative">
                <InputText id="login-password"
                           @bind-Value="Input.Password"
                           type="password"
                           class="input"
                           placeholder="Enter password"
                           autocomplete="current-password" />
                <button type="button" tabindex="-1"
                        style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                               background:none;border:none;cursor:pointer;color:var(--color-text-muted);
                               padding:0;display:flex;align-items:center;">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <path d="M1 9C2.5 5 5.5 3 9 3s6.5 2 8 6c-1.5 4-4.5 6-8 6S2.5 13 1 9Z"
                              stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                </button>
            </div>
            <ValidationMessage For="@(() => Input.Password)" class="validation-message" />
        </div>

        <button type="submit"
                style="width:100%;height:44px;border-radius:8px;background:white;
                       border:1px solid var(--color-border-strong);color:var(--color-text-dark);
                       font-size:15px;font-weight:500;cursor:pointer;font-family:var(--font-sans);">
            Sign in
        </button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    public LoginInputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // If already authenticated, send them home.
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task HandleLogin()
    {
        var result = await Mediator.Send(new AuthenticateUserCommand(Input.Email, Input.Password));
        if (result.IsFailure)
        {
            _errorMessage = result.Error.Message;
            return;
        }

        var user = result.Value;
        var ctx = HttpContextAccessor.HttpContext!;

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.Name, user.FullName),
            new(ClaimTypes.Email, user.Email),
            new(ClaimTypes.Role, user.Role.ToString()),
            new(CurrentUserService.ClaimUsername, user.Username),
            new(CurrentUserService.ClaimDepartmentId, user.DepartmentId.ToString()),
            new(CurrentUserService.ClaimMustChangePassword, user.MustChangePassword ? "true" : "false"),
            new(CurrentUserService.ClaimIsFinanceApprover, user.IsFinanceApprover ? "true" : "false"),
        };

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await ctx.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);

        if (user.MustChangePassword)
        {
            Nav.NavigateTo("/account/change-password", forceLoad: true);
            return;
        }

        var dest = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl!;
        Nav.NavigateTo(dest, forceLoad: true);
    }

    public sealed class LoginInputModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}
