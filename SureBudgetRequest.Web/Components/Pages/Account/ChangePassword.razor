@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using MediatR
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SureBudgetRequest.Application.Abstractions
@using SureBudgetRequest.Application.Users.Commands.ChangePassword
@using SureBudgetRequest.Web.Services
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@attribute [ExcludeFromInteractiveRouting]


<PageTitle>Change password — aSure Budget</PageTitle>

<div class="container py-4" style="max-width: 480px;">
    <h4>Change password</h4>
    @if (_mustChange)
    {
        <p class="text-warning small">You must change your initial password before continuing.</p>
    }
    else
    {
        <p class="text-muted small">Choose a new password (at least @ChangePasswordCommandHandler.MinimumPasswordLength characters).</p>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="HandleSubmit"
              FormName="change-password" Enhance="false">
        <DataAnnotationsValidator />
       @*  <AntiforgeryToken /> *@

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_success ? "alert-success" : "alert-danger") py-2 small">@_message</div>
        }

        <div class="mb-3">
            <label class="form-label small">Current password</label>
            <InputText @bind-Value="Input.CurrentPassword"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       autofocus />
            <ValidationMessage For="@(() => Input.CurrentPassword)" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label class="form-label small">New password</label>
            <InputText @bind-Value="Input.NewPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />
            <ValidationMessage For="@(() => Input.NewPassword)" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label class="form-label small">Confirm new password</label>
            <InputText @bind-Value="Input.ConfirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />
            <ValidationMessage For="@(() => Input.ConfirmPassword)" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary">Update password</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    public ChangePasswordInput Input { get; set; } = new();

    private string? _message;
    private bool _success;
    private bool _mustChange;

    protected override void OnInitialized()
    {
        var ctx = HttpContextAccessor.HttpContext;
        _mustChange = ctx?.User.FindFirst(CurrentUserService.ClaimMustChangePassword)?.Value == "true";
    }

    private async Task HandleSubmit()
    {
        if (Input.NewPassword != Input.ConfirmPassword)
        {
            _message = "New password and confirmation do not match.";
            _success = false;
            return;
        }

        var result = await Mediator.Send(new ChangePasswordCommand(
            CurrentUser.UserId,
            Input.CurrentPassword,
            Input.NewPassword));

        if (result.IsFailure)
        {
            _message = result.Error.Message;
            _success = false;
            return;
        }

        // Sign the user out so the next request gets a fresh cookie with
        // MustChangePassword=false. Simpler and safer than rewriting claims here.
        await HttpContextAccessor.HttpContext!.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Current password is required.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(10, ErrorMessage = "New password must be at least 10 characters.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
