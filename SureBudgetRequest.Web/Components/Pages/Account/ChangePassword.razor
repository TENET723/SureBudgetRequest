@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using MediatR
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SureBudgetRequest.Application.Abstractions
@using SureBudgetRequest.Application.Users.Commands.ChangePassword
@using SureBudgetRequest.Web.Services
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Change password — aSure Budget</PageTitle>

<div style="max-width:520px;margin:0 auto">
    <div class="card">
        <div class="card-header">
            <span class="card-header-title">@(_mustChange ? "Set your password" : "Change password")</span>
        </div>
        <div class="card-body">
            @if (_mustChange)
            {
                <div class="alert alert-warning mb-4">
                    You must change your initial password before continuing.
                </div>
            }
            else
            {
                <p class="text-sm text-muted mb-4">
                    Choose a new password (at least @ChangePasswordCommandHandler.MinimumPasswordLength characters).
                </p>
            }

            <EditForm Model="Input" method="post" OnValidSubmit="HandleSubmit"
                      FormName="change-password" Enhance="false">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @(_success ? "alert-success" : "alert-error") mb-4">@_message</div>
                }

                <div class="form-field mb-4">
                    <label class="form-label">Current password</label>
                    <InputText @bind-Value="Input.CurrentPassword"
                               type="password"
                               class="input"
                               autocomplete="current-password"
                               autofocus />
                    <ValidationMessage For="@(() => Input.CurrentPassword)" class="validation-message" />
                </div>

                <div class="form-field mb-4">
                    <label class="form-label">New password</label>
                    <InputText @bind-Value="Input.NewPassword"
                               type="password"
                               class="input"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => Input.NewPassword)" class="validation-message" />
                </div>

                <div class="form-field mb-6">
                    <label class="form-label">Confirm new password</label>
                    <InputText @bind-Value="Input.ConfirmPassword"
                               type="password"
                               class="input"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => Input.ConfirmPassword)" class="validation-message" />
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public ChangePasswordInput Input { get; set; } = new();

    private string? _message;
    private bool _success;
    private bool _mustChange;

    protected override void OnInitialized()
    {
        var ctx = HttpContextAccessor.HttpContext;
        _mustChange = ctx?.User.FindFirst(CurrentUserService.ClaimMustChangePassword)?.Value == "true";
    }

    private async Task HandleSubmit()
    {
        if (Input.NewPassword != Input.ConfirmPassword)
        {
            _message = "New password and confirmation do not match.";
            _success = false;
            return;
        }

        var result = await Mediator.Send(new ChangePasswordCommand(
            CurrentUser.UserId,
            Input.CurrentPassword,
            Input.NewPassword));

        if (result.IsFailure)
        {
            _message = result.Error.Message;
            _success = false;
            return;
        }

        // Sign the user out so the next request gets a fresh cookie with
        // MustChangePassword=false. Simpler and safer than rewriting claims here.
        await HttpContextAccessor.HttpContext!.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Current password is required.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(10, ErrorMessage = "New password must be at least 10 characters.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
